{% doc %}
  @prompt
    Adicione uma grade de produtos com titulo, subtitulo, seletor de qual coleção vai ser exibida na grade, seletor de quantidade de produtos por linha e botão ver mais para expandir a exibição para mais linhas., a exibição do card do produto esta diferente do restante do site. Preciso que fique no mesmo padrão., O product.card atual tem o seguinte código:
    {% comment %}
      Reutilizável — card de produto
      Parâmetros:
        card_product    — objeto product (obrigatório)
        card_show_badge — boolean (opcional)
        card_btn_label  — string (opcional, default "Comprar")
    {% endcomment %}
    
    {%- liquid
      assign card_url = card_product.url
      assign card_title = card_product.title
      assign card_img = card_product.featured_image
      assign card_cta_label = card_btn_label | default: 'Comprar'
    
      assign card_has_discount = false
      assign card_discount_pct = 0
      assign card_compare = card_product.compare_at_price_max | default: 0
      if card_compare == 0
        assign card_cv = card_product.selected_or_first_available_variant
        assign card_compare = card_cv.compare_at_price | default: 0
      endif
      assign card_price = card_product.price_min | default: card_product.price
      if card_compare > card_price
        assign card_has_discount = true
        assign card_discount_pct = card_compare | minus: card_price | times: 100 | divided_by: card_compare | round
      endif
    
      assign card_effective_price = card_product.price
      if card_has_discount == false and settings.auto_discount_enabled and settings.auto_discount_percent > 0
        assign card_has_discount = true
        assign card_discount_pct = settings.auto_discount_percent
        assign card_compare_price = card_product.price
        assign card_discount_cents = card_product.price | times: card_discount_pct | divided_by: 100
        assign card_effective_price = card_product.price | minus: card_discount_cents
      else
        assign card_compare_price = card_compare
      endif
    
      assign card_badge = ''
      if card_product.tags contains 'heritage'
        assign card_badge = 'Heritage'
      elsif card_product.tags contains 'novo'
        assign card_badge = 'Novo'
      elsif card_product.tags contains 'mais-vendido'
        assign card_badge = 'Mais Vendido'
      endif
    
      assign card_rating = card_product.metafields.reviews.rating.value
    
      assign pix_pct = settings.pix_discount | default: 5
      assign pix_cents = card_effective_price | times: pix_pct | divided_by: 100
      assign pix_cents = card_effective_price | minus: pix_cents
      assign inst_count = settings.installments_count | default: 3
      assign inst_value = card_effective_price | divided_by: inst_count
    -%}
    
    <div class="ame-card" data-product-card>
      <a href="{{ card_url }}" class="ame-card__link" tabindex="-1" aria-hidden="true">
        <div class="ame-card__image-wrap">
          {%- if card_img != blank -%}
            {%- assign card_img_alt = card_img.alt | default: card_title | escape -%}
            {{ card_img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '200, 400, 600', class: 'ame-card__img', alt: card_img_alt }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'ame-card__img ame-card__img--placeholder' }}
          {%- endif -%}
    
          <!-- Desconto top-left -->
          {%- if card_has_discount -%}
            <span class="ame-card__discount-badge" aria-label="{{ card_discount_pct }}% de desconto">
              {{ card_discount_pct }}% OFF
            </span>
          {%- endif -%}
    
          <!-- Badge de texto (Heritage / Novo / Mais Vendido) bottom-left -->
          {%- if card_badge != '' -%}
            <span class="ame-chip ame-chip--primary ame-card__badge">{{ card_badge }}</span>
          {%- endif -%}
    
          <!-- Avaliação top-right -->
          {%- if card_rating != blank -%}
            <span class="ame-card__rating-badge" aria-label="Avaliação: {{ card_rating }}">
              <span class="material-symbols-outlined ame-card__rating-star" aria-hidden="true">star</span>
              {{ card_rating }}
            </span>
          {%- endif -%}
    
          <!-- Favorito bottom-right -->
          <button
            class="ame-wishlist ame-card__wishlist"
            aria-label="Adicionar aos favoritos" title="Adicionar aos favoritos"
            data-wishlist-btn="{{ card_product.id }}"
            type="button"
            aria-pressed="false"
          >
            <span class="material-symbols-outlined" style="font-size:1.125rem; font-variation-settings:'FILL' 0;"
              >favorite</span
            >
          </button>
        </div>
      </a>
    
      <div class="ame-card__info">
        {%- if card_product.metafields.custom.collection_name != blank -%}
          <p class="ame-card__collection">{{ card_product.metafields.custom.collection_name }}</p>
        {%- elsif card_product.collections.first != blank -%}
          <p class="ame-card__collection">{{ card_product.collections.first.title }}</p>
        {%- endif -%}
    
        <h3 class="ame-card__title">
          <a href="{{ card_url }}">{{ card_title }}</a>
        </h3>
    
        <!-- Bloco de preços -->
        <div class="ame-card__prices">
          {%- if card_has_discount -%}
            <p class="ame-card__price-de">
              De: <s>{{ card_compare_price | money }}</s>
            </p>
          {%- endif -%}
    
          <p class="ame-card__price-main">
            <span class="ame-card__price-label">a partir de</span>
            <strong class="ame-card__price-value">{{ card_effective_price | money }}</strong>
          </p>
    
          {%- if settings.show_installments != false and inst_count > 1 -%}
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    /* Sem padding lateral: o grid da .shopify-section pai já cuida da margem
       da página via --page-margin. Aplicar de novo aqui causaria padding duplo. */
  }
  /* Garante que filhos de qualquer profundidade não estourem o container.
     Sem isto, cards com elementos absolute/inline-block podem ultrapassar. */
  .ai-product-grid-{{ ai_gen_id }} * {
    min-width: 0;
  }

  .ai-product-grid__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-product-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-product-grid__subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  /* Mesma fórmula do grid de coleções ([sections/collection.liquid:427]):
     mobile = 2 cols, tablet/desktop = N cols configurável no admin.
     Gap progressivo (menor no mobile, maior no desktop) pra ficar igual
     visualmente ao grid das páginas de coleção. */
  .ai-product-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.products_per_row_mobile }}, 1fr);
    gap: 1.5rem 0.75rem;
    margin-bottom: 32px;
  }
  @media (min-width: 768px) {
    .ai-product-grid__grid-{{ ai_gen_id }} {
      gap: 2rem 1.5rem;
      grid-template-columns: repeat({{ block.settings.products_per_row }}, 1fr);
    }
  }

  /* Usa flex (não block) pra preservar o display:flex do .ame-card. Sem isso,
     o `margin-top:auto` do .ame-card__buy-btn não funciona e produtos sem
     parcelamento ficam com o botão desalinhado dos demais na mesma linha. */
  .ai-product-grid__grid-{{ ai_gen_id }} > .ame-card {
    display: none;
  }
  .ai-product-grid__grid-{{ ai_gen_id }} > .ame-card:nth-child(-n+{{ block.settings.initial_rows | times: block.settings.products_per_row }}) {
    display: flex;
  }
  .ai-product-grid__grid-{{ ai_gen_id }} > .ame-card.visible {
    display: flex;
  }

  /* ── Layout carrossel ── */
  .ai-product-grid__carousel-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: 32px;
  }
  .ai-product-grid__carousel-track-{{ ai_gen_id }} {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 0.5rem 1rem;
    min-width: 0;
  }
  .ai-product-grid__carousel-track-{{ ai_gen_id }}::-webkit-scrollbar { display: none; }
  /* Cada card ocupa fração fixa do track e cresce pra bater a altura do vizinho
     (align-items:stretch do flex parent). display:flex no filho preserva
     margin-top:auto do botão comprar. */
  .ai-product-grid__carousel-track-{{ ai_gen_id }} > .ame-card {
    flex: 0 0 auto;
    width: 78%;
    max-width: 18rem;
    scroll-snap-align: start;
    display: flex;
  }
  @media (min-width: 600px) {
    .ai-product-grid__carousel-track-{{ ai_gen_id }} > .ame-card {
      width: calc(50% - 0.5rem);
    }
  }
  @media (min-width: 900px) {
    .ai-product-grid__carousel-track-{{ ai_gen_id }} > .ame-card {
      width: calc(33.333% - 0.667rem);
    }
  }
  @media (min-width: 1200px) {
    .ai-product-grid__carousel-track-{{ ai_gen_id }} > .ame-card {
      width: calc((100% - ({{ block.settings.products_per_row }} - 1) * 1rem) / {{ block.settings.products_per_row }});
      max-width: none;
    }
  }
  .ai-product-grid__carousel-nav-{{ ai_gen_id }} {
    position: absolute;
    top: 36%;
    transform: translateY(-50%);
    /* Precisa ficar ACIMA do .ame-card__link (z-index:4) — sem isso o clique
       na seta atravessava a seta e caía no link invisível do card, abrindo
       a página do produto em vez de rolar o carrossel. */
    z-index: 10;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgba(255, 248, 243, 0.95);
    border: 1px solid rgba(210, 195, 192, 0.4);
    cursor: pointer;
    display: none;
    align-items: center;
    justify-content: center;
    color: var(--color-on-background, #201b14);
    box-shadow: 0 4px 14px rgba(32, 27, 20, 0.08);
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .ai-product-grid__carousel-nav-{{ ai_gen_id }}:hover {
    background: #fff;
    transform: translateY(-50%) scale(1.05);
  }
  .ai-product-grid__carousel-nav-{{ ai_gen_id }}[hidden] { display: none !important; }
  .ai-product-grid__carousel-nav--prev-{{ ai_gen_id }} { left: 0.5rem; }
  .ai-product-grid__carousel-nav--next-{{ ai_gen_id }} { right: 0.5rem; }
  @media (min-width: 1024px) {
    .ai-product-grid__carousel-nav-{{ ai_gen_id }} { display: flex; }
  }

  /* Garante alinhamento horizontal dos cards mesmo com nomes de tamanhos
     diferentes. O .ame-card global usa `min-height: calc(1.3em * 2)` no
     título (reserva 2 linhas), mas alguns produtos têm nomes que ocupam
     3 linhas — gera desalinhamento entre preços e botões na mesma linha
     da grid. Aqui forçamos 3 linhas reservadas só pro escopo deste bloco. */
  .ai-product-grid__grid-{{ ai_gen_id }} .ame-card__title {
    min-height: calc(1.3em * 3);
    -webkit-line-clamp: 3;
    line-clamp: 3;
  }

  .ai-product-grid__footer-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-product-grid__button-{{ ai_gen_id }} {
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: 16px;
    cursor: pointer;
    transition: background-color 0.3s ease;
  }

  .ai-product-grid__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-product-grid__button-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-product-grid__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #999;
    font-size: 16px;
  }
{% endstyle %}

<product-grid-{{ ai_gen_id }} class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.title != blank or block.settings.subtitle != blank %}
    <div class="ai-product-grid__header-{{ ai_gen_id }}">
      {% if block.settings.title != blank %}
        <h2 class="ai-product-grid__title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}
      {% if block.settings.subtitle != blank %}
        <p class="ai-product-grid__subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
      {% endif %}
    </div>
  {% endif %}

  {% if block.settings.collection != blank %}
    {% assign collection = block.settings.collection %}
    {% assign products = collection.products %}
    {% assign initial_rows = block.settings.initial_rows %}
    {% assign products_per_row = block.settings.products_per_row %}
    {% assign initial_count = initial_rows | times: products_per_row %}

    {% if products.size > 0 %}
      {% if block.settings.layout == 'carousel' %}
        {%- comment -%}
          Layout carrossel: rolagem horizontal com scroll-snap. Setas só aparecem
          no desktop (>=1024px) via CSS. Não usa `initial_rows`/`button_text` —
          tudo é rolagem contínua. `data-fp-track` bate com o handler de setas
          e visibilidade em [sections/featured-products.liquid:106].
        {%- endcomment -%}
        <div class="ai-product-grid__carousel-{{ ai_gen_id }}" data-fp-section>
          <button
            type="button"
            class="ai-product-grid__carousel-nav-{{ ai_gen_id }} ai-product-grid__carousel-nav--prev-{{ ai_gen_id }}"
            data-fp-prev
            aria-label="Anterior"
          >
            <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
          </button>
          <button
            type="button"
            class="ai-product-grid__carousel-nav-{{ ai_gen_id }} ai-product-grid__carousel-nav--next-{{ ai_gen_id }}"
            data-fp-next
            aria-label="Próximo"
          >
            <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
          </button>
          <div class="ai-product-grid__carousel-track-{{ ai_gen_id }}" data-fp-track>
            {% render 'product-card' for products as card_product %}
          </div>
        </div>
      {% else %}
        <div class="ai-product-grid__grid-{{ ai_gen_id }}">
          {% comment %}
            ⚡ Bolt: Replace snippet render inside for-loop with `render ... for` syntax.
            💡 What: Uses the `render 'product-card' for array` tag instead of manually looping. We also replaced the wrapper div logic with CSS :nth-child visibility to avoid breaking the snippet.
            🎯 Why: Liquid processes a `for` loop with a `render` inside by parsing and scoping the snippet per iteration (N+1 overhead).
            📊 Impact: Eliminates N+1 rendering overhead, reducing template compilation time.
            🔬 Measurement: Profile the Server Response time on the page.
          {% endcomment %}
          {% render 'product-card' for products as card_product %}
        </div>

        {% if products.size > initial_count and block.settings.button_text != blank %}
          <div class="ai-product-grid__footer-{{ ai_gen_id }}">
            <button class="ai-product-grid__button-{{ ai_gen_id }}" data-load-more>
              {{ block.settings.button_text }}
            </button>
          </div>
        {% endif %}
      {% endif %}
    {% else %}
      <div class="ai-product-grid__empty-{{ ai_gen_id }}">Nenhum produto encontrado nesta coleção.</div>
    {% endif %}
  {% else %}
    <div class="ai-product-grid__empty-{{ ai_gen_id }}">Selecione uma coleção para exibir os produtos.</div>
  {% endif %}
</product-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class ProductGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.loadMoreButton = this.querySelector('[data-load-more]');
        this.items = this.querySelectorAll('.ame-card');
        this.productsPerRow = {{ block.settings.products_per_row }};
        this.currentVisibleCount = {{ block.settings.initial_rows | times: block.settings.products_per_row }};
      }

      connectedCallback() {
        if (this.loadMoreButton) {
          this.loadMoreButton.addEventListener('click', () => this.loadMore());
        }
      }

      loadMore() {
        const nextCount = this.currentVisibleCount + this.productsPerRow;

        for (let i = this.currentVisibleCount; i < nextCount && i < this.items.length; i++) {
          this.items[i].classList.add('visible');
        }

        this.currentVisibleCount = nextCount;

        if (this.currentVisibleCount >= this.items.length) {
          this.loadMoreButton.classList.add('hidden');
        }
      }
    }

    if (!customElements.get('product-grid-{{ ai_gen_id }}')) {
      customElements.define('product-grid-{{ ai_gen_id }}', ProductGrid{{ ai_gen_id }});
    }
  })();

  // Handler das setas do carrossel — só ativa quando layout=carousel montou
  // o track. Espelha a lógica de [sections/featured-products.liquid:106].
  (() => {
    const section = document.querySelector('.ai-product-grid-{{ ai_gen_id }} [data-fp-section]');
    if (!section) return;
    const track = section.querySelector('[data-fp-track]');
    const prev = section.querySelector('[data-fp-prev]');
    const next = section.querySelector('[data-fp-next]');
    if (!track) return;
    function scrollBy(dir) {
      track.scrollBy({ left: track.clientWidth * 0.8 * dir, behavior: 'smooth' });
    }
    // stopPropagation/preventDefault pra garantir que o click da seta não borbulhe
    // pro .ame-card__link — em conjunto com z-index acima do card, blinda o clique.
    function handleNav(e, dir) {
      e.preventDefault();
      e.stopPropagation();
      scrollBy(dir);
    }
    prev?.addEventListener('click', (e) => handleNav(e, -1));
    next?.addEventListener('click', (e) => handleNav(e, 1));
    function updateNavState() {
      if (!prev || !next) return;
      const max = track.scrollWidth - track.clientWidth - 4;
      prev.toggleAttribute('hidden', track.scrollLeft <= 4);
      next.toggleAttribute('hidden', track.scrollLeft >= max);
    }
    track.addEventListener('scroll', () => requestAnimationFrame(updateNavState), { passive: true });
    window.addEventListener('resize', updateNavState);
    updateNavState();
  })();
</script>

{% schema %}
{
  "name": "Grade de produtos",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Conteúdo"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Título",
      "default": "Nossos produtos"
    },
    {
      "type": "inline_richtext",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Descubra nossa seleção especial"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Coleção"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Formato",
      "info": "Grade fixa OU carrossel horizontal com rolagem",
      "options": [
        { "value": "grid", "label": "Grade" },
        { "value": "carousel", "label": "Carrossel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_per_row",
      "label": "Produtos por linha (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "products_per_row_mobile",
      "label": "Produtos por linha (mobile)",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "initial_rows",
      "label": "Linhas iniciais visíveis",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Espaçamento entre produtos",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Largura no desktop",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Botão ver mais"
    },
    {
      "type": "inline_richtext",
      "id": "button_text",
      "label": "Texto do botão",
      "default": "Ver mais produtos"
    },
    {
      "type": "color",
      "id": "button_bg_color",
      "label": "Cor de fundo",
      "default": "#5a4742"
    },
    {
      "type": "color",
      "id": "button_hover_bg_color",
      "label": "Cor de fundo (hover)",
      "default": "#735e59"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Cor do texto",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "button_border_radius",
      "label": "Arredondamento do botão",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "header",
      "content": "Estilo dos títulos"
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Tamanho do título",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Cor do título",
      "default": "#201b14"
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Tamanho do subtítulo",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "subtitle_color",
      "label": "Cor do subtítulo",
      "default": "#4f4442"
    }
  ],
  "presets": [
    {
      "name": "Grade de produtos"
    }
  ]
}
{% endschema %}
