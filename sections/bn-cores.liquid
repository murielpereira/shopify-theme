{%- comment -%}
  Âme · Black November / Natal
  Seção invisível: carrega as fontes e define as cores usadas por todas as seções "BN".
  Para virar o visual de Natal, troque só as cores aqui no editor de tema.
{%- endcomment -%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --bn-bg: {{ section.settings.cor_fundo }};
    --bn-surface: {{ section.settings.cor_superficie }};
    --bn-accent: {{ section.settings.cor_destaque }};
    --bn-on-accent: {{ section.settings.cor_texto_destaque }};
    --bn-text: {{ section.settings.cor_texto }};
    --bn-natal: {{ section.settings.cor_natal }};
    --bn-natal-2: {{ section.settings.cor_natal_2 }};
    --bn-serif: 'Cormorant Garamond', 'Times New Roman', serif;
    --bn-sans: 'Inter', ui-sans-serif, system-ui, -apple-system, sans-serif;
    --bn-muted: color-mix(in srgb, var(--bn-text) 62%, transparent);
    --bn-line: color-mix(in srgb, var(--bn-text) 10%, transparent);
  }
  .bn { background: var(--bn-bg); color: var(--bn-text); font-family: var(--bn-sans); -webkit-font-smoothing: antialiased; }
  .bn *, .bn *::before, .bn *::after { box-sizing: border-box; }
  .bn a { color: inherit; text-decoration: none; }
  .bn img { display: block; max-width: 100%; }
  .bn .bn-wrap { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  .bn.bn-section { padding: clamp(56px, 8vw, 104px) 0; }
  .bn { position: relative; width: 100vw; max-width: 100vw; margin-left: calc(50% - 50vw); margin-right: calc(50% - 50vw); }
  html, body { overflow-x: clip; }
  .bn .bn-eyebrow { margin: 0 0 14px; font: 500 11px/1.4 var(--bn-sans); letter-spacing: .28em; text-transform: uppercase; color: var(--bn-accent); }
  .bn .bn-title { margin: 0; font-family: var(--bn-serif); font-weight: 400; line-height: 1.04; letter-spacing: -.01em; color: var(--bn-text); }
  .bn .bn-h2 { font-size: clamp(34px, 4.6vw, 54px); max-width: 16ch; }
  .bn .bn-lead { margin: 16px 0 0; max-width: 56ch; font-size: 17px; line-height: 1.6; color: var(--bn-muted); }
  .bn .bn-lead p { margin: 0 0 .6em; }
  .bn .bn-lead strong { color: var(--bn-text); font-weight: 600; }
  .bn .bn-btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; min-height: 46px; padding: 0 26px; border: 1px solid var(--bn-accent); border-radius: 999px; background: var(--bn-accent); color: var(--bn-on-accent); font: 600 12px/1 var(--bn-sans); letter-spacing: .18em; text-transform: uppercase; cursor: pointer; transition: box-shadow .2s ease; }
  .bn .bn-btn:hover { box-shadow: 0 10px 32px color-mix(in srgb, var(--bn-accent) 35%, transparent); }
  .bn .bn-btn--ghost { background: transparent; color: var(--bn-accent); }
  .bn .bn-btn:focus-visible, .bn a:focus-visible, .bn summary:focus-visible { outline: 2px solid var(--bn-accent); outline-offset: 3px; }
  .bn .bn-pill { display: inline-block; padding: 6px 11px; border-radius: 999px; background: var(--bn-accent); color: var(--bn-on-accent); font: 600 10px/1.2 var(--bn-sans); letter-spacing: .14em; text-transform: uppercase; }
</style>

{% schema %}
{
  "name": "BN · Cores e fontes",
  "tag": "div",
  "class": "bn-cores",
  "settings": [
    { "type": "paragraph", "content": "Deixe esta seção no topo da página. Ela não aparece na loja: só define as fontes e as cores de todas as seções BN. Para o Natal, troque as cores aqui." },
    { "type": "color", "id": "cor_fundo", "label": "Fundo", "default": "#080808" },
    { "type": "color", "id": "cor_superficie", "label": "Fundo dos cards", "default": "#141414" },
    { "type": "color", "id": "cor_destaque", "label": "Cor de destaque", "default": "#C8FF3D" },
    { "type": "color", "id": "cor_texto_destaque", "label": "Texto sobre o destaque", "default": "#0A0A0A" },
    { "type": "color", "id": "cor_texto", "label": "Texto", "default": "#FFFFFF" },
    { "type": "color", "id": "cor_natal", "label": "Natal · vermelho", "default": "#8E1014" },
    { "type": "color", "id": "cor_natal_2", "label": "Natal · verde", "default": "#0E5B3A" }
  ],
  "presets": [{ "name": "BN · Cores e fontes" }]
}
{% endschema %}
