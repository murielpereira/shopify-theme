                  <svg viewBox="0 0 48 48">
                    <path d="M10 20h28v20H10zM8 14h32v6H8zM24 14v26M24 14c-4-6-12-6-10 0m10 0c4-6 12-6 10 0" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
