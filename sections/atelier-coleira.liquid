                  <svg viewBox="0 0 48 48">
                    <path d="M6 16h36v16H6z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M13 16v6m7-6v9m7-9v6m7-6v9" stroke="currentColor" stroke-width="1.2"/>
