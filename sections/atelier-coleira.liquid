5C72.96,80.5,72.89,80.439,72.81,80.42z"/>
                  </svg>
                {%- when 'mao' -%}
                  <svg viewBox="0 0 48 48">
                    <path d="M8 40 30 18m-6-6 12 12M28 8l12 12-4 4-12-12 4-4Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M10 30c2 2 4 2 6 0" fill="none" stroke="currentColor" stroke-width="1.2"/>
