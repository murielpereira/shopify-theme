        "azulbb": {{ 'couro-mini-azulbb.jpg' | asset_url | json }},
        "borgonha": {{ 'couro-mini-borgonha.jpg' | asset_url | json }},
        "branco": {{ 'couro-mini-branco.jpg' | asset_url | json }},
        "cafe": {{ 'couro-mini-cafe.jpg' | asset_url | json }},
        "camel": {{ 'couro-mini-camel.jpg' | asset_url | json }},
        "chiclete": {{ 'couro-mini-chiclete.jpg' | asset_url | json }},
        "lilascandy": {{ 'couro-mini-lilascandy.jpg' | asset_url | json }},
        "marinho": {{ 'couro-mini-marinho.jpg' | asset_url | json }},
        "militar": {{ 'couro-mini-militar.jpg' | asset_url | json }},
        "nude": {{ 'couro-mini-nude.jpg' | asset_url | json }},
        "off": {{ 'couro-mini-off.jpg' | asset_url | json }},
        "preto": {{ 'couro-mini-preto.jpg' | asset_url | json }},
        "rosabb": {{ 'couro-mini-rosabb.jpg' | asset_url | json }},
        "rosaseco": {{ 'couro-mini-rosaseco.jpg' | asset_url | json }},
        "sepia": {{ 'couro-mini-sepia.jpg' | asset_url | json }}
      },
      "couros": {
        "allure": {{ 'couro-allure.jpg' | asset_url | json }},
        "azulbb": {{ 'couro-azulbb.jpg' | asset_url | json }},
        "borgonha": {{ 'couro-borgonha.jpg' | asset_url | json }},
        "branco": {{ 'couro-branco.jpg' | asset_url | json }},
        "cafe": {{ 'couro-cafe.jpg' | asset_url | json }},
        "camel": {{ 'couro-camel.jpg' | asset_url | json }},
        "chiclete": {{ 'couro-chiclete.jpg' | asset_url | json }},
        "lilascandy": {{ 'couro-lilascandy.jpg' | asset_url | json }},
        "marinho": {{ 'couro-marinho.jpg' | asset_url | json }},
        "militar": {{ 'couro-militar.jpg' | asset_url | json }},
        "nude": {{ 'couro-nude.jpg' | asset_url | json }},
        "off": {{ 'couro-off.jpg' | asset_url | json }},
        "preto": {{ 'couro-preto.jpg' | asset_url | json }},
        "rosabb": {{ 'couro-rosabb.jpg' | asset_url | json }},
        "rosaseco": {{ 'couro-rosaseco.jpg' | asset_url | json }},
        "sepia": {{ 'couro-sepia.jpg' | asset_url | json }}
      },
      "nomeCurto": {{ palavra | json }},
      "waltz": {{ section.settings.waltz_base | default: 'https://waltz.up.railway.app' | json }},
      "pixPct": {{ pix_pct | json }},
      "parcelas": {
        "max": {{ settings.installments_max | default: 12 | json }},
        "semJuros": {{ settings.installments_no_interest | default: 6 | json }},
        "minimo": {{ settings.installment_min_value | default: 40 | json }},
        "tabela": {{ settings.installments_interest_table | default: '' | json }}
      },
      "swatches": {
        {%- assign swatch_entradas = settings.swatch_solido_cores | default: '' | split: ',' -%}
        {%- assign swatch_primeiro = true -%}
        {%- for entrada in swatch_entradas -%}
          {%- assign par = entrada | split: ':' -%}
          {%- if par.size >= 2 -%}
            {%- unless swatch_primeiro -%},{%- endunless -%}
            {{ par[0] | strip | downcase | json }}: {{ par[1] | strip | json }}
            {%- assign swatch_primeiro = false -%}
          {%- endif -%}
        {%- endfor -%}
      },
      "pingente": {
        "ativo": {{ oferece_pingente | json }},
        "metal": {{ pingente_metal_handle | strip | json }},
        "couro": {{ pingente_couro_handles | json }},
        "metalCouro": {{ pingente_metal_couro_handles | json }},
        "mapaTamanho": {{ settings.pingente_size_map | default: '' | json }},
        "ignorar": {{ settings.pingente_ignore_terms | default: '' | json }},
        "remover": {{ settings.pingente_strip_terms | default: '' | json }}
      },
      "campos": [{{ cf_json }}],
      "metais": {{ section.settings.metais_info | json }},
      "producao": {{ section.settings.producao_texto | json }},
      "hero": [{{ hero_lista }}],
      "inicio": { "cor": {{ hero_primeira_cor | json }}, "metal": {{ hero_primeiro_metal | json }} }
    }
  </script>

  {%- comment -%} ═══════════════════════ TOPO ═══════════════════════ {%- endcomment -%}
  <section class="atl-hero" data-atl-hero aria-labelledby="atl-hero-titulo">
    <div class="atl-hero__grain" aria-hidden="true"></div>
    <div class="atl-hero__inner">
      <p class="atl-eyebrow atl-hero__eyebrow atl-in" style="--d: 0">{{ section.settings.hero_eyebrow }}</p>

      <div class="atl-hero__stage" data-atl-hero-stage>
        <span class="atl-hero__word" aria-hidden="true" data-atl-hero-word>{{ palavra }}</span>
        <div class="atl-hero__collar" data-atl-hero-collar>
          <div class="atl-hero__float">
            {%- if hero_primeira -%}
              <img
                class="atl-hero__img is-front"
                src="{{ hero_primeira | image_url: width: 1200 }}"
                srcset="{{ hero_primeira | image_url: width: 600 }} 600w, {{ hero_primeira | image_url: width: 900 }} 900w, {{ hero_primeira | image_url: width: 1200 }} 1200w, {{ hero_primeira | image_url: width: 1600 }} 1600w"
                sizes="(min-width: 990px) 46vw, 108vw"
                width="1600"
                height="1600"
                alt="{{ product.title | escape }}"
                fetchpriority="high"
                data-atl-hero-img
              >
            {%- endif -%}
            <img class="atl-hero__img" alt="" aria-hidden="true" width="1600" height="1600" data-atl-hero-img-b>
            <span class="atl-hero__sheen" aria-hidden="true"></span>
          </div>
          <span class="atl-hero__shadow" aria-hidden="true"></span>
        </div>
      </div>

      <div class="atl-hero__swatch atl-in" style="--d: 2">
        <p class="atl-hero__swatch-nome" aria-live="polite" data-atl-hero-nome>
          {%- if hero_primeira_cor != '' -%}{{ hero_primeira_cor }} · {{ hero_primeiro_metal }}{%- endif -%}
        </p>
        <div class="atl-hero__dots" data-atl-hero-dots role="group" aria-label="Cores em destaque"></div>
      </div>

      <div class="atl-hero__copy">
        <h1 id="atl-hero-titulo" class="atl-hero__titulo atl-in" style="--d: 3">
          {{- section.settings.hero_titulo -}}
          {%- if section.settings.hero_titulo_destaque != blank -%}
            <span class="atl-ouro"> {{ section.settings.hero_titulo_destaque }}</span>
          {%- endif -%}
        </h1>
        <p class="atl-hero__texto atl-in" style="--d: 4">{{ section.settings.hero_texto }}</p>
        <ul class="atl-hero__garantias atl-in" style="--d: 4" role="list">
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
              <path d="M12 3 5 6v5.5c0 4.3 2.9 7.6 7 9.5 4.1-1.9 7-5.2 7-9.5V6l-7-3Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="m9 12 2.2 2.2L15.4 10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            6 meses de garantia
          </li>
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22">
              <path d="M5 9h13m-3-3 3 3-3 3M19 15H6m3 3-3-3 3-3" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Troca facilitada
          </li>
        </ul>
        <div class="atl-hero__acoes atl-in" style="--d: 5">
          <a href="#atelie" class="atl-btn atl-btn--primario atl-btn--grande" data-atl-comecar>
            <span>{{ section.settings.hero_cta }}</span>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
              <path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <p class="atl-hero__preco">
            a partir de <strong>{{ product.price_min | money }}</strong>
            <span aria-hidden="true">·</span>
            {{ pix_pct }}% off no Pix
          </p>
          {%- comment -%}
            Resumo de estrelas da Konfidency, igual ao da PDP. Além de mostrar
            a nota, ele é OBRIGATÓRIO para a lista de avaliações (seção
            product-reviews) aparecer: sem .konfidency-reviews-summary na página
            o SDK marca a lista com data-fail="no-summary-element" e não monta.
          {%- endcomment -%}
          <div class="atl-hero__nota">
            <div class="konfidency-reviews-summary" data-sku="{%- render 'konfidency-id', product: product -%}"></div>
          </div>
        </div>
        <ul class="atl-hero__confianca atl-in" style="--d: 6" role="list">
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="M12 3c4 3 7 4.5 7 9.5S15.5 20 12 21c-3.5-1-7-3.5-7-8.5S8 6 12 3Z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M12 7v10" stroke="currentColor" stroke-width="1.2" stroke-dasharray="1.5 2"/>
            </svg>
            Couro legítimo
          </li>
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="M4 20 15 9m-3-3 6 6M14 4l6 6-2 2-6-6 2-2Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            Feita à mão
          </li>
          <li>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="M3 8h18v8H3z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M7 8v3m4-3v4m4-4v3m4-3v4" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            Tamanho conferido
          </li>
        </ul>
        {%- comment -%}
          Stories: os vídeos do produto em círculos, logo abaixo dos selos.
          Tocam num visualizador de tela cheia (JS). O vídeo "Como medir" vem
          do Waltz e o JS o acrescenta no fim; sem vídeo do produto a faixa
          nasce escondida e só aparece se o "Como medir" existir.
        {%- endcomment -%}
        {%- assign stories_videos = product.media | where: 'media_type', 'video' -%}
        <div class="atl-stories atl-in" style="--d: 7" role="list" aria-label="Vídeos" data-atl-stories{% if stories_videos.size == 0 or section.settings.mostrar_stories == false %} hidden{% endif %}>
          {%- if section.settings.mostrar_stories -%}
            {%- for m in stories_videos limit: 4 -%}
              {%- liquid
                assign fonte = ''
                assign fonte_altura = 0
                for s in m.sources
                  if s.format == 'mp4' and s.height <= 720
                    if s.height > fonte_altura
                      assign fonte = s.url
                      assign fonte_altura = s.height
                    endif
                  endif
                endfor
                if fonte == ''
                  assign fonte = m.sources.first.url
                endif
                assign rotulo = m.alt | strip
                if rotulo == blank
                  assign rotulo = 'Vídeo ' | append: forloop.index
                endif
              -%}
              <button type="button" class="atl-story" role="listitem" data-atl-story data-src="{{ fonte }}" data-rotulo="{{ rotulo | escape }}" aria-label="Ver vídeo: {{ rotulo | escape }}">
                <span class="atl-story__anel"><img src="{{ m.preview_image | image_url: width: 176 }}" alt="" width="88" height="88" loading="lazy"></span>
                <span class="atl-story__nome">{{ rotulo }}</span>
              </button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
    <a href="#atelie" class="atl-hero__descer" aria-label="Ir para o ateliê" data-atl-comecar>
      <span></span>
    </a>
  </section>

  {%- comment -%} ═══════════════════════ ATELIÊ ═══════════════════════ {%- endcomment -%}
  <section class="atl-studio" id="atelie" data-atl-studio aria-labelledby="atl-studio-titulo">
    <header class="atl-studio__head">
      <p class="atl-eyebrow">{{ section.settings.studio_eyebrow }}</p>
      <h2 id="atl-studio-titulo" class="atl-studio__titulo" tabindex="-1">
        {{ palavra }}, feita para <span class="atl-ouro" data-atl-pet-titulo>seu pet</span>
      </h2>
      <p class="atl-studio__restaurado" data-atl-restaurado hidden>
        Guardamos as suas escolhas da última visita.
        <button type="button" class="atl-link" data-atl-recomecar>Começar do zero</button>
      </p>
    </header>

    <nav class="atl-passos" aria-label="Etapas" data-atl-passos>
      <ol role="list">
        {%- assign rotulos = 'Cores,Metal,Tamanho,Pingente,Resumo' | split: ',' -%}
        {%- for r in rotulos -%}
          <li>
            <button type="button" class="atl-passos__item" data-atl-ir="{{ forloop.index0 }}" disabled>
              <span class="atl-passos__n">{{ forloop.index }}</span>
              <span class="atl-passos__rotulo">{{ r }}</span>
            </button>
          </li>
        {%- endfor -%}
      </ol>
      <span class="atl-passos__linha" aria-hidden="true"><span data-atl-passos-linha></span></span>
    </nav>

    <div class="atl-studio__corpo">
      {%- comment -%} Palco: a coleira, o pingente em 3D e a legenda {%- endcomment -%}
      <div class="atl-palco-wrap" data-atl-palco-wrap>
        <div class="atl-palco" data-atl-palco data-modo="colar">
          <div class="atl-palco__arte" data-atl-arte>
            {%- if hero_primeira -%}
              <img
                class="atl-palco__img is-front"
                src="{{ hero_primeira | image_url: width: 1000 }}"
                alt=""
                width="1000"
                height="1000"
                loading="lazy"
                data-atl-img-a
              >
            {%- else -%}
              <img class="atl-palco__img is-front" alt="" width="1000" height="1000" data-atl-img-a>
            {%- endif -%}
            <img class="atl-palco__img" alt="" width="1000" height="1000" data-atl-img-b>
            <span class="atl-palco__foco" data-atl-foco aria-hidden="true"></span>
            <div class="atl-palco__pendurado" data-atl-pendurado aria-hidden="true"></div>
          </div>
          <span class="atl-palco__brilho" aria-hidden="true" data-atl-brilho></span>
          <div class="atl-p3d" data-atl-p3d aria-hidden="true">
            <div class="atl-p3d__obj" data-atl-p3d-obj></div>
            <span class="atl-p3d__sombra"></span>
          </div>
          <div class="atl-palco__ferramentas" data-atl-ferramentas>
            <button type="button" class="atl-chip atl-chip--vidro" data-atl-virar hidden>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16">
                <path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M18 3v4h-4M6 21v-4h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              <span data-atl-virar-rotulo>Ver o verso</span>
            </button>
          </div>
          <p class="atl-palco__selo" data-atl-selo hidden></p>
          <span class="atl-palco__carregando" data-atl-carregando hidden aria-hidden="true"></span>
        </div>
        <p class="atl-palco__legenda" aria-live="polite" data-atl-legenda>&nbsp;</p>
        {%- comment -%}
          Passador: fica AQUI, colado na foto fixa, e não embaixo da grade de
          cores (onde a cliente precisava rolar para achar). Só aparece na
          etapa Cores, quando o couro escolhido tem mais de uma opção.
        {%- endcomment -%}
        <div class="atl-passador" data-atl-passador-bloco hidden>
          <span class="atl-passador__rotulo" id="atl-passador-r">Cor do Detalhe</span>
          <div class="atl-passador__opcoes" role="group" aria-labelledby="atl-passador-r" data-atl-passadores></div>
        </div>
      </div>

      {%- comment -%} Painéis das etapas — o conteúdo de cada um é montado pelo JS {%- endcomment -%}
      <div class="atl-paineis" data-atl-paineis>
        <div class="atl-esqueleto" data-atl-esqueleto><span></span><span></span><span class="is-curto"></span></div>
        <div class="atl-erro" data-atl-erro hidden>
          <p><strong>Não conseguimos abrir o ateliê agora.</strong> Verifique a sua conexão e tente de novo.</p>
          <button type="button" class="atl-btn atl-btn--secundario" data-atl-tentar>Tentar de novo</button>
        </div>

        <section class="atl-painel" data-atl-painel="0" hidden aria-labelledby="atl-p1-t">
          <h3 class="atl-painel__titulo" id="atl-p1-t" tabindex="-1">Escolha o couro</h3>
          <p class="atl-painel__sub" data-atl-sub-cores>Couro bovino legítimo. Toque numa cor para ver na peça.</p>
          <div class="atl-cores" role="group" aria-label="Cor do couro" data-atl-couros></div>
        </section>

        <section class="atl-painel" data-atl-painel="1" hidden aria-labelledby="atl-p2-t">
          <h3 class="atl-painel__titulo" id="atl-p2-t" tabindex="-1">Escolha o banho do metal</h3>
          <p class="atl-painel__sub">Fivela e argola no mesmo acabamento. O pingente acompanha.</p>
          <div class="atl-metais" role="group" aria-label="Cor do metal" data-atl-metais></div>
        </section>

        <section class="atl-painel" data-atl-painel="2" hidden aria-labelledby="atl-p3-t">
          <h3 class="atl-painel__titulo" id="atl-p3-t" tabindex="-1">O tamanho certo</h3>
          <p class="atl-painel__sub">
            Conte sobre o seu pet. A gente sugere o tamanho e confere tudo antes de produzir.
          </p>
          <div class="atl-pet-info" data-atl-pet-info></div>
          <div class="atl-recomendacao" data-atl-recomendacao hidden aria-live="polite"></div>
          <h4 class="atl-painel__subtitulo">Tamanho</h4>
          <div class="atl-tamanhos" role="group" aria-label="Tamanho" data-atl-tamanhos></div>
          <p class="atl-nota" data-atl-tamanho-nota hidden></p>
          <button type="button" class="atl-link atl-link--icone" data-atl-medir-abrir>
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="M3 8h18v8H3z" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M7 8v3m4-3v4m4-4v3" stroke="currentColor" stroke-width="1.2"/>
            </svg>
            Como medir o pescoço
          </button>
          <div class="atl-campos-extra" data-atl-campos-extra></div>
        </section>

        <section class="atl-painel" data-atl-painel="3" hidden aria-labelledby="atl-p4-t">
          <h3 class="atl-painel__titulo" id="atl-p4-t" tabindex="-1" data-atl-titulo-pingente>
            Um pingente com o nome do seu pet
          </h3>
          <p class="atl-painel__sub" data-atl-sub-pingente>Gravado frente e verso, no mesmo metal da coleira.</p>
          <div class="atl-tipos" role="group" aria-label="Tipo de pingente" data-atl-tipos></div>
          <div class="atl-pingente-detalhes" data-atl-pingente-detalhes hidden>
            <h4 class="atl-painel__subtitulo">Formato</h4>
            <div class="atl-formatos" role="group" aria-label="Formato do pingente" data-atl-formatos></div>
            <h4 class="atl-painel__subtitulo">Gravação</h4>
            <div class="atl-campo">
              <input
                type="text"
                id="atl-p-frente"
                class="atl-campo__input"
                maxlength="13"
                autocomplete="off"
                autocapitalize="words"
                placeholder=" "
                data-atl-p-frente
                data-lado="frente"
              >
              <label for="atl-p-frente" class="atl-campo__rotulo">Nome do pet · frente</label>
              <span class="atl-campo__contador" data-atl-contador="atl-p-frente">0/13</span>
            </div>
            <div class="atl-campo">
              <input
                type="text"
                id="atl-p-tutor"
                class="atl-campo__input"
                maxlength="13"
                autocomplete="off"
                autocapitalize="words"
                placeholder=" "
                data-atl-p-tutor
                data-lado="verso"
              >
              <label for="atl-p-tutor" class="atl-campo__rotulo">Nome do tutor · verso</label>
              <span class="atl-campo__contador" data-atl-contador="atl-p-tutor">0/13</span>
            </div>
            <div class="atl-campo">
              <input
                type="tel"
                id="atl-p-tel"
                class="atl-campo__input"
                maxlength="13"
                autocomplete="off"
                inputmode="numeric"
                placeholder=" "
                data-atl-p-tel
                data-lado="verso"
              >
              <label for="atl-p-tel" class="atl-campo__rotulo">Telefone · verso</label>
            </div>
            <p class="atl-nota" data-atl-pingente-nota></p>
          </div>
        </section>

        <section class="atl-painel" data-atl-painel="4" hidden aria-labelledby="atl-p5-t">
          <h3 class="atl-painel__titulo" id="atl-p5-t" tabindex="-1" data-atl-titulo-resumo>Pronta para ser feita</h3>
          <div class="atl-ficha" data-atl-ficha></div>
          {%- comment -%}
            Compre Junto da página padrão (guia e peitoral pelas tags
            crosssell:<handle>). `is_kit: true` faz o widget ler a seleção de
            window.AmeKit, que o ame-atelier.js preenche; sem isso ele
            procuraria o formulário da PDP, que não existe aqui.
          {%- endcomment -%}
          <div class="atl-compre-junto">
            {%- render 'pdp-bundle', product: product, is_kit: true -%}
          </div>
          <div class="atl-total" data-atl-total-resumo></div>
          <p class="atl-producao">
            <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
              <path d="M4 20 15 9m-3-3 6 6M14 4l6 6-2 2-6-6 2-2Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            </svg>
            <span>{{ section.settings.producao_texto }}</span>
          </p>
        </section>

        {%- comment -%} Barra do ateliê: total + voltar/continuar (no último passo, Adicionar ao carrinho) {%- endcomment -%}
        <div class="atl-barra" data-atl-barra role="group" aria-label="Total e navegação">
          <div class="atl-barra__preco">
            <span class="atl-barra__valor" data-atl-barra-valor aria-live="polite"
              >a partir de {{ product.price_min | money_without_trailing_zeros -}}
            </span>
            <span class="atl-barra__pix" data-atl-barra-pix></span>
          </div>
          <div class="atl-barra__acoes">
            <button type="button" class="atl-btn atl-btn--icone" data-atl-voltar aria-label="Voltar" hidden>
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
                <path d="m15 5-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button type="button" class="atl-btn atl-btn--primario" data-atl-continuar>
              <span data-atl-continuar-rotulo>Continuar</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ═══════════════════════ HISTÓRIA ═══════════════════════ {%- endcomment -%}
  {%- assign beneficios = section.blocks | where: 'type', 'beneficio' -%}
