            <h3 class="atl-beneficio__titulo">{{ b.settings.titulo }}</h3>
            <p class="atl-beneficio__texto">{{ b.settings.texto }}</p>
          </li>
        {%- endfor -%}
      </ul>
    </section>
  {%- endif -%}

  {%- assign etapas = section.blocks | where: 'type', 'etapa' -%}
  {%- if etapas.size > 0 -%}
    <section class="atl-processo" aria-labelledby="atl-proc-t" data-atl-processo>
      <div class="atl-processo__inner">
        <p class="atl-eyebrow atl-eyebrow--claro atl-revela">{{ section.settings.processo_eyebrow }}</p>
        <h2 class="atl-secao__titulo atl-secao__titulo--claro atl-revela" id="atl-proc-t">
          {{ section.settings.processo_titulo }}
        </h2>
        <p class="atl-processo__texto atl-revela">{{ section.settings.processo_texto }}</p>
        <ol class="atl-processo__lista" role="list">
          <span class="atl-processo__trilho" aria-hidden="true"><span data-atl-trilho></span></span>
          {%- for e in etapas -%}
            <li class="atl-processo__etapa atl-revela" {{ e.shopify_attributes }}>
              <span class="atl-processo__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div>
                <h3>{{ e.settings.titulo }}</h3>
                <p>{{ e.settings.texto }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
        <p class="atl-processo__assinatura atl-revela">{{ section.settings.processo_assinatura }}</p>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.mostrar_videos -%}
    {%- assign videos = product.media | where: 'media_type', 'video' -%}
    {%- if videos.size > 0 -%}
      <section class="atl-videos" aria-labelledby="atl-vid-t">
        <p class="atl-eyebrow atl-revela">{{ section.settings.videos_eyebrow }}</p>
        <h2 class="atl-secao__titulo atl-revela" id="atl-vid-t">{{ section.settings.videos_titulo }}</h2>
        <div class="atl-videos__trilho" data-atl-videos>
          {%- for m in videos limit: 4 -%}
            {%- liquid
              assign fonte = ''
              assign fonte_altura = 0
              for s in m.sources
                if s.format == 'mp4' and s.height <= 720
                  if s.height > fonte_altura
                    assign fonte = s.url
                    assign fonte_altura = s.height
                  endif
                endif
              endfor
              if fonte == ''
                assign fonte = m.sources.first.url
              endif
            -%}
            <figure class="atl-video atl-revela" style="--d: {{ forloop.index0 }}">
              <video
                muted
                playsinline
                loop
                preload="none"
                poster="{{ m.preview_image | image_url: width: 540 }}"
                data-src="{{ fonte }}"
                data-atl-video
              ></video>
              <button type="button" class="atl-video__som" data-atl-video-som aria-label="Ativar som">
                <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18">
                  <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path d="m16 9 5 6m0-6-5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
                </svg>
              </button>
            </figure>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}

  <section class="atl-final" aria-labelledby="atl-final-t">
    <h2 class="atl-final__titulo atl-revela" id="atl-final-t">{{ section.settings.final_titulo }}</h2>
    <p class="atl-final__texto atl-revela">{{ section.settings.final_texto }}</p>
    <a href="#atelie" class="atl-btn atl-btn--primario atl-btn--grande atl-revela" data-atl-comecar>
      <span>{{ section.settings.hero_cta }}</span>
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
        <path d="M5 12h13m-5-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </section>

  {%- comment -%} Chamada flutuante fora do ateliê (só celular) {%- endcomment -%}
  <a href="#atelie" class="atl-flutuante" data-atl-flutuante data-atl-comecar aria-hidden="true" tabindex="-1">
    <span data-atl-flutuante-texto>{{ section.settings.flutuante_texto }}</span>
    <strong data-atl-flutuante-valor>{{ product.price_min | money }}</strong>
  </a>

  {%- comment -%} Folha "Como medir" {%- endcomment -%}
  <div class="atl-folha" data-atl-folha hidden role="dialog" aria-modal="true" aria-labelledby="atl-folha-t">
    <div class="atl-folha__fundo" data-atl-folha-fechar></div>
    <div class="atl-folha__caixa">
      <button type="button" class="atl-folha__fechar" data-atl-folha-fechar aria-label="Fechar">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
      </button>
      <h3 id="atl-folha-t" class="atl-folha__titulo">Como medir o pescoço</h3>
      <div class="atl-folha__conteudo" data-atl-folha-conteudo></div>
    </div>
  </div>

  {%- comment -%} Visualizador dos stories (conteúdo montado pelo JS) {%- endcomment -%}
  <div class="atl-hist" data-atl-hist hidden role="dialog" aria-modal="true" aria-label="Vídeos">
    <div class="atl-hist__fundo" data-atl-hist-fechar></div>
    <div class="atl-hist__quadro">
      <div class="atl-hist__barras" data-atl-hist-barras></div>
      <p class="atl-hist__titulo" data-atl-hist-titulo></p>
      <button type="button" class="atl-hist__fechar" data-atl-hist-fechar aria-label="Fechar">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
      <video class="atl-hist__video" data-atl-hist-video playsinline></video>
      <button type="button" class="atl-hist__nav atl-hist__nav--ant" data-atl-hist-ant aria-label="Vídeo anterior"></button>
      <button type="button" class="atl-hist__nav atl-hist__nav--prox" data-atl-hist-prox aria-label="Próximo vídeo"></button>
      <button type="button" class="atl-hist__som" data-atl-hist-som aria-label="Desativar som">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="M4 9h4l5-4v14l-5-4H4z" fill="currentColor"/><path data-atl-hist-mudo d="m16 9 5 6m0-6-5 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" style="display:none"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="atl-aviso" data-atl-aviso role="status" aria-live="polite" hidden></div>
</div>

<script src="{{ 'ame-atelier.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Ateliê da coleira",
  "class": "atl-section",
  "settings": [
    { "type": "header", "content": "Topo" },
    { "type": "text", "id": "hero_eyebrow", "label": "Sobretítulo", "default": "Coleira Atena · couro legítimo" },
    {
      "type": "text",
      "id": "hero_palavra",
      "label": "Palavra grande no fundo",
      "info": "Vazio = título do produto",
      "default": "Atena"
    },
    { "type": "text", "id": "hero_titulo", "label": "Título", "default": "Feita para um só pet." },
    { "type": "text", "id": "hero_titulo_destaque", "label": "Título — parte em destaque", "default": "O seu." },
    {
      "type": "textarea",
      "id": "hero_texto",
      "label": "Texto",
      "default": "Couro legítimo em 15 cores, quatro banhos de metal e o nome do seu pet gravado no pingente. Cada peça é feita depois do seu pedido."
    },
    { "type": "text", "id": "hero_cta", "label": "Botão", "default": "Criar a coleira do meu pet" },
    {
      "type": "textarea",
      "id": "hero_combos",
      "label": "Cores que passam no topo",
      "info": "Uma por linha, no formato Cor / Metal, com os nomes exatos das variações. A primeira é a foto inicial do ateliê.",
      "default": "Allure com Off White / Ouro\nRosa Bebê / Rose\nMilitar com Off White / Grafite\nChiclete com Rosa Bebê / Rose\nPreto com Branco / Prata\nCamel com Nude / Ouro\nLilás Candy / Prata"
