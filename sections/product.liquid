{% comment %} Âme — Página de Produto {% endcomment %}

{%- liquid
  # cv é nil quando nenhum option_values foi enviado na URL — força o cliente a escolher
  assign cv = product.selected_variant
  assign has_variant = false
  if cv != blank
    assign has_variant = true
  endif
  assign media_size = product.media.size

  # Kit de produtos — produto-pai com metafield `custom.kit_componentes`
  # (Product reference, list). Quando presente, substitui o variant picker
  # padrão pelo snippet kit-picker e o submit padrão pelo handler atomico
  # em assets/ame-kit.js. Vide [snippets/kit-picker.liquid] pra detalhes.
  assign kit_components = product.metafields.custom.kit_componentes.value
  assign is_kit = false
  if kit_components != blank and kit_components.size > 1
    assign is_kit = true
  endif

  # Pra renderizar custom fields no kit (campos como "comprimento_guia" e
  # "customizacao_raca"), as tags efetivas são a UNIÃO das tags dos
  # componentes (e do produto-pai). O JS coleta valores por componente
  # via data-cf-tag e envia properties só no item que tem aquela tag.
  assign effective_tags = product.tags
  if is_kit
    for comp in kit_components
      assign effective_tags = effective_tags | concat: comp.tags
    endfor
  endif

  # Quando o produto é um "produto principal" do agrupador de cores, oculta o sufixo " - <cor>" no nome visível.
  # Ex: "Coleira Atena - Azul" → "Coleira Atena". O title original continua sendo usado em meta tags e propriedades.
  assign display_title = product.title
  if product.tags contains 'produto_principal'
    assign display_title = display_title | split: ' - ' | first
  endif

  assign pdp_videos_show = false
  assign pdp_videos_count = 0
  if section.settings.videos_enabled
    # Bolt: usa filtro native `where` em vez de loop manual sobre product.media
    # (executa em C/Rust no servidor Shopify, evita overhead de parse do Liquid
    # loop e melhora TTFB em produtos com galerias grandes).
    assign native_videos = product.media | where: 'media_type', 'video'
    assign external_videos = product.media | where: 'media_type', 'external_video'
    assign pdp_videos_count = native_videos.size | plus: external_videos.size

    if pdp_videos_count > 0
      assign pdp_videos_show = true
    endif
  endif
  assign pdp_videos_pos = section.settings.videos_position | default: 'below-title'
-%}

{%- capture pdp_videos_widget -%}
  {%- if pdp_videos_show -%}
    {%- render 'video-stories',
      videos: product.media,
      source_type: 'media',
      widget_id: 'pdp',
      format: section.settings.videos_format,
      border_type: section.settings.videos_border_type,
      cor: section.settings.videos_cor,
      cor_fim: section.settings.videos_cor_fim,
      cor_3: section.settings.videos_cor_3,
      angulo: section.settings.videos_angulo,
      tamanho: section.settings.videos_tamanho,
      espessura: section.settings.videos_espessura,
      espacamento: section.settings.videos_espacamento,
      mostrar_titulo: section.settings.videos_mostrar_titulo,
      autoplay: section.settings.videos_autoplay
    -%}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign pdp_btn_bg = section.settings.pdp_btn_bg_color | default: '#000000'
  assign pdp_btn_fg = section.settings.pdp_btn_fg_color | default: '#ffffff'
-%}
<style>
  #shopify-section-{{ section.id }} .pdp {
    --pdp-btn-bg: {{ pdp_btn_bg }};
    --pdp-btn-fg: {{ pdp_btn_fg }};
  }
</style>

<!-- Breadcrumb -->
{%- liquid
  # Resolve a coleção pro breadcrumb:
  # 1. `collection` vem preenchido quando o cliente acessa via URL
  #    /collections/<handle>/products/<handle> — usa esta direto.
  # 2. Senão (acesso direto via /products/<handle>), procura a primeira
  #    coleção do produto que NÃO seja virtual/automática (Shopify cria
  #    "frontpage" e "all" automaticamente que não fazem sentido aqui).
  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank or breadcrumb_collection == empty
    for col in product.collections
      if col.handle == 'frontpage' or col.handle == 'all'
        continue
      endif
      assign breadcrumb_collection = col
      break
    endfor
  endif
-%}
<nav class="pdp-breadcrumb full-width" aria-label="Navegação">
  <a href="{{ routes.root_url }}">Início</a>
  <span aria-hidden="true">/</span>
  {%- if breadcrumb_collection != blank and breadcrumb_collection.url != blank -%}
    <a href="{{ breadcrumb_collection.url }}">{{ breadcrumb_collection.title }}</a>
    <span aria-hidden="true">/</span>
  {%- endif -%}
  <span aria-current="page">{{ display_title }}</span>
</nav>

<div class="pdp full-width{% if is_kit %} pdp--is-kit{% endif %}">
  <!-- ── Coluna esquerda: galeria ── -->
  <div class="pdp__gallery">
    {%- assign selection_pos = section.settings.selection_info_position | default: 'below' -%}
    <!-- Wrapper sticky no mobile: imagem + barra de seleção compactam juntas -->
    <div class="pdp__sticky-wrap pdp__sticky-wrap--selection-{{ selection_pos }}">
      <!-- Imagem principal -->
      <div class="pdp__main-img-wrap">
        {%- if media_size > 0 -%}
          <div class="pdp__track" id="pdp-track">
            {%- for media in product.media -%}
              <div class="pdp__slide" data-media-id="{{ media.id }}">
                {%- if media.media_type == 'image' -%}
                  {%- liquid
                    assign img_loading = 'lazy'
                    assign img_fetchpriority = 'auto'

                    # ⚡ Bolt: Eager load the LCP (Largest Contentful Paint) image.
                    # 💡 What: Apply `loading: 'eager'` and `fetchpriority: 'high'` to the first image in the product gallery.
                    # 🎯 Why: Hardcoding `loading: 'lazy'` for all images delays the LCP. Eager loading the first image improves perceived load time.
                    # 📊 Impact: Improves LCP Web Vital metric significantly.
                    if forloop.first
                      assign img_loading = 'eager'
                      assign img_fetchpriority = 'high'
                    endif
                    assign img_alt = media.alt | default: product.title | escape
                  -%}
                  {{-
                    media
                    | image_url: width: 1200
                    | image_tag:
                      loading: img_loading,
                      fetchpriority: img_fetchpriority,
                      class: 'pdp__slide-img',
                      alt: img_alt
                  -}}
                {%- elsif media.media_type == 'video' -%}
                  {%- comment -%}
                    Renderiza o <video> manualmente em vez de usar | video_tag,
                    pra forçar preload="none". O filtro do Shopify aplica
                    preload="metadata" que, dependendo do encoding do MP4
                    (moov box no fim), acaba baixando o vídeo inteiro mesmo
                    sem dar play — chegou a 21MB de transferência inútil no
                    PSI desta PDP.

                    Estratégia: o primeiro slide (LCP) carrega metadata pra
                    o frame inicial aparecer rápido se o cliente trocar pra
                    ele logo; demais ficam com preload="none" — só baixam ao
                    receber play().
                  {%- endcomment -%}
                  {%- liquid
                    assign video_preload = 'none'
                    if forloop.first
                      assign video_preload = 'metadata'
                    endif
                    assign video_src = ''
                    for s in media.sources
                      if s.format == 'mp4' and s.height >= 720
                        assign video_src = s.url
                        break
                      endif
                    endfor
                    if video_src == '' and media.sources.size > 0
                      assign video_src = media.sources[0].url
                    endif
                    assign video_poster = ''
                    if media.preview_image != blank
                      assign video_poster = media.preview_image | image_url: width: 1200
                    endif
                  -%}
                  <video
                    class="pdp__slide-img"
                    preload="{{ video_preload }}"
                    loop
                    muted
                    playsinline
                    aria-label="{{ product.title | escape }}"
                    {% if video_poster != '' %}
                      poster="{{ video_poster }}"
                    {% endif %}
                  >
                    <source src="{{ video_src }}" type="video/mp4">
                  </video>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
          <!-- contador -->
          <div class="pdp__counter" aria-live="polite"><span id="pdp-current">1</span> / {{ media_size }}</div>
          <!-- botões de navegação -->
          <button type="button" class="pdp__nav pdp__nav--prev" id="pdp-prev" aria-label="Anterior" title="Anterior">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back_ios</span>
          </button>
          <button type="button" class="pdp__nav pdp__nav--next" id="pdp-next" aria-label="Próximo" title="Próximo">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward_ios</span>
          </button>
        {%- else -%}
          <div class="pdp__track" id="pdp-track">
            <div class="pdp__slide">
              {{ 'product-1' | placeholder_svg_tag: 'pdp__slide-img pdp__slide-img--placeholder' }}
            </div>
          </div>
        {%- endif -%}

        {%- liquid
          assign img_base_price = cv.price | default: product.price_min
          assign img_compare = cv.compare_at_price | default: 0
          if img_compare == 0
            assign img_compare = product.compare_at_price_max | default: 0
          endif
          assign pdp_img_discount = 0
          if img_compare > img_base_price
            assign pdp_img_discount = img_compare | minus: img_base_price | times: 100 | divided_by: img_compare | round
          elsif settings.auto_discount_enabled and settings.auto_discount_percent > 0
            assign pdp_img_discount = settings.auto_discount_percent
          endif
        -%}
        <div id="pdp-img-badge-wrap">
          {%- if pdp_img_discount > 0 -%}
            <span class="pdp__img-discount-badge" aria-label="{{ pdp_img_discount }}% de desconto">
              {{ pdp_img_discount }}% OFF
            </span>
          {%- endif -%}
        </div>

        {%- if product.tags contains 'customizacao_pingente'
          or product.tags contains 'customizacao_pingente_obrigatorio'
        -%}
          <div class="pdp__pingente-overlay" data-pingente-overlay hidden aria-hidden="true">
            {%- assign transparent_gif = 'data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==' -%}
            <img
              src="{{ transparent_gif }}"
              alt=""
              data-pingente-overlay-img
              loading="lazy"
              width="800"
              height="800"
            >
          </div>
        {%- endif -%}

        {%- if product.tags contains 'customizacao_jogoamericano' -%}
          <div class="pdp__text-overlay" data-text-overlay hidden aria-hidden="true">
            <span class="pdp__text-overlay__text" data-text-overlay-text></span>
          </div>
        {%- endif -%}

        {%- if selection_pos == 'over' -%}
          <!-- Resumo sobre a imagem (overlay no topo) -->
          <div class="pdp__selection-info" data-selection-info hidden aria-live="polite">
            <span class="pdp__selection-info__label">Você selecionou:</span>
            <span class="pdp__selection-info__values" data-selection-info-values></span>
          </div>
        {%- endif -%}
      </div>

      {%- if selection_pos != 'over' -%}
        <!-- Resumo abaixo da imagem (padrão) -->
        <div class="pdp__selection-info" data-selection-info hidden aria-live="polite">
          <span class="pdp__selection-info__label">Você selecionou:</span>
          <span class="pdp__selection-info__values" data-selection-info-values></span>
        </div>
      {%- endif -%}
    </div>
    <!-- /pdp__sticky-wrap -->

    <!-- Thumbnails em linha horizontal com scroll -->
    {%- if media_size > 1 -%}
      <div class="pdp__thumbs-wrap">
        <div class="pdp__thumbs-fade pdp__thumbs-fade--top" aria-hidden="true"></div>
        {%- comment -%}
          Cada thumb é um <button> interativo. ARIA proíbe role="listitem"
          em elemento com role implícito "button" (PSI/agente flagged).
          Mantemos buttons individuais; o container ganha aria-label pra
          contexto sem forçar semântica de lista.
        {%- endcomment -%}
        <div class="pdp__thumbs" aria-label="Miniaturas do produto">
          {%- for media in product.media -%}
            <button
              class="pdp__thumb{% if forloop.first %} pdp__thumb--active{% endif %}"
              data-index="{{ forloop.index0 }}"
              aria-label="Imagem {{ forloop.index }}"
              type="button"
            >
              {{-
                media.preview_image
                | image_url: width: 160
                | image_tag: loading: 'lazy', alt: '', class: 'pdp__thumb-img'
              -}}
            </button>
          {%- endfor -%}
        </div>
        <div class="pdp__thumbs-fade pdp__thumbs-fade--bottom" aria-hidden="true"></div>
      </div>
    {%- endif -%}
  </div>

  {%- comment -%}
    Kit: no mobile, título precisa aparecer ANTES do showcase (UX),
    mas no desktop continua na coluna direita junto com o preço. Por isso
    sai do `.pdp__info` e vira child direto do grid `.pdp` — `grid-column: 2`
    no desktop o realinha. No mobile (grid 1-col), a ordem natural do markup
    coloca título → showcase → resto-do-info.
  {%- endcomment -%}
  {%- if is_kit -%}
    <h1 class="pdp__title pdp__title--kit-outside">{{ display_title }}</h1>
    <div class="pdp-kit__showcase" data-kit-showcase></div>
  {%- endif -%}

  <!-- ── Coluna direita: informações ── -->
  <div class="pdp__info">
    <!-- Badge de coleção / heritage / lançamento / sob medida / esgotado -->
    {%- liquid
      assign show_meta = false
      if product.tags contains 'lancamento'
        assign show_meta = true
      endif
      if product.tags contains 'heritage' or product.tags contains 'Heritage'
        assign show_meta = true
      endif
      if product.tags contains 'customizacao_sobmedida'
        assign show_meta = true
      endif
      if product.available == false
        assign show_meta = true
      endif
    -%}
    {%- if show_meta -%}
      <div class="pdp__meta">
        {%- comment -%}
          ⚡ Bolt: Optimize heritage tag check
          💡 What: Replaced `for tag in product.tags` loop with `product.tags contains` array check.
          🎯 Why: Iterating over `product.tags` to find a specific tag causes O(N) rendering overhead. Native `contains` provides O(N) internal C++ lookup without the Liquid loop scoping overhead.
          📊 Impact: Reduces template compilation overhead and improves server response time for products with many tags.
        {%- endcomment -%}
        {%- if product.tags contains 'lancamento' -%}
          <span class="ame-chip ame-chip--lancamento">Lançamento</span>
        {%- endif -%}
        {%- if product.tags contains 'heritage' or product.tags contains 'Heritage' -%}
          <span class="ame-chip">Heritage Series</span>
        {%- endif -%}
        {%- if product.tags contains 'customizacao_sobmedida' -%}
          <span class="ame-chip ame-chip--sob-medida">Sob Medida</span>
        {%- endif -%}
        {%- if product.available == false -%}
          <span class="ame-chip">Esgotado</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if pdp_videos_pos == 'above-title' -%}{{ pdp_videos_widget }}{%- endif -%}

    {%- comment -%} Slot pra apps: antes do título {%- endcomment -%}
    <div class="pdp__app-slot pdp__app-slot--before-title">
      {% content_for 'block', type: '@app', id: 'pdp-app-before-title' %}
    </div>

    <!-- Título (no kit, renderizado FORA do .pdp__info pra que mobile mostre antes do showcase) -->
    {%- unless is_kit -%}
      <h1 class="pdp__title">{{ display_title }}</h1>
    {%- endunless -%}

    {%- comment -%} Slot pra apps: depois do título {%- endcomment -%}
    <div class="pdp__app-slot pdp__app-slot--after-title">
      {% content_for 'block', type: '@app', id: 'pdp-app-after-title' %}
    </div>

    {%- if pdp_videos_pos == 'below-title' -%}{{ pdp_videos_widget }}{%- endif -%}

    {%- comment -%}
      Resumo de avaliações renderizado pelo Konfidency Reviews (estrelinhas +
      contagem + link "ver avaliações"). O loader em theme.liquid procura
      .konfidency-reviews-summary no DOM e injeta o conteúdo via JS. O atributo
      data-sku recebe o ID numérico do produto Shopify — convenção definida
      junto com a Konfidency.
    {%- endcomment -%}
    <div class="pdp__rating">
      <div class="konfidency-reviews-summary" data-sku="{%- render 'konfidency-id', product: product -%}"></div>
    </div>

    {%- comment -%} Slot pra apps: antes do preço {%- endcomment -%}
    <div class="pdp__app-slot pdp__app-slot--before-price">
      {% content_for 'block', type: '@app', id: 'pdp-app-before-price' %}
    </div>

    <!-- ── Bloco de preços ── -->
    {%- liquid
      # Sem variante selecionada: usa price_min do produto
      assign base_price = cv.price
      if has_variant == false
        assign base_price = product.price_min
      endif

      assign cv_compare = cv.compare_at_price | default: 0
      if cv_compare == 0
        assign cv_compare = product.compare_at_price_max | default: 0
      endif
      assign has_compare = false
      assign discount_pct = 0
      if cv_compare > base_price
        assign has_compare = true
        assign discount_pct = cv_compare | minus: base_price | times: 100 | divided_by: cv_compare
      endif

      assign effective_price = base_price
      assign displayed_compare = cv_compare
      if has_compare == false and settings.auto_discount_enabled and settings.auto_discount_percent > 0
        assign has_compare = true
        assign discount_pct = settings.auto_discount_percent
        assign displayed_compare = base_price
        assign disc_cents = base_price | times: discount_pct | divided_by: 100
        assign effective_price = base_price | minus: disc_cents
      endif

      # Pix é só anúncio no tema — pagar.me processa no checkout. Mantém
      # `settings.pix_discount` sincronizado com a config do pagar.me admin.
      # Parcelamento (max sem juros + min_value + tabela de juros) está
      # encapsulado em snippets/installments-info.liquid e snippets/installments-modal.liquid.
      assign pix_pct = settings.pix_discount | default: 5
      assign pix_price_cents = effective_price | times: pix_pct | divided_by: 100
      assign pix_price_cents = effective_price | minus: pix_price_cents
    -%}

    {%- comment -%}
      Quando produto é Kit, este bloco mostra um placeholder de preço
      atualizado dinamicamente pelo ame-kit.js (soma dos preços dos
      componentes selecionados). Mesmo wrapper #pdp-price-block é usado
      pra manter compatibilidade com Section Rendering API e CSS herdado.
    {%- endcomment -%}
    <div class="pdp__price-block" id="pdp-price-block">
      {%- if is_kit -%}
        {%- comment -%}
          Kit segue mesma ordem da PDP normal (Pix → Cartão → Parcelas →
          Cashback). Valores são placeholders ("—") até ame-kit.js terminar
          o fetch do Waltz e calcular total dos componentes selecionados.
        {%- endcomment -%}
        <div class="pdp__price-pix-row pdp__price-pix-row--primary" data-kit-pix-row hidden>
          <strong class="pdp__price-pix" data-kit-price-pix>—</strong>
          <span class="pdp__price-label">no Pix</span>
        </div>
        <div class="pdp__price-card-row">
          <span class="pdp__price-label"
            >ou <strong class="pdp__price-main" data-kit-price-total>—</strong> no cartão</span
          >
        </div>
        <p class="pdp__installments" data-kit-installments-row hidden>
          Em até <strong data-kit-installments-n>—</strong>x de <strong data-kit-price-installment>—</strong> sem juros
          {%- if settings.show_installments_link != false -%}
            <button type="button" class="pdp__installments-link" data-installments-modal-open>Ver mais detalhes</button>
          {%- endif -%}
        </p>
        <!-- Cashback no kit — valor atualizado pelo ame-kit.js conforme seleção -->
        <div id="pdp-cashback-wrap">
          {%- render 'cashback', cashback_price: 0, cashback_mode: 'pdp' -%}
        </div>

        <!-- Modal de parcelas: vazio inicial (ame-kit.js popula com base no total) -->
        {%- render 'installments-modal', price_cents: 0 -%}
      {%- else -%}
        <!-- Linha "De:" riscado -->
        {%- if has_compare -%}
          <div class="pdp__price-compare-row">
            <s class="pdp__price-compare">De: {{ displayed_compare | money }}</s>
          </div>
        {%- endif -%}

        {%- comment -%}
          Ordem visual: Pix (com desconto) → Cartão (preço cheio) → Parcelas
          sem juros → Cashback. Pagar.me processa o pagamento real no checkout
          — aqui é só anúncio. Manter valores sincronizados com o admin pagar.me.
        {%- endcomment -%}

        <!-- Preço no Pix (com desconto destacado em primeiro) -->
        {%- if settings.show_pix != false -%}
          <div class="pdp__price-pix-row pdp__price-pix-row--primary">
            <strong class="pdp__price-pix">{{ pix_price_cents | money }}</strong>
            <span class="pdp__price-label">no Pix</span>
          </div>
        {%- endif -%}

        <!-- Preço no cartão + badge de desconto -->
        <div class="pdp__price-card-row">
          <span class="pdp__price-label">ou {{ effective_price | money }} no cartão</span>
          {%- if has_compare -%}
            <span class="pdp__discount-badge">−{{ discount_pct }}% OFF</span>
          {%- endif -%}
        </div>

        <!-- Parcelamento: max sem juros viável + link pra modal -->
        {%- render 'installments-info', price_cents: effective_price, mode: 'pdp' -%}

        <!-- Cashback -->
        <div id="pdp-cashback-wrap">
          {%- render 'cashback', cashback_price: effective_price, cashback_mode: 'pdp' -%}
        </div>

        <!-- Modal de parcelas (popup com tabela completa) -->
        {%- render 'installments-modal', price_cents: effective_price -%}
      {%- endif -%}
      {%- comment -%} fim do else do is_kit (preço padrão){%- endcomment -%}
    </div>

    {%- comment -%} Slot pra apps: depois do preço {%- endcomment -%}
    <div class="pdp__app-slot pdp__app-slot--after-price">
      {% content_for 'block', type: '@app', id: 'pdp-app-after-price' %}
    </div>

    {%- if pdp_videos_pos == 'below-price' -%}{{ pdp_videos_widget }}{%- endif -%}

    <!-- ── Descrição curta (metafield custom.descricao_curta) ── -->
    {%- if product.metafields.custom.descricao_curta != blank -%}
      <div class="pdp__desc pdp__desc--short">
        {{- product.metafields.custom.descricao_curta | metafield_tag -}}
      </div>
    {%- endif -%}

    <!-- ── Características do produto (metafield custom.caracteristicas — lista de strings) ── -->
    {%- assign caracteristicas = product.metafields.custom.caracteristicas.value -%}
    {%- if caracteristicas and caracteristicas.size > 0 -%}
      <ul class="pdp__features" aria-label="Características do produto">
        {%- for feature in caracteristicas -%}
          {%- if feature != blank -%}
            <li class="pdp__features__chip">{{ feature }}</li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <!-- ── Formulário de produto ── -->
    {%- form 'product', product, id: 'pdp-form', novalidate: true -%}
      <input
        type="hidden"
        name="id"
        value="{{ cv.id }}"
        id="pdp-variant-id"
        data-media-id="{{ cv.featured_media.id | default: cv.featured_image.id }}"
      >

      {%- comment -%} Slot pra apps: antes das variantes {%- endcomment -%}
      <div class="pdp__app-slot pdp__app-slot--before-variants">
        {% content_for 'block', type: '@app', id: 'pdp-app-before-variants' %}
      </div>

      {%- comment -%}
        Widget de "Agrupamento de Produtos" migrou pra módulo Waltz —
        agora injetado via waltz-core.js (ativado em Configurações →
        Módulos → Agrupamento de Produtos no painel Waltz). Tema não
        renderiza mais nada aqui.
      {%- endcomment -%}

      {%- comment -%}
        Kit: substitui as opções padrão (que viriam do produto-pai com
        apenas default variant) pelo picker unificado dos componentes.
        Renderizado dentro do wrapper #pdp-options-wrap pra manter a
        compatibilidade com o JS de Section Rendering API.
      {%- endcomment -%}
      {%- if is_kit -%}
        <div id="pdp-options-wrap" data-section-id="{{ section.id }}">
          {% render 'kit-picker', kit_components: kit_components %}
        </div>
      {%- else -%}
        <!-- Opções (Cor, Tamanho...) — renderizadas sob demanda via Section Rendering API -->
        <div id="pdp-options-wrap" data-section-id="{{ section.id }}">
          {%- for option in product.options_with_values -%}
            {%- liquid
              assign is_color = false
              if option.name == 'Color' or option.name == 'Cor' or option.name == 'Acabamento'
                assign is_color = true
              endif
              assign is_metal_color = false
              if settings.show_metal_color_swatches and option.name == 'Cor do Metal' or settings.show_metal_color_swatches and option.name == 'Metal'
                assign is_metal_color = true
              endif
            -%}

            <div class="pdp__option" data-option-group-index="{{ forloop.index0 }}">
              <div class="pdp__option-header">
                <span class="pdp__option-label">{{ option.name }}</span>
                <span class="pdp__option-value" id="pdp-opt-val-{{ forloop.index }}">
                  {%- if has_variant -%}{{ option.selected_value }}{%- endif -%}
                </span>
              </div>

              {%- if is_color -%}
                <!-- Grade de swatches por imagem (6 colunas no mobile) -->
                {%- comment -%}
                  Produtos com tag `swatch_solido` (peças finas onde a foto não
                  mostra a cor com clareza) usam o snippet de swatch sólido em
                  vez da foto da variante. Cores definidas em
                  settings.swatch_solido_cores.
                {%- endcomment -%}
                {%- assign use_swatch_solido = false -%}
                {%- if product.tags contains 'swatch_solido' -%}
                  {%- assign use_swatch_solido = true -%}
                {%- endif -%}
                <div
                  class="pdp__swatches{% if use_swatch_solido %} pdp__swatches--solido{% endif %}"
                  data-option-index="{{ forloop.index0 }}"
                >
                  {%- for option_value in option.values -%}
                    {%- liquid
                      assign sw_variant = option_value.variant
                      assign sw_img = ''
                      assign sw_media_id = ''
                      if sw_variant.featured_media != blank
                        assign sw_img = sw_variant.featured_media.preview_image | image_url: width: 120
                        assign sw_media_id = sw_variant.featured_media.id
                      elsif sw_variant.featured_image != blank
                        assign sw_img = sw_variant.featured_image | image_url: width: 120
                        assign sw_media_id = sw_variant.featured_image.id
                      endif
                    -%}
                    <button
                      type="button"
                      class="pdp__swatch{% if has_variant and option_value.selected %} pdp__swatch--active{% endif %}{% unless option_value.available %} pdp__swatch--disabled{% endunless %}"
                      data-value="{{ option_value | escape }}"
                      data-option-value-id="{{ option_value.id }}"
                      aria-label="{{ option_value | escape }}{% unless option_value.available %} (Esgotado){% endunless %}"
                      title="{{ option_value | escape }}{% unless option_value.available %} (Esgotado){% endunless %}"
                      aria-pressed="{% if has_variant and option_value.selected %}true{% else %}false{% endif %}"
                      {% if sw_media_id != '' %}
                        data-media-id="{{ sw_media_id }}"
                      {% endif %}
                      {% unless option_value.available %}
                        aria-disabled="true"
                      {% endunless %}
                    >
                      {%- if use_swatch_solido -%}
                        {%- render 'swatch-solido', value: option_value -%}
                      {%- elsif sw_img != '' -%}
                        <img
                          src="{{ sw_img }}"
                          alt="{{ option_value | escape }}"
                          class="pdp__swatch-img"
                          loading="lazy"
                          width="120"
                          height="120"
                        >
                      {%- else -%}
                        <span
                          class="pdp__swatch-color"
                          style="background:var(--swatch-{{ option_value | downcase | replace: ' ', '-' }},var(--color-surface-container,#f8ece0));"
                        ></span>
                      {%- endif -%}
                    </button>
                  {%- endfor -%}
                </div>
              {%- elsif is_metal_color -%}
                <!-- Botões com swatch de cor do metal -->
                <div class="pdp__sizes pdp__sizes--metal" data-option-index="{{ forloop.index0 }}">
                  {%- for option_value in option.values -%}
                    {%- assign metal_slug = option_value | downcase | replace: ' ', '-' -%}
                    <button
                      type="button"
                      class="pdp__size-btn pdp__size-btn--metal{% if has_variant and option_value.selected %} pdp__size-btn--active{% endif %}{% unless option_value.available %} pdp__size-btn--disabled{% endunless %}"
                      data-value="{{ option_value | escape }}"
                      data-option-value-id="{{ option_value.id }}"
                      aria-label="{{ option_value | escape }}{% unless option_value.available %} (Esgotado){% endunless %}"
                      title="{{ option_value | escape }}{% unless option_value.available %} (Esgotado){% endunless %}"
                      aria-pressed="{% if has_variant and option_value.selected %}true{% else %}false{% endif %}"
                      {% unless option_value.available %}
                        aria-disabled="true"
                      {% endunless %}
                    >
                      <span
                        class="pdp__metal-dot"
                        aria-hidden="true"
                        style="background:var(--metal-{{ metal_slug }}, var(--color-surface-container,#f8ece0));"
                      ></span>
                      {{ option_value }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <!-- Botões de tamanho -->
                <div class="pdp__sizes" data-option-index="{{ forloop.index0 }}">
                  {%- for option_value in option.values -%}
                    <button
                      type="button"
                      class="pdp__size-btn{% if has_variant and option_value.selected %} pdp__size-btn--active{% endif %}{% unless option_value.available %} pdp__size-btn--disabled{% endunless %}"
                      data-value="{{ option_value | escape }}"
                      data-option-value-id="{{ option_value.id }}"
                      aria-label="{{ option_value | escape }}{% unless option_value.available %} (Esgotado){% endunless %}"
                      title="{{ option_value | escape }}{% unless option_value.available %} (Esgotado){% endunless %}"
                      aria-pressed="{% if has_variant and option_value.selected %}true{% else %}false{% endif %}"
                      {% unless option_value.available %}
                        aria-disabled="true"
                      {% endunless %}
                    >
                      {{ option_value }}
                    </button>
                  {%- endfor -%}
                </div>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- comment -%} fim do else do is_kit (variant picker padrão){%- endcomment -%}

      {%- comment -%} Slot pra apps: depois das variantes {%- endcomment -%}
      {%- unless is_kit -%}
        <div class="pdp__app-slot pdp__app-slot--after-variants">
          {% content_for 'block', type: '@app', id: 'pdp-app-after-variants' %}
        </div>
      {%- endunless -%}

      {%- comment -%}
        Pingente customizado: pro kit, render exige que o produto-pai (kit)
        tenha a tag `customizacao_pingente` no admin Shopify. O snippet
        renderiza checando `product.tags`. Em kits, o snippet adapta a
        leitura das opções pra ler `[data-kit-options]` (vide JS interno).
      {%- endcomment -%}
      {%- render 'pingente-customization', product: product -%}

      <!-- ── Campos Personalizados ── -->
      {%- comment -%}
        ⚡ Bolt: Replace O(N²) nested loop with O(N) sort.
        💡 What: Builds an array of active custom fields prefixed by order, sorts it natively, and then iterates.
        🎯 Why: Replaces 400 (20x20) Liquid loop iterations with a single pass build (20 iterations) and native `sort`, significantly reducing template evaluation time.
        📊 Impact: Improves server response time (TTFB) on product pages with custom fields enabled.
      {%- endcomment -%}
      {%- liquid
        assign active_cf_str = ''
        for cf_i in (1..20)
          assign cf_en_key = 'custom_field_' | append: cf_i | append: '_enable'
          assign cf_tag_key = 'custom_field_' | append: cf_i | append: '_tag'
          assign cf_enabled = settings[cf_en_key]
          assign cf_cfg_tag = settings[cf_tag_key]

          if cf_enabled and effective_tags contains cf_cfg_tag
            assign cf_or_key = 'custom_field_' | append: cf_i | append: '_order'
            assign cf_order = settings[cf_or_key] | default: cf_i
            # Padds order with 0 if single digit to ensure correct string sorting
            assign padded_order = cf_order | prepend: '00' | slice: -2, 2

            # Format: order_cf_i
            assign cf_item = padded_order | append: '_' | append: cf_i
            assign active_cf_str = active_cf_str | append: cf_item | append: ','
          endif
        endfor

        assign active_cfs = active_cf_str | split: ',' | sort
      -%}

      {%- for sorted_cf in active_cfs -%}
        {%- if sorted_cf == blank -%}{%- continue -%}{%- endif -%}

        {%- liquid
          assign cf_parts = sorted_cf | split: '_'
          assign cf_i = cf_parts[1]

          assign cf_nm_key = 'custom_field_' | append: cf_i | append: '_name'
          assign cf_tt_key = 'custom_field_' | append: cf_i | append: '_title'
          assign cf_ph_key = 'custom_field_' | append: cf_i | append: '_placeholder'
          assign cf_hl_key = 'custom_field_' | append: cf_i | append: '_helper'
          assign cf_lm_key = 'custom_field_' | append: cf_i | append: '_limiter'
          assign cf_tp_key = 'custom_field_' | append: cf_i | append: '_type'
          assign cf_op_key = 'custom_field_' | append: cf_i | append: '_options'
          assign cf_rq_key = 'custom_field_' | append: cf_i | append: '_required'

          assign cf_name = settings[cf_nm_key]
          assign cf_title = settings[cf_tt_key]
          assign cf_placeholder = settings[cf_ph_key] | default: cf_title
          assign cf_helper = settings[cf_hl_key]
          assign cf_limiter = settings[cf_lm_key]
          assign cf_type = settings[cf_tp_key]
          assign cf_options = settings[cf_op_key]
          assign cf_req = settings[cf_rq_key]
          # Re-resolve a tag desse CF pra anotar no DOM. O JS do kit usa pra
          # decidir em qual item da requisição /cart/add.js essa property entra
          # (só vai pro componente que tem a tag).
          assign cf_tag_key2 = 'custom_field_' | append: cf_i | append: '_tag'
          assign cf_field_tag = settings[cf_tag_key2]
        -%}
        <div class="pdp__custom-field" data-cf-tag="{{ cf_field_tag | escape }}" data-cf-name="{{ cf_name | escape }}">
          {%- if cf_type == 'text' or cf_type == 'date' or cf_type == 'phone' -%}
            {%- liquid
              # Mapeia o tipo do campo pro input HTML correspondente
              assign input_type = 'text'
              if cf_type == 'date'
                assign input_type = 'date'
              elsif cf_type == 'phone'
                assign input_type = 'tel'
              endif
              # Phone: placeholder e maxlength default quando não configurados
              assign phone_placeholder = cf_placeholder
              if cf_type == 'phone' and cf_placeholder == cf_title
                assign phone_placeholder = '11 99999-9999'
              endif
              assign phone_maxlength = cf_limiter
              if cf_type == 'phone' and cf_limiter == blank
                assign phone_maxlength = 13
              endif
            -%}
            <label class="pdp__custom-field__label" for="cf-{{ cf_name | handle }}">
              {{- cf_title -}}
              {%- if cf_req -%}
                <span class="pdp__custom-field__req" aria-hidden="true"> *</span>
              {%- endif -%}
            </label>
            {%- liquid
              # Define o max do contador: usa o limiter cadastrado pra qualquer tipo,
              # ou 13 (máscara completa) como default pro telefone.
              assign counter_max = cf_limiter
              if cf_type == 'phone' and cf_limiter == blank
                assign counter_max = 13
              endif
            -%}
            <div class="pdp__custom-field__input-wrap{% if counter_max != blank %} pdp__custom-field__input-wrap--has-counter{% endif %}">
              <input
                id="cf-{{ cf_name | handle }}"
                type="{{ input_type }}"
                name="properties[{{ cf_name }}]"
                placeholder="{% if cf_type == 'phone' %}{{ phone_placeholder }}{% else %}{{ cf_placeholder }}{% endif %}"
                class="pdp__custom-field__input{% if cf_type == 'date' %} pdp__custom-field__input--date{% endif %}{% if cf_type == 'phone' %} pdp__custom-field__input--phone{% endif %}"
                {%- if cf_req %}
                  data-cf-required="true"
                {% endif %}
                {%- if cf_type == 'phone' %}
                  data-cf-phone="true"
                  inputmode="numeric"
                  maxlength="{{ phone_maxlength }}"
                {%- elsif cf_limiter != blank %}
                  maxlength="{{ cf_limiter }}"
                {% endif %}
              >
              {%- if counter_max != blank -%}
                <span
                  class="pdp__custom-field__counter pdp__custom-field__counter--inline"
                  data-cf-counter
                  data-cf-max="{{ counter_max }}"
                  aria-live="polite"
                  >0 / {{ counter_max -}}
                </span>
              {%- endif -%}
            </div>
            {%- if cf_helper != blank -%}
              <p class="pdp__custom-field__helper">{{ cf_helper }}</p>
            {%- endif -%}
            {%- if cf_req -%}
              <p class="pdp__custom-field__error-msg">Este campo é obrigatório.</p>
            {%- endif -%}
          {%- elsif cf_type == 'long_text' -%}
            <label class="pdp__custom-field__label" for="cf-{{ cf_name | handle }}">
              {{- cf_title -}}
              {%- if cf_req -%}
                <span class="pdp__custom-field__req" aria-hidden="true"> *</span>
              {%- endif -%}
            </label>
            <div class="pdp__custom-field__input-wrap pdp__custom-field__input-wrap--textarea">
              <textarea
                id="cf-{{ cf_name | handle }}"
                name="properties[{{ cf_name }}]"
                placeholder="{{ cf_placeholder }}"
                class="pdp__custom-field__textarea"
                {%- if cf_req %}
                  data-cf-required="true"
                {% endif %}
                {%- if cf_limiter != blank %}
                  maxlength="{{ cf_limiter }}"
                {% endif %}
                rows="3"
              ></textarea>
              {%- if cf_limiter != blank -%}
                <span
                  class="pdp__custom-field__counter pdp__custom-field__counter--inline pdp__custom-field__counter--textarea"
                  data-cf-counter
                  data-cf-max="{{ cf_limiter }}"
                  aria-live="polite"
                  >0 / {{ cf_limiter -}}
                </span>
              {%- endif -%}
            </div>
            {%- if cf_helper != blank -%}
              <p class="pdp__custom-field__helper">{{ cf_helper }}</p>
            {%- endif -%}
            {%- if cf_req -%}
              <p class="pdp__custom-field__error-msg">Este campo é obrigatório.</p>
            {%- endif -%}
          {%- elsif cf_type == 'radio' -%}
            <div class="pdp__custom-field__label">
              {{- cf_title -}}
              {%- if cf_req -%}
                <span class="pdp__custom-field__req" aria-hidden="true"> *</span>
              {%- endif -%}
            </div>
            <div class="pdp__custom-field__radio-group pdp__sizes">
              {%- assign cf_opts = cf_options | split: ',' -%}
              {%- for cf_opt in cf_opts -%}
                {%- assign opt_val = cf_opt | strip -%}
                <button
                  type="button"
                  class="pdp__size-btn"
                  data-value="{{ opt_val | escape }}"
                  aria-label="{{ opt_val | escape }}"
                  title="{{ opt_val | escape }}"
                  aria-pressed="false"
                >
                  {{- opt_val -}}
                </button>
              {%- endfor -%}
            </div>
            <input
              type="hidden"
              name="properties[{{ cf_name }}]"
              id="cf-hidden-{{ cf_name | handle }}"
              class="pdp__custom-field__radio-val"
              {%- if cf_req %}
                data-cf-required="true"
              {% endif %}
            >
            {%- if cf_helper != blank -%}
              <p class="pdp__custom-field__helper">{{ cf_helper }}</p>
            {%- endif -%}
            {%- if cf_req -%}
              <p class="pdp__custom-field__error-msg">Selecione uma opção.</p>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endfor -%}

      {%- comment -%}
        Quantidade — escondida pra kit (qty é sempre 1 por componente; o
        cliente pode aumentar manualmente no drawer depois). O CTA padrão
        ABAIXO continua visível: o ame-kit.js intercepta o submit do form
        e dispara cart/add.js com N items em vez do submit padrão.
      {%- endcomment -%}
      {%- unless is_kit -%}
        <!-- Quantidade -->
        <div class="pdp__qty">
          <span class="pdp__option-label">Quantidade</span>
          <div class="pdp__qty-ctrl">
            <button
              type="button"
              class="pdp__qty-btn"
              id="pdp-qty-minus"
              aria-label="Diminuir"
              title="Diminuir"
              disabled
            >
              −
            </button>
            <input
              type="number"
              name="quantity"
              id="pdp-qty"
              value="1"
              min="1"
              class="pdp__qty-input"
              aria-label="Quantidade"
            >
            <button type="button" class="pdp__qty-btn" id="pdp-qty-plus" aria-label="Aumentar" title="Aumentar">
              +
            </button>
          </div>
        </div>
      {%- endunless -%}

      {%- if pdp_videos_pos == 'above-cta' -%}{{ pdp_videos_widget }}{%- endif -%}

      {%- comment -%}
        Kit: resumo "Itens inclusos no kit" logo antes do CTA, pra cliente
        revisar exatamente o que vai adicionar. Renderizado pelo ame-kit.js.
      {%- endcomment -%}
      {%- if is_kit -%}
        <div data-kit-summary-bottom></div>
      {%- endif -%}

      {%- comment -%}
        Calculadora de frete da PDP — chama Waltz que cota direto na
        SmartEnvios sem mexer no cart. Aparece em produtos normais
        (oculta no kit; lá o cliente cota no carrinho após adicionar).
        Toggle global em Customize → Produto → "Cotação de frete na PDP".
      {%- endcomment -%}
      {%- if settings.pdp_freight_enabled and is_kit == false -%}
        {%- render 'pdp-frete-calculator' -%}
      {%- endif -%}

      {%- comment -%} Slot pra apps: antes do CTA {%- endcomment -%}
      <div class="pdp__app-slot pdp__app-slot--before-cta">
        {% content_for 'block', type: '@app', id: 'pdp-app-before-cta' %}
      </div>

      <!-- CTAs -->
      <div class="pdp__ctas">
        <div id="pdp-add-btn-wrap" style="display:contents">
          {%- liquid
            # Desabilita o botão em dois cenários:
            # 1. Produto inteiro esgotado (product.available == false → todas as variantes sem estoque)
            # 2. Cliente escolheu uma variante específica e ela está esgotada
            # Sem nada selecionado mas produto disponível, deixa habilitado pra mostrar
            # o erro de validação no clique (força o cliente a escolher variante).
            assign cta_sold_out = false
            unless product.available
              assign cta_sold_out = true
            endunless
            if has_variant and cv.available == false
              assign cta_sold_out = true
            endif
          -%}
          <button
            type="submit"
            class="ame-cta pdp__add-btn{% if cta_sold_out %} pdp__add-btn--sold-out{% endif %}"
            id="pdp-add-btn"
            {% if product.tags contains 'efeito_borboletas_svg' %}
              data-fly-effect="butterflies-svg"
            {% elsif product.tags contains 'efeito_borboletas' %}
              data-fly-effect="butterflies"
            {% endif %}
            {% if cta_sold_out %}
              disabled
              aria-disabled="true"
            {% endif %}
          >
            {%- if cta_sold_out -%}
              Produto esgotado
            {%- else -%}
              Adicionar ao Carrinho
              <span class="material-symbols-outlined" style="font-size:1rem;" aria-hidden="true">shopping_bag</span>
            {%- endif -%}
          </button>
        </div>

        <button
          type="button"
          class="pdp__wishlist-btn"
          aria-label="Favoritar"
          title="Favoritar"
          id="pdp-wishlist"
          aria-pressed="false"
        >
          <span
            class="material-symbols-outlined"
            style="font-size:1.25rem;font-variation-settings:'FILL' 0;"
            aria-hidden="true"
            >favorite</span
          >
        </button>
      </div>

      {%- comment -%} Slot pra apps: depois do CTA {%- endcomment -%}
      <div class="pdp__app-slot pdp__app-slot--after-cta">
        {% content_for 'block', type: '@app', id: 'pdp-app-after-cta' %}
      </div>
    {%- endform -%}
  </div>
  <!-- /pdp__info -->
</div>
<!-- /pdp -->

{%- if product.tags contains 'efeito_borboletas' -%}
  {%- render 'cart-flying-butterflies' -%}
{%- endif -%}
{%- if product.tags contains 'efeito_borboletas_svg' -%}
  {%- render 'cart-flying-butterflies-svg' -%}
{%- endif -%}

<!-- Acordeões de detalhes foram movidos pra section própria: sections/product-accordions.liquid -->

<!-- ── Produtos relacionados ── -->
{%- if section.settings.show_related and recommendations.performed and recommendations.products_count > 0 -%}
  <div class="ame-pdp-related full-width">
    <div class="ame-pdp-related__header ame-reveal">
      <p class="ame-label-sm">Complete o Look</p>
      <h2 class="ame-pdp-related__title">Você Também Vai Amar.</h2>
    </div>
    <div class="ame-pdp-related__grid">
      {% comment %}
        ⚡ Bolt: Replace snippet render inside for-loop with `render ... for` syntax.
        💡 What: Pre-slices the recommendations to 4 products and uses the `render 'product-card' for array` tag instead of manually looping.
        🎯 Why: Liquid processes a `for` loop with a `render` inside by parsing and scoping the snippet per iteration (N+1 overhead).
        📊 Impact: Eliminates N+1 rendering overhead, improving product page rendering time.
        🔬 Measurement: Profile the Server Response time on product pages.
      {% endcomment %}
      {%- assign limited_recs = recommendations.products | slice: 0, 4 -%}
      {%- render 'product-card' for limited_recs as card_product -%}
    </div>
  </div>
{%- endif -%}

<script
  type="module"
>
  /* PERF: type="module" faz o browser deferir esse script automaticamente
     (executa após o HTML parse, sem bloquear). PSI 2026-06 mediu HTML inline
     da PDP em 4.6s de script time — quase tudo daqui. Module = auto-defer +
     strict mode. O IIFE já existia, então scope module não muda nada. */
  (() => {
    /* ── Carousel ── */
    const track   = document.getElementById('pdp-track');
    const thumbs     = document.querySelectorAll('.pdp__thumb');
    const counter    = document.getElementById('pdp-current');
    const thumbsEl   = document.querySelector('.pdp__thumbs');
    const thumbsWrap = document.querySelector('.pdp__thumbs-wrap');
    let cur = 0;
    const total = thumbs.length || 1;

    function updateThumbIndicators() {
      if (!thumbsWrap || !thumbsEl) return;
      thumbsWrap.classList.toggle('can-scroll-up',   thumbsEl.scrollLeft > 4);
      thumbsWrap.classList.toggle('can-scroll-down',
        thumbsEl.scrollLeft < thumbsEl.scrollWidth - thumbsEl.clientWidth - 4);
    }

    function scrollThumbIntoView(thumb) {
      if (!thumbsEl || !thumb) return;
      const relLeft  = thumb.offsetLeft - thumbsEl.offsetLeft;
      const relRight = relLeft + thumb.offsetWidth;
      if (relRight > thumbsEl.scrollLeft + thumbsEl.clientWidth) {
        thumbsEl.scrollTo({ left: relRight - thumbsEl.clientWidth, behavior: 'smooth' });
      } else if (relLeft < thumbsEl.scrollLeft) {
        thumbsEl.scrollTo({ left: relLeft, behavior: 'smooth' });
      }
    }

    function goTo(i) {
      cur = Math.max(0, Math.min(i, total - 1));
      track.style.transform = `translateX(-${cur * 100}%)`;
      thumbs.forEach((t, idx) => t.classList.toggle('pdp__thumb--active', idx === cur));
      if (counter) counter.textContent = cur + 1;
      scrollThumbIntoView(thumbs[cur]);
    }

    if (thumbsEl) {
      thumbsEl.addEventListener('scroll', updateThumbIndicators, { passive: true });
      updateThumbIndicators();
    }

    document.getElementById('pdp-prev')?.addEventListener('click', () => goTo(cur - 1));
    document.getElementById('pdp-next')?.addEventListener('click', () => goTo(cur + 1));
    thumbs.forEach(t => t.addEventListener('click', () => goTo(+t.dataset.index)));

    /* swipe */
    let sx = 0;
    track?.addEventListener('touchstart', e => { sx = e.touches[0].clientX; }, { passive: true });
    track?.addEventListener('touchend', e => {
      const dx = sx - e.changedTouches[0].clientX;
      if (Math.abs(dx) > 40) goTo(dx > 0 ? cur + 1 : cur - 1);
    }, { passive: true });

    /* ── Quantidade ── */
    const qtyInput = document.getElementById('pdp-qty');
    const btnMinus = document.getElementById('pdp-qty-minus');
    const updateMinusBtn = () => {
      if (btnMinus && qtyInput) {
        btnMinus.disabled = +qtyInput.value <= 1;
      }
    };

    btnMinus?.addEventListener('click', () => {
      if (qtyInput && +qtyInput.value > 1) {
        qtyInput.value = +qtyInput.value - 1;
        updateMinusBtn();
      }
    });
    document.getElementById('pdp-qty-plus')?.addEventListener('click', () => {
      if (qtyInput) {
        qtyInput.value = +qtyInput.value + 1;
        updateMinusBtn();
      }
    });
    qtyInput?.addEventListener('change', () => {
      if (+qtyInput.value < 1) qtyInput.value = 1;
      updateMinusBtn();
    });

    /* ── Variantes (Section Rendering API — suporta >250 variantes) ── */
    const SECTION_ID = {{ section.id | json }};
    const PRODUCT_URL = {{ product.url | json }};

    function navigateGalleryToMedia(mediaId) {
      if (!mediaId || !track) return;
      const targetSlide = track.querySelector(`[data-media-id="${mediaId}"]`);
      if (!targetSlide) return;
      const slides = Array.from(track.querySelectorAll('.pdp__slide'));
      const idx = slides.indexOf(targetSlide);
      if (idx >= 0) goTo(idx);
    }

    async function refreshVariantSection() {
      const optionValueIds = [];
      document.querySelectorAll('#pdp-options-wrap [data-option-index]').forEach(g => {
        const active = g.querySelector('.pdp__swatch--active, .pdp__size-btn--active');
        if (active?.dataset.optionValueId) optionValueIds.push(active.dataset.optionValueId);
      });
      if (optionValueIds.length === 0) return;

      const params = new URLSearchParams({
        section_id: SECTION_ID,
        option_values: optionValueIds.join(','),
      });
      try {
        const res = await fetch(`${PRODUCT_URL}?${params.toString()}`, { headers: { Accept: 'text/html' } });
        if (!res.ok) return;
        const html = await res.text();
        const doc = new DOMParser().parseFromString(html, 'text/html');

        ['pdp-options-wrap', 'pdp-price-block', 'pdp-add-btn-wrap', 'pdp-img-badge-wrap'].forEach(id => {
          const fresh = doc.getElementById(id);
          const current = document.getElementById(id);
          if (fresh && current) current.replaceWith(fresh);
        });

        const freshVariantInput = doc.getElementById('pdp-variant-id');
        const currentVariantInput = document.getElementById('pdp-variant-id');
        if (freshVariantInput && currentVariantInput) {
          currentVariantInput.value = freshVariantInput.value;
          if (freshVariantInput.dataset.mediaId) {
            currentVariantInput.dataset.mediaId = freshVariantInput.dataset.mediaId;
          } else {
            delete currentVariantInput.dataset.mediaId;
          }
        }

        bindOptionClicks();

        // Prioriza a featured_media da variante selecionada (cobre opções como Tamanho,
        // Cor do Metal, Formato — que não têm data-media-id no botão). Fallback: swatch ativo.
        const variantMediaId = currentVariantInput?.dataset.mediaId;
        const newActive = document.querySelector('#pdp-options-wrap .pdp__swatch--active');
        if (variantMediaId) navigateGalleryToMedia(variantMediaId);
        else if (newActive?.dataset.mediaId) navigateGalleryToMedia(newActive.dataset.mediaId);

        document.dispatchEvent(new CustomEvent('pdp:variant-changed'));
      } catch (err) {
        console.warn('[pdp] refreshVariantSection failed', err);
      }
    }

    function isSelectionComplete() {
      const groups = document.querySelectorAll('#pdp-options-wrap [data-option-index]');
      if (!groups.length) return true;
      return Array.from(groups).every(g =>
        g.querySelector('.pdp__swatch--active, .pdp__size-btn--active')
      );
    }

    /* ── Resumo "Você selecionou: X + Y + Z." sobre a imagem (mobile) ── */
    function updateSelectionInfo() {
      const wrap = document.querySelector('[data-selection-info]');
      if (!wrap) return;
      const valuesEl = wrap.querySelector('[data-selection-info-values]');
      const groups = document.querySelectorAll('#pdp-options-wrap [data-option-index]');
      const values = [];
      groups.forEach(g => {
        const active = g.querySelector('.pdp__swatch--active, .pdp__size-btn--active');
        if (active?.dataset.value) values.push(active.dataset.value);
      });
      if (values.length === 0) {
        wrap.hidden = true;
        return;
      }
      valuesEl.textContent = values.join(' + ') + '.';
      wrap.hidden = false;
    }

    function bindOptionClicks() {
      document.querySelectorAll('#pdp-options-wrap [data-option-index]').forEach(group => {
        const btns = group.querySelectorAll('.pdp__swatch, .pdp__size-btn');
        btns.forEach(btn => btn.addEventListener('click', () => {
          // Variantes sem estoque (aria-disabled="true") continuam selecionáveis.
          // Selecionar uma variante esgotada faz o Section Rendering API atualizar
          // o CTA pra "Produto esgotado" (não clicável) e revela o botão do app
          // "Avise-me quando chegar" — sem essa seleção, o cliente não conseguia
          // pedir notificação pra variantes específicas que estavam esgotadas.
          btns.forEach(b => {
            b.classList.remove('pdp__swatch--active', 'pdp__size-btn--active');
            b.setAttribute('aria-pressed', 'false');
          });
          btn.classList.add(btn.classList.contains('pdp__swatch') ? 'pdp__swatch--active' : 'pdp__size-btn--active');
          btn.setAttribute('aria-pressed', 'true');
          const valEl = document.getElementById(`pdp-opt-val-${+group.dataset.optionIndex + 1}`);
          if (valEl) valEl.textContent = btn.dataset.value;

          // Limpa o highlight de erro nesse grupo (cliente respondeu)
          group.closest('.pdp__option')?.classList.remove('pdp__option--invalid');

          if (btn.classList.contains('pdp__swatch') && btn.dataset.mediaId) {
            navigateGalleryToMedia(btn.dataset.mediaId);
          }

          updateSelectionInfo();

          // Section Rendering API só roda quando tudo está selecionado — sem isso o
          // servidor devolveria cv=nil e perderíamos os botões com seleção parcial.
          if (isSelectionComplete()) {
            refreshVariantSection();
          } else {
            // Sinaliza pro pingente revalidar o estado da coleira (mesmo sem variant final)
            document.dispatchEvent(new CustomEvent('pdp:variant-changed'));
          }
        }));
      });
    }

    bindOptionClicks();
    // Boot: caso a URL traga ?variant=... os botões já vêm marcados, então mostramos.
    updateSelectionInfo();
    // Re-aplica após Section Rendering API substituir o markup das opções.
    document.addEventListener('pdp:variant-changed', updateSelectionInfo);

    /* ── Validação no submit: destaca opções faltantes + scroll + toast ── */
    function validateAndHighlight() {
      const groups = document.querySelectorAll('#pdp-options-wrap [data-option-index]');
      const missing = [];
      groups.forEach(g => {
        const wrap = g.closest('.pdp__option');
        if (!g.querySelector('.pdp__swatch--active, .pdp__size-btn--active')) {
          wrap?.classList.add('pdp__option--invalid');
          missing.push(wrap);
        } else {
          wrap?.classList.remove('pdp__option--invalid');
        }
      });
      if (missing.length === 0) return { ok: true };
      const labels = missing.map(w => w.querySelector('.pdp__option-label')?.textContent.trim()).filter(Boolean);
      // Scroll até o primeiro grupo faltante
      const headerH = document.querySelector('.ame-header-group')?.getBoundingClientRect().height || 0;
      const firstTop = missing[0].getBoundingClientRect().top + window.scrollY - headerH - 16;
      window.scrollTo({ top: firstTop, behavior: 'smooth' });
      return { ok: false, msg: labels.length
        ? `Selecione: ${labels.join(', ')}.`
        : 'Selecione todas as opções antes de continuar.' };
    }

    /* Toast simples no topo da PDP */
    function showSelectionToast(msg) {
      let toast = document.getElementById('pdp-toast');
      if (!toast) {
        toast = document.createElement('div');
        toast.id = 'pdp-toast';
        toast.className = 'pdp__toast';
        toast.setAttribute('role', 'alert');
        document.body.appendChild(toast);
      }
      toast.textContent = msg;
      toast.classList.add('is-visible');
      clearTimeout(showSelectionToast._t);
      showSelectionToast._t = setTimeout(() => toast.classList.remove('is-visible'), 3500);
    }

    // Expõe pra ser usado pelo handler de submit que já existe abaixo
    window.AmePdpValidate = function () {
      const r = validateAndHighlight();
      if (!r.ok) showSelectionToast(r.msg);
      return r.ok;
    };
    // Toast público — usado também pelo snippet do pingente
    window.AmePdpToast = showSelectionToast;

    /* ── Campos Personalizados — radio (reusa visual do .pdp__size-btn) ── */
    document.querySelectorAll('.pdp__custom-field .pdp__size-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const group = btn.closest('.pdp__custom-field');
        group?.querySelectorAll('.pdp__size-btn').forEach(b => {
          b.classList.remove('pdp__size-btn--active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('pdp__size-btn--active');
        btn.setAttribute('aria-pressed', 'true');
        const hidden = group?.querySelector('.pdp__custom-field__radio-val');
        if (hidden) hidden.value = btn.dataset.value;
        group?.classList.remove('pdp__custom-field--error');
      });
    });

    /* ── Contador de caracteres dos campos personalizados ── */
    document.querySelectorAll('.pdp__custom-field [data-cf-counter]').forEach(counter => {
      const max = parseInt(counter.dataset.cfMax, 10) || 0;
      if (!max) return;
      const wrap = counter.closest('.pdp__custom-field');
      const field = wrap?.querySelector('input[maxlength], textarea[maxlength]');
      if (!field) return;
      const update = () => {
        const len = field.value.length;
        counter.textContent = `${len} / ${max}`;
        counter.classList.toggle('is-near', len >= max * 0.8 && len < max);
        counter.classList.toggle('is-full', len >= max);
      };
      field.addEventListener('input', update);
      update();
    });

    /* ── Máscara de telefone nos custom fields tipo "phone" ── */
    document.querySelectorAll('[data-cf-phone]').forEach(input => {
      input.addEventListener('input', (e) => {
        const digits = e.target.value.replace(/\D/g, '').slice(0, 11);
        let formatted = digits;
        if (digits.length > 7) {
          formatted = `${digits.slice(0, 2)} ${digits.slice(2, 7)}-${digits.slice(7)}`;
        } else if (digits.length > 2) {
          formatted = `${digits.slice(0, 2)} ${digits.slice(2)}`;
        }
        e.target.value = formatted;
      });
    });

    /* ── Texto sobreposto à imagem (customizacao_jogoamericano) ──
       Pega o primeiro campo de propriedade do form (texto/long-text, ignorando phone/date/hidden)
       e espelha o valor digitado como overlay sobre a imagem principal. */
    (() => {
      const overlay = document.querySelector('[data-text-overlay]');
      if (!overlay) return;
      const textEl = overlay.querySelector('[data-text-overlay-text]');
      if (!textEl) return;
      // Aceita qualquer input/textarea com name="properties[...]" no form da PDP,
      // exceto telefone, data e campos ocultos. Robusto pra diferentes estruturas de markup.
      const form = document.getElementById('pdp-form') || document;
      const source = form.querySelector(
        'input[name^="properties["]:not([data-cf-phone]):not([type="date"]):not([type="hidden"]),'
        + ' textarea[name^="properties["]'
      );
      if (!source) return;
      const update = () => {
        const v = source.value.trim();
        textEl.textContent = v;
        overlay.hidden = !v;
      };
      source.addEventListener('input', update);
      update();
    })();

    document.getElementById('pdp-form')?.addEventListener('input', e => {
      if (e.target.dataset.cfRequired) {
        e.target.closest('.pdp__custom-field')?.classList.remove('pdp__custom-field--error');
      }
    });

    /* ── Wishlist ── */
    const wishBtn = document.getElementById('pdp-wishlist');
    wishBtn?.addEventListener('click', () => {
      const on = wishBtn.classList.toggle('is-active');
      wishBtn.setAttribute('aria-pressed', on);
      wishBtn.querySelector('.material-symbols-outlined').style.fontVariationSettings = on ? "'FILL' 1" : "'FILL' 0";
    });

    /* ── Add to cart AJAX ── */
    document.getElementById('pdp-form')?.addEventListener('submit', async e => {
      e.preventDefault();

      /* Validate variant selection (todas as opções escolhidas) */
      if (!window.AmePdpValidate || !window.AmePdpValidate()) return;

      /* Validate required custom fields */
      let cfValid = true;
      e.target.querySelectorAll('[data-cf-required]').forEach(field => {
        const wrap = field.closest('.pdp__custom-field');
        if (!field.value.trim()) { cfValid = false; wrap?.classList.add('pdp__custom-field--error'); }
        else wrap?.classList.remove('pdp__custom-field--error');
      });
      if (!cfValid) return;

      /* Validate phone custom fields: telefone só aceita números completos (10 ou 11 dígitos) */
      let phoneIncomplete = false;
      let firstIncompletePhone = null;
      e.target.querySelectorAll('[data-cf-phone]').forEach(field => {
        const digits = field.value.replace(/\D/g, '');
        const wrap = field.closest('.pdp__custom-field');
        // Vazio: deixa o "required" cuidar (já validado acima); aqui só pega preenchido-mas-incompleto
        if (digits.length > 0 && digits.length < 10) {
          phoneIncomplete = true;
          wrap?.classList.add('pdp__custom-field--error');
          if (!firstIncompletePhone) firstIncompletePhone = field;
        } else {
          wrap?.classList.remove('pdp__custom-field--error');
        }
      });
      if (phoneIncomplete) {
        (window.AmePdpToast || ((m) => alert(m)))('Telefone incompleto. Digite o número completo (DDD + 8 ou 9 dígitos).');
        firstIncompletePhone?.focus();
        return;
      }

      /* Validate pingente (se cliente optou por adicionar) */
      if (window.amePingente?.isActive()) {
        const pv = window.amePingente.validate();
        if (!pv.ok) {
          (window.AmePdpToast || ((m) => alert(m)))(pv.msg);
          return;
        }
      }

      const btn  = document.getElementById('pdp-add-btn');
      const orig = btn.innerHTML;

      btn.innerHTML = 'Adicionando... <span class="material-symbols-outlined" style="font-size:1rem;animation:pdp-spin 0.6s linear infinite;" aria-hidden="true">refresh</span>';
      btn.disabled  = true;
      btn.setAttribute('aria-busy', 'true');

      try {
        /* Monta item da coleira a partir do form */
        const form = e.target;
        const coleiraId = form.querySelector('#pdp-variant-id')?.value;
        const coleiraQty = parseInt(form.querySelector('#pdp-qty')?.value || '1', 10);
        const coleiraProps = {};
        form.querySelectorAll('[name^="properties["]').forEach(el => {
          if (!el.value || !el.value.trim()) return;
          const key = el.name.replace(/^properties\[/, '').replace(/\]$/, '');
          coleiraProps[key] = el.value.trim();
        });

        /* Vincula coleira+pingente via _coleira_key — usado pelo cart drawer
           pra remover o par junto quando o cliente remove a coleira. */
        const willAddPingente = window.amePingente?.isActive() && window.amePingente.getCartItem;
        let coleiraKey = '';
        if (willAddPingente) {
          coleiraKey = 'ck-' + Date.now() + '-' + Math.random().toString(36).slice(2, 8);
          coleiraProps['_coleira_key'] = coleiraKey;
        }

        const items = [{
          id: coleiraId,
          quantity: coleiraQty,
          ...(Object.keys(coleiraProps).length ? { properties: coleiraProps } : {})
        }];

        /* Adiciona pingente como item separado, se aplicável.
           Passa a quantidade da coleira pra manter 1 pingente por coleira. */
        if (willAddPingente) {
          const pingenteItem = window.amePingente.getCartItem(coleiraQty, coleiraKey);
          if (pingenteItem) items.push(pingenteItem);
        }

        /* XHR (não fetch) — apps de terceiro na loja (adsagent/Easify/Clarity)
           sobrescrevem `window.fetch` e engolem silenciosamente o POST do
           /cart/add.js. Resultado: drawer abre mas cart fica vazio. XHR não
           é interceptado pelos apps — caminho confirmado funcional via
           ame-kit.js (que sempre usou XHR). */
        const addItems = items;
        const cartData = await new Promise((resolve, reject) => {
          const xhrAdd = new XMLHttpRequest();
          xhrAdd.open('POST', '/cart/add.js', true);
          xhrAdd.setRequestHeader('Content-Type', 'application/json');
          xhrAdd.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
          xhrAdd.setRequestHeader('Accept', 'application/json');
          xhrAdd.onload = () => {
            if (xhrAdd.status < 200 || xhrAdd.status >= 300) {
              return reject(new Error('cart/add HTTP ' + xhrAdd.status));
            }
            // Busca cart.js depois do add (também via XHR pelo mesmo motivo)
            const xhrGet = new XMLHttpRequest();
            xhrGet.open('GET', '/cart.js', true);
            xhrGet.setRequestHeader('Accept', 'application/json');
            xhrGet.onload = () => {
              if (xhrGet.status < 200 || xhrGet.status >= 300) {
                return reject(new Error('cart.js HTTP ' + xhrGet.status));
              }
              try { resolve(JSON.parse(xhrGet.responseText)); }
              catch (err) { reject(err); }
            };
            xhrGet.onerror = () => reject(new Error('cart.js network'));
            xhrGet.send();
          };
          xhrAdd.onerror = () => reject(new Error('cart/add network'));
          xhrAdd.send(JSON.stringify({ items: addItems }));
        });

        window.AmeCart?.refresh(cartData);

        /* Efeito de borboletas — duas variantes pra comparar:
           - tag `efeito_borboletas`     → modelo simples (CSS radial gradient)
           - tag `efeito_borboletas_svg` → modelo SVG 3D detalhado */
        const flyEffect = btn.dataset.flyEffect;
        const flyApi = flyEffect === 'butterflies-svg' ? window.AmeButterfliesSvg
                     : flyEffect === 'butterflies'     ? window.AmeButterflies
                     : null;
        if (flyApi?.fly) {
          await flyApi.fly(btn);
        }

        window.AmeCart?.open();

        /* Feedback no botão */
        btn.innerHTML = 'Adicionado ✓';
        btn.removeAttribute('aria-busy');
        setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; }, 1800);

      } catch {
        btn.innerHTML = 'Tente novamente';
        btn.style.opacity = '0.7';
        btn.removeAttribute('aria-busy');
        setTimeout(() => { btn.innerHTML = orig; btn.disabled = false; btn.style.opacity = ''; }, 2000);
      }
    });

    /* Acordeões: handler movido pra sections/product-accordions.liquid */
  })();
</script>

<script type="module">
  /* PERF: type="module" auto-defere a execução (mesma motivação do script
     anterior na PDP — ver comment acima). Esse aqui é o handler de sticky
     image, depende de DOM já parseado. */
  /* ── Imagem fixa no scroll mobile até o botão "Adicionar ao Carrinho" aparecer ── */
  (() => {
    // O wrapper sticky inclui imagem + barra "Você selecionou: ..." — vira fixed juntos
    const wrap = document.querySelector('.pdp__sticky-wrap');
    if (!wrap) return;

    // O CTA é re-buscado a cada update porque a Section Rendering API substitui o
    // nó do botão (#pdp-add-btn-wrap) ao trocar variante — referência cacheada vira órfã.
    const getCta = () => document.querySelector('.ame-cta.pdp__add-btn');

    const spacer = document.createElement('div');
    spacer.className = 'pdp__main-img-spacer';
    spacer.setAttribute('aria-hidden', 'true');
    wrap.after(spacer);

    // Sticky só ativa em mobile real (< 600px). Em tablets/laptops pequenos
    // (600-1023px) sobra espaço lateral pra exibir o layout naturalmente, e
    // o pin estava ocupando 100% da viewport — imagem quadrada vinha maior
    // que a altura, bloqueando o acesso ao form e ao botão Comprar.
    const mq = window.matchMedia('(max-width: 599px)');
    let pinned = false;
    let headerOffset = 0;

    function measureHeader() {
      const header = document.querySelector('.ame-header-group');
      headerOffset = header ? header.getBoundingClientRect().height : 0;
      // Aplicar no <html> pra que tanto o sticky-wrap quanto o breadcrumb
      // (que vive fora do wrap) consigam ler --pdp-pinned-top.
      document.documentElement.style.setProperty('--pdp-pinned-top', headerOffset + 'px');
    }

    function pin() {
      if (pinned) return;
      spacer.style.height = wrap.offsetHeight + 'px';
      wrap.classList.add('is-pinned');
      pinned = true;
    }
    function unpin() {
      if (!pinned) return;
      wrap.classList.remove('is-pinned');
      wrap.style.transform = '';
      spacer.style.height = '';
      pinned = false;
    }

    function update() {
      if (!mq.matches) {
        unpin();
        return;
      }
      const cta = getCta();
      if (!cta) {
        unpin();
        return;
      }
      // Re-medir o header a cada scroll: o header.is-scrolled colapsa de 4rem
      // pra 3rem ao rolar, e a imagem fixa precisa subir junto pra não deixar
      // gap visível (que mostraria o conteúdo passando atrás).
      measureHeader();
      const ctaRect = cta.getBoundingClientRect();
      const refRect = pinned ? spacer.getBoundingClientRect() : wrap.getBoundingClientRect();
      const scrolledPastImage = refRect.top < headerOffset;

      if (!scrolledPastImage) {
        unpin();
        return;
      }

      // Se o CTA já entrou no viewport, desfixa a imagem — ela não pode
      // ficar cobrindo o botão "Adicionar ao Carrinho". Threshold de
      // viewport bottom (CTA está visível na tela).
      if (ctaRect.top < window.innerHeight) {
        unpin();
        return;
      }

      pin();
      wrap.style.transform = '';
    }

    let ticking = false;
    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    }

    function onResize() {
      measureHeader();
      if (pinned) spacer.style.height = wrap.offsetHeight + 'px';
      update();
    }

    measureHeader();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    if (mq.addEventListener) mq.addEventListener('change', onResize);
    // Re-avalia quando a variante muda (CTA/preço/badge são re-renderizados pelo Section Rendering API)
    document.addEventListener('pdp:variant-changed', () => requestAnimationFrame(update));

    if (document.readyState === 'complete') update();
    else window.addEventListener('load', update);
  })();
</script>

{% stylesheet %}
  /* ── Características do produto (chips) ── */

  /* ════════════════════════════════════════
     PÁGINA DE PRODUTO
     Mobile-first → Desktop ≥1024px: 2 colunas
  ════════════════════════════════════════ */

  /* Breadcrumb */
  .pdp-breadcrumb {
    padding: 0.5rem var(--page-margin, 20px) 0.25rem;
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    /* Alpha 0.4 dava ratio ~3:1 (PSI flagava color-contrast). Cor sólida
       --color-on-surface-variant dá ratio ~7:1 (passa WCAG AA com folga). */
    color: var(--color-on-surface-variant, #4f4442);
    flex-wrap: wrap;
  }

  .pdp-breadcrumb a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pdp-breadcrumb a:hover {
    color: var(--color-primary, #5a4742);
  }

  @media (min-width: 1024px) {
    .pdp-breadcrumb {
      padding: 0.75rem var(--page-margin, 20px);
      font-size: 0.6875rem;
    }
  }

  /* ── Layout principal ── */
  .pdp {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    padding: 10px var(--page-margin, 1.5rem);
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .pdp__info {
    min-width: 0;
  }

  /* Kit em qualquer breakpoint: sem galeria. Usa a largura toda da página
     (mesma do PDP normal — `var(--page-width)`), apenas com a coluna de
     galeria removida. O .pdp__info ocupa todo o espaço. */
  .pdp--is-kit .pdp__gallery {
    display: none;
  }

  /* No mobile, galeria precisa de min-width: 0 pra não estourar o grid quando
     tem muitas imagens (slider horizontal com 100+ thumbnails). Sem isso, o
     conteúdo intrinsicamente largo empurra a coluna do grid pra fora. */
  .pdp__gallery,
  .pdp__sticky-wrap {
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .pdp {
      grid-template-columns: minmax(0, 44%) minmax(0, 1fr);
      column-gap: clamp(1.5rem, 3.5vw, 4rem);
      row-gap: 0;
      padding-top: 1.5rem;
      align-items: start;
    }

    .pdp__gallery {
      grid-column: 1;
      position: sticky;
      top: 10rem; /*era 6.5*/
      align-self: start;
      height: fit-content;
    }

    /* PDP do kit (desktop): mantém o grid 2-col do PDP normal, mas a coluna
       esquerda passa a ser o showcase dos componentes (Peitoral + Guia)
       em vez da galeria do produto-pai. Fica sticky igual a galeria. */
    .pdp--is-kit .pdp-kit__showcase {
      grid-column: 1;
      position: sticky;
      top: 10rem;
      align-self: start;
      height: fit-content;
    }
    .pdp--is-kit .pdp__info {
      grid-column: 2;
    }

    /* No desktop, título do kit (renderizado fora do .pdp__info por
       conta da ordem mobile) volta pra coluna direita. Auto-placement
       coloca ele em (col 2, row 1) — showcase fica em (col 1, row 1)
       e .pdp__info cai em (col 2, row 2). */
    .pdp--is-kit .pdp__title--kit-outside {
      grid-column: 2;
      margin: 0 0 0.5rem 0;
    }

    /* PDP do kit: galeria do produto-pai não fica sticky — o cliente
       precisa rolar pra ver showcase dos componentes + pickers + CFs +
       CTA. Sticky atrapalha porque a foto principal do kit é genérica,
       não interativa como nas PDPs normais (variant change → DOM swap). */
    .pdp--is-kit .pdp__gallery {
      position: static;
    }

    .pdp__info {
      grid-column: 2;
      padding-top: 0.5rem;
      min-width: 0;
    }
  }

  /* ── Galeria ── */
  .pdp__main-img-wrap {
    position: relative;
    width: 100%;
    max-width: 100%;
    aspect-ratio: 1 / 1;
    /* background: var(--color-surface-container-highest, #ece1d5); */
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 0.5rem;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .pdp__main-img-wrap {
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-lg, 0.5rem);
      /* Em telas largas com sticky ativo, evita que a imagem quadrada
         exceda a viewport e fique cortada na rolagem. Reserva espaço
         pra: top sticky (6.5rem ≈ 104px) + thumbnails (~6rem) + respiro
         inferior (~1rem). max-width casa com max-height pra manter o
         aspect-ratio 1:1 — quando a viewport é baixa, a imagem encolhe
         proporcionalmente em vez de distorcer. margin-inline: auto
         centraliza a imagem quando ela fica menor que a coluna. */
      max-height: calc(100vh - 13rem);
      max-width: calc(100vh - 13rem);
      margin-inline: auto;
    }
  }

  .pdp__track {
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform 800ms var(--ease-luxury, cubic-bezier(0.22, 1, 0.36, 1));
    will-change: transform;
  }

  .pdp__slide {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
  }

  .pdp__slide-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pdp__slide-img--placeholder {
    opacity: 0.3;
  }

  /* botões de navegação */
  .pdp__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    border: none;
    cursor: pointer;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary, #5a4742);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .pdp__main-img-wrap:hover .pdp__nav {
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .pdp__nav {
      opacity: 0.6;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .pdp__nav--prev {
    left: 0.75rem;
  }

  .pdp__nav--next {
    right: 0.75rem;
  }

  .pdp__nav .material-symbols-outlined {
    font-size: 1rem;
  }

  /* badge de desconto sobre a imagem da PDP */
  .pdp__img-discount-badge {
    position: absolute;
    top: 0.875rem;
    left: 0.875rem;
    z-index: 10;
    background: var(--color-on-background, #201b14);
    color: #ffffff;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-full, 0.75rem);
    pointer-events: none;
  }

  /* contador */
  .pdp__counter {
    position: absolute;
    bottom: 0.75rem;
    right: 0.75rem;
    background: rgba(255, 255, 255, 0.55);
    backdrop-filter: blur(8px);
    border-radius: 999px;
    padding: 0.2rem 0.625rem;
    font-size: 0.5625rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(32, 27, 20, 0.6);
  }

  /* Thumbnails */
  .pdp__thumbs {
    display: flex;
    flex-direction: row;
    overflow-x: auto;
    gap: 5px;
    margin-top: 10px;
    width: auto;
    -ms-overflow-style: none;
    scrollbar-width: none;
    /* padding para o box-shadow dos thumbs não ser cortado */
    padding: 3px;
    margin-left: -3px;
    margin-right: -3px;
  }

  .pdp__thumbs::-webkit-scrollbar {
    display: none;
  }

  .pdp__thumb {
    flex-shrink: 0;
    width: 22%;
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    overflow: hidden;
    background: var(--color-surface-container, #f8ece0);
    border: none;
    cursor: pointer;
    padding: 0;
    opacity: 0.55;
    box-shadow: 0 0 0 0px transparent;
    transition: opacity 0.25s ease, box-shadow 0.2s ease;
  }

  @media (min-width: 1024px) {
    .pdp__thumbs-wrap {
      position: relative;
      width: 100%;
      overflow: hidden;
    }

    .pdp__thumbs-fade {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 3rem;
      z-index: 2;
      pointer-events: none;
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .pdp__thumbs-fade--top {
      left: 0;
      background: linear-gradient(to right, var(--color-background, #fff8f3) 40%, transparent);
    }

    .pdp__thumbs-fade--bottom {
      right: 0;
      background: linear-gradient(to left, var(--color-background, #fff8f3) 40%, transparent);
    }

    .pdp__thumbs-wrap.can-scroll-up .pdp__thumbs-fade--top,
    .pdp__thumbs-wrap.can-scroll-down .pdp__thumbs-fade--bottom {
      opacity: 1;
    }

    .pdp__thumbs {
      flex-direction: row;
      overflow-x: auto;
      overflow-y: hidden;
      width: 100%;
      height: auto;
      gap: 0.5rem;
      margin: 0.5rem 0 0;
      padding: 3px;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    .pdp__thumbs::-webkit-scrollbar {
      display: none;
    }

    .pdp__thumb {
      width: 4.5rem;
      height: 4.5rem;
      aspect-ratio: 1 / 1;
      border-radius: var(--radius-md, 0.25rem);
      flex-shrink: 0;
    }

    .pdp__main-img-wrap {
      width: 100%;
      aspect-ratio: 1 / 1;
      margin-bottom: 0;
    }
  }

  .pdp__thumb--active {
    opacity: 1;
    box-shadow: 0 0 0 2px var(--color-primary, #5a4742);
  }

  .pdp__thumb:hover {
    opacity: 0.85;
  }

  .pdp__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Info ── */
  .pdp__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.375rem;
  }

  .pdp__title {
    font-size: clamp(1.375rem, 5.5vw, 2.5rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--color-on-surface-variant);
    margin: 0 0 0.375rem;
  }

  @media (min-width: 1024px) {
    .pdp__title {
      font-size: clamp(1.75rem, 2.5vw, 2.75rem);
      margin-bottom: 0.5rem;
    }
  }

  .pdp__rating {
    margin-bottom: 0.75rem;
    min-height: 1.25rem;
  }

  /* ── Bloco de preços ── */
  .pdp__price-block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    margin-bottom: 1rem;
    padding: 0;
    /* Reserva espaço pra evitar CLS quando o Section Rendering API troca
         a variante. Cabe: linha "De:" (se houver) + preço + PIX + parcelamento
         + cashback. PSI reportou CLS de 0.163 vindo do .pdp__info (a maior
         parte é desse bloco). */
    min-height: 120px;
    /*teste destaque preco*/
    background: #f8ece099;
    padding: 24px;
    justify-content: center;
    align-items: center;
    border-radius: 15px;
  }

  /* Kit: bloco maior (preço total + pix + parcelamento + cashback, todos
     começam com "—" e trocam quando o ame-kit.js termina o fetch+resolve).
     Sem reservar altura, PSI media CLS 0.446 só desse swap. */
  .pdp--is-kit .pdp__price-block {
    min-height: 200px;
  }

  @media (min-width: 1024px) {
    .pdp__price-block {
      margin-bottom: 1.5rem;
      gap: 0.3rem;
      min-height: 120px;
      /*teste destaque preco*/
      background: var(--color-surface-light);
      padding: 24px;
      display: flex;
      justify-content: center;
      align-items: center;
      border-radius: 15px;
    }
  }

  /* linha "De: R$xxx  –X% OFF" */
  .pdp__price-compare-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.1rem;
  }

  .pdp__price-compare {
    font-size: 0.875rem;
    color: rgba(90, 71, 66, 0.45);
    text-decoration: line-through;
  }

  .pdp__discount-badge {
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(90, 71, 66, 0.09);
    color: var(--color-primary, #5a4742);
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
  }

  /* linha preço cartão */
  .pdp__price-card-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  /* linha preço pix */
  .pdp__price-pix-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .pdp__price-label {
    font-size: 0.8125rem;
    /* Alpha 0.55 → ratio ~3.7:1 (PSI flagava). Cor sólida dá ratio ~7:1. */
    color: var(--color-on-surface-variant, #4f4442);
    font-weight: 400;
  }

  /* valor cartão — secundário agora (Pix tem destaque maior). Quando o
     preço aparece dentro do texto "ou R$ X no cartão", fica inline com
     ligeiro destaque. No kit usa fonte um pouco maior porque é placeholder
     que troca dinamicamente. */
  .pdp__price-main {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-on-background, #201b14);
    line-height: 1;
  }

  @media (min-width: 1024px) {
    .pdp__price-main {
      font-size: 1.125rem;
    }
  }

  /* valor pix — PRIMÁRIO. Maior, mais escuro, primeira coisa que o cliente vê. */
  .pdp__price-pix {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-on-surface-variant);
    line-height: 1;
  }

  @media (min-width: 1024px) {
    .pdp__price-pix {
      font-size: 2rem;
    }
  }

  .pdp__price-pix-row--primary {
    margin-bottom: 0.15rem;
  }
  .pdp__price-pix-row--primary .pdp__price-label {
    font-size: 0.875rem;
    color: var(--color-primary, #5a4742);
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  /* parcelamento */
  .pdp__installments {
    font-size: 0.75rem;
    color: rgba(90, 71, 66, 0.55);
    margin-top: 0.1rem;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
    margin-bottom: 5px;
    justify-content: center;
  }

  .pdp__installments strong {
    color: var(--color-on-surface-variant);
    font-weight: 500;
  }

  .pdp__installments-link {
    font-size: 0.6875rem;
    color: rgba(90, 71, 66, 0.5);
    text-decoration: underline;
    text-underline-offset: 2px;
    margin-left: 0.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    border: none;
    background: none;
    cursor: pointer;
  }

  /* ── Descrição ── */
  .pdp__desc {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant, #4f4442);
    margin-bottom: 1rem;
  }

  @media (min-width: 1024px) {
    .pdp__desc {
      margin-bottom: 1.5rem;
    }
  }

  /* ── Opções ── */
  .pdp__option {
    margin-bottom: 1rem;
  }

  @media (min-width: 1024px) {
    .pdp__option {
      margin-bottom: 1.5rem;
    }
  }

  .pdp__option-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
  }

  .pdp__option-label {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-surface, #201b14);
  }

  .pdp__option-value {
    font-size: 0.6875rem;
    /*color: rgba(90, 71, 66, 0.5);*/
    color: var(--color-on-surface-variant, #4f4442);
  }

  /* Swatches — 6 colunas no mobile como produto.html */
  .pdp__swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    min-width: 0;
    max-width: 100%;
  }

  @media (min-width: 1024px) {
    .pdp__swatches {
      display: flex;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
  }

  .pdp__swatch {
    /* Cálculo correto pra 6 colunas com gap fixo (5 gaps entre 6 itens).
       Compatível com produtos que têm muitas variantes (100+). */
    width: calc((100% - 5 * 0.45rem) / 6);
    aspect-ratio: 1 / 1;
    border-radius: 8px;
    border: none;
    cursor: pointer;
    padding: 0;
    background: var(--color-surface-container, #f8ece0);
    overflow: hidden;
    transition: transform 0.25s ease, outline 0.2s ease;
    flex-shrink: 0;
    border: 1px solid rgba(210, 195, 192, 0.25);
    min-width: 0;
    box-sizing: border-box;
  }

  @media (min-width: 1024px) {
    .pdp__swatch {
      width: 3.25rem;
      height: 3.25rem;
      aspect-ratio: unset;
      border-radius: var(--radius-md, 0.25rem);
    }
  }

  .pdp__swatch:hover {
    transform: scale(1.05);
  }

  .pdp__swatch--active {
    outline: 2px solid var(--color-primary, #5a4742);
    outline-offset: 1px;
  }

  .pdp__swatch-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pdp__swatch-color {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Swatch sólido (tag swatch_solido) — bloco de cor pintado em vez da
     foto da variante. Usado em peças finas (colares, ex: Fifi) onde a
     foto não renderiza bem a cor.
     - 1 cor: background sólido
     - 2 cores: diagonal split 50/50 via linear-gradient */
  .ame-swatch-solido {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ame-swatch-solido--single {
    background: var(--swatch-base);
  }
  .ame-swatch-solido--dual {
    background: linear-gradient(135deg, var(--swatch-base) 50%, var(--swatch-accent) 50%);
  }

  /* Tamanhos */
  .pdp__sizes {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  @media (min-width: 480px) {
    .pdp__sizes {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .pdp__size-btn {
    padding: 0.625rem 0.5rem;
    text-align: center;
    background: var(--color-surface, #fff8f3);
    border: 1px solid rgba(210, 195, 192, 0.25);
    border-radius: var(--radius-md, 0.25rem);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-surface, #201b14);
    cursor: pointer;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .pdp__size-btn:hover {
    background: var(--color-surface-container, #f8ece0);
  }

  .pdp__size-btn--active {
    border-color: var(--color-primary, #5a4742);
    background: rgba(90, 71, 66, 0.05);
    color: var(--color-primary, #5a4742);
    font-weight: 500;
  }

  /* Metal color swatches */
  :root {
    --metal-grafite: linear-gradient(135deg, #4a4a4a 0%, #1f1f1f 100%);
    --metal-ouro: linear-gradient(135deg, #f8e3a0 0%, #d4af37 60%, #a17912 100%);
    --metal-prata: linear-gradient(135deg, #f3f3f3 0%, #c0c0c0 60%, #8e8e8e 100%);
    --metal-rose: linear-gradient(135deg, #f3d3d3 0%, #d49797 60%, #a87070 100%);
  }

  .pdp__size-btn--metal {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
  }

  .pdp__metal-dot {
    display: inline-block;
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.15);
  }

  /* Variantes sem estoque ficam visualmente apagadas (opacity + linha diagonal
       no ::after), mas continuam CLICÁVEIS — selecioná-las aciona o botão
       "Avise-me quando chegar" do app de notificação de estoque. Por isso
       cursor:pointer (não not-allowed) e opacity um pouco menos agressiva. */
  .pdp__swatch--disabled,
  .pdp__size-btn--disabled {
    opacity: 0.45;
    cursor: pointer;
    position: relative;
  }

  .pdp__swatch--disabled::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to top right,
      transparent calc(50% - 1px),
      rgba(90, 71, 66, 0.6) calc(50% - 1px),
      rgba(90, 71, 66, 0.6) calc(50% + 1px),
      transparent calc(50% + 1px)
    );
    pointer-events: none;
  }

  .pdp__swatch--disabled:hover,
  .pdp__size-btn--disabled:hover {
    transform: none;
    border-color: var(--color-outline-variant, #d2c3c0);
    background: transparent;
  }

  /* ── Quantidade ── */
  .pdp__qty {
    margin-bottom: 1rem;
  }

  @media (min-width: 1024px) {
    .pdp__qty {
      margin-bottom: 1.5rem;
    }
  }

  .pdp__qty .pdp__option-label {
    display: block;
    margin-bottom: 0.5rem;
  }

  .pdp__qty-ctrl {
    display: flex;
    align-items: center;
    width: fit-content;
  }

  .pdp__qty-btn {
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(210, 195, 192, 0.25);
    background: var(--color-surface, #fff8f3);
    cursor: pointer;
    font-size: 1.125rem;
    color: var(--color-on-background, #201b14);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
  }

  .pdp__qty-btn:first-child {
    border-radius: var(--radius-md, 0.25rem) 0 0 var(--radius-md, 0.25rem);
  }

  .pdp__qty-btn:last-child {
    border-radius: 0 var(--radius-md, 0.25rem) var(--radius-md, 0.25rem) 0;
  }

  .pdp__qty-btn:hover {
    background: var(--color-surface-container, #f8ece0);
  }

  .pdp__qty-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .pdp__qty-input {
    width: 3rem;
    height: 2.5rem;
    text-align: center;
    border: 1px solid rgba(210, 195, 192, 0.25);
    border-left: none;
    border-right: none;
    border-radius: 0;
    background: var(--color-surface, #fff8f3);
    font-size: 0.875rem;
    color: var(--color-on-background, #201b14);
    outline: none;
  }

  /* Chrome, Safari, Edge e Opera */
  .pdp__qty-input::-webkit-outer-spin-button,
  .pdp__qty-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    appearance: none;
    margin: 0;
  }

  /* Firefox */
  .pdp__qty-input[type='number'] {
    -moz-appearance: textfield;
    appearance: textfield;
  }

  /* ── CTAs ── */
  .pdp__ctas {
    display: flex;
    gap: 0.625rem;
    margin-bottom: 1rem;
    width: 100%;
    min-width: 0;
  }

  /* botão de checkout acelerado do Shopify */
  .shopify-payment-button {
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .pdp__ctas {
      margin-bottom: 1.5rem;
    }
  }

  .pdp__add-btn {
    flex: 1;
  }

  /* Estado "esgotado" do CTA — fundo cinza, sem hover, sem clique.
       `disabled` no <button> já impede submit; pointer-events:none é redundância
       defensiva. Mantemos a opacidade próxima de 1 (não 0.5) porque o cinza
       já comunica "indisponível" sem precisar atenuar. */
  .pdp__add-btn--sold-out,
  .pdp__add-btn:disabled {
    background: var(--color-outline, #817471) !important;
    color: var(--color-on-primary, #ffffff) !important;
    cursor: not-allowed;
    pointer-events: none;
    box-shadow: none;
    transform: none !important;
  }
  .pdp__add-btn--sold-out:hover,
  .pdp__add-btn--sold-out:focus,
  .pdp__add-btn:disabled:hover,
  .pdp__add-btn:disabled:focus {
    transform: none !important;
    background: var(--color-outline, #817471) !important;
    color: var(--color-on-primary, #ffffff) !important;
  }
  /* Desativa o efeito de shimmer/luxo (::after) quando esgotado. */
  .pdp__add-btn--sold-out::after,
  .pdp__add-btn:disabled::after {
    display: none;
  }

  .pdp__wishlist-btn {
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(210, 195, 192, 0.25);
    border-radius: var(--radius-md, 0.25rem);
    background: transparent;
    cursor: pointer;
    color: rgba(90, 71, 66, 0.35);
    transition: color 0.25s ease, border-color 0.25s ease;
  }

  .pdp__wishlist-btn:hover,
  .pdp__wishlist-btn.is-active {
    color: var(--color-primary, #5a4742);
    border-color: rgba(90, 71, 66, 0.3);
  }

  .pdp__wishlist-btn.is-active .material-symbols-outlined {
    font-variation-settings: 'FILL' 1;
  }

  /* ── Selos de confiança ── */
  .pdp__trust {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(210, 195, 192, 0.15);
  }

  .pdp__trust-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-on-surface-variant, #4f4442);
  }

  .pdp__trust-item .material-symbols-outlined {
    font-size: 1.125rem;
    color: var(--color-outline, #817471);
    flex-shrink: 0;
  }

  /* ── Acordeões ── */
  /* Padding responsivo seguindo --page-margin do tema (12px no mobile,
     clamp(32px..160px) no tablet/desktop). Antes era fixo em 20rem (320px)
     em todos os tamanhos exceto mobile, espremendo a descrição em telas
     769-1279px (tablet/laptop pequeno). */
  .pdp-accordions {
    padding: 10px var(--page-margin, 20px);
    max-width: 100%;
    margin: 0 auto;
  }

  /* Desktop largo: mantém o padding generoso de 20rem do design original. */
  @media (min-width: 1280px) {
    .pdp-accordions {
      padding: 10px 20rem;
    }
  }

  @media (max-width: 768px) {
    .pdp-accordions {
      padding: 0 var(--page-margin, 20px) 3rem;
    }
  }

  .ame-accordion {
    border-top: 1px solid rgba(210, 195, 192, 0.2);
  }

  .ame-accordion:last-child {
    border-bottom: 1px solid rgba(210, 195, 192, 0.2);
  }

  .ame-accordion__btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 0;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-on-background, #201b14);
  }

  .ame-accordion__btn:hover {
    color: var(--color-primary, #5a4742);
  }

  .ame-accordion__icon {
    transition: transform 0.3s ease;
  }

  .ame-accordion__btn[aria-expanded='true'] .ame-accordion__icon {
    transform: rotate(45deg);
  }

  .ame-accordion__content {
    overflow: hidden;
    transition: max-height 0.4s var(--ease-luxury, cubic-bezier(0.22, 1, 0.36, 1));
    max-height: 0;
  }

  .ame-accordion__content:not([hidden]) {
    /* Suficientemente grande pra descrições ricas (imagens, listas, vídeos).
       Imagens dentro do body usam max-width:100% pra não overflowar lateralmente. */
    max-height: none;
  }

  .ame-accordion__body img,
  .ame-accordion__body iframe,
  .ame-accordion__body video {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Proteção contra overflow lateral em descrições com tabelas, divs com width fixo etc. */
  .ame-accordion__body {
    overflow-wrap: break-word;
    word-break: break-word;
    /* Container clipa qualquer conteúdo HTML colado no admin que tente estourar
       (divs com width fixo inline, imagens com width inline, etc.). */
    overflow-x: hidden;
    max-width: 100%;
  }

  .ame-accordion__body *,
  .ame-accordion__body table {
    max-width: 100% !important;
  }

  .ame-accordion__body img,
  .ame-accordion__body video,
  .ame-accordion__body iframe,
  .ame-accordion__body svg {
    height: auto;
  }

  .ame-accordion__body table {
    display: block;
    overflow-x: auto;
  }

  .ame-accordion__body {
    padding-bottom: 1.5rem;
    font-size: 0.9375rem;
    line-height: 1.8;
    color: var(--color-on-surface-variant, #4f4442);
  }

  .ame-accordion__body ul {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Related */
  .ame-pdp-related {
    padding: 4rem var(--page-margin, 2rem) var(--section-gap, 7.5rem);
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
  }

  .ame-pdp-related__header {
    margin-bottom: 3.5rem;
  }

  .ame-pdp-related__title {
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--color-on-background, #201b14);
  }

  .ame-pdp-related__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
  }

  @media (min-width: 768px) {
    .ame-pdp-related__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* .ame-label-sm vive global no critical.css. Aqui só override de margem
       (0.5rem vs 0.75rem padrão) pra encaixar no layout compacto da PDP. */
  .pdp .ame-label-sm {
    margin-bottom: 0.5rem;
  }

  .account-button {
    color: var(--color-primary) !important;
  }

  /* Keyboard accessibility: focus rings for interactive elements */
  .pdp__swatch:focus-visible,
  .pdp__size-btn:focus-visible,
  .pdp__qty-btn:focus-visible,
  .pdp__thumb:focus-visible,
  .ame-cart-item__qty-btn:focus-visible,
  .ame-wishlist:focus-visible,
  .pdp__wishlist-btn:focus-visible,
  .ame-accordion__btn:focus-visible,
  .ame-header__icon-btn:focus-visible,
  .ame-search-page-form__btn:focus-visible {
    outline: 2px solid var(--color-primary, #5a4742);
    outline-offset: 2px;
  }

  .ame-pingente-aviso {
    font-size: 0.55rem;
    color: rgba(90, 71, 66, 0.5);
  }

  .pdp__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0.75rem 0 1.25rem;
  }
  .pdp__features__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    background: rgba(90, 71, 66, 0.05);
    border: 1px solid rgba(210, 195, 192, 0.5);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--color-on-background, #201b14);
    line-height: 1.2;
    white-space: nowrap;
  }

  .pdp__custom-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
  }

  .pdp__custom-field__label {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant, #4f4442);
    font-weight: 600;
  }

  .pdp__custom-field__req {
    color: var(--color-primary, #5a4742);
  }

  .pdp__custom-field__input,
  .pdp__custom-field__textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-outline-variant, #d2c3c0);
    border-radius: var(--radius-md, 4px);
    background: transparent;
    font-size: 0.875rem;
    color: var(--color-on-background, #201b14);
    transition: border-color 0.2s ease;
    outline: none;
  }
  /* iPhone Safari aplica zoom automático em inputs com font-size < 16px ao
     receberem foco. Forçamos 16px no mobile pra evitar esse comportamento,
     sem mudar o tamanho visual em desktop. */
  @media (max-width: 767px) {
    .pdp__custom-field__input,
    .pdp__custom-field__textarea,
    .pdp__qty-input {
      font-size: 16px;
    }
  }

  .pdp__custom-field__input:focus,
  .pdp__custom-field__textarea:focus {
    border-color: var(--color-primary, #5a4742);
  }

  .pdp__custom-field__textarea {
    resize: vertical;
    min-height: 5rem;
  }

  .pdp__custom-field__helper {
    font-size: 0.75rem;
    color: var(--color-on-surface-variant, #4f4442);
    opacity: 0.7;
    margin: 0;
  }

  .pdp__custom-field__footer {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .pdp__custom-field__footer .pdp__custom-field__helper {
    flex: 1;
  }

  /* Wrapper relativo pra o counter ficar dentro do input/textarea como overlay */
  .pdp__custom-field__input-wrap {
    position: relative;
  }
  .pdp__custom-field__input-wrap--has-counter .pdp__custom-field__input {
    padding-right: 4rem; /* reserva espaço pro contador */
  }
  .pdp__custom-field__input-wrap--textarea .pdp__custom-field__textarea {
    padding-bottom: 1.75rem; /* reserva espaço pro contador no canto inferior */
  }

  .pdp__custom-field__counter {
    font-size: 0.6875rem;
    color: var(--color-on-surface-variant, #4f4442);
    opacity: 0.55;
    margin-left: auto;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: color 0.2s ease, opacity 0.2s ease;
  }
  /* Counter como overlay dentro do input (canto direito, centralizado verticalmente) */
  .pdp__custom-field__counter--inline {
    position: absolute;
    right: 0.875rem;
    top: 50%;
    transform: translateY(-50%);
    pointer-events: none;
    margin-left: 0;
  }
  /* Counter em textarea: canto inferior direito */
  .pdp__custom-field__counter--textarea {
    top: auto;
    bottom: 0.5rem;
    transform: none;
  }
  .pdp__custom-field__counter.is-near {
    opacity: 1;
    color: var(--color-primary, #5a4742);
  }
  .pdp__custom-field__counter.is-full {
    opacity: 1;
    color: #c0392b;
    font-weight: 600;
  }

  /* Botões de opção dos campos personalizados reusam o visual do
       .pdp__size-btn (definido em outra parte do arquivo). Mantemos o
       wrapper .pdp__custom-field__radio-group só pra agrupar/flexbox;
       todo o styling dos botões vem da classe global. */
  .pdp__custom-field__radio-group {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pdp__custom-field__error-msg {
    font-size: 0.75rem;
    color: #c0392b;
    margin: 0;
    display: none;
  }

  .pdp__custom-field--error .pdp__custom-field__error-msg {
    display: block;
  }

  .pdp__custom-field--error .pdp__custom-field__label {
    color: #c0392b;
  }

  .pdp__custom-field--error .pdp__custom-field__input,
  .pdp__custom-field--error .pdp__custom-field__textarea {
    border-color: #c0392b;
  }

  .pdp__custom-field--error .pdp__size-btn {
    border-color: #c0392b;
  }

  /* ── Override: cor do botão selecionado e add-to-cart (configurável via painel) ── */
  .pdp .pdp__size-btn--active {
    background: var(--pdp-btn-bg, #000000);
    color: var(--pdp-btn-fg, #ffffff);
    border-color: var(--pdp-btn-bg, #000000);
  }

  .pdp .pdp__swatch--active {
    outline-color: var(--pdp-btn-bg, #000000);
  }

  .pdp .pdp__add-btn {
    background: var(--pdp-btn-bg);
    color: var(--color-btn-primary-text, var(--color-on-primary, #ffffff));
  }

  /* ── Largura flexível dos botões de variação ── */
  .pdp .pdp__sizes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .pdp .pdp__size-btn {
    width: auto;
    padding: 0.625rem 1.125rem;
  }

  .pdp .pdp__size-btn.pdp__size-btn--metal {
    padding: 0.5rem 1rem;
  }

  .pdp__size-btn {
    border-radius: var(--radius-lg, 4px);
  }

  /* ── Pingente overlay sobre a imagem principal ── */
  .pdp__pingente-overlay {
    position: absolute;
    bottom: 6%;
    left: 35%;
    width: 30%;
    aspect-ratio: 1 / 1;
    z-index: 3;
    pointer-events: none;
    border-radius: 50%;
    overflow: hidden;
    /* filter: drop-shadow(0 6px 14px rgba(32, 27, 20, 0.28)); */
    opacity: 0;
    transform: translateY(6px) scale(0.9);
    transition: opacity 0.25s ease, transform 0.25s var(--ease-luxury, cubic-bezier(0.22, 1, 0.36, 1));
  }

  .pdp__pingente-overlay[hidden] {
    display: none;
  }

  .pdp__pingente-overlay.is-visible {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .pdp__pingente-overlay img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    /* transform: scale(1.6); */
    /*margin-top: 10px;*/
  }

  /* ── Texto sobreposto à imagem (customizacao_jogoamericano) ── */
  .pdp__text-overlay {
    position: absolute;
    top: 30%;
    bottom: 0;
    right: 0;
    left: 0;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    padding: 8% 12%;
  }
  .pdp__text-overlay[hidden] {
    display: none;
  }
  .pdp__text-overlay__text {
    font-family: 'Comic Sans MS', 'Comic Sans', 'Chalkboard SE', 'Marker Felt', cursive;
    font-weight: 700;
    font-size: clamp(1.5rem, 2vw, 2.5rem);
    color: #1a1a1a;
    text-align: center;
    line-height: 1.1;
    letter-spacing: 0;
    /*text-shadow: 0 1px 2px rgba(255, 255, 255, 0.4);*/
    max-width: 100%;
  }

  /*
    @media (min-width: 1300px) {
      .pdp__text-overlay {
        top: 125px;
      }

      .pdp__text-overlay__text {
        font-size: 2.5rem;
      }
    }
      */
  /* ── Resumo das variações escolhidas (abaixo da imagem, mobile) ── */
  .pdp__selection-info {
    padding: 0.5rem 1rem;
    background: #f7f5f2c9; /*--color-surface*/
    color: var(--color-on-surface-variant, #4f4442);
    font-size: 0.67rem;
    line-height: 1.35;
    text-align: center;
    border-top: 1px solid rgba(210, 195, 192, 0.3);
    opacity: 0.8;
  }
  .pdp__selection-info[hidden] {
    display: none;
  }
  .pdp__selection-info__label {
    font-weight: 400;
    color: var(--color-on-surface-variant, #4f4442);
    margin-right: 0.25rem;
  }
  .pdp__selection-info__values {
    font-weight: 600;
    letter-spacing: 0.01em;
  }
  /* Desktop não mostra (a coluna lateral já dá o feedback) */
  @media (min-width: 1024px) {
    .pdp__selection-info {
      display: none;
    }
  }

  /* Variante "over" — texto sobreposto no topo da imagem (libera espaço da tela).
     Gradient mais suave: o anterior (0.7→0.35) escurecia demais o topo da
     imagem, atrapalhando a leitura visual do produto. Atual deixa o texto
     legível sem ofuscar a foto. */
  .pdp__sticky-wrap--selection-over .pdp__main-img-wrap > .pdp__selection-info {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 5;
    padding: 0.5rem 1rem;
    background: var(--color-surface, #fff8f3);
    color: var(--color-on-surface-variant, #4f4442);
    border-top: none;
    pointer-events: none;
    opacity: 1;
  }
  .pdp__sticky-wrap--selection-over .pdp__main-img-wrap > .pdp__selection-info .pdp__selection-info__label {
    color: var(--color-on-surface-variant, #4f4442);
  }

  /* ── Slots pra apps de terceiros (cores, CEP, etc) ── */
  .pdp__app-slot:empty {
    display: none;
  }
  .pdp__app-slot:not(:empty) {
    margin: 0.875rem 0;
  }

  /* ── Validação: opções não selecionadas no clique do CTA ── */
  .pdp__option--invalid {
    border-radius: var(--radius-md, 4px);
    padding: 0.75rem;
    /*margin-left: -0.75rem;
      margin-right: -0.75rem;*/
    background: rgba(192, 57, 43, 0.06);
    box-shadow: inset 0 0 0 1px rgba(192, 57, 43, 0.55);
    animation: pdpOptionShake 0.45s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }
  .pdp__option--invalid .pdp__option-label {
    color: #c0392b;
  }
  @keyframes pdpOptionShake {
    10%,
    90% {
      transform: translateX(-2px);
    }
    20%,
    80% {
      transform: translateX(3px);
    }
    30%,
    50%,
    70% {
      transform: translateX(-5px);
    }
    40%,
    60% {
      transform: translateX(5px);
    }
  }

  /* ── Toast de erro de seleção ── */
  .pdp__toast {
    position: fixed;
    top: 5rem;
    left: 50%;
    transform: translate(-50%, -16px);
    z-index: 200;
    background: var(--color-on-background, #201b14);
    color: var(--color-background, #fff);
    font-size: 0.875rem;
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md, 4px);
    box-shadow: 0 12px 32px rgba(32, 27, 20, 0.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    max-width: calc(100% - 2rem);
    text-align: center;
  }
  .pdp__toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  /* ── Imagem + barra de seleção ficam fixas no scroll mobile até o CTA aparecer ── */
  .pdp__main-img-spacer {
    width: 100%;
    display: none;
  }

  /* Sticky pinned é só pra mobile (<600px). Em tablets/laptops menores
     o pin com width:100% + aspect-ratio 1/1 tornava a imagem maior que
     o viewport vertical, bloqueando o form e o botão Comprar.
     O breakpoint 599px é o mesmo do --page-margin override do tema. */
  @media (max-width: 599px) {
    .pdp__sticky-wrap.is-pinned {
      position: fixed;
      top: 81px;
      left: 0;
      right: 0;
      width: 100%;
      margin: 0;
      padding: 5px 1.2rem 0;
      z-index: 50;
      will-change: transform;
      background: var(--color-surface, #fff8f3);
    }
    /* Kit: cancela o pin mobile também — galeria do kit não é interativa
       como nas PDPs normais (sem section rendering API por variant change),
       então sticky no mobile só atrapalha quando cliente rola pros pickers. */
    .pdp--is-kit .pdp__sticky-wrap.is-pinned {
      position: static;
      padding: 0;
      background: transparent;
    }
    /* Imagem fica quadrada com borda lateral + sombra (efeito de flutuar) */
    .pdp__sticky-wrap.is-pinned .pdp__main-img-wrap {
      /*width: min(100%, 38vh);*/
      aspect-ratio: 1 / 1;
      height: auto;
      margin: 0 auto;
      border-radius: var(--radius-lg, 0.75rem);
      box-shadow: 0 10px 24px rgba(32, 27, 20, 0.18);
    }
    /* Pingente sobreposto reposicionado para acompanhar a imagem encolhida */
    .pdp__sticky-wrap.is-pinned .pdp__pingente-overlay {
      bottom: 4%;
      width: 30%;
    }
    .pdp__sticky-wrap.is-pinned + .pdp__main-img-spacer {
      display: block;
    }
  }
{% endstylesheet %}
