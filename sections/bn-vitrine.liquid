{%- comment -%}
  Âme · Black November · Vitrine de produtos (Home)
  Usa o MESMO componente da coleção Black November (snippets/bn-ofertas.liquid): abas por coleção,
  filtro Cães/Gatos, filtro por % de desconto, ordenação e cartões com a nota das avaliações.
  As cores vêm da seção "BN · Cores" (bn-cores). O selo de % OFF sai do preço comparativo.
{%- endcomment -%}
{%- liquid
  assign abas = section.blocks | where: 'type', 'aba'
  assign base_handle = section.settings.colecao.handle | default: 'black-november'
-%}
<div class="bn" data-bn-vitrine>
  {%- render 'bn-ofertas',
    abas: abas,
    base_handle: base_handle,
    titulo_todos: section.settings.titulo_todos,
    selo_todos: section.settings.selo_todos,
    sub_todos: section.settings.sub_todos,
    eyebrow: section.settings.eyebrow,
    titulo: section.settings.titulo,
    so_da_promocao: false,
    so_desconto: section.settings.so_com_desconto,
    tag_gato: section.settings.tag_gato,
    por_pagina: section.settings.por_pagina,
    texto_vazio: section.settings.texto_vazio,
    anchor: 'ofertas-home',
    largura: '1180px',
    p_bg: 'var(--bn-bg)',
    p_fg: 'var(--bn-text)',
    p_card: 'var(--bn-surface)',
    p_border: 'color-mix(in srgb, var(--bn-text) 14%, transparent)',
    p_accent: 'var(--bn-accent)',
    p_on_accent: 'var(--bn-on-accent)',
    p_serif: 'var(--bn-serif)',
    p_sans: 'var(--bn-sans)'
  -%}
</div>

{% schema %}
{
  "name": "BN · Vitrine de produtos",
  "tag": "div",
  "settings": [
    { "type": "header", "content": "Quais produtos aparecem" },
    { "type": "collection", "id": "colecao", "label": "Coleção base da promoção", "info": "Vazio = black-november (a automática pela tag black_november, mantida pelo Waltz)." },
    { "type": "checkbox", "id": "so_com_desconto", "label": "Esconder produtos sem desconto", "info": "Ligado: só aparece o que tem preço riscado na loja, ou seja, o que o Waltz já colocou em promoção.", "default": true },
    { "type": "range", "id": "por_pagina", "label": "Produtos por \"Ver mais\"", "min": 4, "max": 40, "step": 4, "default": 8 },
    { "type": "text", "id": "tag_gato", "label": "Tag de produto para gato (além de \"gato\" no título)", "default": "gato" },
    { "type": "textarea", "id": "texto_vazio", "label": "Texto quando não há produtos", "default": "As ofertas desta categoria entram aqui assim que a Black November começar." },

    { "type": "header", "content": "Títulos" },
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Ofertas da Black" },
    { "type": "text", "id": "titulo", "label": "Título", "default": "Escolha a categoria e veja os preços da Black" },
    { "type": "text", "id": "titulo_todos", "label": "Primeira aba — nome", "default": "Black November" },
    { "type": "text", "id": "selo_todos", "label": "Primeira aba — selo", "default": "Todos os descontos" },
    { "type": "text", "id": "sub_todos", "label": "Primeira aba — descrição", "default": "Todos os produtos da loja com desconto da Black November, em couro legítimo feito à mão." }
  ],
  "blocks": [
    {
      "type": "aba",
      "name": "Aba de ofertas",
      "limit": 6,
      "settings": [
        { "type": "collection", "id": "colecao", "label": "Coleção" },
        { "type": "text", "id": "titulo", "label": "Nome da aba", "default": "Coleiras" },
        { "type": "text", "id": "selo", "label": "Selo", "default": "20% OFF" },
        { "type": "textarea", "id": "subtitulo", "label": "Descrição" }
      ]
    }
  ],
  "presets": [{ "name": "BN · Vitrine de produtos" }]
}
{% endschema %}
