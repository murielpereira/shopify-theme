{% comment %}
  PDP — Galeria de pets usando o produto.

  Lê o metafield `product.metafields.custom.pet_gallery` (File reference, list)
  cadastrado no admin Shopify de cada produto. Se não houver imagens, a section
  inteira não renderiza (zero peso no DOM).

  Carrossel = scroll horizontal nativo com scroll-snap. Mobile usa swipe (touch),
  desktop usa setas via JS leve. Sem dependência de Swiper.js ou similar.

  Como criar o metafield (admin Shopify):
    Loja online → Configurações → Custom data → Produtos → Adicionar definição
    - Nome: "Galeria de pets"
    - Namespace e chave: custom.pet_gallery
    - Tipo: File reference (lista)
    - Aceitar somente imagens
{% endcomment %}

{%- liquid
  assign gallery = product.metafields.custom.pet_gallery.value
  assign has_gallery = false
  if gallery != blank and gallery.size > 0
    assign has_gallery = true
  endif
-%}

{%- if has_gallery -%}
  <section
    class="pdp-pet-gallery full-width"
    aria-labelledby="pdp-pet-gallery-title-{{ section.id }}"
    data-pdp-pet-gallery
  >
    <div class="pdp-pet-gallery__inner">
      <header class="pdp-pet-gallery__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="pdp-pet-gallery__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 id="pdp-pet-gallery-title-{{ section.id }}" class="pdp-pet-gallery__title">
          {{ section.settings.title | default: 'Pets que amam essa peça' }}
        </h2>
      </header>

      <div class="pdp-pet-gallery__viewport" data-viewport>
        <ul class="pdp-pet-gallery__track">
          {%- for media in gallery -%}
            {%- liquid
              assign img_alt = media.alt | default: product.title | append: ' — foto de cliente'
            -%}
            <li class="pdp-pet-gallery__item">
              {{
                media
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 500, 700, 900',
                  sizes: '(min-width: 1024px) 22vw, (min-width: 600px) 33vw, 70vw',
                  class: 'pdp-pet-gallery__img',
                  alt: img_alt
              }}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- comment -%}
        Controles desktop. Aparecem só se houver mais de 4 imagens (= não cabem
        sem scroll). O JS abaixo mostra/esconde com base em scrollWidth real.
      {%- endcomment -%}
      <div class="pdp-pet-gallery__controls" data-controls hidden>
        <button
          type="button"
          class="pdp-pet-gallery__nav pdp-pet-gallery__nav--prev"
          aria-label="Imagem anterior"
          data-prev
        >
          <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>
        <button
          type="button"
          class="pdp-pet-gallery__nav pdp-pet-gallery__nav--next"
          aria-label="Próxima imagem"
          data-next
        >
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const host = document.querySelector('[data-pdp-pet-gallery]');
      if (!host || host.dataset.init) return;
      host.dataset.init = '1';

      const viewport = host.querySelector('[data-viewport]');
      const controls = host.querySelector('[data-controls]');
      const btnPrev  = host.querySelector('[data-prev]');
      const btnNext  = host.querySelector('[data-next]');
      if (!viewport) return;

      function passo() {
        const item = viewport.querySelector('.pdp-pet-gallery__item');
        if (!item) return 320;
        const track = viewport.querySelector('.pdp-pet-gallery__track');
        const gap = parseFloat(getComputedStyle(track).columnGap || '16') || 16;
        return item.getBoundingClientRect().width + gap;
      }

      btnPrev?.addEventListener('click', () => viewport.scrollBy({ left: -passo(), behavior: 'smooth' }));
      btnNext?.addEventListener('click', () => viewport.scrollBy({ left:  passo(), behavior: 'smooth' }));

      function atualizar() {
        const podeScroll = viewport.scrollWidth > viewport.clientWidth + 4;
        controls.hidden = !podeScroll;
      }
      // ResizeObserver pega mudanças de viewport (zoom, rotação) sem polling
      const ro = new ResizeObserver(atualizar);
      ro.observe(viewport);
      window.addEventListener('load', atualizar);
      atualizar();
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  .pdp-pet-gallery {
    padding: 2.5rem 0;
    background: var(--color-surface-light, #faf3ea);
  }

  @media (min-width: 768px) {
    .pdp-pet-gallery {
      padding: 3.5rem 0;
    }
  }

  .pdp-pet-gallery__inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 1rem;
    position: relative;
  }

  @media (min-width: 768px) {
    .pdp-pet-gallery__inner {
      padding: 0 2rem;
    }
  }

  .pdp-pet-gallery__header {
    text-align: center;
    margin-bottom: 1.75rem;
  }

  .pdp-pet-gallery__eyebrow {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary, #5a4742);
    margin: 0 0 0.5rem;
  }

  .pdp-pet-gallery__title {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-on-background, #201b14);
    margin: 0;
    letter-spacing: -0.01em;
  }

  @media (min-width: 768px) {
    .pdp-pet-gallery__title {
      font-size: 1.75rem;
    }
  }

  .pdp-pet-gallery__viewport {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    margin: 0 -1rem;
    padding: 0.5rem 1rem;
  }

  .pdp-pet-gallery__viewport::-webkit-scrollbar { display: none; }

  @media (min-width: 768px) {
    .pdp-pet-gallery__viewport { margin: 0; padding: 0.5rem 0; }
  }

  .pdp-pet-gallery__track {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 768px) {
    .pdp-pet-gallery__track { gap: 1rem; }
  }

  .pdp-pet-gallery__item {
    flex: 0 0 70%;
    scroll-snap-align: start;
    aspect-ratio: 1 / 1;
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-surface-container, #f8ece0);
    box-shadow: 0 1px 3px rgba(90, 71, 66, 0.04);
  }

  @media (min-width: 600px) {
    .pdp-pet-gallery__item { flex-basis: calc((100% - 0.75rem) / 2); }
  }

  @media (min-width: 1024px) {
    .pdp-pet-gallery__item { flex-basis: calc((100% - 3rem) / 4); }
  }

  .pdp-pet-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Controles desktop ── */
  .pdp-pet-gallery__controls {
    display: none;
  }

  @media (min-width: 1024px) {
    .pdp-pet-gallery__controls {
      display: flex;
      justify-content: center;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }
  }

  .pdp-pet-gallery__nav {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--color-outline-variant, #d2c3c0);
    background: var(--color-surface, #fff);
    color: var(--color-primary, #5a4742);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .pdp-pet-gallery__nav:hover {
    background: var(--color-surface-container, #f8ece0);
  }

  .pdp-pet-gallery__nav:active {
    transform: scale(0.95);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Galeria de pets (PDP)",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Carrossel de fotos de pets usando o produto. As imagens são puxadas do metafield `custom.pet_gallery` cadastrado em cada produto no admin Shopify. Se o produto não tiver imagens no metafield, a section não aparece automaticamente."
    },
    {
      "type": "paragraph",
      "content": "Como criar o metafield: Loja online → Configurações → Custom data → Produtos → Adicionar definição. Nome: \"Galeria de pets\". Namespace e chave: custom.pet_gallery. Tipo: File reference (lista). Aceitar apenas imagens."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow (texto acima do título)",
      "default": "Da nossa comunidade"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Título",
      "default": "Pets que amam essa peça"
    }
  ],
  "presets": [
    {
      "name": "Galeria de pets (PDP)",
      "settings": {
        "eyebrow": "Da nossa comunidade",
        "title": "Pets que amam essa peça"
      }
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
