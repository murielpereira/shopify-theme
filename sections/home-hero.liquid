{% comment %} Home Hero — editorial assimétrico {% endcomment %}

{%- liquid
  # Vídeo desktop (principal).
  # Prioridade: vídeo nativo (Shopify-hosted) → URL do YouTube (legacy) → imagem fallback
  assign hero_native_video = section.settings.video
  assign hero_native_src = ''
  if hero_native_video != blank and hero_native_video.sources.size > 0
    assign hero_native_src = hero_native_video.sources[0].url
    for s in hero_native_video.sources
      if s.format == 'mp4' and s.height >= 720
        assign hero_native_src = s.url
        break
      endif
    endfor
  endif

  # Vídeo mobile (opcional — quando preenchido, usa este em telas <768px).
  # Permite enviar um corte vertical/9:16 otimizado pro celular.
  assign hero_mobile_video = section.settings.video_mobile
  assign hero_mobile_src = ''
  if hero_mobile_video != blank and hero_mobile_video.sources.size > 0
    assign hero_mobile_src = hero_mobile_video.sources[0].url
    for s in hero_mobile_video.sources
      if s.format == 'mp4' and s.height >= 720
        assign hero_mobile_src = s.url
        break
      endif
    endfor
  endif

  assign hero_video_id = ''
  assign hero_video_url = section.settings.video_url
  if hero_native_src == '' and hero_video_url != blank
    assign hero_video_str = hero_video_url | downcase
    if hero_video_str contains 'youtube.com/watch'
      assign hero_video_id = hero_video_url | split: 'v=' | last | split: '&' | first
    elsif hero_video_str contains 'youtu.be/'
      assign hero_video_id = hero_video_url | split: 'youtu.be/' | last | split: '?' | first
    endif
  endif
-%}

{%- comment -%}
  Preload do poster do vídeo hero — é o LCP candidato típico desta page.
  `fetchpriority=high` é crítico: PSI flaggou `priorityHinted: false` no
  LCP discovery, indicando que o browser estava baixando o poster com
  prioridade média (depois de scripts de apps). Com `high` ele vai pro
  topo da fila.
{%- endcomment -%}
{%- if hero_native_video.preview_image != blank -%}
  {%- if hero_mobile_video.preview_image != blank -%}
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      media="(min-width: 768px)"
      href="{{ hero_native_video.preview_image | image_url: width: 1600 }}"
    >
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      media="(max-width: 767px)"
      href="{{ hero_mobile_video.preview_image | image_url: width: 900 }}"
    >
  {%- else -%}
    <link
      rel="preload"
      as="image"
      fetchpriority="high"
      href="{{ hero_native_video.preview_image | image_url: width: 1600 }}"
    >
  {%- endif -%}
{%- endif -%}

<section class="ame-hero full-width">
  <!-- Fundo (lado direito): vídeo ou imagem -->
  <div class="ame-hero__bg">
    {%- if hero_native_src != '' -%}
      {%- comment -%}
        Renderizamos até 2 elementos <video> quando há vídeo mobile específico:
        - .ame-hero__bg-video--desktop: visível em ≥768px, oculto no mobile
        - .ame-hero__bg-video--mobile : visível em <768px, oculto no desktop
        Se mobile_src estiver vazio, só renderiza o desktop e ele cobre ambos
        (comportamento legado preservado).
        Browsers modernos não baixam o body de vídeos `display:none`, mas
        ainda podem baixar metadata — aceitável (~50KB).
      {%- endcomment -%}
      {%- comment -%}
        width/height fornecem aspect-ratio implícito pro browser antes do
        CSS aplicar (CLS fix — PSI flaggou "Media element lacking an explicit
        size"). 1600×900 = 16:9 desktop, 900×1600 = 9:16 mobile portrait.
        CSS depois sobrescreve com width:100%; height:100% absoluto.
      {%- endcomment -%}
      <video
        class="ame-hero__bg-video ame-hero__bg-video--desktop"
        src="{{ hero_native_src }}"
        width="1600"
        height="900"
        {%- if hero_native_video.preview_image != blank %}
          poster="{{ hero_native_video.preview_image | image_url: width: 1600 }}"
        {% endif -%}
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        aria-hidden="true"
      ></video>
      {%- if hero_mobile_src != '' -%}
        <video
          class="ame-hero__bg-video ame-hero__bg-video--mobile"
          src="{{ hero_mobile_src }}"
          width="900"
          height="1600"
          {%- if hero_mobile_video.preview_image != blank %}
            poster="{{ hero_mobile_video.preview_image | image_url: width: 900 }}"
          {% endif -%}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-hidden="true"
        ></video>
      {%- endif -%}
    {%- elsif hero_video_id != '' -%}
      <iframe
        class="ame-hero__bg-video"
        src="https://www.youtube-nocookie.com/embed/{{ hero_video_id }}?autoplay=1&mute=1&loop=1&playlist={{ hero_video_id }}&controls=0&disablekb=1&modestbranding=1&playsinline=1&rel=0&iv_load_policy=3&fs=0"
        frameborder="0"
        allow="autoplay; encrypted-media"
        allowfullscreen
        aria-hidden="true"
        title=""
      ></iframe>
    {%- elsif section.settings.image != blank -%}
      {%- assign hero_img_alt = section.settings.image.alt | escape -%}
      {{
        section.settings.image
        | image_url: width: 1600
        | image_tag:
          widths: '600, 1200, 1600',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'ame-hero__bg-img',
          alt: hero_img_alt
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'ame-hero__bg-img ame-hero__bg-img--placeholder' }}
    {%- endif -%}
    <div class="ame-hero__bg-fade"></div>
  </div>

  <!-- Conteúdo editorial -->
  <div class="ame-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ame-hero__eyebrow ame-fade-up ame-delay-1">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="ame-hero__title ame-fade-up ame-delay-2">
      {{ section.settings.title | newline_to_br }}
    </h1>

    {%- if section.settings.subtitle != blank -%}
      <p class="ame-hero__subtitle ame-fade-up ame-delay-3">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    <div class="ame-hero__ctas ame-fade-up ame-delay-4">
      {%- if section.settings.cta_primary_label != blank -%}
        <a href="{{ section.settings.cta_primary_url }}" class="ame-cta">
          {{ section.settings.cta_primary_label }}
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      {%- endif -%}
      {%- if section.settings.cta_secondary_label != blank -%}
        <a href="{{ section.settings.cta_secondary_url }}" class="ame-btn-secondary">
          {{ section.settings.cta_secondary_label }}
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  <!-- Indicador de scroll -->
  <div class="ame-hero__scroll-indicator ame-fade-up ame-delay-5" aria-hidden="true">
    <div class="ame-hero__scroll-line"></div>
    <span class="ame-hero__scroll-label">Scroll</span>
  </div>

  <!-- Stats -->
  <div class="ame-hero__stats ame-fade-up ame-delay-5">
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="ame-hero__stat" {{ block.shopify_attributes }}>
          <p class="ame-hero__stat-value">{{ block.settings.value }}</p>
          <p class="ame-hero__stat-label">{{ block.settings.label }}</p>
        </div>
        {%- unless forloop.last -%}
          <div class="ame-hero__stat-divider" aria-hidden="true"></div>
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
  .ame-hero {
    position: relative;
    width: 100%;
    min-height: 75svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  /* Mobile: empurra o conteúdo pro fim (canto inferior). O alinhamento à
     esquerda já vem do padding-left natural do .ame-hero__content. */
  @media (max-width: 767px) {
    .ame-hero {
      justify-content: flex-end;
    }
  }
  @media (min-width: 768px) {
    .ame-hero {
      min-height: calc(100svh - 5rem);
    }
  }

  /* Background — full width, fade cobre o lado esquerdo */
  .ame-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--color-background, #fff8f3);
  }

  .ame-hero__bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right center;
    mix-blend-mode: multiply;
    opacity: 0.8;
  }
  .ame-hero__bg-img--placeholder {
    opacity: 0.3;
  }

  /* No mobile, escondemos eyebrow + subtítulo pra liberar espaço visual
     pro vídeo de fundo. Title + CTAs continuam (essenciais), stats abaixo
     também. Se quiser voltar, é só remover este bloco. */
  @media (max-width: 767px) {
    .ame-hero__eyebrow,
    .ame-hero__subtitle {
      display: none;
    }
  }

  /* Mobile: vídeo preenche toda a section (cover). */
  .ame-hero__bg-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    border: none;
    pointer-events: none;
    opacity: 0.9;
  }
  /* Desktop: vídeo alinhado à direita, ocupando ~metade da section.
     Funciona pra vídeos verticais (9:16) sem distorção — o lado esquerdo
     fica livre pro texto do hero. object-fit:cover preenche a metade
     direita inteira, cortando bordas se necessário. */
  @media (min-width: 768px) {
    .ame-hero__bg-video {
      inset: 0 0 0 auto;
      width: 100%;
      height: 100%;
    }
  }

  /* Troca entre vídeo desktop e mobile (quando há os dois configurados).
     display:none impede o browser de baixar o body do vídeo escondido —
     só metadata é puxada (~50KB), comportamento aceitável. */
  .ame-hero__bg-video--mobile {
    display: none;
  }
  @media (max-width: 767px) {
    .ame-hero__bg-video--desktop {
      display: none;
    }
    /* Mobile-specific só aparece quando existir (renderizado condicionalmente
       no Liquid); a regra aqui ativa ele. */
    .ame-hero__bg-video--mobile {
      display: block;
    }
  }

  /* Máscara no topo — esconde o título do YouTube que aparece quando o vídeo está carregando/pausado */
  .ame-hero__bg::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4rem;
    /*
    background: linear-gradient(
      to bottom,
      var(--color-background, #fff8f3) 0%,
      color-mix(in srgb, var(--color-background, #fff8f3) 65%, transparent) 55%,
      transparent 100%
    )
    */
    z-index: 1;
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .ame-hero__bg::before {
      /* No mobile o vídeo vertical preenche a tela; o fade no topo escondia
         demais do vídeo. Removemos pra deixar o frame inicial do vídeo
         totalmente visível. */
      display: none;
    }
  }

  /* Fade cobre o lado esquerdo (conteúdo) de forma opaca e suave */
  .ame-hero__bg-fade {
    position: absolute;
    inset: 0;
    /*background: linear-gradient(
      to right,
      var(--color-background, #fff8f3) 0%,
      var(--color-background, #fff8f3) 30%,
      color-mix(in srgb, var(--color-background, #fff8f3) 45%, transparent) 45%,
      color-mix(in srgb, var(--color-background, #fff8f3) 25%, transparent) 50%,
      transparent 60%
    );*/
    background: transparent;
    z-index: 1;
  }
  @media (max-width: 767px) {
    /* Fade inferior mais sutil — só uma sombra suave embaixo pra dar
       contraste com o texto, sem cobrir tanto vídeo. */
    .ame-hero__bg-fade {
      /*background: linear-gradient(
        to top,
        color-mix(in srgb, var(--color-background, #fff8f3) 75%, transparent) 0%,
        color-mix(in srgb, var(--color-background, #fff8f3) 30%, transparent) 25%,
        transparent 50%
      );*/
      background: transparent;
    }
  }

  /* Content */
  .ame-hero__content {
    position: relative;
    z-index: 2;
    padding: 3rem 4rem;
    width: fit-content;
    background: #ffffff69;
    border-radius: 0 90px 90px 0;
    /*max-width: min(calc(var(--page-width, 120rem) / 2), 42rem);*/
  }
  @media (max-width: 767px) {
    .ame-hero__content {
      max-width: 100%;
      /* Padding-top zerado (texto fica colado no fim com justify-content:flex-end
         do .ame-hero). Padding-bottom moderado pra não colar no rodapé da section. */
      /*padding: 0 20px 2.5rem;*/
      text-align: left;
      border-radius: 0 90px 0 0;
    }
  }

  .ame-hero__eyebrow {
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(90, 71, 66, 0.55);
    margin-bottom: 1.5rem;
  }

  .ame-hero__title {
    font-size: clamp(2.25rem, 8vw, 6.5rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.025em;
    color: var(--color-on-surface-variant);
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .ame-hero__title {
      margin-bottom: 2.5rem;
      line-height: 0.92;
    }
  }
  .ame-hero__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-primary, #5a4742);
  }

  .ame-hero__subtitle {
    font-size: 0.9375rem;
    line-height: 1.75;
    color: var(--color-on-surface-variant, #4f4442);
    max-width: 28rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 768px) {
    .ame-hero__subtitle {
      font-size: 1rem;
      margin-bottom: 3.5rem;
    }
  }

  .ame-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  /* Scroll indicator */
  .ame-hero__scroll-indicator {
    display: none !important;
    position: absolute;
    bottom: 3rem;
    left: var(--page-margin, 2rem);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 1;
    color: rgba(90, 71, 66, 0.35);
  }
  @media (max-width: 767px) {
    .ame-hero__scroll-indicator {
      display: none !important;
    }
  }
  .ame-hero__scroll-line {
    width: 1px;
    height: 4rem;
    background: linear-gradient(to bottom, transparent, rgba(90, 71, 66, 0.3));
  }
  .ame-hero__scroll-label {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  /* Stats */
  .ame-hero__stats {
    position: absolute;
    bottom: 3rem;
    right: var(--page-margin, 2rem);
    display: flex;
    align-items: center;
    gap: 2rem;
    z-index: 1;
  }
  @media (max-width: 767px) {
    .ame-hero__stats {
      display: none;
    }
  }

  .ame-hero__stat {
    text-align: right;
    background: rgba(255, 248, 243, 0.72);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-radius: var(--radius-lg, 0.5rem);
    padding: 0.75rem 1rem;
  }
  .ame-hero__stat-value {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-on-background, #201b14);
  }
  .ame-hero__stat-label {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(90, 71, 66, 0.5);
    margin-top: 0.25rem;
  }
  .ame-hero__stat-divider {
    width: 1px;
    height: 2.5rem;
    background: rgba(210, 195, 192, 0.25);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero — Início",
  "tag": "section",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Vídeo de fundo — desktop",
      "info": "Upload nativo do Shopify (recomendado: MP4 horizontal 16:9, ≤ 50MB, ≥ 720p)."
    },
    {
      "type": "video",
      "id": "video_mobile",
      "label": "Vídeo de fundo — mobile (opcional)",
      "info": "Versão vertical 9:16 pro celular. Se vazio, usa o vídeo desktop em todas as resoluções."
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "URL do vídeo (YouTube — fallback)",
      "info": "Usado apenas se nenhum vídeo for enviado acima."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem de fundo (fallback)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto acima do título",
      "default": "Heritage Series — 2024"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<p>Crafted<br><em>for the</em><br>Avenue.</p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtítulo",
      "default": "Acessórios de couro toscano feitos à mão para cães que se movem com propósito."
    },
    {
      "type": "header",
      "content": "Botão primário"
    },
    {
      "type": "text",
      "id": "cta_primary_label",
      "label": "Texto",
      "default": "Explorar Coleções"
    },
    {
      "type": "url",
      "id": "cta_primary_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Botão secundário"
    },
    {
      "type": "url",
      "id": "cta_secondary_url",
      "label": "Link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estatística",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Valor",
          "default": "100%"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Rótulo",
          "default": "Couro Natural"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero — Início",
      "blocks": [
        { "type": "stat", "settings": { "value": "100%", "label": "Couro Natural" } },
        { "type": "stat", "settings": { "value": "Artesanal", "label": "Feito à Mão" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
