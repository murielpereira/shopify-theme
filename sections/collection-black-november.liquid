        <p class="bn-hero__text">{{ section.settings.hero_texto }}</p>
        {%- if abas.size > 0 -%}
          <p class="bn-hero__label">Compre por categoria</p>
          <div class="bn-chips">
            <a class="bn-chip" href="#ofertas" data-bn-go="0">{{ section.settings.titulo_todos }} <small>{{ section.settings.selo_todos }}</small></a>
            {%- assign idx = 0 -%}
            {%- for aba in abas -%}
              {%- if aba.settings.colecao != blank -%}
                {%- assign idx = idx | plus: 1 -%}
                <a class="bn-chip" href="#ofertas" data-bn-go="{{ idx }}" {{ aba.shopify_attributes }}>{{ aba.settings.titulo }} <small>{{ aba.settings.selo }}</small></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if fim_data != blank -%}
          <p class="bn-left" data-bn-left="{{ fim_data }}" hidden>Termina em <b data-bn-left-t></b></p>
        {%- endif -%}
      </div>
    </div>
  </section>

  <section id="ofertas" class="bn-section bn-offers" data-bn-offers>
    <div class="bn-wrap">
      <div class="bn-offers__top">
        <div>
          <span class="bn-eyebrow">Ofertas da Black</span>
          <h2 class="bn-h2">{{ section.settings.ofertas_titulo }}</h2>
        </div>
        <a class="bn-btn bn-btn--line" href="{{ routes.all_products_collection_url }}">Ver a loja completa</a>
      </div>

      <div class="bn-tabs" data-bn-tabs>
        <button type="button" class="bn-tab" data-bn-tab="0" aria-pressed="true">
          <span class="bn-tab__n">01</span>
          <span class="bn-tab__t">{{ section.settings.titulo_todos }}</span>
          <span class="bn-tab__s">{{ section.settings.selo_todos }}</span>
        </button>
        {%- assign idx = 0 -%}
        {%- for aba in abas -%}
