            {%- assign idx = idx | plus: 1 -%}
            <button type="button" class="bn-tab" data-bn-tab="{{ idx }}" aria-pressed="false" {{ aba.shopify_attributes }}>
              <span class="bn-tab__n">0{{ idx | plus: 1 }}</span>
