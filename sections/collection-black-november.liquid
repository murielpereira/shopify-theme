{% comment %}
  Âme — Coleção "Black November": página de campanha escura (faixa + hero + ofertas por
  aba com ordenar/filtrar por % de desconto + brinde + contagem da coleção de Natal + FAQ).
  Base: protótipo do Base44 (ame-black-pet).

  Quais produtos aparecem: os da coleção base (padrão = a coleção onde o template foi
  aplicado, a automática pela tag `black_november` que o Waltz põe/tira conforme a
  promoção Black November). Cada aba é uma coleção; só entram nela os produtos que
  TAMBÉM estão na coleção base. Lista, preço, riscado e % vêm da loja em tempo real
  (/collections/<handle>/products.json): % = maior desconto entre as variantes
  (compare_at_price x price), o mesmo que o Waltz grava ao aplicar a promoção.
{% endcomment %}

{%- liquid
  assign base_handle = section.settings.colecao_base.handle | default: collection.handle | default: 'black-november'
  assign solo_promo = section.settings.so_da_promocao
  assign fim_data = section.settings.fim_data | strip
  assign natal_data = section.settings.natal_data | strip
  assign hero_img = section.settings.hero_image
  assign natal_img = section.settings.natal_image
  assign brinde_img = section.settings.brinde_image
  assign abas = section.blocks | where: 'type', 'aba'
  assign beneficios = section.blocks | where: 'type', 'beneficio'
  assign perguntas = section.blocks | where: 'type', 'pergunta'
  assign raiz = routes.root_url
  if raiz != '/'
    assign raiz = raiz | append: '/'
  endif
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">

{%- liquid
  # Mesma regra da página Esquenta Black: com "Usar as cores do tema geral" (ou Modo de cores
  # Escuro) a página herda a paleta da loja; senão, preto + verde-limão da campanha.
  if settings.eb_usar_tema_geral or settings.modo_cores == 'escuro'
    assign bn_bg = 'var(--color-background)'
    assign bn_fg = 'var(--color-on-background)'
    assign bn_card = 'var(--color-surface-container)'
    assign bn_border = 'var(--color-outline-variant)'
    assign bn_lime = 'var(--color-primary)'
    assign bn_on_lime = 'var(--color-on-primary)'
  else
    assign bn_bg = settings.eb_bg | default: '#080808'
    assign bn_fg = settings.eb_fg | default: '#ffffff'
    assign bn_card = settings.eb_secondary | default: '#141414'
    assign bn_border = settings.eb_border | default: '#2e2e2e'
    assign bn_lime = settings.eb_lime | default: '#c8ff3d'
    assign bn_on_lime = settings.eb_on_lime | default: '#080808'
  endif
-%}

<style>
  .bn {
    --bn-bg: {{ bn_bg }};
    --bn-fg: {{ bn_fg }};
    --bn-card: {{ bn_card }};
    --bn-border: {{ bn_border }};
    --bn-lime: {{ bn_lime }};
    --bn-on-lime: {{ bn_on_lime }};
    --bn-muted: color-mix(in srgb, var(--bn-fg) 68%, transparent);
    --bn-faint: color-mix(in srgb, var(--bn-fg) 55%, transparent);
    --bn-natal: #8e1014;
    --bn-natal-deep: #5c0a0d;
    --bn-pine: #0e5b3a;
    --bn-body: 'Inter', ui-sans-serif, system-ui, sans-serif;
    --bn-display: 'Cormorant Garamond', 'Times New Roman', Georgia, serif;

    background: var(--bn-bg);
    color: var(--bn-fg);
    color-scheme: dark;
    font-family: var(--bn-body);
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  .bn *, .bn *::before, .bn *::after { box-sizing: border-box; }
  .bn ::selection { background: var(--bn-lime); color: var(--bn-on-lime); }
  :where(.bn) a { color: inherit; text-decoration: none; }
  :where(.bn) :is(h1, h2, h3, p, ul, figure) { margin: 0; padding: 0; }
  :where(.bn) ul { list-style: none; }
  :where(.bn) button, :where(.bn) select { font: inherit; color: inherit; }
  :where(.bn) button { cursor: pointer; background: none; border: 0; padding: 0; }
  .bn [hidden] { display: none !important; }
  .bn :focus-visible { outline: 2px solid var(--bn-lime); outline-offset: 3px; }

  .bn-wrap { max-width: 1400px; margin: 0 auto; padding: 0 1.25rem; }
  @media (min-width: 640px) { .bn-wrap { padding: 0 2rem; } }
  @media (min-width: 1280px) { .bn-wrap { padding: 0 4rem; } }

  .bn-eyebrow { display: block; font-size: 11px; text-transform: uppercase; letter-spacing: .38em; color: var(--bn-lime); }
  .bn-h2 { margin-top: 1rem; font-family: var(--bn-display); font-size: clamp(2.2rem, 5vw, 3.5rem); font-weight: 400; line-height: 1.02; letter-spacing: -.01em; }
  .bn-h2 em { font-style: italic; color: var(--bn-lime); }
  .bn-lead { margin-top: 1.25rem; max-width: 36rem; font-size: 16px; line-height: 1.65; color: var(--bn-muted); }
  .bn-btn { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; border-radius: 999px; background: var(--bn-lime); color: var(--bn-on-lime); padding: 1rem 1.75rem; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .2em; transition: transform .3s; }
  .bn-btn:hover { transform: translateY(-2px); }
  .bn-btn--line { background: none; color: var(--bn-lime); border: 1px solid color-mix(in srgb, var(--bn-lime) 60%, transparent); }
  .bn-btn--line:hover { background: var(--bn-lime); color: var(--bn-on-lime); }
  .bn-section { padding: 4.5rem 0; scroll-margin-top: 6rem; }
  @media (min-width: 768px) { .bn-section { padding: 6rem 0; } }

  /* Faixa que corre + contagem do fim da Black */
  .bn-marquee { overflow: hidden; background: var(--bn-lime); color: var(--bn-on-lime); padding: .875rem 0; }
  .bn-marquee__track { display: flex; width: max-content; align-items: center; gap: 2.5rem; padding-right: 2.5rem; animation: bn-marquee 38s linear infinite; }
  .bn-marquee__item { display: flex; align-items: center; gap: 2.5rem; white-space: nowrap; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .26em; }
  .bn-marquee__item::after { content: ''; width: 4px; height: 4px; border-radius: 50%; background: currentColor; opacity: .5; }
  @keyframes bn-marquee { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) { .bn-marquee__track { animation: none; } }

  /* Hero */
  .bn-hero { position: relative; isolation: isolate; display: flex; flex-direction: column; justify-content: flex-end; min-height: min(92vh, 820px); background: var(--bn-bg); }
  .bn-hero__media { position: absolute; inset: 0; z-index: -2; }
  .bn-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; display: block; }
  .bn-hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, var(--bn-bg) 2%, color-mix(in srgb, var(--bn-bg) 35%, transparent) 55%, color-mix(in srgb, var(--bn-bg) 55%, transparent)); }
  @media (min-width: 1024px) { .bn-hero::after { background: linear-gradient(to right, var(--bn-bg) 5%, color-mix(in srgb, var(--bn-bg) 70%, transparent) 45%, transparent); } }
  .bn-hero__in { width: 100%; padding-top: 7rem; padding-bottom: 3.5rem; }
  @media (min-width: 1024px) { .bn-hero__in { padding-bottom: 5rem; } }
  .bn-hero__copy { max-width: 36rem; }
  .bn-pill { display: inline-block; border-radius: 999px; background: var(--bn-lime); color: var(--bn-on-lime); padding: .4rem 1rem; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .24em; }
  .bn-hero__title { margin-top: 1rem; font-family: var(--bn-display); font-size: clamp(3.6rem, 11vw, 7rem); font-weight: 400; line-height: .86; letter-spacing: -.02em; }
  .bn-hero__title span { display: block; }
  .bn-hero__title span + span { color: var(--bn-lime); }
  .bn-hero__text { margin-top: 1.5rem; max-width: 32rem; font-size: 16px; line-height: 1.65; color: var(--bn-muted); }
  .bn-hero__text strong { font-weight: 500; color: var(--bn-fg); }
  .bn-hero__label { margin-top: 2rem; font-size: 10px; text-transform: uppercase; letter-spacing: .3em; color: var(--bn-faint); }
  .bn-chips { margin-top: .75rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  .bn-chip { display: inline-flex; align-items: baseline; gap: .5rem; border: 1px solid color-mix(in srgb, var(--bn-fg) 28%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--bn-bg) 45%, transparent); padding: .75rem 1.1rem; font-size: 11px; text-transform: uppercase; letter-spacing: .16em; transition: background .3s, color .3s, border-color .3s; }
  .bn-chip small { font-size: 9px; color: var(--bn-lime); letter-spacing: .12em; }
  .bn-chip:hover { border-color: var(--bn-lime); background: var(--bn-lime); color: var(--bn-on-lime); }
  .bn-chip:hover small { color: color-mix(in srgb, var(--bn-on-lime) 70%, transparent); }
  .bn-left { margin-top: 1.5rem; display: inline-flex; align-items: center; gap: .6rem; font-size: 11px; text-transform: uppercase; letter-spacing: .2em; color: var(--bn-faint); }
  .bn-left b { font-variant-numeric: tabular-nums; font-weight: 600; color: var(--bn-lime); letter-spacing: .08em; }

  /* Brinde */
  .bn-gift { background: var(--bn-card); }
  .bn-gift__in { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 900px) { .bn-gift__in { grid-template-columns: .9fr 1.1fr; gap: 4rem; } }
  .bn-gift__img { aspect-ratio: 4 / 5; overflow: hidden; border: 1px solid color-mix(in srgb, var(--bn-lime) 40%, transparent); }
  .bn-gift__img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .bn-steps { margin-top: 2rem; display: grid; gap: 1.25rem; }
  .bn-step { border-top: 1px solid var(--bn-border); padding-top: 1rem; }
  .bn-step b { font-family: var(--bn-display); font-size: 1.15rem; font-weight: 400; color: var(--bn-lime); }
  .bn-step p:first-of-type { margin-top: .4rem; font-size: 15px; }
  .bn-step p + p { margin-top: .35rem; font-size: 13px; line-height: 1.6; color: var(--bn-muted); }
  .bn-gift .bn-btn { margin-top: 2.25rem; }

  /* Natal */
  .bn-natal { position: relative; overflow: hidden; background: linear-gradient(160deg, var(--bn-natal), var(--bn-natal-deep)); color: #fff; }
  .bn-natal::before, .bn-natal::after { content: ''; position: absolute; border-radius: 50%; filter: blur(60px); pointer-events: none; }
  .bn-natal::before { left: -6rem; top: 4rem; width: 16rem; height: 16rem; background: rgba(255,255,255,.1); }
  .bn-natal::after { right: -5rem; bottom: 2rem; width: 14rem; height: 14rem; background: rgba(0,0,0,.25); }
  .bn-natal__in { position: relative; display: grid; gap: 2.5rem; align-items: center; z-index: 1; }
  @media (min-width: 900px) { .bn-natal__in { grid-template-columns: 1.1fr .9fr; gap: 4rem; } }
  .bn-natal__pill { display: inline-block; border-radius: 999px; background: var(--bn-pine); padding: .4rem .9rem; font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .26em; }
  .bn-natal .bn-h2 { color: #fff; }
  .bn-natal .bn-h2 em { color: #ffd9a8; }
  .bn-natal .bn-lead { color: rgba(255,255,255,.78); }
  .bn-clock { margin-top: 2rem; display: flex; gap: .6rem; }
  .bn-clock__u { min-width: 4.4rem; border: 1px solid rgba(255,255,255,.22); border-radius: 16px; background: rgba(0,0,0,.22); padding: .8rem .5rem; text-align: center; font-variant-numeric: tabular-nums; }
  .bn-clock__u b { display: block; font-family: var(--bn-display); font-size: 2.2rem; font-weight: 400; line-height: 1; }
  .bn-clock__u small { display: block; margin-top: .35rem; font-size: 9px; text-transform: uppercase; letter-spacing: .2em; color: rgba(255,255,255,.7); }
  .bn-clock__date { margin-top: 1rem; font-size: 12px; letter-spacing: .08em; color: rgba(255,255,255,.7); }
  .bn-natal__live { margin-top: 2rem; }
  .bn-notify { margin-top: 1.5rem; }
  .bn-notify .bn-btn { background: #fff; color: var(--bn-natal-deep); }
  .bn-notify__form { margin-top: 1rem; display: grid; max-width: 26rem; gap: .6rem; }
  .bn-notify__label { font-size: 11px; text-transform: uppercase; letter-spacing: .2em; color: rgba(255,255,255,.8); }
  .bn-notify__row { display: flex; gap: .5rem; }
  .bn-notify__input { width: 100%; min-width: 0; border: 1px solid rgba(255,255,255,.35); border-radius: 999px; background: rgba(0,0,0,.28); padding: .85rem 1.1rem; font-size: 14px; color: #fff; }
  .bn-notify__input::placeholder { color: rgba(255,255,255,.6); }
  .bn-notify__input:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
  .bn-notify__send { flex: none; padding: .85rem 1.25rem; }
  .bn-notify__msg { margin-top: .9rem; font-size: 14px; line-height: 1.5; color: #fff; }
  .bn-notify__msg.is-erro { color: #ffd2d2; }
  .bn-natal__img { aspect-ratio: 4 / 5; overflow: hidden; border-radius: 20px; border: 1px solid rgba(255,255,255,.18); }
  .bn-natal__img img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Benefícios e dúvidas */
  .bn-benefits { display: grid; gap: 2rem; margin-top: 2.5rem; }
  @media (min-width: 640px) { .bn-benefits { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .bn-benefits { grid-template-columns: repeat(3, 1fr); gap: 2.5rem; } }
  .bn-benefit { display: flex; gap: 1rem; }
  .bn-benefit::before { content: ''; flex: none; width: 8px; height: 8px; margin-top: .5rem; border-radius: 50%; background: var(--bn-lime); }
  .bn-benefit p:first-child { font-size: 15px; }
  .bn-benefit p + p { margin-top: .3rem; font-size: 13px; line-height: 1.6; color: var(--bn-muted); }
  .bn-faq { max-width: 52rem; margin-top: 2.5rem; border-top: 1px solid var(--bn-border); }
  .bn-faq__q { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 1rem; border-bottom: 1px solid var(--bn-border); padding: 1.25rem 0; text-align: left; font-family: var(--bn-display); font-size: clamp(1.25rem, 2.6vw, 1.6rem); line-height: 1.2; }
  .bn-faq__q::after { content: '+'; flex: none; font-family: var(--bn-body); font-size: 1.4rem; color: var(--bn-lime); transition: transform .3s; }
  .bn-faq__q[aria-expanded="true"]::after { transform: rotate(45deg); }
  .bn-faq__a { border-bottom: 1px solid var(--bn-border); padding: 0 0 1.4rem; font-size: 15px; line-height: 1.7; color: var(--bn-muted); }
</style>

<div class="bn" data-bn>

  <section class="bn-hero">
    <div class="bn-hero__media">
      {%- comment -%} Imagem própria para mobile/tablet (< 1024px, mesmo ponto em que o layout do hero muda); sem ela, usa a do desktop. {%- endcomment -%}
      {%- assign hero_img_mobile = section.settings.hero_image_mobile -%}
      {%- if hero_img_mobile != blank -%}
        <style>
          @media (max-width: 1023px) {
            .bn-hero__media img { object-position: {{ hero_img_mobile.presentation.focal_point | default: '50% 50%' }} !important; }
          }
        </style>
      {%- endif -%}
      <picture>
        {%- if hero_img_mobile != blank -%}
          <source media="(max-width: 1023px)" sizes="100vw" width="{{ hero_img_mobile.width }}" height="{{ hero_img_mobile.height }}" srcset="
            {%- for w in (1..2) -%}
              {%- assign largura = w | times: 400 | plus: 200 -%}
              {%- if largura <= hero_img_mobile.width -%}{{ hero_img_mobile | image_url: width: largura }} {{ largura }}w, {% endif -%}
            {%- endfor -%}
            {{ hero_img_mobile | image_url: width: 1400 }} 1400w">
        {%- endif -%}
        {%- if hero_img != blank -%}
          {{ hero_img | image_url: width: 1600 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '800, 1200, 1600', sizes: '100vw', alt: section.settings.hero_alt }}
        {%- else -%}
          <img src="{{ 'black-november-hero.jpg' | asset_url }}" alt="{{ section.settings.hero_alt | escape }}" width="1536" height="2752" fetchpriority="high">
        {%- endif -%}
      </picture>
    </div>
    <div class="bn-wrap bn-hero__in">
      <div class="bn-hero__copy">
        <span class="bn-pill">{{ section.settings.hero_selo }}</span>
        <h1 class="bn-hero__title"><span>{{ section.settings.titulo_1 }}</span><span>{{ section.settings.titulo_2 }}</span></h1>
        <p class="bn-hero__text">{{ section.settings.hero_texto }}</p>
        {%- if abas.size > 0 -%}
          <p class="bn-hero__label">Compre por categoria</p>
          <div class="bn-chips">
            <a class="bn-chip" href="#ofertas" data-bx-go="0">{{ section.settings.titulo_todos }} <small>{{ section.settings.selo_todos }}</small></a>
            {%- assign idx = 0 -%}
            {%- for aba in abas -%}
              {%- if aba.settings.colecao != blank -%}
                {%- assign idx = idx | plus: 1 -%}
                <a class="bn-chip" href="#ofertas" data-bx-go="{{ idx }}" {{ aba.shopify_attributes }}>{{ aba.settings.titulo }} <small>{{ aba.settings.selo }}</small></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if fim_data != blank -%}
          <p class="bn-left" data-bn-left="{{ fim_data }}" hidden>Termina em <b data-bn-left-t></b></p>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Faixa que corre: no pé do hero, logo abaixo do bloco do título. {%- endcomment -%}
    {%- if section.settings.faixa != blank -%}
      {%- assign faixa_itens = section.settings.faixa | newline_to_br | split: '<br />' -%}
      <div class="bn-marquee" aria-hidden="true">
        <div class="bn-marquee__track">
          {%- for rodada in (1..2) -%}
            {%- for item in faixa_itens -%}
              {%- assign t = item | strip -%}
              {%- if t != blank -%}<span class="bn-marquee__item">{{ t }}</span>{%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </section>

  {%- render 'bn-ofertas',
    abas: abas,
    base_handle: base_handle,
    titulo_todos: section.settings.titulo_todos,
    selo_todos: section.settings.selo_todos,
    sub_todos: section.settings.sub_todos,
    eyebrow: 'Ofertas da Black',
    titulo: section.settings.ofertas_titulo,
    so_da_promocao: solo_promo,
    so_desconto: section.settings.so_com_desconto,
    tag_gato: section.settings.tag_gato,
    por_pagina: section.settings.por_pagina,
    texto_vazio: section.settings.texto_vazio,
    p_bg: 'var(--bn-bg)', p_fg: 'var(--bn-fg)', p_card: 'var(--bn-card)', p_border: 'var(--bn-border)',
    p_accent: 'var(--bn-lime)', p_on_accent: 'var(--bn-on-lime)', p_serif: 'var(--bn-display)', p_sans: 'var(--bn-body)'
  -%}

  {%- if section.settings.brinde_show -%}
    <section id="brinde" class="bn-section bn-gift">
      <div class="bn-wrap bn-gift__in">
        {%- if brinde_img != blank -%}
          <div class="bn-gift__img">{{ brinde_img | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '500, 800, 1000', sizes: '(min-width: 900px) 40vw, 100vw', alt: section.settings.brinde_titulo }}</div>
        {%- endif -%}
        <div>
          <span class="bn-eyebrow">Brinde exclusivo</span>
          <h2 class="bn-h2">{{ section.settings.brinde_titulo }}</h2>
          <p class="bn-lead">{{ section.settings.brinde_texto }}</p>
          <div class="bn-steps">
            {%- for passo in (1..3) -%}
              {%- assign k_t = 'passo_' | append: passo | append: '_titulo' -%}
              {%- assign k_x = 'passo_' | append: passo | append: '_texto' -%}
              {%- if section.settings[k_t] != blank -%}
                <div class="bn-step"><b>0{{ passo }}</b><p>{{ section.settings[k_t] }}</p><p>{{ section.settings[k_x] }}</p></div>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <a class="bn-btn" href="#ofertas" data-bx-go="0">Comprar e garantir o brinde</a>
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if section.settings.natal_show -%}
    <section id="natal" class="bn-section bn-natal">
      <div class="bn-wrap bn-natal__in">
        <div>
          <span class="bn-natal__pill">{{ section.settings.natal_selo }}</span>
          <h2 class="bn-h2">{{ section.settings.natal_titulo }}</h2>
          <p class="bn-lead">{{ section.settings.natal_texto }}</p>
          {%- if natal_data != blank -%}
            <div data-bn-natal="{{ natal_data }}">
              <div class="bn-clock" data-bn-clock role="timer" aria-label="Contagem para o lançamento da coleção de Natal">
                <div class="bn-clock__u"><b data-u="d">00</b><small>dias</small></div>
                <div class="bn-clock__u"><b data-u="h">00</b><small>horas</small></div>
                <div class="bn-clock__u"><b data-u="m">00</b><small>min</small></div>
                <div class="bn-clock__u"><b data-u="s">00</b><small>seg</small></div>
              </div>
              {%- if section.settings.natal_data_label != blank -%}
                <p class="bn-clock__date" data-bn-clock-date>{{ section.settings.natal_data_label }}</p>
              {%- endif -%}
              {%- if section.settings.natal_lista != blank -%}
                <div class="bn-notify" data-bn-notify data-lista="{{ section.settings.natal_lista | strip | downcase }}" data-api="{{ section.settings.waltz_url | default: 'https://waltz.up.railway.app' | strip }}">
                  <button type="button" class="bn-btn" data-bn-notify-open aria-expanded="false" aria-controls="bn-notify-form">{{ section.settings.natal_aviso_botao | default: 'Avise-me quando lançar' }}</button>
                  <form class="bn-notify__form" id="bn-notify-form" data-bn-notify-form hidden novalidate>
                    <label class="bn-notify__label" for="bn-notify-email">Seu e-mail</label>
                    <div class="bn-notify__row">
                      <input class="bn-notify__input" id="bn-notify-email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="160" required placeholder="voce@email.com">
                      <button type="submit" class="bn-btn bn-notify__send">Me avisar</button>
                    </div>
                    <input class="bn-notify__input" name="nome" type="text" autocomplete="given-name" maxlength="80" placeholder="Seu nome (opcional)" aria-label="Seu nome (opcional)">
                  </form>
                  <p class="bn-notify__msg" data-bn-notify-msg role="status" aria-live="polite" hidden></p>
                </div>
              {%- endif -%}
              <div class="bn-natal__live" data-bn-natal-live hidden>
                {%- if section.settings.natal_url != blank -%}
                  <a class="bn-btn" href="{{ section.settings.natal_url }}">Ver a coleção de Natal</a>
                {%- else -%}
                  <p class="bn-lead">A coleção de Natal chegou.</p>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
        {%- if natal_img != blank -%}
          <div class="bn-natal__img">{{ natal_img | image_url: width: 900 | image_tag: loading: 'lazy', widths: '450, 700, 900', sizes: '(min-width: 900px) 40vw, 100vw', alt: section.settings.natal_titulo }}</div>
        {%- else -%}
          <div class="bn-natal__img"><img src="{{ 'black-november-natal.jpg' | asset_url }}" alt="{{ section.settings.natal_titulo | escape }}" width="1536" height="2752" loading="lazy"></div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if beneficios.size > 0 -%}
    <section class="bn-section">
      <div class="bn-wrap">
        <span class="bn-eyebrow">Por que comprar na Âme</span>
        <h2 class="bn-h2">{{ section.settings.beneficios_titulo }}</h2>
        <div class="bn-benefits">
          {%- for b in beneficios -%}
            <div class="bn-benefit" {{ b.shopify_attributes }}><div><p>{{ b.settings.titulo }}</p><p>{{ b.settings.texto }}</p></div></div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- if perguntas.size > 0 -%}
    <section id="duvidas" class="bn-section" style="padding-top:0">
      <div class="bn-wrap">
        <span class="bn-eyebrow">Dúvidas frequentes</span>
        <h2 class="bn-h2">{{ section.settings.faq_titulo }}</h2>
        <div class="bn-faq">
          {%- for q in perguntas -%}
            <div {{ q.shopify_attributes }}>
              <button type="button" class="bn-faq__q" aria-expanded="false" aria-controls="bn-a-{{ forloop.index }}">{{ q.settings.pergunta }}</button>
              <div class="bn-faq__a" id="bn-a-{{ forloop.index }}" hidden>{{ q.settings.resposta | newline_to_br }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>



<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-bn')) return;
    var $ = function (s, r) { return (r || root).querySelector(s); };
    var $$ = function (s, r) { return Array.prototype.slice.call((r || root).querySelectorAll(s)); };
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var BRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    var pad = function (n) { return String(n).padStart(2, '0'); };

    /* ---------- Contagens ---------- */
    function countdown(iso, onTick) {
      var end = Date.parse(iso);
      if (isNaN(end)) return;
      var tick = function () {
        var left = end - Date.now();
        onTick(Math.max(left, 0));
        return left > 0;
      };
      if (tick()) { var t = setInterval(function () { if (!tick()) clearInterval(t); }, 1000); }
    }

    var leftEl = $('[data-bn-left]');
    if (leftEl) {
      countdown(leftEl.getAttribute('data-bn-left'), function (ms) {
        if (ms <= 0) { leftEl.hidden = true; return; }
        leftEl.hidden = false;
        var d = Math.floor(ms / 86400000), h = Math.floor(ms % 86400000 / 3600000), m = Math.floor(ms % 3600000 / 60000);
        $('[data-bn-left-t]', leftEl).textContent = (d ? d + 'd ' : '') + pad(h) + 'h ' + pad(m) + 'min';
      });
    }

    var natal = $('[data-bn-natal]');
    if (natal) {
      var u = {};
      $$('[data-u]', natal).forEach(function (el) { u[el.getAttribute('data-u')] = el; });
      countdown(natal.getAttribute('data-bn-natal'), function (ms) {
        u.d.textContent = pad(Math.floor(ms / 86400000));
        u.h.textContent = pad(Math.floor(ms % 86400000 / 3600000));
        u.m.textContent = pad(Math.floor(ms % 3600000 / 60000));
        u.s.textContent = pad(Math.floor(ms % 60000 / 1000));
        if (ms <= 0) {
          $('[data-bn-clock]', natal).hidden = true;
          var dl = $('[data-bn-clock-date]', natal); if (dl) dl.hidden = true;
          $('[data-bn-natal-live]', natal).hidden = false;
          var nb = $('[data-bn-notify]', natal); if (nb) nb.hidden = true;
        }
      });

      /* "Avise-me quando lançar": e-mail para a lista do Waltz; o aviso sai depois que o lançamento vai ao ar. */
      var nbox = $('[data-bn-notify]', natal);
      if (nbox) {
        var nform = $('[data-bn-notify-form]', nbox), nopen = $('[data-bn-notify-open]', nbox), nmsg = $('[data-bn-notify-msg]', nbox);
        var say = function (text, erro) { nmsg.textContent = text; nmsg.classList.toggle('is-erro', !!erro); nmsg.hidden = !text; };
        nopen.addEventListener('click', function () {
          var abrir = nform.hidden;
          nform.hidden = !abrir;
          nopen.setAttribute('aria-expanded', String(abrir));
          if (abrir) $('input[name=email]', nform).focus();
        });
        nform.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = $('input[name=email]', nform).value.trim(), nome = $('input[name=nome]', nform).value.trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { say('Confira o e-mail: parece incompleto.', true); return; }
          var send = $('.bn-notify__send', nform); send.disabled = true; say('Enviando…');
          fetch(nbox.getAttribute('data-api').replace(/\/$/, '') + '/api/lancamentos/interessado', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lista: nbox.getAttribute('data-lista'), email: email, nome: nome })
          }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok && j.sucesso, erro: j.erro }; }); })
            .then(function (r) {
              if (r.ok) { nform.hidden = true; nopen.hidden = true; say('Pronto! Você vai receber um e-mail assim que a coleção chegar. 🎄'); }
              else { send.disabled = false; say(r.erro || 'Não consegui registrar agora. Tente de novo em instantes.', true); }
            })
            .catch(function () { send.disabled = false; say('Sem conexão agora. Tente de novo em instantes.', true); });
        });
      }
    }

    /* ---------- FAQ: um aberto por vez ---------- */
    var qs = $$('.bn-faq__q');
    qs.forEach(function (q) {
      q.addEventListener('click', function () {
        var open = q.getAttribute('aria-expanded') === 'true';
        qs.forEach(function (o) { o.setAttribute('aria-expanded', 'false'); document.getElementById(o.getAttribute('aria-controls')).hidden = true; });
        if (!open) { q.setAttribute('aria-expanded', 'true'); document.getElementById(q.getAttribute('aria-controls')).hidden = false; }
      });
    });
  })();
</script>

