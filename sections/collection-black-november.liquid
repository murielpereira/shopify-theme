    <div class="bn-marquee" aria-hidden="true">
      <div class="bn-marquee__track">
        {%- for rodada in (1..2) -%}
          {%- for item in faixa_itens -%}
            {%- assign t = item | strip -%}
            {%- if t != blank -%}<span class="bn-marquee__item">{{ t }}</span>{%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <section class="bn-hero">
    <div class="bn-hero__media">
      {%- if hero_img != blank -%}
