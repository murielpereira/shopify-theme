</div>

{%- comment -%} Configuração lida pelo script: as abas (a 0 é "Todos" = a coleção base). {%- endcomment -%}
<script type="application/json" data-bn-config>
  {
    "root": {{ raiz | json }},
    "base": {{ base_handle | json }},
    "soPromo": {{ solo_promo | json }},
    "tagGato": {{ section.settings.tag_gato | strip | downcase | json }},
    "porPagina": {{ section.settings.por_pagina | default: 12 | json }},
    "abas": [
      { "handle": {{ base_handle | json }}, "titulo": {{ section.settings.titulo_todos | json }}, "sub": {{ section.settings.sub_todos | json }} }
      {%- for aba in abas -%}
        {%- if aba.settings.colecao != blank -%}
          , { "handle": {{ aba.settings.colecao.handle | json }}, "titulo": {{ aba.settings.titulo | json }}, "sub": {{ aba.settings.subtitulo | json }} }
        {%- endif -%}
      {%- endfor -%}
    ],
    "vazio": {{ section.settings.texto_vazio | json }}
  }
</script>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling.previousElementSibling;
    var cfgEl = document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-bn') || !cfgEl) return;
    var cfg = JSON.parse(cfgEl.textContent);
    var $ = function (s, r) { return (r || root).querySelector(s); };
    var $$ = function (s, r) { return Array.prototype.slice.call((r || root).querySelectorAll(s)); };
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var BRL = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });
    var pad = function (n) { return String(n).padStart(2, '0'); };

    /* ---------- Contagens ---------- */
    function countdown(iso, onTick) {
      var end = Date.parse(iso);
      if (isNaN(end)) return;
      var tick = function () {
        var left = end - Date.now();
        onTick(Math.max(left, 0));
        return left > 0;
      };
      if (tick()) { var t = setInterval(function () { if (!tick()) clearInterval(t); }, 1000); }
    }

    var leftEl = $('[data-bn-left]');
    if (leftEl) {
      countdown(leftEl.getAttribute('data-bn-left'), function (ms) {
        if (ms <= 0) { leftEl.hidden = true; return; }
        leftEl.hidden = false;
        var d = Math.floor(ms / 86400000), h = Math.floor(ms % 86400000 / 3600000), m = Math.floor(ms % 3600000 / 60000);
        $('[data-bn-left-t]', leftEl).textContent = (d ? d + 'd ' : '') + pad(h) + 'h ' + pad(m) + 'min';
      });
    }

    var natal = $('[data-bn-natal]');
    if (natal) {
      var u = {};
      $$('[data-u]', natal).forEach(function (el) { u[el.getAttribute('data-u')] = el; });
      countdown(natal.getAttribute('data-bn-natal'), function (ms) {
        u.d.textContent = pad(Math.floor(ms / 86400000));
        u.h.textContent = pad(Math.floor(ms % 86400000 / 3600000));
        u.m.textContent = pad(Math.floor(ms % 3600000 / 60000));
        u.s.textContent = pad(Math.floor(ms % 60000 / 1000));
        if (ms <= 0) {
          $('[data-bn-clock]', natal).hidden = true;
          var dl = $('[data-bn-clock-date]', natal); if (dl) dl.hidden = true;
          $('[data-bn-natal-live]', natal).hidden = false;
          var nb = $('[data-bn-notify]', natal); if (nb) nb.hidden = true;
        }
      });

      /* "Avise-me quando lançar": e-mail para a lista do Waltz; o aviso sai depois que o lançamento vai ao ar. */
      var nbox = $('[data-bn-notify]', natal);
      if (nbox) {
        var nform = $('[data-bn-notify-form]', nbox), nopen = $('[data-bn-notify-open]', nbox), nmsg = $('[data-bn-notify-msg]', nbox);
        var say = function (text, erro) { nmsg.textContent = text; nmsg.classList.toggle('is-erro', !!erro); nmsg.hidden = !text; };
        nopen.addEventListener('click', function () {
          var abrir = nform.hidden;
          nform.hidden = !abrir;
          nopen.setAttribute('aria-expanded', String(abrir));
          if (abrir) $('input[name=email]', nform).focus();
        });
        nform.addEventListener('submit', function (e) {
          e.preventDefault();
          var email = $('input[name=email]', nform).value.trim(), nome = $('input[name=nome]', nform).value.trim();
          if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) { say('Confira o e-mail: parece incompleto.', true); return; }
          var send = $('.bn-notify__send', nform); send.disabled = true; say('Enviando…');
          fetch(nbox.getAttribute('data-api').replace(/\/$/, '') + '/api/lancamentos/interessado', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ lista: nbox.getAttribute('data-lista'), email: email, nome: nome })
          }).then(function (r) { return r.json().catch(function () { return {}; }).then(function (j) { return { ok: r.ok && j.sucesso, erro: j.erro }; }); })
            .then(function (r) {
              if (r.ok) { nform.hidden = true; nopen.hidden = true; say('Pronto! Você vai receber um e-mail assim que a coleção chegar. 🎄'); }
              else { send.disabled = false; say(r.erro || 'Não consegui registrar agora. Tente de novo em instantes.', true); }
            })
            .catch(function () { send.disabled = false; say('Sem conexão agora. Tente de novo em instantes.', true); });
        });
      }
    }

    /* ---------- Ofertas ---------- */
    var grid = $('[data-bn-grid]'), emptyEl = $('[data-bn-empty]'), moreBox = $('[data-bn-more]'), moreBtn = $('[data-bn-more-btn]');
    var tools = $('[data-bn-tools]'), filterBox = $('[data-bn-filter]'), sortSel = $('[data-bn-sort]');
    var countEl = $('[data-bn-count]'), titleEl = $('[data-bn-title]'), subEl = $('[data-bn-sub]');
    var tabBtns = $$('[data-bn-tab]');
    var speciesBox = $('[data-bn-species]');
    var cache = {};       // handle -> Promise<produtos[]>
    var state = { tab: 0, esp: '', pct: 0, sort: 'rel', shown: cfg.porPagina, list: [] };

    function url(handle, page) {
      return cfg.root + 'collections/' + encodeURIComponent(handle) + '/products.json?limit=250&page=' + page;
    }
    function fetchAll(handle) {
      if (cache[handle]) return cache[handle];
      cache[handle] = (function next(page, acc) {
        return fetch(url(handle, page), { headers: { Accept: 'application/json' } })
          .then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
          .then(function (j) {
            var all = acc.concat(j.products || []);
            return (j.products || []).length === 250 && page < 8 ? next(page + 1, all) : all;
          });
      })(1, []).catch(function (e) { delete cache[handle]; throw e; });
      return cache[handle];
    }

    // % = maior desconto entre as variantes; preço mostrado = o da variante que dá esse desconto.
    function norm(p, i) {
      var best = null, min = Infinity, avail = false;
      (p.variants || []).forEach(function (v) {
        var pr = parseFloat(v.price), cp = v.compare_at_price ? parseFloat(v.compare_at_price) : 0;
        if (v.available) avail = true;
        if (pr < min) min = pr;
        if (cp > pr) {
          var pct = (1 - pr / cp) * 100;
          if (!best || pct > best.pct || (pct === best.pct && pr < best.pr)) best = { pct: pct, pr: pr, cp: cp };
        }
      });
      var img = p.images && p.images.length ? p.images : (p.image ? [p.image] : []);
      var tags = (p.tags || []).map(function (t) { return String(t).toLowerCase(); });
      var gato = /gato/i.test(p.title) || (cfg.tagGato && tags.indexOf(cfg.tagGato) !== -1);
      return {
        gato: gato,
        id: p.id, i: i, handle: p.handle, title: p.title, type: p.product_type || '',
        pct: best ? Math.round(best.pct) : 0,
        por: best ? best.pr : (isFinite(min) ? min : 0), de: best ? best.cp : 0,
        avail: avail, imgs: img.slice(0, 2).map(function (m) { return m.src; })
      };
    }
    function sized(src, w) { return src.replace(/(\.[a-z]+)(\?|$)/i, '_' + w + 'x$1$2'); }

    function load(tab) {
      var aba = cfg.abas[tab];
      return Promise.all([fetchAll(cfg.base), tab ? fetchAll(aba.handle) : null]).then(function (r) {
        var base = r[0].map(norm), byId = {};
        base.forEach(function (p) { byId[p.id] = p; });
        if (!tab) return base;
        // Ordem da própria aba (ex.: mais vendidos); só o que também está na promoção.
        var out = [];
        r[1].forEach(function (p, i) {
          var item = byId[p.id] || (cfg.soPromo ? null : norm(p, i));
          if (item) out.push(Object.assign({}, item, { i: i }));
        });
        return out;
      });
    }

    function bySpecies() {
      return state.list.filter(function (p) { return !state.esp || (state.esp === 'gato') === p.gato; });
    }
    function visibleList() {
      var l = bySpecies().filter(function (p) { return !state.pct || p.pct === state.pct; });
      var by = {
        rel: function (a, b) { return a.i - b.i; },
        off: function (a, b) { return b.pct - a.pct || a.i - b.i; },
        menor: function (a, b) { return a.por - b.por; },
        maior: function (a, b) { return b.por - a.por; },
        az: function (a, b) { return a.title.localeCompare(b.title, 'pt-BR'); }
      }[state.sort];
      // Esgotado vai sempre para o fim, qualquer que seja a ordem.
      return l.sort(function (a, b) { return (b.avail - a.avail) || by(a, b); });
    }

    function el(tag, cls, text) {
      var e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text != null) e.textContent = text;
      return e;
    }

    function card(p, n) {
      var a = el('a', 'bn-card'); a.href = cfg.root + 'products/' + p.handle;
      a.style.setProperty('--bn-delay', Math.min(n, 8) * 0.05 + 's');
      var im = el('div', 'bn-card__img');
      p.imgs.forEach(function (src, k) {
        var i = el('img'); i.src = sized(src, 600); i.alt = k ? '' : p.title; i.loading = n < 4 ? 'eager' : 'lazy'; i.width = 600; i.height = 750;
        i.srcset = sized(src, 400) + ' 400w, ' + sized(src, 600) + ' 600w, ' + sized(src, 900) + ' 900w';
        i.sizes = '(min-width: 1100px) 22vw, (min-width: 768px) 30vw, 46vw';
        im.appendChild(i);
      });
      if (p.pct) im.appendChild(el('span', 'bn-card__off', p.pct + '% OFF'));
      if (!p.avail) im.appendChild(el('span', 'bn-card__soldout', 'Esgotado'));
      a.appendChild(im);
      var b = el('div', 'bn-card__body');
      if (p.type) b.appendChild(el('p', 'bn-card__type', p.type));
      b.appendChild(el('p', 'bn-card__name', p.title));
      var pr = el('p', 'bn-card__price');
      if (p.de) pr.appendChild(el('s', '', BRL.format(p.de)));
      pr.appendChild(el('b', '', BRL.format(p.por)));
      b.appendChild(pr);
      b.appendChild(el('span', 'bn-card__cta', p.avail ? 'Comprar' : 'Ver produto'));
      a.appendChild(b);
      return a;
    }

    function renderChips() {
      var counts = {};
      bySpecies().forEach(function (p) { if (p.pct) counts[p.pct] = (counts[p.pct] || 0) + 1; });
      var vals = Object.keys(counts).map(Number).sort(function (a, b) { return b - a; });
      if (state.pct && !counts[state.pct]) state.pct = 0;
      filterBox.textContent = '';
      var nGato = state.list.filter(function (p) { return p.gato; }).length, nCao = state.list.length - nGato;
      // Só oferece a separação quando a aba tem cães E gatos.
      speciesBox.hidden = !(nGato && nCao);
      if (speciesBox.hidden) state.esp = '';
      $$('[data-bn-esp]', speciesBox).forEach(function (b) {
        var v = b.getAttribute('data-bn-esp');
        b.setAttribute('aria-pressed', String(state.esp === v));
        var n = v === 'gato' ? nGato : v === 'cao' ? nCao : state.list.length;
        b.querySelector('small') && b.querySelector('small').remove();
        b.appendChild(el('small', '', '(' + n + ')'));
      });
      tools.hidden = !bySpecies().length;
      if (vals.length > 1) {
        filterBox.appendChild(el('span', 'bn-filter__label', 'Desconto'));
        [0].concat(vals).forEach(function (v) {
          var b = el('button', 'bn-pct', v ? v + '% OFF' : 'Todos');
          b.type = 'button'; b.setAttribute('aria-pressed', String(state.pct === v));
          if (v) b.appendChild(el('small', '', '(' + counts[v] + ')'));
          b.addEventListener('click', function () { state.pct = v; state.shown = cfg.porPagina; renderChips(); renderGrid(); });
          filterBox.appendChild(b);
        });
      }
    }

    function renderGrid(append) {
      var list = visibleList();
      if (!append) grid.textContent = '';
      var from = append ? grid.children.length : 0;
      var frag = document.createDocumentFragment();
      list.slice(from, state.shown).forEach(function (p, k) { frag.appendChild(card(p, append ? k : from + k)); });
      grid.appendChild(frag);
      emptyEl.hidden = list.length > 0;
      if (!list.length) emptyEl.textContent = cfg.vazio;
      countEl.hidden = !list.length;
      countEl.textContent = list.length + (list.length === 1 ? ' modelo' : ' modelos');
      var rest = list.length - state.shown;
      moreBox.hidden = rest <= 0;
      if (rest > 0) moreBtn.textContent = 'Ver mais ' + Math.min(cfg.porPagina, rest) + ' modelos';
    }

    function setTab(tab, scroll) {
      state.tab = tab; state.pct = 0; state.esp = ''; state.shown = cfg.porPagina; state.list = [];
      tabBtns.forEach(function (b) { b.setAttribute('aria-pressed', String(+b.getAttribute('data-bn-tab') === tab)); });
      titleEl.textContent = cfg.abas[tab].titulo; subEl.textContent = cfg.abas[tab].sub || '';
      grid.textContent = ''; emptyEl.hidden = true; moreBox.hidden = true; countEl.hidden = true; tools.hidden = true; speciesBox.hidden = true;
      for (var i = 0; i < 4; i++) grid.appendChild(el('div', 'bn-skel'));
      if (scroll) $('#ofertas').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      var mine = tab;
      load(tab).then(function (list) {
        if (mine !== state.tab) return;
        state.list = list; renderChips(); renderGrid();
      }).catch(function () {
        if (mine !== state.tab) return;
        grid.textContent = ''; emptyEl.hidden = false; emptyEl.textContent = '';
        emptyEl.appendChild(document.createTextNode('Não consegui carregar as ofertas agora. '));
        var a = el('a', '', 'Ver a coleção direto na loja'); a.href = cfg.root + 'collections/' + cfg.base; emptyEl.appendChild(a);
      });
    }

    tabBtns.forEach(function (b) { b.addEventListener('click', function () { setTab(+b.getAttribute('data-bn-tab'), false); }); });
    $$('[data-bn-go]').forEach(function (a) {
      a.addEventListener('click', function (e) { e.preventDefault(); setTab(+a.getAttribute('data-bn-go'), true); });
    });
    $$('[data-bn-esp]').forEach(function (b) {
      b.addEventListener('click', function () { state.esp = b.getAttribute('data-bn-esp'); state.pct = 0; state.shown = cfg.porPagina; renderChips(); renderGrid(); });
    });
    sortSel.addEventListener('change', function () { state.sort = sortSel.value; state.shown = cfg.porPagina; renderGrid(); });
    moreBtn.addEventListener('click', function () { state.shown += cfg.porPagina; renderGrid(true); });
    setTab(0, false);

    /* ---------- FAQ: um aberto por vez ---------- */
    var qs = $$('.bn-faq__q');
    qs.forEach(function (q) {
      q.addEventListener('click', function () {
        var open = q.getAttribute('aria-expanded') === 'true';
        qs.forEach(function (o) { o.setAttribute('aria-expanded', 'false'); document.getElementById(o.getAttribute('aria-controls')).hidden = true; });
        if (!open) { q.setAttribute('aria-expanded', 'true'); document.getElementById(q.getAttribute('aria-controls')).hidden = false; }
      });
    });
  })();
</script>

