{% comment %}
  Rastreamento de pedidos — usa proxy externo (Waltz/Railway ou Vercel) pra não
  expor o token da SmartEnvios no client-side. A URL e o token são definidos
  nas configurações da seção. Espera response no formato:
    { result: { tracking_code, destiny_name, destiny_city_name, destiny_uf,
                service_name, delivery_prevision, trackings: [{ date, code:{name,tracking_type}, observation }] } }
{% endcomment %}

<section
  class="ame-track"
  data-track-section
  data-api-url="{{ section.settings.api_url | escape }}"
  data-api-token="{{ section.settings.api_token | escape }}"
  data-whatsapp="{{ section.settings.whatsapp_url | escape }}"
>
  <div class="ame-track__hero">
    {%- if section.settings.eyebrow != blank -%}
      <p class="ame-eyebrow ame-eyebrow--center ame-track__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="ame-track__title">{{ section.settings.title | default: 'Acompanhe seu pedido' }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <div class="ame-track__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    <form class="ame-track__form" data-track-form novalidate>
      <label class="ame-track__field">
        <span class="material-symbols-outlined ame-track__field-icon" aria-hidden="true">search</span>
        <input
          type="text"
          name="codigo"
          id="codigo-rastreio"
          class="ame-track__input"
          placeholder="{{ section.settings.input_placeholder | default: 'Ex: SM123456789BR' }}"
          aria-label="Código de rastreamento"
          autocomplete="off"
          spellcheck="false"
          autocapitalize="characters"
        >
      </label>
      <button type="submit" class="ame-cta ame-track__submit" data-track-submit>
        <span class="ame-track__submit-label">Rastrear</span>
        <span class="ame-track__submit-loader" aria-hidden="true"></span>
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </button>
    </form>
  </div>

  {% comment %} Estado vazio (default antes da pesquisa) {% endcomment %}
  <div class="ame-track__empty" data-track-empty>
    <span class="material-symbols-outlined ame-track__empty-icon" aria-hidden="true">shopping_bag</span>
    <p class="ame-track__empty-text">{{ section.settings.empty_text | default: 'Digite seu código acima para acompanhar a entrega.' }}</p>
    {%- if section.settings.show_account_link -%}
      <p class="ame-track__empty-help">
        Não tem o código?
        <a href="{{ routes.account_url }}">Acesse sua conta</a>
        ou
        <a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener">fale conosco</a>.
      </p>
    {%- endif -%}
  </div>

  {% comment %} Resultado — JS preenche {% endcomment %}
  <div class="ame-track__result" data-track-result hidden></div>

  {% comment %} Alerta de fraude — sempre visível pra reforçar canais oficiais {% endcomment %}
  {%- if section.settings.show_alerta_golpes -%}
    <aside class="ame-track-alert" role="note" aria-labelledby="ame-track-alert-title">
      <div class="ame-track-alert__icon" aria-hidden="true">
        <span class="material-symbols-outlined">lock</span>
      </div>
      <div class="ame-track-alert__content">
        <h2 class="ame-track-alert__title" id="ame-track-alert-title">
          {{ section.settings.alerta_title | default: 'Fique atento contra golpes' }}
        </h2>
        <div class="ame-track-alert__body">
          {{ section.settings.alerta_text }}
        </div>
        {%- if section.settings.alerta_canais != blank -%}
          <p class="ame-track-alert__channels-label">Nossos canais oficiais:</p>
          <div class="ame-track-alert__channels">
            {{ section.settings.alerta_canais }}
          </div>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}

  {% comment %} Toast (copiar código) {% endcomment %}
  <div class="ame-track__toast" data-track-toast aria-live="polite" role="status"></div>
</section>

{% stylesheet %}
  .ame-track {
    padding: clamp(2rem, 5vw, 4rem) var(--page-margin, 16px);
    color: var(--color-on-background, #201b14);
    min-width: 0;
    /* Garante que nada dentro vaze e force scroll horizontal */
    overflow-x: hidden;
  }

  /* ── HERO ── */
  .ame-track__hero {
    text-align: center;
    max-width: 42rem;
    margin: 0 auto 3rem;
  }
  .ame-track__eyebrow {
    margin-bottom: 0.75rem;
  }
  .ame-track__title {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0 0 0.75rem;
    color: var(--color-on-background, #201b14);
  }
  .ame-track__subtitle {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant, #4f4442);
    line-height: 1.6;
    margin-bottom: 2rem;
  }
  .ame-track__subtitle p { margin: 0; }

  .ame-track__form {
    display: flex;
    gap: 0.5rem;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.5);
    border-radius: 999px;
    padding: 0.375rem;
    box-shadow: 0 4px 18px rgba(32, 27, 20, 0.06);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .ame-track__form:focus-within {
    border-color: var(--color-primary, #5a4742);
    box-shadow: 0 4px 22px rgba(90, 71, 66, 0.15);
  }
  .ame-track__field {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding-left: 1rem;
    min-width: 0;
  }
  .ame-track__field-icon {
    color: var(--color-on-surface-variant, #4f4442);
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  .ame-track__input {
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--color-on-background, #201b14);
    font-family: inherit;
    font-size: 16px; /* impede zoom iOS */
    padding: 0.75rem 0;
    outline: none;
    text-transform: uppercase;
    min-width: 0;
  }
  .ame-track__input::placeholder {
    color: var(--color-on-surface-variant, #8a7d7b);
    text-transform: none;
  }
  .ame-track__submit {
    flex-shrink: 0;
    position: relative;
    padding: 0.875rem 1.5rem;
    border-radius: 999px;
  }
  .ame-track__submit[disabled] {
    opacity: 0.6;
    cursor: wait;
  }
  .ame-track__submit-loader {
    display: none;
    width: 1rem;
    height: 1rem;
    border: 2px solid currentColor;
    border-top-color: transparent;
    border-radius: 50%;
    animation: ame-track-spin 0.7s linear infinite;
  }
  .ame-track__submit.is-loading .ame-track__submit-label,
  .ame-track__submit.is-loading .material-symbols-outlined {
    display: none;
  }
  .ame-track__submit.is-loading .ame-track__submit-loader {
    display: inline-block;
  }
  @keyframes ame-track-spin {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 599px) {
    .ame-track__form {
      flex-direction: column;
      border-radius: 1.25rem;
      padding: 0.75rem;
    }
    .ame-track__field {
      padding: 0.25rem 1rem;
      border-bottom: 1px solid rgba(210, 195, 192, 0.3);
      padding-bottom: 0.75rem;
      margin-bottom: 0.5rem;
    }
    .ame-track__submit {
      width: 100%;
      justify-content: center;
    }
  }

  /* ── ESTADO VAZIO ── */
  .ame-track__empty {
    text-align: center;
    padding: 3rem 1.5rem;
    color: var(--color-on-surface-variant, #4f4442);
    max-width: 28rem;
    margin: 0 auto;
  }
  .ame-track__empty[hidden] { display: none; }
  .ame-track__empty-icon {
    font-size: 4rem;
    color: rgba(210, 195, 192, 0.7);
    margin-bottom: 1rem;
  }
  .ame-track__empty-text {
    font-size: 1rem;
    margin: 0 0 0.75rem;
  }
  .ame-track__empty-help {
    font-size: 0.875rem;
    margin: 0;
  }
  .ame-track__empty-help a {
    color: var(--color-primary, #5a4742);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* ── RESULTADO ── */
  .ame-track__result {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 64rem;
    margin: 0 auto;
    min-width: 0;
  }
  .ame-track__result > * { min-width: 0; }
  .ame-track__result[hidden] { display: none; }
  @media (min-width: 900px) {
    .ame-track__result {
      grid-template-columns: 1.6fr 1fr;
      align-items: start;
    }
  }

  .ame-track-card {
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    box-shadow: 0 2px 10px rgba(32, 27, 20, 0.04);
    min-width: 0;
    overflow: hidden;
  }

  /* Header do pedido (código + badge status) */
  .ame-track-result__header {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 1.25rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(210, 195, 192, 0.4);
    min-width: 0;
  }
  .ame-track-result__code {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: var(--color-on-background, #201b14);
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: color 0.15s ease;
    max-width: 100%;
    min-width: 0;
  }
  .ame-track-result__code-text {
    flex: 1;
    min-width: 0;
    overflow-wrap: anywhere;
    text-align: left;
  }
  .ame-track-result__code:hover { color: var(--color-primary, #5a4742); }
  .ame-track-result__code .material-symbols-outlined {
    font-size: 1.125rem;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-track-result__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: rgba(248, 236, 224, 0.7);
    color: var(--color-on-background, #201b14);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .ame-track-result__badge--entregue {
    background: rgba(120, 169, 122, 0.18);
    color: #2f5f33;
  }
  .ame-track-result__badge--transito {
    background: rgba(90, 71, 66, 0.1);
    color: var(--color-primary, #5a4742);
  }
  .ame-track-result__badge .material-symbols-outlined {
    font-size: 1rem;
  }

  /* Progress steps.
     Wrapper interno .ame-track-progress__bar limita a linha (fundo e fill)
     ao espaço entre o 1º e o 3º dot — assim o fill com width:100% NÃO
     vaza pra fora do step "Entregue". */
  .ame-track-progress {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    position: relative;
    margin: 0 0 2rem;
    padding: 0;
  }
  .ame-track-progress__bar {
    position: absolute;
    top: 1.125rem;
    left: 16.666%;
    right: 16.666%;
    height: 2px;
    z-index: 0;
  }
  .ame-track-progress__line {
    position: absolute;
    inset: 0;
    background: rgba(210, 195, 192, 0.5);
  }
  .ame-track-progress__fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    background: var(--color-primary, #5a4742);
    width: 0;
    transition: width 0.6s ease;
  }
  .ame-track-progress__step {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  .ame-track-progress__dot {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-surface-container-lowest, #fff);
    border: 2px solid rgba(210, 195, 192, 0.6);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: rgba(210, 195, 192, 0.9);
    transition: all 0.3s ease;
  }
  .ame-track-progress__dot .material-symbols-outlined {
    font-size: 1.125rem;
  }
  .ame-track-progress__label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-on-surface-variant, #4f4442);
    letter-spacing: 0.03em;
  }
  .ame-track-progress__step.is-active .ame-track-progress__dot {
    background: var(--color-primary, #5a4742);
    border-color: var(--color-primary, #5a4742);
    color: #fff;
    box-shadow: 0 0 0 4px rgba(90, 71, 66, 0.1);
  }
  .ame-track-progress__step.is-active .ame-track-progress__label {
    color: var(--color-on-background, #201b14);
    font-weight: 600;
  }

  /* Timeline */
  .ame-track-timeline__title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0 0 1rem;
  }
  .ame-track-timeline {
    position: relative;
    padding-left: 1.25rem;
  }
  .ame-track-timeline__item {
    position: relative;
    padding-left: 1.5rem;
    padding-bottom: 1.5rem;
  }
  .ame-track-timeline__item::before {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.75rem;
    bottom: -0.25rem;
    width: 2px;
    background: rgba(210, 195, 192, 0.4);
  }
  .ame-track-timeline__item:last-child::before {
    display: none;
  }
  .ame-track-timeline__item::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0.375rem;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--color-surface-container-lowest, #fff);
    border: 2px solid rgba(210, 195, 192, 0.6);
    z-index: 1;
  }
  .ame-track-timeline__item--entregue::after {
    background: #78a97a;
    border-color: #78a97a;
  }
  .ame-track-timeline__item--transito::after {
    background: var(--color-primary, #5a4742);
    border-color: var(--color-primary, #5a4742);
  }
  .ame-track-timeline__item--postado::after {
    background: #d4a76a;
    border-color: #d4a76a;
  }
  .ame-track-timeline__status {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-on-background, #201b14);
    margin: 0 0 0.25rem;
  }
  .ame-track-timeline__desc {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0 0 0.375rem;
    line-height: 1.5;
  }
  .ame-track-timeline__date {
    font-size: 0.75rem;
    color: var(--color-on-surface-variant, #8a7d7b);
    font-variant-numeric: tabular-nums;
  }

  /* Side cards */
  .ame-track-side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ame-track-info {
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1rem;
    padding: 1.25rem;
  }
  .ame-track-info__header {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }
  .ame-track-info__header .material-symbols-outlined {
    width: 2rem;
    height: 2rem;
    background: rgba(248, 236, 224, 0.7);
    color: var(--color-primary, #5a4742);
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.125rem;
  }
  .ame-track-info__label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-track-info__value {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-on-background, #201b14);
    margin: 0 0 0.25rem;
  }
  .ame-track-info__sub {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0;
  }
  .ame-track-info__carrier {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  .ame-track-info__carrier-logo {
    width: 3rem;
    height: 3rem;
    object-fit: contain;
    background: #fff;
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 0.5rem;
    padding: 0.25rem;
  }
  .ame-track-info__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    margin-top: 0.75rem;
    border-top: 1px solid rgba(210, 195, 192, 0.3);
  }
  .ame-track-info__row .ame-track-info__label {
    margin-bottom: 0.25rem;
  }
  .ame-track-help {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.25rem;
    background: rgba(248, 236, 224, 0.5);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1rem;
    text-decoration: none;
    color: var(--color-primary, #5a4742);
    font-weight: 600;
    font-size: 0.9375rem;
    transition: background 0.2s ease, transform 0.15s ease;
  }
  .ame-track-help:hover {
    background: rgba(248, 236, 224, 0.85);
    transform: translateY(-1px);
  }
  .ame-track-help .material-symbols-outlined {
    color: var(--color-primary, #5a4742);
  }

  /* Erro */
  .ame-track-error {
    grid-column: 1 / -1;
    text-align: center;
    padding: 2.5rem 1.5rem;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-track-error__icon {
    font-size: 3rem;
    color: #c97b6a;
    margin-bottom: 0.75rem;
  }
  .ame-track-error__title {
    font-weight: 600;
    color: var(--color-on-background, #201b14);
    margin: 0 0 0.375rem;
  }

  /* ── ALERTA DE FRAUDE ──
     Tom âmbar sutil sobre cream — comunica "atenção" sem o vermelho/roxo
     berrante das transportadoras. Bordersuperior destacada pro olho bater. */
  .ame-track-alert {
    max-width: 64rem;
    margin: 2.5rem auto 0;
    padding: 1.25rem clamp(1rem, 3vw, 1.5rem);
    background: rgba(248, 236, 224, 0.6);
    border: 1px solid rgba(212, 167, 106, 0.35);
    border-top: 3px solid #d4a76a;
    border-radius: 1rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: start;
  }
  .ame-track-alert__icon {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: rgba(212, 167, 106, 0.2);
    color: #8a6630;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ame-track-alert__icon .material-symbols-outlined {
    font-size: 1.25rem;
  }
  .ame-track-alert__title {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    color: var(--color-on-background, #201b14);
    margin: 0 0 0.5rem;
  }
  .ame-track-alert__body {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-track-alert__body p { margin: 0 0 0.5rem; }
  .ame-track-alert__body p:last-child { margin-bottom: 0; }
  .ame-track-alert__body ul {
    margin: 0;
    padding-left: 1.25rem;
  }
  .ame-track-alert__body li {
    margin-bottom: 0.375rem;
  }
  .ame-track-alert__body li:last-child {
    margin-bottom: 0;
  }
  .ame-track-alert__body strong {
    color: var(--color-on-background, #201b14);
    font-weight: 600;
  }
  .ame-track-alert__channels-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 1rem 0 0.5rem;
  }
  .ame-track-alert__channels {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-track-alert__channels p { margin: 0 0 0.25rem; }
  .ame-track-alert__channels a {
    color: var(--color-primary, #5a4742);
    text-decoration: none;
    border-bottom: 1px solid rgba(90, 71, 66, 0.3);
    transition: border-color 0.15s ease;
  }
  .ame-track-alert__channels a:hover {
    border-bottom-color: var(--color-primary, #5a4742);
  }

  @media (max-width: 599px) {
    .ame-track-alert {
      padding: 1rem;
      gap: 0.75rem;
    }
    .ame-track-alert__icon {
      width: 2rem;
      height: 2rem;
    }
    .ame-track-alert__icon .material-symbols-outlined {
      font-size: 1rem;
    }
  }

  /* Toast */
  .ame-track__toast {
    position: fixed;
    bottom: 2rem;
    left: 50%;
    transform: translate(-50%, 1rem);
    background: var(--color-primary, #5a4742);
    color: #fff;
    padding: 0.75rem 1.25rem;
    border-radius: 999px;
    font-size: 0.875rem;
    box-shadow: 0 8px 24px rgba(32, 27, 20, 0.2);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 9999;
  }
  .ame-track__toast.is-visible {
    opacity: 1;
    transform: translate(-50%, 0);
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    const section = document.querySelector('[data-track-section]');
    if (!section) return;

    const form = section.querySelector('[data-track-form]');
    const input = section.querySelector('#codigo-rastreio');
    const submitBtn = section.querySelector('[data-track-submit]');
    const result = section.querySelector('[data-track-result]');
    const empty = section.querySelector('[data-track-empty]');
    const toast = section.querySelector('[data-track-toast]');

    const apiUrl = section.dataset.apiUrl || '';
    const apiToken = section.dataset.apiToken || '';
    const whatsapp = section.dataset.whatsapp || '';

    function escapeHTML(str) {
      if (str === null || str === undefined) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('is-visible');
      setTimeout(() => toast.classList.remove('is-visible'), 2500);
    }

    function showEmpty() {
      result.hidden = true;
      result.innerHTML = '';
      empty.hidden = false;
    }

    function setLoading(loading) {
      submitBtn.disabled = loading;
      submitBtn.classList.toggle('is-loading', loading);
      input.disabled = loading;
    }

    function carrierLogo(name) {
      if (!name) return '';
      const n = name.toLowerCase();
      if (n.includes('loggi')) return 'https://logodownload.org/wp-content/uploads/2019/07/loggi-logo-0.png';
      if (n.includes('pac')) return 'https://logodownload.org/wp-content/uploads/2017/03/pac-correios-logo-1.png';
      if (n.includes('sedex')) return 'https://logodownload.org/wp-content/uploads/2017/03/sedex-logo-1.png';
      if (n.includes('total')) return 'https://logodownload.org/wp-content/uploads/2019/09/total-express-logo-0.png';
      if (n.includes('j&t')) return 'https://images.seeklogo.com/logo-png/33/1/jt-express-logo-png_seeklogo-336498.png';
      if (n.includes('jadlog')) return 'https://logodownload.org/wp-content/uploads/2019/02/jadlog-logo-0.png';
      return '';
    }

    function eventClass(type) {
      if (type === 'DELIVERED') return 'entregue';
      if (type === 'IN TRANSIT') return 'transito';
      if (type === 'POSTED') return 'postado';
      return '';
    }

    function formatDate(iso) {
      try {
        const d = new Date(iso);
        if (isNaN(d)) return '';
        const dd = d.toLocaleDateString('pt-BR');
        const hh = d.toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' });
        return `${dd} às ${hh}`;
      } catch (e) { return ''; }
    }

    function copyCode(code) {
      const fallback = () => {
        const ta = document.createElement('textarea');
        ta.value = code;
        ta.style.position = 'fixed';
        ta.style.opacity = '0';
        document.body.appendChild(ta);
        ta.select();
        try { document.execCommand('copy'); } catch (e) {}
        document.body.removeChild(ta);
      };
      if (navigator.clipboard?.writeText) {
        navigator.clipboard.writeText(code).then(() => showToast('Código copiado!')).catch(() => { fallback(); showToast('Código copiado!'); });
      } else {
        fallback();
        showToast('Código copiado!');
      }
    }

    function renderError(msg) {
      empty.hidden = true;
      result.hidden = false;
      result.innerHTML = `
        <div class="ame-track-error">
          <span class="material-symbols-outlined ame-track-error__icon" aria-hidden="true">info</span>
          <p class="ame-track-error__title">Não conseguimos encontrar seu código</p>
          <p>${escapeHTML(msg)}</p>
          ${whatsapp ? `<p style="margin-top:1rem"><a class="ame-track-help" href="${escapeHTML(whatsapp)}" target="_blank" rel="noopener"><span class="material-symbols-outlined" aria-hidden="true">info</span>Fale com a gente</a></p>` : ''}
        </div>
      `;
    }

    function renderResult(r) {
      empty.hidden = true;
      result.hidden = false;

      const events = (r.trackings || []).slice().sort((a, b) => new Date(b.date) - new Date(a.date));
      const latest = events[0];
      const isDelivered = !!latest && latest.code?.tracking_type === 'DELIVERED';
      const isInTransit = !!latest && (latest.code?.tracking_type === 'IN TRANSIT' || events.length > 1);

      let stepPosted = false, stepTransit = false, stepDelivered = false;
      if (events.length > 0) stepPosted = true;
      if (events.length > 1 || isInTransit) stepTransit = true;
      if (isDelivered) { stepTransit = true; stepDelivered = true; }

      let fillPct = 0;
      if (stepPosted) fillPct = 0;
      if (stepTransit) fillPct = 50;
      if (stepDelivered) fillPct = 100;

      let statusBadgeClass = 'ame-track-result__badge--transito';
      let statusLabel = 'Em transito';
      let statusIcon = 'local_shipping';
      if (isDelivered) {
        statusBadgeClass = 'ame-track-result__badge--entregue';
        statusLabel = 'Entregue';
        statusIcon = 'check';
      } else if (events.length <= 1) {
        statusLabel = 'Postado';
        statusIcon = 'shopping_bag';
      }

      const previsaoData = r.delivery_prevision ? new Date(r.delivery_prevision) : null;
      const previsao = previsaoData && !isNaN(previsaoData)
        ? previsaoData.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long' })
        : 'Sob consulta';
      const previsaoEstimada = !!r.delivery_prevision_estimada;

      const timelineHTML = events.length === 0
        ? '<p style="color:var(--color-on-surface-variant);font-size:0.9375rem;">Nenhum evento registrado ainda. Volte mais tarde.</p>'
        : events.map((ev) => `
            <div class="ame-track-timeline__item ame-track-timeline__item--${eventClass(ev.code?.tracking_type)}">
              <p class="ame-track-timeline__status">${escapeHTML(ev.code?.name || '')}</p>
              ${ev.observation ? `<p class="ame-track-timeline__desc">${escapeHTML(ev.observation)}</p>` : ''}
              <p class="ame-track-timeline__date">${formatDate(ev.date)}</p>
            </div>
          `).join('');

      const logo = carrierLogo(r.service_name);

      result.innerHTML = `
        <div class="ame-track-card">
          <div class="ame-track-result__header">
            <button type="button" class="ame-track-result__code" data-copy="${escapeHTML(r.tracking_code)}" title="Copiar código">
              <span class="material-symbols-outlined" aria-hidden="true">local_shipping</span>
              <span class="ame-track-result__code-text">${escapeHTML(r.tracking_code)}</span>
              <span class="material-symbols-outlined" aria-hidden="true">content_copy</span>
            </button>
            <span class="ame-track-result__badge ${statusBadgeClass}">
              <span class="material-symbols-outlined" aria-hidden="true">${statusIcon}</span>
              ${statusLabel}
            </span>
          </div>

          <div class="ame-track-progress">
            <div class="ame-track-progress__bar">
              <div class="ame-track-progress__line"></div>
              <div class="ame-track-progress__fill" style="width: ${fillPct}%"></div>
            </div>
            <div class="ame-track-progress__step${stepPosted ? ' is-active' : ''}">
              <span class="ame-track-progress__dot"><span class="material-symbols-outlined" aria-hidden="true">shopping_bag</span></span>
              <span class="ame-track-progress__label">Postado</span>
            </div>
            <div class="ame-track-progress__step${stepTransit ? ' is-active' : ''}">
              <span class="ame-track-progress__dot"><span class="material-symbols-outlined" aria-hidden="true">local_shipping</span></span>
              <span class="ame-track-progress__label">Em rota</span>
            </div>
            <div class="ame-track-progress__step${stepDelivered ? ' is-active' : ''}">
              <span class="ame-track-progress__dot"><span class="material-symbols-outlined" aria-hidden="true">check</span></span>
              <span class="ame-track-progress__label">Entregue</span>
            </div>
          </div>

          <p class="ame-track-timeline__title">Histórico de eventos</p>
          <div class="ame-track-timeline">${timelineHTML}</div>
        </div>

        <div class="ame-track-side">
          ${r.destiny_name ? `
            <div class="ame-track-info">
              <div class="ame-track-info__header">
                <span class="material-symbols-outlined" aria-hidden="true">person</span>
                <span class="ame-track-info__label">Destinatário</span>
              </div>
              <p class="ame-track-info__value">${escapeHTML(r.destiny_name)}</p>
              ${(r.destiny_city_name || r.destiny_uf) ? `<p class="ame-track-info__sub">${escapeHTML(r.destiny_city_name || '')}${r.destiny_uf ? ' - ' + escapeHTML(r.destiny_uf) : ''}</p>` : ''}
            </div>
          ` : ''}

          <div class="ame-track-info">
            <div class="ame-track-info__header">
              <span class="material-symbols-outlined" aria-hidden="true">local_shipping</span>
              <span class="ame-track-info__label">Transportadora</span>
            </div>
            <div class="ame-track-info__carrier">
              ${logo ? `<img class="ame-track-info__carrier-logo" src="${escapeHTML(logo)}" alt="" loading="lazy">` : ''}
              <p class="ame-track-info__value" style="margin:0">${escapeHTML(r.service_name || 'Não informado')}</p>
            </div>
            <div class="ame-track-info__row">
              <div>
                <p class="ame-track-info__label">Previsão de entrega${previsaoEstimada ? ' (estimada)' : ''}</p>
                <p class="ame-track-info__value" style="margin:0">${escapeHTML(previsao)}</p>
              </div>
              <span class="material-symbols-outlined" aria-hidden="true" style="color:var(--color-primary);">info</span>
            </div>
          </div>

          ${whatsapp ? `
            <a href="${escapeHTML(whatsapp)}" target="_blank" rel="noopener" class="ame-track-help">
              <span class="material-symbols-outlined" aria-hidden="true">info</span>
              Precisa de ajuda? Fale conosco
            </a>
          ` : ''}
        </div>
      `;

      const copyBtn = result.querySelector('[data-copy]');
      copyBtn?.addEventListener('click', () => copyCode(copyBtn.dataset.copy));
    }

    // Cache pra evitar refetch quando o cliente clica de novo no mesmo código
    const cache = new Map();

    async function search(code) {
      if (!code) return;
      if (!apiUrl) {
        renderError('A URL do endpoint de rastreio não foi configurada nas opções da seção.');
        return;
      }

      setLoading(true);
      empty.hidden = true;
      result.hidden = false;
      result.innerHTML = `
        <div class="ame-track-error" style="grid-column:1 / -1;">
          <span class="ame-track__submit-loader" style="display:inline-block;width:1.75rem;height:1.75rem;border-color:var(--color-primary);border-top-color:transparent;"></span>
          <p style="margin-top:1rem;">Buscando informações...</p>
        </div>
      `;

      try {
        let data;
        if (cache.has(code)) {
          data = cache.get(code);
        } else {
          const headers = { 'Content-Type': 'application/json', 'Accept': 'application/json' };
          if (apiToken) headers.token = apiToken;
          const resp = await fetch(apiUrl, {
            method: 'POST',
            headers,
            body: JSON.stringify({ tracking_code: code })
          });
          if (!resp.ok) throw new Error('Não conseguimos contactar o servidor de rastreio. Tente novamente em instantes.');
          const json = await resp.json();
          data = json.result || json;
          if (data?.tracking_code) cache.set(code, data);
        }

        if (!data || !data.tracking_code) {
          renderError('Verifique se o código está correto. Se acabou de receber, pode levar algumas horas até estar disponível.');
          return;
        }
        renderResult(data);
      } catch (err) {
        renderError(err.message || 'Erro inesperado.');
      } finally {
        setLoading(false);
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const code = input.value.trim().toUpperCase();
      if (!code) { input.focus(); return; }
      // Atualiza URL sem reload pra permitir compartilhar link
      try {
        const url = new URL(window.location.href);
        url.searchParams.set('codigo', code);
        history.replaceState(null, '', url.toString());
      } catch (e) {}
      search(code);
    });

    // Pre-fill via querystring (?codigo=XXX) — útil pra links de email
    try {
      const params = new URLSearchParams(window.location.search);
      const initial = params.get('codigo') || params.get('code') || params.get('tracking_code');
      if (initial) {
        input.value = initial.trim().toUpperCase();
        search(input.value);
      } else {
        showEmpty();
        // Auto-focus em desktop só (no mobile abre teclado e atrapalha)
        if (window.matchMedia && window.matchMedia('(min-width: 768px)').matches) {
          input.focus();
        }
      }
    } catch (e) {
      showEmpty();
    }
  })();
{% endjavascript %}

{% schema %}
