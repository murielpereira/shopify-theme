{%- liquid
  # Tenta primeiro ler dos settings do tema (preenchidos no Customize → Footer).
  # Se vazio, faz fallback pros campos de Configurações → Marca do Shopify Admin
  # (que em algumas contas demoram a propagar pro storefront via `shop.social_*_link`).
  assign social_facebook = section.settings.social_facebook | default: shop.social_facebook_link
  assign social_instagram = section.settings.social_instagram | default: shop.social_instagram_link
  assign social_twitter = section.settings.social_twitter | default: shop.social_twitter_link
  assign social_youtube = section.settings.social_youtube | default: shop.social_youtube_link
  assign social_pinterest = section.settings.social_pinterest | default: shop.social_pinterest_link
  assign social_tiktok = section.settings.social_tiktok | default: shop.social_tiktok_link
  assign social_whatsapp = section.settings.social_whatsapp

  assign has_any_social = false
  if social_facebook != blank or social_instagram != blank or social_twitter != blank or social_youtube != blank or social_pinterest != blank or social_tiktok != blank or social_whatsapp != blank
    assign has_any_social = true
  endif
-%}
<footer class="ame-footer full-width">
  <div class="ame-footer__inner">
    <!-- Brand column -->
    <div class="ame-footer__brand">
      {%- comment -%}
        Logo do footer: configurada no schema desta section. Costuma ser a
        mesma do header, mas é uma setting separada porque o footer tem
        fundo escuro e talvez você queira uma versão clara/em branco aqui.
        Se vazio, mostra apenas o nome da loja em texto.
      {%- endcomment -%}
      <a href="{{ routes.root_url }}" class="ame-footer__logo" aria-label="{{ shop.name }}">
        {%- if section.settings.logo != blank -%}
          {%- assign logo_img_alt = section.settings.logo.alt | default: shop.name | escape -%}
          {{
            section.settings.logo
            | image_url: width: 560
            | image_tag:
              widths: '200, 400, 560',
              loading: 'lazy',
              class: 'ame-footer__logo-img',
              alt: logo_img_alt,
              width: section.settings.logo.width,
              height: section.settings.logo.height
          }}
        {%- else -%}
          <span class="ame-footer__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>
      {% if section.settings.tagline != blank %}
        <p class="ame-footer__tagline">{{ section.settings.tagline }}</p>
      {% endif %}
    </div>

    <!-- Nav columns -->
    {% if section.settings.menu_1 != blank %}
      <div class="ame-footer__nav">
        {% if section.settings.menu_1_title != blank %}
          <p class="ame-footer__nav-title">{{ section.settings.menu_1_title }}</p>
        {% endif %}
        {% for link in section.settings.menu_1.links %}
          <a href="{{ link.url }}" class="ame-footer__nav-link">{{ link.title }}</a>
        {% endfor %}
      </div>
    {% endif %}

    {% if section.settings.menu_2 != blank %}
      <div class="ame-footer__nav">
        {% if section.settings.menu_2_title != blank %}
          <p class="ame-footer__nav-title">{{ section.settings.menu_2_title }}</p>
        {% endif %}
        {% for link in section.settings.menu_2.links %}
          <a href="{{ link.url }}" class="ame-footer__nav-link">{{ link.title }}</a>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Coluna: redes sociais -->
    {% if has_any_social %}
      <div class="ame-footer__nav ame-footer__social-col">
        {% if section.settings.social_title != blank %}
          <p class="ame-footer__nav-title">{{ section.settings.social_title }}</p>
        {% endif %}
        <div class="ame-footer__social">
          {% if social_instagram != blank %}
            <a
              href="{{ social_instagram }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class="ame-footer__social-link"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
              </svg>
            </a>
          {% endif %}
          {% if social_facebook != blank %}
            <a
              href="{{ social_facebook }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              class="ame-footer__social-link"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M13.5 22v-8h2.7l.4-3.2h-3.1V8.7c0-.9.3-1.6 1.6-1.6h1.7V4.2c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3v2.4H7.4V14h2.7v8h3.4z"/>
              </svg>
            </a>
          {% endif %}
          {% if social_twitter != blank %}
            <a
              href="{{ social_twitter }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X (Twitter)"
              class="ame-footer__social-link"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M17.5 3h3.2l-7 8 8.2 10h-6.4l-5-6.5L4.7 21H1.5l7.5-8.6L1.1 3h6.6l4.5 6 5.3-6zm-1.1 16.2h1.8L7.7 4.7H5.8l10.6 14.5z"/>
              </svg>
            </a>
          {% endif %}
          {% if social_youtube != blank %}
            <a
              href="{{ social_youtube }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="ame-footer__social-link"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M21.6 7.2s-.2-1.4-.8-2c-.8-.8-1.6-.8-2-.9C16 4 12 4 12 4s-4 0-6.8.3c-.4.1-1.2.1-2 .9-.6.6-.8 2-.8 2S2 8.8 2 10.5v1.6c0 1.6.2 3.2.2 3.2s.2 1.4.8 2c.8.8 1.8.8 2.3.9 1.7.2 6.7.3 6.7.3s4 0 6.8-.3c.4-.1 1.2-.1 2-.9.6-.6.8-2 .8-2s.2-1.6.2-3.2v-1.6c0-1.6-.2-3.3-.2-3.3zM10 14.3V8.7l5.3 2.8L10 14.3z"/>
              </svg>
            </a>
          {% endif %}
          {% if social_pinterest != blank %}
            <a
              href="{{ social_pinterest }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pinterest"
              class="ame-footer__social-link"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M12 2C6.5 2 2 6.5 2 12c0 4.2 2.6 7.8 6.3 9.3-.1-.8-.2-2 0-2.9.2-.8 1.2-5.1 1.2-5.1s-.3-.6-.3-1.5c0-1.4.8-2.4 1.8-2.4.9 0 1.3.7 1.3 1.4 0 .9-.6 2.2-.8 3.4-.2 1 .5 1.9 1.5 1.9 1.8 0 3.2-1.9 3.2-4.7 0-2.4-1.8-4.2-4.3-4.2-3 0-4.7 2.2-4.7 4.5 0 .9.3 1.9.8 2.4.1.1.1.2.1.3l-.3 1.1c-.1.2-.2.2-.4.2-1.4-.6-2.2-2.7-2.2-4.3 0-3.5 2.6-6.8 7.4-6.8 3.9 0 6.9 2.8 6.9 6.5 0 3.9-2.4 7-5.8 7-1.1 0-2.2-.6-2.6-1.3l-.7 2.7c-.3 1-1 2.3-1.5 3.1.9.3 2 .4 3 .4 5.5 0 10-4.5 10-10S17.5 2 12 2z"/>
              </svg>
            </a>
          {% endif %}
          {% if social_tiktok != blank %}
            <a
              href="{{ social_tiktok }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
              class="ame-footer__social-link"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M19.6 6.4c-1.3-.3-2.4-1.1-3-2.2-.3-.6-.5-1.3-.5-2h-3v12.7c0 1.5-1.2 2.7-2.7 2.7s-2.7-1.2-2.7-2.7 1.2-2.7 2.7-2.7c.3 0 .6.1.9.2v-3.1c-.3 0-.6-.1-.9-.1-3.2 0-5.7 2.6-5.7 5.7s2.6 5.7 5.7 5.7 5.7-2.6 5.7-5.7V9.6c1.2.8 2.6 1.3 4.1 1.3v-3c-.2 0-.4 0-.6-.1z"/>
              </svg>
            </a>
          {% endif %}
          {% if social_whatsapp != blank %}
            <a
              href="{{ social_whatsapp }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="WhatsApp"
              class="ame-footer__social-link"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
                <path d="M17.5 6.5C16.1 5 14.1 4.2 12 4.2c-4.3 0-7.8 3.5-7.8 7.8 0 1.4.4 2.7 1 3.9L4 20l4.2-1.1c1.2.6 2.5 1 3.8 1 4.3 0 7.8-3.5 7.8-7.8 0-2.1-.8-4.1-2.3-5.6zM12 18.6c-1.2 0-2.4-.3-3.4-.9l-.2-.1-2.5.7.7-2.4-.2-.3c-.7-1.1-1-2.3-1-3.6 0-3.7 3-6.7 6.7-6.7 1.8 0 3.4.7 4.7 2 1.3 1.3 2 2.9 2 4.7-.1 3.7-3.1 6.6-6.8 6.6zm3.7-5c-.2-.1-1.2-.6-1.4-.7-.2-.1-.3-.1-.5.1s-.5.7-.7.8c-.1.2-.2.2-.5.1-.2-.1-.9-.3-1.7-1-.6-.6-1.1-1.3-1.2-1.5-.1-.2 0-.4.1-.5l.4-.4c.1-.1.2-.3.2-.4 0-.2 0-.3-.1-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.4c-.2 0-.4 0-.6.2-.2.2-.8.8-.8 1.9 0 1.1.8 2.2 1 2.4.1.2 1.6 2.4 3.8 3.4.5.2 1 .4 1.3.5.5.2 1 .1 1.4.1.4-.1 1.2-.5 1.4-1 .2-.5.2-.9.1-1-.1-.1-.2-.1-.4-.3z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Coluna automática: páginas cadastradas em Loja Virtual > Páginas -->
    {% if section.settings.show_pages and pages.size > 0 %}
      {%- liquid
        # Constrói uma string ",handle1,handle2," pra usar com `contains` (sem espaços)
        assign exclude_raw = section.settings.pages_exclude | default: '' | downcase | replace: ' ', ''
        assign exclude_str = ',' | append: exclude_raw | append: ','
      -%}
      {%- capture pages_html -%}
        {%- liquid
          # ⚡ Bolt: Single pass page filtering.
          # 💡 What: Use `capture` instead of iterating through `pages` twice (once to count, once to render).
          # 🎯 Why: Iterating over collections multiple times adds unnecessary template processing overhead in Liquid.
          # 📊 Impact: Reduces array iterations by 50% for page rendering in the footer.
        -%}
        {%- for p in pages -%}
          {%- assign needle = ',' | append: p.handle | append: ',' -%}
          {%- unless exclude_str contains needle -%}
            <a href="{{ p.url }}" class="ame-footer__nav-link">{{ p.title }}</a>
          {%- endunless -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- assign pages_html_stripped = pages_html | strip -%}
      {%- if pages_html_stripped != blank -%}
        <div class="ame-footer__nav">
          {% if section.settings.pages_title != blank %}
            <p class="ame-footer__nav-title">{{ section.settings.pages_title }}</p>
          {% endif %}
          {{ pages_html }}
        </div>
      {%- endif -%}
    {% endif %}

    {%- comment -%}
      Coluna de Atendimento + Dados da empresa.
      Renderiza só se ao menos um campo da empresa estiver preenchido —
      assim quem não quer essa coluna pode esvaziar tudo no admin que ela
      some sem deixar um <div> vazio no markup.
    {%- endcomment -%}
    {%- liquid
      assign company_phone = section.settings.company_phone
      assign company_email = section.settings.company_email
      assign company_hours = section.settings.company_hours
      assign company_name = section.settings.company_name
      assign company_cnpj = section.settings.company_cnpj
      assign company_address = section.settings.company_address

      assign has_company_info = false
      if company_phone != blank or company_email != blank or company_hours != blank or company_name != blank or company_cnpj != blank or company_address != blank
        assign has_company_info = true
      endif

      # Limpa o telefone pra usar no href tel: (só dígitos, sem espaço/parênteses).
      # Brasil precisa de +55 + DDD + número.
      assign phone_digits = company_phone | replace: ' ', '' | replace: '-', '' | replace: '(', '' | replace: ')', '' | replace: '+', ''
    -%}

    {%- if has_company_info -%}
      {%- comment -%}
        Layout interno: texto à esquerda + mapa à direita (desktop), empilhado
        no mobile. Wrapper .ame-footer__company-text-col agrupa tudo que é
        texto pra o grid 2-colunas funcionar sem precisar de grid-area por item.
      {%- endcomment -%}
      <div class="ame-footer__nav ame-footer__company">
        <div class="ame-footer__company-text-col">
          <p class="ame-footer__nav-title">Atendimento</p>

          {%- if company_phone != blank -%}
            <a href="tel:+55{{ phone_digits }}" class="ame-footer__nav-link">{{ company_phone }}</a>
          {%- endif -%}
          {%- if company_email != blank -%}
            <a href="mailto:{{ company_email }}" class="ame-footer__nav-link">{{ company_email }}</a>
          {%- endif -%}
          {%- if company_hours != blank -%}
            <p class="ame-footer__company-text">{{ company_hours | newline_to_br }}</p>
          {%- endif -%}

          {%- if company_name != blank or company_cnpj != blank or company_address != blank -%}
            <address class="ame-footer__company-info">
              {%- if company_name != blank -%}
                <span>{{ company_name }}</span>
              {%- endif -%}
              {%- if company_cnpj != blank -%}
                <span>CNPJ: {{ company_cnpj }}</span>
              {%- endif -%}
              {%- if company_address != blank -%}
                <span>{{ company_address | newline_to_br }}</span>
              {%- endif -%}
            </address>
          {%- endif -%}
        </div>

        {%- comment -%}
          Mapa + botões "Como chegar". O iframe usa loading="lazy", então
          o player do Google Maps só baixa quando o cliente rola até o
          rodapé — não impacta o PSI da primeira vista.
          A query é o próprio endereço (sem precisar de lat/lng nem API key).
        {%- endcomment -%}
        {%- if section.settings.show_map and section.settings.company_maps_query != blank -%}
          {%- assign maps_q = section.settings.company_maps_query | url_encode -%}
          <div class="ame-footer__map">
            <iframe
              src="https://maps.google.com/maps?q={{ maps_q }}&output=embed"
              width="100%"
              height="180"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              title="Localização da loja no mapa"
            ></iframe>
            <div class="ame-footer__map-actions">
              <a
                href="https://www.google.com/maps/dir/?api=1&destination={{ maps_q }}"
                target="_blank"
                rel="noopener noreferrer"
                class="ame-footer__map-btn"
                >Google Maps</a
              >
              <a
                href="https://waze.com/ul?q={{ maps_q }}&navigate=yes"
                target="_blank"
                rel="noopener noreferrer"
                class="ame-footer__map-btn"
                >Waze</a
              >
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <!-- Copyright + payment -->
    <div class="ame-footer__bottom">
      <p class="ame-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }}
        {{ shop.name }}. Todos os direitos reservados.
      </p>
      {% if section.settings.show_payment_icons %}
        <div class="ame-footer__payment">
          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag: class: 'ame-footer__payment-icon' }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</footer>

{% stylesheet %}
  .ame-footer {
    background: var(--color-primary, #5a4742);
    padding: 5rem var(--page-margin, 2rem);
    margin-top: 10px;
    color: var(--color-on-primary, #ffffff);
  }

  .ame-footer__inner {
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .ame-footer__inner {
      grid-template-columns: 2fr repeat(1, minmax(0, 1fr));
      gap: 3rem;
      align-items: start;
    }
  }

  @media (min-width: 1280px) {
    .ame-footer__inner {
      gap: 3rem 4rem;
    }
  }

  /* Logo wrapper — link em volta da imagem OU do texto fallback.
     inline-flex + min 24x24 garante área clicável WCAG/PSI (target-size). */
  .ame-footer__logo {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    min-width: 24px;
    margin-bottom: 1rem;
    text-decoration: none;
    color: var(--color-on-primary, #ffffff);
  }
  .ame-footer__logo-img {
    display: block;
    max-width: 12rem;
    max-height: 3rem;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  /* Fallback de texto quando não há imagem configurada. */
  .ame-footer__logo-text {
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    padding: 0.25rem 0;
  }

  .ame-footer__tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 22rem;
    margin-bottom: 1.5rem;
  }

  .ame-footer__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
  }

  .ame-footer__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.08);
    color: var(--color-on-primary, #ffffff);
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .ame-footer__social-link:hover {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.16);
  }

  .ame-footer__social-link svg {
    width: 1.125rem;
    height: 1.125rem;
  }

  .ame-footer__nav {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .ame-footer__nav-title {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 0.25rem;
  }

  .ame-footer__nav-link {
    font-size: 0.7rem;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }

  .ame-footer__nav-link:hover {
    opacity: 0.7;
  }

  /* Coluna de Atendimento / Empresa.
     Mobile: empilhado, ocupa 1 coluna do grid pai.
     Desktop: ocupa a row INTEIRA do footer (grid-column: 1 / -1) e o
     conteúdo interno fica em flex space-between — texto à esquerda,
     mapa à direita, ambos verticalmente centralizados. */
  .ame-footer__company {
    min-width: 0;
  }
  .ame-footer__company-text-col {
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  @media (min-width: 768px) {
    .ame-footer__company {
      grid-column: 1 / -1;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 2rem;
    }
    .ame-footer__company .ame-footer__map {
      margin-top: 0;
      flex-shrink: 0;
      width: min(28rem, 45%);
    }
  }
  .ame-footer__company-text {
    font-size: 0.8125rem;
    line-height: 1.55;
    margin: 0.25rem 0 0;
    opacity: 0.85;
  }
  .ame-footer__company-info {
    font-style: normal;
    font-size: 0.75rem;
    line-height: 1.6;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    opacity: 0.7;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  /* Mapa + botões de rota */
  .ame-footer__map {
    margin-top: 0.875rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ame-footer__map iframe {
    width: 100%;
    border: 0;
    border-radius: var(--radius-md, 8px);
    background: rgba(255, 255, 255, 0.05);
    /* Filtro deixa o mapa em tons mais sóbrios pra combinar com o footer escuro.
       Cliente ainda enxerga ruas/marcador, mas com paleta sutil. */
    filter: grayscale(0.25) brightness(0.95);
    transition: filter 0.25s ease;
  }
  .ame-footer__map iframe:hover {
    filter: none;
  }
  .ame-footer__map-actions {
    display: none;
    gap: 0.5rem;
  }
  .ame-footer__map-btn {
    flex: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 0.75rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--radius-md, 8px);
    background: rgba(255, 255, 255, 0.04);
    color: var(--color-on-primary, #fff);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .ame-footer__map-btn:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.4);
  }

  /* Bottom row — spans all columns */
  .ame-footer__bottom {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(210, 195, 192, 0.2);
  }

  @media (min-width: 768px) {
    .ame-footer__bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .ame-footer__copyright {
    font-size: 0.75rem;
  }

  .ame-footer__copyright a {
    color: inherit;
    text-decoration: none;
  }

  .ame-footer__payment {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .ame-footer__payment-icon {
    height: 1.5rem;
    width: auto;
    opacity: 0.4;
    transition: opacity 0.2s ease;
  }

  .ame-footer__payment-icon:hover {
    opacity: 0.7;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Rodapé",
  "settings": [
    {
