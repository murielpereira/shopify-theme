    },
    {
      "type": "text",
      "id": "social_pinterest",
      "label": "Pinterest",
      "default": "https://pinterest.com/ameacessoriospet"
    },
    {
      "type": "text",
      "id": "social_twitter",
      "label": "X (Twitter)"
    },
    {
      "type": "text",
      "id": "social_whatsapp",
      "label": "WhatsApp (link wa.me/...)",
      "default": "https://wa.me/5548991574943"
    },
    {
      "type": "header",
      "content": "Pagamento"
    },
    {
      "type": "checkbox",
