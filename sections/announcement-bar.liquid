{% comment %} Âme — Barra de anúncios rotativa (fluxo normal — some ao rolar) {% endcomment %}

{%- if section.blocks.size > 0 -%}
  {%- liquid
    assign announce_bg = section.settings.bg_color | default: settings.color_announce_bg
    assign announce_text = section.settings.text_color | default: settings.color_announce_text
  -%}
  <div
    class="ame-announce"
    role="region"
    aria-label="Anúncios"
    data-announce
    style="top: 0; --color-announce-bg: {{ announce_bg }}; --color-announce-text: {{ announce_text }};"
  >
    <div class="ame-announce__track" data-announce-track>
      {%- for block in section.blocks -%}
        <div
          class="ame-announce__slide{% if forloop.first %} ame-announce__slide--active{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="ame-announce__inner" data-announce-inner>
            {%- if block.settings.link != blank -%}
              <a href="{{ block.settings.link }}" class="ame-announce__link">
            {%- endif -%}

            {%- if block.settings.icon != blank -%}
              <span class="ame-announce__icon material-symbols-outlined" aria-hidden="true">
                {{- block.settings.icon -}}
              </span>
            {%- endif -%}

            <span class="ame-announce__text">{{ block.settings.text }}</span>

            {%- if block.settings.link != blank -%}
              </a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="ame-announce__dots" aria-hidden="true">
        {%- for block in section.blocks -%}
          <span
            class="ame-announce__dot{% if forloop.first %} ame-announce__dot--active{% endif %}"
            data-announce-dot="{{ forloop.index0 }}"
          ></span>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

<script>
  (() => {
    const slides = document.querySelectorAll('.ame-announce__slide');
    const dots   = document.querySelectorAll('[data-announce-dot]');

    const baseInterval = {{ section.settings.speed | times: 1000 }};
    const marqueeDuration = 18000;

    if (slides.length === 0) return;

    /* Cache de overflow por slide. Como o conteúdo dos slides é estático
       (server-rendered), o overflow só muda em resize. Antes mediamos a
       cada goTo() — PSI reportou 497ms de forced reflow por causa disso
       (cada medida invalidava layout do próximo paint).
       Agora medimos UMA VEZ por slide via IntersectionObserver (não força
       reflow) e remedimos só em resize debounced.
       Resultado: 0 forced reflow no caminho quente do carrossel. */
    const overflowCache = new WeakMap();

    function measureAll() {
      /* Fase 1 — writes: garante que nenhum slide está em estado
         is-marquee (que tem white-space: nowrap e infla o scrollWidth). */
      slides.forEach((slide) => slide.classList.remove('is-marquee'));

      /* Fase 2 — reads: todas as medidas em sequência sem writes no meio.
         Browser pode batchar em UM único reflow pra todo o grupo. */
      const reads = [];
      slides.forEach((slide) => {
        const inner = slide.querySelector('[data-announce-inner]');
        if (!inner) {
          reads.push({ slide, overflow: false });
          return;
        }
        reads.push({
          slide,
          slideWidth: slide.clientWidth,
          innerWidth: inner.scrollWidth,
        });
      });

      /* Fase 3 — writes: aplica resultados no cache. */
      reads.forEach((r) => {
        const overflow = r.overflow !== undefined
          ? r.overflow
          : r.innerWidth > r.slideWidth - 32;
        overflowCache.set(r.slide, overflow);
      });
    }

    function isOverflow(slide) {
      return overflowCache.get(slide) || false;
    }

    function setMarquee(slide, on) {
      slide.classList.toggle('is-marquee', on);
    }

    /* Init — mede depois das fontes carregarem pra valor correto, e tudo
       fora do caminho crítico. document.fonts.ready resolve assim que
       todas as fontes em uso na página terminaram de baixar. */
    function init() {
      measureAll();
      const first = slides[0];
      if (isOverflow(first)) setMarquee(first, true);
    }
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(init);
    } else {
      init();
    }

    let current = 0;

    if (slides.length <= 1) return;

    let timer = null;

    function goTo(next) {
      slides[current].classList.remove('ame-announce__slide--active');
      slides[current].classList.add('ame-announce__slide--exit');
      slides[current].classList.remove('is-marquee');
      dots[current]?.classList.remove('ame-announce__dot--active');

      const prev = current;
      setTimeout(() => slides[prev].classList.remove('ame-announce__slide--exit'), 500);

      current = next % slides.length;
      slides[current].classList.add('ame-announce__slide--active');
      dots[current]?.classList.add('ame-announce__dot--active');

      const overflow = isOverflow(slides[current]);
      setMarquee(slides[current], overflow);
      const duration = overflow ? marqueeDuration : baseInterval;
      clearTimeout(timer);
      timer = setTimeout(() => goTo(current + 1), duration);
    }

    /* Primeira transição: usa o cache pra decidir duration. */
    const startCadence = () => {
      const initialOverflow = isOverflow(slides[current]);
      timer = setTimeout(() => goTo(current + 1), initialOverflow ? marqueeDuration : baseInterval);
    };
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(startCadence);
    } else {
      startCadence();
    }

    /* Resize debounced via rAF — evita rodar medida múltiplas vezes durante
       um drag de janela (antes era chamado sync a cada pixel). */
    let resizeRaf = null;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(() => {
        measureAll();
        setMarquee(slides[current], isOverflow(slides[current]));
      });
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Barra de Anúncios",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Tempo por anúncio",
      "default": 5
    },
    {
      "type": "header",
      "content": "Cores"
    },
    {
      "type": "paragraph",
      "content": "Sobrescreve as cores globais da barra de anúncios definidas em Configurações do tema → Cores."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo",
      "default": "#5a4742"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Anúncio",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texto",
          "default": "Frete grátis acima de R$299"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Ícone (Material Symbols)",
          "info": "Ex: local_shipping, sell, favorite",
          "default": "local_shipping"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (opcional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Barra de Anúncios",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Frete grátis acima de R$299", "icon": "local_shipping" } },
        { "type": "announcement", "settings": { "text": "Parcelamento em até 6x sem juros", "icon": "sell" } },
        {
          "type": "announcement",
          "settings": { "text": "10% off na primeira compra · use o cupom BEMVINDO", "icon": "favorite" }
        }
      ]
    }
  ],
  "enabled_on": { "groups": ["header"] }
}
{% endschema %}
