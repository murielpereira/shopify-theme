<div class="eb full-width" id="eb-root" data-eb>
  <script>document.getElementById('eb-root').classList.add('eb-js');</script>

  {%- comment %} ───────── Hero ───────── {% endcomment -%}
  <section class="eb-hero" id="top">
    <div class="eb-hero__media" data-eb-parallax>
      {%- if hero_img != blank -%}
        {{ hero_img | image_url: width: 2000 | image_tag: widths: '800, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: 'Chihuahua branco de pelo longo com peitoral e guia de couro rosa, sentado em poltrona de veludo preto' }}
      {%- else -%}
        <img src="{{ 'esquenta-black-hero.jpg' | asset_url }}" alt="Chihuahua branco de pelo longo com peitoral e guia de couro rosa, sentado em poltrona de veludo preto" width="1600" height="900" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
    <span class="eb-hero__outline" aria-hidden="true">{{ desconto }}%</span>

    <div class="eb-wrap eb-hero__inner">
      <div class="eb-hero__content">
        <span class="eb-pill eb-hero__anim">
          <span class="eb-pill__row"><span class="eb-pill__dot"></span>{{ periodo }}</span>
          <span class="eb-pill__sub">só kits peitoral + guia</span>
        </span>
        <h1 class="eb-hero__title eb-hero__anim" style="animation-delay:.08s">
          Esquenta<br><em>Black</em> Âme
        </h1>
        <p class="eb-hero__text eb-hero__anim" style="animation-delay:.22s">Uma semana para garantir o conjunto completo em couro legítimo, costurado à mão, no tamanho do seu pet.</p>
        <div class="eb-hero__ctas">
          <a href="#kits" class="eb-btn eb-btn--lime" data-eb-go="cachorro">Ver kits para cachorro <svg class="eb-i"><use href="#eb-arrow-right"/></svg></a>
          <a href="#kits" class="eb-btn eb-btn--ghost" data-eb-go="gato">Ver kits para gato</a>
        </div>
      </div>
    </div>
  </section>

  {%- comment %} ───────── Faixa de confiança ───────── {% endcomment -%}
  <section class="eb-trust">
    <div class="eb-trust__grid">
      {%- assign trust = 'shield|Garantia de 6 meses|Em todas as peças Âme#hand|Couro legítimo|Costurado à mão, peça por peça#pin|Frete grátis|Sul e Sudeste acima de R$ 190#truck|Todo o Brasil|Entrega para todas as regiões#card|Até 6x sem juros|Ou no Pix com desconto extra#rotate|10% de cashback|De volta em toda compra' | split: '#' -%}
      {%- for t in trust -%}
        {%- assign parts = t | split: '|' -%}
        <div class="eb-trust__item">
          <svg class="eb-i"><use href="#eb-{{ parts[0] }}"/></svg>
          <div>
            <p class="eb-trust__title">{{ parts[1] }}</p>
            <p class="eb-trust__text">{{ parts[2] }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </section>

  {%- comment %} ───────── Kits ───────── {% endcomment -%}
  <section class="eb-section" id="kits" aria-labelledby="eb-kits-title">
    <div class="eb-wrap">
      <div class="eb-kits__head eb-reveal">
        <p class="eb-eyebrow">Kits do esquenta</p>
        <h2 class="eb-h2" id="eb-kits-title">Peitoral + guia, do mesmo couro</h2>
      </div>

      <div class="eb-tabs" role="group" aria-label="Filtrar kits">
        <button type="button" class="eb-tab" data-eb-tab="todos" aria-pressed="true">Todos os kits</button>
        <button type="button" class="eb-tab" data-eb-tab="cachorro" aria-pressed="false">Para cães</button>
        <button type="button" class="eb-tab" data-eb-tab="gato" aria-pressed="false">Para gatos</button>
      </div>

      {%- paginate collection.products by 50 -%}
        <div class="eb-grid" data-eb-grid>
          {%- for p in collection.products -%}
            {%- liquid
              assign kit_title = p.title
              if p.tags contains 'produto_principal'
                assign kit_title = kit_title | split: ' - ' | first
              endif

              assign kit_is_gato = false
              assign kit_title_min = p.title | downcase
              if kit_title_min contains 'gato'
                assign kit_is_gato = true
              elsif tag_gato != blank and p.tags contains tag_gato
                assign kit_is_gato = true
              endif

              # Preço e "De:" da MESMA variação (a mais barata) — mesma regra do
              # snippets/product-card.liquid, incluindo kit-bundle e kit não convertido.
              assign kit_price = p.price_min | default: p.price
              assign kit_compare = 0
              for v in p.variants
                if v.price == kit_price
                  assign kit_compare = v.compare_at_price | default: 0
                  break
                endif
              endfor
              if kit_compare == 0
                assign kit_cv = p.selected_or_first_available_variant
                if kit_cv.price == kit_price
                  assign kit_compare = kit_cv.compare_at_price | default: 0
                endif
              endif
              assign kit_comps = p.metafields.custom.kit_componentes.value
              assign kit_is_comp = false
              if kit_comps != blank and kit_comps.size > 1
                assign kit_is_comp = true
              endif
              if kit_is_comp and p.has_only_default_variant
                assign kit_price = 0
                for comp in kit_comps
                  assign comp_price = comp.price_min | default: comp.price
                  assign kit_price = kit_price | plus: comp_price
                endfor
              elsif kit_is_comp and kit_compare == 0 and p.compare_at_price_min > kit_price
                assign kit_compare = p.compare_at_price_min
              endif

              assign kit_pct = 0
              if kit_compare > kit_price
                assign kit_pct = kit_compare | minus: kit_price | times: 100 | divided_by: kit_compare | round
              endif
              assign kit_parcela = kit_price | divided_by: 6.0 | round
            -%}
            <div class="eb-reveal" style="--eb-delay: {{ forloop.index0 | at_most: 5 | times: 0.05 }}s" data-eb-card data-cat="{% if kit_is_gato %}gato{% else %}cachorro{% endif %}">
              <article class="eb-kit{% unless p.available %} eb-kit--out{% endunless %}">
                <a href="{{ p.url }}" class="eb-kit__img" tabindex="-1" aria-hidden="true">
                  {%- if p.featured_image != blank -%}
                    {{ p.featured_image | image_url: width: 700 | image_tag: widths: '350, 500, 700', sizes: '(min-width: 1024px) 400px, (min-width: 640px) 45vw, 92vw', loading: 'lazy', alt: kit_title }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {%- endif -%}
                  {%- unless p.available -%}
                    <span class="eb-kit__off eb-kit__off--out">Esgotado</span>
                  {%- elsif kit_pct > 0 -%}
                    <span class="eb-kit__off">-{{ kit_pct }}%</span>
                  {%- endunless -%}
                </a>
                <div class="eb-kit__body">
                  <div class="eb-kit__meta"><span>{% if kit_is_gato %}Para gatos{% else %}Para cães{% endif %}</span></div>
                  <h3 class="eb-kit__name">{{ kit_title }}</h3>
                  <div class="eb-kit__price">
                    {%- if kit_pct > 0 -%}
                      <p class="eb-kit__de">De <s>{{ kit_compare | money }}</s> por</p>
                    {%- endif -%}
                    <p class="eb-kit__now">{{ kit_price | money }}{% if kit_pct > 0 %}<small>com {{ kit_pct }}% OFF</small>{% endif %}</p>
                    <p class="eb-kit__parc">ou 6x de {{ kit_parcela | money }} sem juros · 10% de cashback</p>
                  </div>
                  <a href="{{ p.url }}" class="eb-kit__cta">{% if p.available %}Quero esse kit{% else %}Esgotado{% endif %} <svg class="eb-i"><use href="#eb-arrow-up-right"/></svg></a>
                </div>
              </article>
            </div>
          {%- endfor -%}
        </div>

        <div class="eb-empty" data-eb-empty {% if collection.products.size > 0 %}hidden{% endif %}>
          <p>Nenhum kit nesta categoria por enquanto.</p>
          <a href="{{ whatsapp }}" target="_blank" rel="noopener noreferrer"><svg class="eb-i"><use href="#eb-message"/></svg> Falar com a gente</a>
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="eb-more" aria-label="Mais kits">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}#kits">Anteriores</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}#kits">Ver mais kits</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </section>

  {%- comment %} ───────── Como aproveitar ───────── {% endcomment -%}
  <section class="eb-steps" id="cupom">
    <div class="eb-wrap">
      <div class="eb-steps__grid">
        <div>
          <div class="eb-reveal">
            <p class="eb-eyebrow">Como aproveitar</p>
            <h2 class="eb-h2">{{ desconto }}% OFF em três passos</h2>
          </div>
          <div class="eb-steps__list">
            <div class="eb-step eb-reveal">
              <span class="eb-step__n">1</span>
              <div><h3>Escolha o kit</h3><p>Peitoral + guia para cães ou gatos, no tamanho e no estilo do seu pet.</p></div>
            </div>
            <div class="eb-step eb-reveal" style="--eb-delay:.07s">
              <span class="eb-step__n">2</span>
              <div><h3>Desconto já no preço</h3><p>Os {{ desconto }}% já estão aplicados no valor de cada kit, é só escolher o seu.</p></div>
            </div>
            <div class="eb-step eb-reveal" style="--eb-delay:.14s">
              <span class="eb-step__n">3</span>
              <div><h3>Pague como quiser</h3><p>No Pix com desconto extra ou em até 6x sem juros, e ainda receba 10% de cashback.</p></div>
            </div>
          </div>
          <div class="eb-steps__ctas eb-reveal" style="--eb-delay:.2s">
            <a href="#kits" class="eb-btn eb-btn--lime" data-eb-go="cachorro">Ver kits com {{ desconto }}% OFF <svg class="eb-i"><use href="#eb-arrow-right"/></svg></a>
            <a href="{{ whatsapp }}" target="_blank" rel="noopener noreferrer" class="eb-btn eb-btn--ghost">Tirar dúvidas</a>
          </div>
        </div>
        <div class="eb-rules-col eb-reveal" style="--eb-delay:.1s">
          <div class="eb-rules">
            <ul>
              <li>· Válido de {{ periodo }}, somente para kits de peitoral + guia.</li>
              <li>· Vale para modelos de cachorro e de gato, em todos os tamanhos.</li>
              <li>· Coleiras, pingentes e acessórios avulsos ficam fora do esquenta.</li>
              <li>· Enquanto durar o estoque de cada modelo.</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment %} ───────── Os kits na vida real ───────── {% endcomment -%}
  <section class="eb-section">
    <div class="eb-wrap">
      <div class="eb-split eb-reveal">
        <div style="max-width:42rem">
          <p class="eb-eyebrow">Feito à mão, aprovado por quem usa</p>
          <h2 class="eb-h2">Os kits na vida real</h2>
        </div>
        <div class="eb-rating">
          <span class="eb-stars">{% for i in (1..5) %}<svg class="eb-i"><use href="#eb-star"/></svg>{% endfor %}</span>
          <span>4,9 de 5 nas avaliações da loja</span>
        </div>
      </div>

      <div class="eb-gallery">
        {%- assign galeria = 'kit_peitoral_e_guia_de_couro_para_cachorro_com_asas_de_borboleta_tereza.jpg|Cachorro usando o Kit Tereza, peitoral e guia de couro com borboletas|Kit Tereza#kit_peitoral_e_guia_de_couro_para_cachorro_com_pedraria_rhaenyra.jpg|Cachorro usando o Kit Rhaenyra, peitoral e guia de couro com pedraria|Kit Rhaenyra#kit-gabriel1.jpg|Cachorro usando o Kit Gabriel, peitoral e guia de couro com asas de anjo|Kit Gabriel#cecilia-gato-2-0c460d55adbf8d095217696927986776-640-0.jpg|Gato usando o Kit Cecília para gatos, peitoral de couro com fecho anti-pânico|Kit Cecília para gatos#cachorro_usando_coleira_personalizada_de_couro_com_nome_shitzu.jpg|Cachorro usando acessório de couro personalizado da Âme Acessórios Pet|Personalizado com o nome#1_89be4723-00a7-4937-8457-30af8e53d3ae.jpg|Detalhe do Kit Meg, peitoral e guia de couro com strass|Kit Meg em detalhe' | split: '#' -%}
        {%- for g in galeria -%}
          {%- assign gp = g | split: '|' -%}
