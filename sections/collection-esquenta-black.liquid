<div class="eb full-width" id="eb-root" data-eb>
  <script>document.getElementById('eb-root').classList.add('eb-js');</script>

  {%- comment %} ───────── Faixa da campanha + contagem ───────── {% endcomment -%}
  <div class="eb-bar">
    <div class="eb-bar__in">
      <span>Esquenta Black</span>
      <span class="eb-bar__sep">•</span>
      <span>{{ desconto }}% off em todos os kits</span>
      <span class="eb-bar__sep">•</span>
      <span class="eb-bar__period">{{ periodo }}</span>
    </div>
  </div>
  <div class="eb-count" data-eb-count="{{ fim_data | escape }}">
    <div class="eb-count__in">
      <span class="eb-count__label" data-eb-count-label>Termina em</span>
      <div class="eb-count__units" data-eb-count-units>
        <span class="eb-count__unit"><b data-u="d">--</b><small>dias</small></span>
        <span class="eb-count__unit"><b data-u="h">--</b><small>horas</small></span>
        <span class="eb-count__unit"><b data-u="m">--</b><small>min</small></span>
        <span class="eb-count__unit"><b data-u="s">--</b><small>seg</small></span>
      </div>
      <span class="eb-count__end" data-eb-count-end hidden>{{ fim_label }}</span>
    </div>
  </div>

  {%- comment %} ───────── Hero ───────── {% endcomment -%}
  <section class="eb-hero" id="top">
    <div class="eb-hero__media">
      {%- if hero_img != blank -%}
        {{ hero_img | image_url: width: 2000 | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: 'Cachorro usando peitoral e guia de couro no Esquenta Black' }}
      {%- else -%}
        <img
          src="{{ 'esquenta-black-hero.jpg' | asset_img_url: '1200x' }}"
          srcset="{{ 'esquenta-black-hero.jpg' | asset_img_url: '600x' }} 600w, {{ 'esquenta-black-hero.jpg' | asset_img_url: '900x' }} 900w, {{ 'esquenta-black-hero.jpg' | asset_img_url: '1200x' }} 1200w, {{ 'esquenta-black-hero.jpg' | asset_url }} 1536w"
          sizes="100vw" alt="Cachorro usando peitoral e guia de couro no Esquenta Black"
          width="1536" height="2752" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>

    <div class="eb-hero__badges">
      {%- assign badges = 'hand|Couro legítimo#truck|Todo o Brasil#shield|Compra segura#card|6x sem juros#badge-percent|' | append: desconto | append: '% off' | split: '#' -%}
      {%- for b in badges -%}
        {%- assign bp = b | split: '|' -%}
        <span class="eb-hero__badge"><svg class="eb-i"><use href="#eb-{{ bp[0] }}"/></svg>{{ bp[1] }}</span>
      {%- endfor -%}
    </div>

    <div class="eb-hero__shade"></div>

    <div class="eb-hero__content">
      <div class="eb-hero__box">
        <span class="eb-hero__kicker">Esquenta Black</span>
        <p class="eb-hero__until">até {{ fim_label }}</p>
        <h1 class="eb-hero__title">Kits com {{ desconto }}% off</h1>
        <p class="eb-hero__text">Peitoral e guia em couro legítimo, feitos à mão, com troca de tamanho grátis.</p>
      </div>
    </div>
  </section>

  {%- comment %} ───────── Kits ───────── {% endcomment -%}
  <section class="eb-kits" id="kits" aria-label="Kits do Esquenta Black">
    <div class="eb-wrap">
      <div class="eb-head eb-reveal">
        <span class="eb-eyebrow">{{ desconto }}% off já aplicado</span>
      </div>

      <div class="eb-tabs" role="group" aria-label="Filtrar kits" data-active="cachorro" data-eb-tabs>
        <span class="eb-tabs__pill" aria-hidden="true"></span>
        <button type="button" class="eb-tab" data-eb-tab="cachorro" aria-pressed="true">Para cães</button>
        <button type="button" class="eb-tab" data-eb-tab="gato" aria-pressed="false">Para gatos</button>
      </div>

      {%- paginate collection.products by 50 -%}
        <div class="eb-grid" data-eb-grid>
          {%- for p in collection.products -%}
            {%- liquid
              assign kit_title = p.title
              if p.tags contains 'produto_principal'
                assign kit_title = kit_title | split: ' - ' | first
              endif

              assign kit_is_gato = false
              assign kit_title_min = p.title | downcase
              if kit_title_min contains 'gato'
                assign kit_is_gato = true
              elsif tag_gato != blank and p.tags contains tag_gato
                assign kit_is_gato = true
              endif

              # Preço e "De:" da MESMA variação (a mais barata) — mesma regra do
              # snippets/product-card.liquid, incluindo kit-bundle e kit não convertido.
              assign kit_price = p.price_min | default: p.price
              assign kit_compare = 0
              for v in p.variants
                if v.price == kit_price
                  assign kit_compare = v.compare_at_price | default: 0
                  break
                endif
              endfor
              if kit_compare == 0
                assign kit_cv = p.selected_or_first_available_variant
                if kit_cv.price == kit_price
                  assign kit_compare = kit_cv.compare_at_price | default: 0
                endif
              endif
              assign kit_comps = p.metafields.custom.kit_componentes.value
              assign kit_is_comp = false
              if kit_comps != blank and kit_comps.size > 1
                assign kit_is_comp = true
              endif
              if kit_is_comp and p.has_only_default_variant
                assign kit_price = 0
                for comp in kit_comps
                  assign comp_price = comp.price_min | default: comp.price
                  assign kit_price = kit_price | plus: comp_price
                endfor
              elsif kit_is_comp and kit_compare == 0 and p.compare_at_price_min > kit_price
                assign kit_compare = p.compare_at_price_min
              endif

              assign kit_pct = 0
              if kit_compare > kit_price
                assign kit_pct = kit_compare | minus: kit_price | times: 100 | divided_by: kit_compare | round
              endif
              assign kit_cashback = kit_price | divided_by: 10
            -%}
            <div data-eb-card data-cat="{% if kit_is_gato %}gato{% else %}cachorro{% endif %}"{% if kit_is_gato %} hidden{% endif %}>
              <article class="eb-kit{% unless p.available %} eb-kit--out{% endunless %}">
                <a href="{{ p.url }}" class="eb-kit__img" tabindex="-1" aria-hidden="true">
                  <span>
                    {%- if p.featured_image != blank -%}
                      {{ p.featured_image | image_url: width: 700 | image_tag: widths: '300, 450, 600, 700', sizes: '(min-width: 1024px) 30vw, 46vw', loading: 'lazy', alt: kit_title }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </span>
                  {%- unless p.available -%}
                    <span class="eb-kit__off eb-kit__off--out">Esgotado</span>
                  {%- elsif kit_pct > 0 -%}
                    <span class="eb-kit__off">{{ kit_pct }}% off</span>
                  {%- endunless -%}
                </a>
                <div class="eb-kit__body">
                  <h3 class="eb-kit__name"><a href="{{ p.url }}">{{ kit_title }}</a></h3>
                  <p class="eb-kit__desc">Peitoral + Guia</p>
                  <div class="eb-kit__price">
                    <div class="eb-kit__row">
                      <span class="eb-kit__now">{{ kit_price | money }}</span>
                      {%- if kit_pct > 0 -%}<s class="eb-kit__de">{{ kit_compare | money }}</s>{%- endif -%}
                    </div>
                    {%- if kit_pct > 0 -%}
                      <p class="eb-kit__save">Você economiza {{ kit_compare | minus: kit_price | money }}</p>
                    {%- endif -%}
                    <p class="eb-kit__cash">Cashback de {{ kit_cashback | money }}</p>
                    <a href="{{ p.url }}" class="eb-kit__cta">
                      {%- if p.available -%}Comprar{% if kit_pct > 0 %} com {{ kit_pct }}% off{% endif %}{%- else -%}Esgotado{%- endif -%}
                      <svg class="eb-i"><use href="#eb-arrow-up-right"/></svg>
                    </a>
                  </div>
                </div>
              </article>
            </div>
          {%- endfor -%}
        </div>

        <p class="eb-empty" data-eb-empty hidden>Novos kits chegando em instantes.</p>

        {%- if paginate.pages > 1 -%}
          <nav class="eb-more" aria-label="Mais kits">
            {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}#kits">Anteriores</a>{%- endif -%}
            {%- if paginate.next -%}<a href="{{ paginate.next.url }}#kits">Ver mais kits</a>{%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}

      <p class="eb-kits__note">Preços com {{ desconto }}% de desconto já aplicados · oferta válida de {{ periodo }}</p>
    </div>
  </section>

  {%- comment %} ───────── Avaliações ───────── {% endcomment -%}
  {%- if section.settings.show_depoimentos -%}
    <section class="eb-section eb-reviews" id="depoimentos">
      <div class="eb-wrap">
        <div class="eb-head eb-reveal">
          <span class="eb-eyebrow">Avaliações reais da loja oficial</span>
          <h2 class="eb-h2">Aprovado por quem usa <em>todo dia</em></h2>
          <p class="eb-reviews__lead">Fotos, notas e comentários enviados por tutores de cães e gatos depois de receber o kit da Âme Acessórios Pet.</p>
          <div class="eb-rating">
            <span class="eb-stars">{% for i in (1..5) %}<svg class="eb-i"><use href="#eb-star"/></svg>{% endfor %}</span>
            <span class="eb-rating__n">4,9</span>
            <span class="eb-rating__t">5.929 avaliações verificadas na loja oficial</span>
          </div>
        </div>

        {%- comment -%}
          kit | espécie | nota | nº avaliações | % recomendam | resumo | fotos (separadas por "," — "asset:" = arquivo do tema) | handle
        {%- endcomment -%}
        {%- capture kit_reviews -%}
Kit Rhaenyra|Para cães|5,0|35|97|Elogiam o brilho das pedras aplicadas à mão, a maciez do couro legítimo e o visual sofisticado do conjunto nos passeios.|asset:esquenta-black-rhaenyra.jpg|kit-rhaenyra#
Kit Tereza|Para cães|4,9|48|94|Elogiam a qualidade dos materiais e do acabamento, destacando o couro, a boa construção e a durabilidade do conjunto.|https://uploads.konfidency.com.br/73d87c13-7fb9-42e6-a663-47a8c2b9c605,https://uploads.konfidency.com.br/f7913875-7c79-437c-8e4c-9d45108948e1,https://uploads.konfidency.com.br/9ffdcc16-63fc-4001-9e69-eb2037de8410|kit-tereza#
Kit Meg|Para cães|4,9|66|92|Elogiam o visual lindo e elegante, os detalhes de strass, a qualidade do couro e das ferragens e o conforto para os pets.|https://uploads.konfidency.com.br/bcf8e0fd-6a1d-4e36-81a9-2cb2e44892b1,asset:esquenta-black-meg.png,https://uploads.konfidency.com.br/thumbs/828ed266-013b-444e-a8d5-4436d7623a0d.0000000.jpg|kit-meg#
Kit Lili|Para cães|5,0|21|96|Destacam o design delicado com corações de metal, a tira contrastante e a liberdade de combinar cores no conjunto.|asset:esquenta-black-lili.jpg|kit-lili
        {%- endcapture -%}
        <div class="eb-rv-grid">
          {%- assign rv_list = kit_reviews | strip | split: '#' -%}
          {%- for r in rv_list -%}
            {%- liquid
              assign rp = r | strip | split: '|'
              assign photos = rp[6] | split: ','
              assign active = 0
              if photos.size > 1
                assign active = 1
              endif
            -%}
            {%- capture photo_urls -%}
              {%- for ph in photos -%}
                {%- if ph contains 'asset:' -%}{{ ph | remove_first: 'asset:' | asset_img_url: '800x' }}{%- else -%}{{ ph }}{%- endif -%}
                {%- unless forloop.last %}|{% endunless -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- assign urls = photo_urls | split: '|' -%}
            <div class="eb-reveal" style="--eb-delay: {{ forloop.index0 | times: 0.09 }}s">
              <article class="eb-rv" data-eb-rv data-active="{{ active }}">
                <div class="eb-rv__photo">
                  <button type="button" class="eb-rv__main" aria-label="Ver próxima foto da avaliação" data-eb-rv-next>
                    {%- for u in urls -%}
                      <img src="{{ u }}" alt="Foto enviada por cliente — {{ rp[0] }}" width="600" height="800" loading="lazy" data-i="{{ forloop.index0 }}"{% if forloop.index0 != active %} hidden{% endif %}>
                    {%- endfor -%}
                  </button>
                  <span class="eb-rv__tag">Foto de cliente</span>
                </div>

                <div class="eb-rv__top">
                  <div>
                    <div class="eb-rv__score">
                      <svg class="eb-i"><use href="#eb-star"/></svg>
                      <b>{{ rp[2] }}</b>
                      <span>· {{ rp[3] }} avaliações</span>
                    </div>
                    <h3 class="eb-rv__name">{{ rp[0] }}</h3>
                    <span class="eb-rv__pet">{{ rp[1] }}</span>
                  </div>
                  {%- if urls.size > 1 -%}
                    <div class="eb-rv__thumbs">
                      {%- for u in urls -%}
                        <button type="button" class="eb-rv__thumb" aria-label="Ver esta foto da avaliação" data-eb-rv-thumb="{{ forloop.index0 }}"{% if forloop.index0 == active %} hidden{% endif %}>
                          <img src="{{ u }}" alt="Foto de cliente — {{ rp[0] }}" width="44" height="56" loading="lazy">
                        </button>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                </div>

                <p class="eb-rv__text">{{ rp[5] }}</p>

                <div class="eb-rv__foot">
                  <span class="eb-rv__rec">{{ rp[4] }}% recomendam</span>
                  <a href="{{ routes.root_url | append: 'products/' | replace: '//', '/' }}{{ rp[7] }}" class="eb-rv__link">Ver avaliações <svg class="eb-i"><use href="#eb-arrow-up-right"/></svg></a>
                </div>
              </article>
            </div>
          {%- endfor -%}
        </div>

        <div class="eb-short eb-reveal">
          {%- assign shorts = 'Muito bonitos e confortáveis|Mariza R.|Kit Diana|https://uploads.konfidency.com.br/45cd965b-c41a-4e29-86d4-6d0e417938b3#Maravilhoso e de excelente qualidade!|Maria H.|Kit Lucky|#Material excelente, entrega e atendimento impecáveis!|Rafaella P.|Kit Cecília|' | split: '#' -%}
          {%- for s in shorts -%}
            {%- assign sp = s | split: '|' -%}
            <figure>
              {%- if sp[3] != blank -%}
                <div class="eb-short__img"><img src="{{ sp[3] }}" alt="Foto de cliente — {{ sp[1] }}" width="48" height="48" loading="lazy"></div>
              {%- endif -%}
              <div>
                <blockquote>“{{ sp[0] }}”</blockquote>
                <figcaption><svg class="eb-i"><use href="#eb-badge-check"/></svg>{{ sp[1] }} · {{ sp[2] }}</figcaption>
              </div>
            </figure>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment %} ───────── Chamada ───────── {% endcomment -%}
  <section class="eb-section eb-promo" id="promo">
    <div class="eb-promo__glow"></div>
    <div class="eb-promo__in">
      <span class="eb-eyebrow">Esquenta Black · {{ periodo }}</span>
      <h2 class="eb-h2">O kit completo com <em>{{ desconto }}% de desconto</em></h2>
      <p class="eb-promo__text">Peitoral e guia em couro legítimo, feitos à mão. Enquanto durar a campanha, os dois saem juntos por {{ desconto }}% menos — o desconto já aparece no preço de cada kit.</p>
      <a href="#kits" class="eb-btn">Escolher meu kit agora <svg class="eb-i"><use href="#eb-arrow-right"/></svg></a>
    </div>
  </section>

  {%- comment %} ───────── FAQ ───────── {% endcomment -%}
  <section class="eb-section" id="faq">
    <div class="eb-wrap">
      <div class="eb-head eb-reveal">
        <span class="eb-eyebrow">Dúvidas frequentes</span>
        <h2 class="eb-h2">Tudo o que você <em>precisa saber</em></h2>
      </div>

      <div class="eb-faq__list eb-reveal">
        {%- capture faq_whats -%}<a href="{{ whatsapp }}" target="_blank" rel="noopener noreferrer">WhatsApp</a>{%- endcapture -%}
        {%- capture faq_all -%}O frete é grátis?|Frete grátis para Sul e Sudeste nas compras a partir de R$ 190 e para as demais regiões a partir de R$ 390. Abaixo desses valores, o frete é calculado no checkout pelo seu CEP.#Qual é o prazo de envio e entrega?|Seu pedido é fabricado exclusivamente para o seu pet, pedimos o prazo de 3 a 5 dias para fabricar e despachar. O código de rastreio é enviado pelo WhatsApp.#Posso trocar um kit comprado na promoção?|Sim, para itens não personalizados você tem 7 dias corridos após o recebimento para solicitar troca ou devolução. Peças personalizadas com o nome do pet são feitas sob medida e só podem ser trocadas em caso de defeito de fabricação ou erro no pedido.#Como peço uma troca ou devolução?|Fale com a gente no {{ faq_whats }} informando o número do pedido, o motivo e fotos do produto. A análise é feita em até 7 dias após o recebimento da peça.#Quais são as formas de pagamento?|Pix, com desconto adicional, ou cartão de crédito em até 6x sem juros. O pagamento é processado no checkout seguro da loja oficial.{%- endcapture -%}
        {%- assign faq_items = faq_all | split: '#' -%}
        {%- for f in faq_items -%}
          {%- assign fp = f | split: '|' -%}
          <div class="eb-faq__item">
            <button type="button" class="eb-faq__q" aria-expanded="false" aria-controls="eb-faq-{{ forloop.index }}">
              <span>{{ fp[0] }}</span>
              <svg class="eb-i"><use href="#eb-chevron"/></svg>
            </button>
            <div class="eb-faq__a" id="eb-faq-{{ forloop.index }}" role="region"><div><p>{{ fp[1] }}</p></div></div>
          </div>
        {%- endfor -%}
      </div>
    </div>
  </section>

  <div class="eb-sticky" data-eb-sticky aria-hidden="true">
    <div class="eb-sticky__in">
      <div>
        <p class="eb-sticky__off">{{ desconto }}% off</p>
        <p class="eb-sticky__until">Oferta até {{ fim_label }}</p>
      </div>
      <a href="#kits" tabindex="-1">Escolher meu kit <svg class="eb-i"><use href="#eb-arrow-right"/></svg></a>
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('eb-root');
    if (!root) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* Contagem regressiva */
    var count = root.querySelector('[data-eb-count]');
    var end = count ? Date.parse(count.getAttribute('data-eb-count')) : NaN;
    if (count && isNaN(end)) count.hidden = true;
    if (count && !isNaN(end)) {
      var units = {};
      count.querySelectorAll('[data-u]').forEach(function (el) { units[el.getAttribute('data-u')] = el; });
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var tick = function () {
        var left = Math.max(0, end - Date.now());
        if (left === 0) {
          count.querySelector('[data-eb-count-label]').textContent = 'Promoção encerrada';
          count.querySelector('[data-eb-count-units]').hidden = true;
          count.querySelector('[data-eb-count-end]').hidden = false;
          return false;
        }
        units.d.textContent = pad(Math.floor(left / 86400000));
        units.h.textContent = pad(Math.floor(left % 86400000 / 3600000));
        units.m.textContent = pad(Math.floor(left % 3600000 / 60000));
        units.s.textContent = pad(Math.floor(left % 60000 / 1000));
        return true;
      };
      if (tick()) { var timer = setInterval(function () { if (!tick()) clearInterval(timer); }, 1000); }
    }

    /* Abas Cães / Gatos */
    var tabsBox = root.querySelector('[data-eb-tabs]');
    var tabs = root.querySelectorAll('[data-eb-tab]');
    var cards = root.querySelectorAll('[data-eb-card]');
    var empty = root.querySelector('[data-eb-empty]');
    function setTab(cat) {
      var shown = 0;
      if (tabsBox) tabsBox.setAttribute('data-active', cat);
      tabs.forEach(function (t) { t.setAttribute('aria-pressed', t.getAttribute('data-eb-tab') === cat ? 'true' : 'false'); });
      cards.forEach(function (c) {
        var ok = c.getAttribute('data-cat') === cat;
        c.hidden = !ok;
        c.classList.remove('eb-card-in');
        if (ok) {
          c.style.setProperty('--eb-delay', Math.min(shown, 8) * 0.07 + 's');
          void c.offsetWidth;
          c.classList.add('eb-card-in');
          shown++;
        }
      });
      if (empty) empty.hidden = shown > 0;
    }
    tabs.forEach(function (t) { t.addEventListener('click', function () { setTab(t.getAttribute('data-eb-tab')); }); });
    setTab('cachorro');

    /* Aparecer ao rolar */
    var rev = root.querySelectorAll('.eb-reveal');
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      rev.forEach(function (el) { io.observe(el); });
    } else {
      rev.forEach(function (el) { el.classList.add('is-in'); });
    }

    /* Fotos das avaliações: clique na foto = próxima; miniatura = aquela foto */
    root.querySelectorAll('[data-eb-rv]').forEach(function (rv) {
      var imgs = rv.querySelectorAll('.eb-rv__main img');
      var thumbs = rv.querySelectorAll('[data-eb-rv-thumb]');
      function show(i) {
        rv.setAttribute('data-active', i);
        imgs.forEach(function (img) { img.hidden = +img.getAttribute('data-i') !== i; });
        thumbs.forEach(function (t) { t.hidden = +t.getAttribute('data-eb-rv-thumb') === i; });
      }
      rv.querySelector('[data-eb-rv-next]').addEventListener('click', function () {
        if (imgs.length > 1) show((+rv.getAttribute('data-active') + 1) % imgs.length);
      });
      thumbs.forEach(function (t) { t.addEventListener('click', function () { show(+t.getAttribute('data-eb-rv-thumb')); }); });
    });

    /* FAQ: um aberto por vez, pode fechar todos */
    var qs = root.querySelectorAll('.eb-faq__q');
    qs.forEach(function (q) {
      q.addEventListener('click', function () {
        var open = q.getAttribute('aria-expanded') === 'true';
        qs.forEach(function (o) { o.setAttribute('aria-expanded', 'false'); });
        q.setAttribute('aria-expanded', open ? 'false' : 'true');
      });
    });

    /* Âncoras #kits com rolagem suave */
    root.querySelectorAll('a[href="#kits"]').forEach(function (a) {
      a.addEventListener('click', function (e) {
        var k = document.getElementById('kits');
        if (!k) return;
        e.preventDefault();
        k.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
      });
    });

    /* Barra fixa (celular) */
    var sticky = root.querySelector('[data-eb-sticky]');
    if (sticky) {
      var link = sticky.querySelector('a');
      var ticking = false;
      var onScroll = function () {
        var on = (window.scrollY || window.pageYOffset) > 520;
        sticky.classList.toggle('is-on', on);
        sticky.setAttribute('aria-hidden', on ? 'false' : 'true');
        link.tabIndex = on ? 0 : -1;
        ticking = false;
      };
      window.addEventListener('scroll', function () {
        if (!ticking) { ticking = true; window.requestAnimationFrame(onScroll); }
      }, { passive: true });
      onScroll();
    }
  })();
</script>

{% schema %}
{
  "name": "Esquenta Black",
  "settings": [
    { "type": "header", "content": "Campanha" },
    { "type": "range", "id": "desconto", "label": "Desconto (%)", "min": 5, "max": 60, "step": 5, "default": 15 },
    { "type": "text", "id": "periodo", "label": "Período (faixa do topo e rodapé dos kits)", "default": "24.10 — 31.10" },
    { "type": "text", "id": "fim_label", "label": "Último dia, por extenso", "info": "Aparece em \"até …\" no hero e na barra fixa.", "default": "31 de outubro" },
    { "type": "text", "id": "fim_data", "label": "Fim da contagem regressiva", "info": "Formato AAAA-MM-DDTHH:MM:SS-03:00. Vazio esconde a contagem.", "default": "2026-10-31T23:59:59-03:00" },
    { "type": "header", "content": "Imagem e contato" },
    { "type": "image_picker", "id": "hero_image", "label": "Imagem do hero (vazio = foto padrão do tema)" },
    { "type": "text", "id": "whatsapp_url", "label": "Link do WhatsApp", "default": "https://wa.me/5548996723567" },
    { "type": "header", "content": "Kits" },
    { "type": "text", "id": "tag_gato", "label": "Tag de produto para gato (além de \"gato\" no título)", "default": "gato" },
    { "type": "checkbox", "id": "show_depoimentos", "label": "Mostrar avaliações", "default": true }
  ],
  "presets": [{ "name": "Esquenta Black" }]
}
{% endschema %}
