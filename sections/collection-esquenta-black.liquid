{% comment %}
  Âme — Coleção "Esquenta Black": layout de campanha (hero + kits + passo a passo + prova + FAQ).
  Réplica da página feita no Base44. Header e footer são os do tema; os kits vêm dos
  produtos da coleção (preço = preço real da loja, "De" = compare_at_price).
  Abas Cães/Gatos: gato = tag `tag_gato` OU "gato" no título; o resto é cachorro.
{% endcomment %}

{%- liquid
  assign desconto = section.settings.desconto
  assign periodo = section.settings.periodo
  assign cupom = section.settings.cupom | strip
  assign whatsapp = section.settings.whatsapp_url
  assign tag_gato = section.settings.tag_gato | strip
  assign hero_img = section.settings.hero_image
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;700;800;900&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

<style>
  .eb {
    --eb-onyx: #0b0a09;
    --eb-cocoa: #2e2521;
    --eb-clay: #4d403a;
    --eb-sand: #d3bca8;
    --eb-linen: #efe6dc;
    --eb-cream: #f7f3ef;
    --eb-gold: #c99a4e;
    --eb-amber: #c1ff72;
    --eb-lime-deep: #aef25a;
    --eb-display: 'Archivo', ui-sans-serif, system-ui, sans-serif;
    --eb-body: 'Inter', ui-sans-serif, system-ui, sans-serif;

    background: var(--eb-cream);
    color: var(--eb-cocoa);
    font-family: var(--eb-body);
    -webkit-font-smoothing: antialiased;
    overflow: hidden;
  }
  .eb *, .eb *::before, .eb *::after { box-sizing: border-box; }
  /* Resets com :where() = especificidade zero, para as classes da seção sempre vencerem */
  :where(.eb) a { color: inherit; text-decoration: none; }
  :where(.eb) :is(h1, h2, h3, p, ul, figure, blockquote) { margin: 0; padding: 0; }
  :where(.eb) ul { list-style: none; }
  :where(.eb) button { font: inherit; cursor: pointer; }
  :where(.eb) svg.eb-i { width: 1rem; height: 1rem; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .eb [hidden] { display: none !important; }

  .eb-wrap { max-width: 80rem; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 640px) { .eb-wrap { padding: 0 1.5rem; } }

  /* Tipografia de seção */
  .eb-eyebrow { font-family: var(--eb-display); font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .3em; color: var(--eb-gold); }
  .eb-h2 { margin-top: 1rem; font-family: var(--eb-display); font-size: 2.25rem; font-weight: 900; text-transform: uppercase; line-height: .95; letter-spacing: -.02em; }
  @media (min-width: 640px) { .eb-h2 { font-size: 3rem; } }
  .eb-section { padding: 5rem 0; scroll-margin-top: 6rem; }
  @media (min-width: 1024px) { .eb-section { padding: 7rem 0; } }

  /* Botões */
  .eb-btn { display: inline-flex; align-items: center; justify-content: center; gap: .625rem; border-radius: 999px; padding: 1rem 1.75rem; font-family: var(--eb-display); font-size: .875rem; font-weight: 800; text-transform: uppercase; letter-spacing: .12em; border: 1px solid transparent; transition: background .2s, border-color .2s, box-shadow .2s; }
  .eb-btn--lime { background: var(--eb-amber); color: var(--eb-onyx); }
  .eb-btn--lime:hover { background: var(--eb-lime-deep); box-shadow: 0 18px 40px -18px rgba(193,255,114,.55); }
  .eb-btn--ghost { border-color: rgba(247,243,239,.3); color: var(--eb-cream); }
  .eb-btn--ghost:hover { border-color: var(--eb-cream); background: rgba(255,255,255,.1); }
  .eb-btn .eb-i { transition: transform .2s; }
  .eb-btn:hover .eb-i { transform: translateX(.25rem); }

  /* Reveal ao rolar (só esconde se o JS rodou) */
  .eb-js .eb-reveal { opacity: 0; transform: translateY(26px); transition: opacity .6s cubic-bezier(.22,1,.36,1), transform .6s cubic-bezier(.22,1,.36,1); transition-delay: var(--eb-delay, 0s); }
  .eb-js .eb-reveal.is-in { opacity: 1; transform: none; }

  /* Hero */
  .eb-hero { position: relative; isolation: isolate; overflow: hidden; background: var(--eb-onyx); color: var(--eb-cream); }
  .eb-hero__media { position: absolute; inset: -45px 0; z-index: -1; will-change: transform; }
  .eb-hero__media img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
  .eb-hero__media::after { content: ''; position: absolute; inset: 0; background: rgba(11,10,9,.25); }
  .eb-hero__outline { display: none; position: absolute; right: -1rem; top: 1rem; font-family: var(--eb-display); font-size: 13rem; font-weight: 900; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px rgba(193,255,114,.45); user-select: none; pointer-events: none; animation: eb-glow 2.8s ease-in-out infinite; }
  @media (min-width: 1024px) { .eb-hero__outline { display: block; } }
  @keyframes eb-glow { 0%, 100% { opacity: .35; } 50% { opacity: .85; } }
  .eb-hero__inner { padding-top: 3.5rem; padding-bottom: 4rem; }
  @media (min-width: 640px) { .eb-hero__inner { padding-top: 5rem; padding-bottom: 4rem; } }
  @media (min-width: 1024px) { .eb-hero__inner { padding-top: 7rem; padding-bottom: 7rem; } }
  .eb-hero__content { max-width: 42rem; }
  .eb-pill { display: inline-flex; flex-direction: column; gap: .25rem; border-radius: 1rem; border: 1px solid rgba(193,255,114,.4); background: rgba(193,255,114,.1); padding: .625rem 1rem; font-size: 10px; font-weight: 700; text-transform: uppercase; line-height: 1; letter-spacing: .24em; color: var(--eb-amber); }
  .eb-pill__row { display: flex; align-items: center; gap: .5rem; }
  .eb-pill__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--eb-amber); }
  .eb-pill__sub { padding-left: 14px; }
  .eb-hero__title { margin-top: 1rem; font-family: var(--eb-display); font-size: 3rem; font-weight: 900; text-transform: uppercase; line-height: .92; letter-spacing: -.02em; }
  .eb-hero__title em { font-style: normal; color: var(--eb-amber); }
  @media (min-width: 640px) { .eb-hero__title { margin-top: 1.5rem; font-size: 3.75rem; } }
  @media (min-width: 1024px) { .eb-hero__title { font-size: 4.5rem; } }
  .eb-hero__text { margin-top: 1rem; max-width: 36rem; font-size: 1rem; line-height: 1.625; color: rgba(211,188,168,.9); }
  .eb-hero__ctas { margin-top: 2.25rem; display: flex; flex-direction: column; gap: .75rem; }
  @media (min-width: 640px) { .eb-hero__ctas { flex-direction: row; } }
  .eb-hero__anim { animation: eb-rise .7s cubic-bezier(.22,1,.36,1) both; }
  @keyframes eb-rise { from { opacity: 0; transform: translateY(22px); } to { opacity: 1; transform: none; } }

  /* Faixa de confiança */
  .eb-trust { border-bottom: 1px solid rgba(77,64,58,.1); background: var(--eb-linen); }
  .eb-trust__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.75rem 1.5rem; padding: 2.25rem 1rem; max-width: 80rem; margin: 0 auto; }
  @media (min-width: 640px) { .eb-trust__grid { padding-left: 1.5rem; padding-right: 1.5rem; } }
  @media (min-width: 768px) { .eb-trust__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .eb-trust__grid { grid-template-columns: repeat(6, 1fr); } }
  .eb-trust__item { display: flex; align-items: flex-start; gap: .75rem; }
  .eb-trust__item .eb-i { width: 1.25rem; height: 1.25rem; margin-top: 2px; color: var(--eb-gold); stroke-width: 1.8; }
  .eb-trust__title { font-family: var(--eb-display); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .eb-trust__text { margin-top: 2px; font-size: 11px; line-height: 1.35; color: rgba(77,64,58,.7); }

  /* Kits */
  .eb-kits__head { max-width: 48rem; }
  .eb-tabs { margin-top: 2.25rem; display: flex; flex-wrap: wrap; gap: .625rem; }
  .eb-tab { border-radius: 999px; border: 1px solid rgba(77,64,58,.2); background: #fff; padding: .625rem 1.25rem; font-family: var(--eb-display); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--eb-clay); transition: border-color .2s; }
  .eb-tab:hover { border-color: rgba(77,64,58,.5); }
  .eb-tab[aria-pressed="true"] { background: var(--eb-onyx); border-color: var(--eb-onyx); color: var(--eb-cream); }
  .eb-grid { margin-top: 2.5rem; display: grid; gap: 1.5rem; grid-template-columns: 1fr; }
  @media (min-width: 640px) { .eb-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .eb-grid { grid-template-columns: repeat(3, 1fr); } }
  .eb-empty { margin-top: 2.5rem; border-radius: 1.5rem; border: 1px solid rgba(77,64,58,.15); background: #fff; padding: 2.5rem 1rem; text-align: center; }
  .eb-empty p { font-family: var(--eb-display); font-size: 1.125rem; font-weight: 800; }
  .eb-empty a { margin-top: 1.25rem; display: inline-flex; align-items: center; gap: .5rem; border-radius: 999px; background: var(--eb-onyx); padding: .75rem 1.5rem; font-family: var(--eb-display); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--eb-cream); }

  .eb-kit { display: flex; flex-direction: column; overflow: hidden; height: 100%; border-radius: 1.5rem; border: 1px solid rgba(77,64,58,.1); background: #fff; transition: transform .35s cubic-bezier(.22,1,.36,1); }
  @media (hover: hover) { .eb-kit:hover { transform: translateY(-6px) rotate(-.6deg); } }
  .eb-kit__img { position: relative; aspect-ratio: 1; overflow: hidden; background: var(--eb-linen); display: block; }
  .eb-kit__img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .7s; }
  .eb-kit:hover .eb-kit__img img { transform: scale(1.05); }
  .eb-kit__off { position: absolute; right: .75rem; top: .75rem; border-radius: 999px; background: var(--eb-amber); padding: .25rem .75rem; font-family: var(--eb-display); font-size: 12px; font-weight: 800; color: var(--eb-onyx); }
  .eb-kit__off--out { background: var(--eb-onyx); color: var(--eb-cream); }
  .eb-kit__body { display: flex; flex: 1; flex-direction: column; padding: 1.25rem; }
  .eb-kit__meta { display: flex; align-items: center; gap: .5rem; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .16em; color: var(--eb-gold); }
  .eb-kit__name { margin-top: .5rem; font-family: var(--eb-display); font-size: 1.125rem; font-weight: 800; line-height: 1.25; }
  .eb-kit__price { margin-top: auto; border-top: 1px dashed rgba(77,64,58,.2); padding-top: 1rem; }
  .eb-kit__body .eb-kit__price { margin-top: 1rem; }
  .eb-kit__de { font-size: 12px; color: rgba(77,64,58,.45); }
  .eb-kit__de s { text-decoration: line-through; }
  .eb-kit__now { margin-top: .25rem; font-family: var(--eb-display); font-size: 1.5rem; font-weight: 800; }
  .eb-kit__now small { margin-left: .5rem; vertical-align: middle; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .12em; color: var(--eb-gold); }
  .eb-kit__parc { margin-top: .375rem; font-size: 12px; color: rgba(77,64,58,.6); }
  .eb-kit__cta { margin-top: 1.25rem; display: inline-flex; align-items: center; justify-content: center; gap: .5rem; border-radius: 999px; background: var(--eb-onyx); padding: .875rem 1.25rem; font-family: var(--eb-display); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--eb-cream); transition: background .2s; }
  .eb-kit__cta:hover { background: var(--eb-cocoa); }
  .eb-kit--out .eb-kit__cta { background: rgba(77,64,58,.35); pointer-events: none; }
  .eb-more { margin-top: 2.5rem; display: flex; justify-content: center; gap: .75rem; }
  .eb-more a { border-radius: 999px; border: 1px solid rgba(77,64,58,.2); background: #fff; padding: .625rem 1.25rem; font-family: var(--eb-display); font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--eb-clay); }

  /* Como aproveitar */
  .eb-steps { background: var(--eb-onyx); color: var(--eb-cream); padding: 5rem 0; scroll-margin-top: 6rem; }
  @media (min-width: 1024px) { .eb-steps { padding: 6rem 0; } }
  .eb-steps__grid { display: grid; gap: 3.5rem; }
  @media (min-width: 1024px) { .eb-steps__grid { grid-template-columns: 1.1fr .9fr; gap: 5rem; } }
  .eb-steps .eb-eyebrow { color: var(--eb-amber); }
  .eb-steps__list { margin-top: 2.5rem; display: grid; gap: 2rem; }
  .eb-step { display: flex; gap: 1.25rem; }
  .eb-step__n { display: flex; width: 2.75rem; height: 2.75rem; flex: none; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid rgba(193,255,114,.5); font-family: var(--eb-display); font-size: 1rem; font-weight: 800; color: var(--eb-amber); }
  .eb-step h3 { font-family: var(--eb-display); font-size: 1.125rem; font-weight: 800; }
  .eb-step p { margin-top: .25rem; font-size: .875rem; line-height: 1.625; color: rgba(211,188,168,.85); }
  .eb-steps__ctas { margin-top: 2.5rem; display: flex; flex-direction: column; gap: .75rem; }
  @media (min-width: 640px) { .eb-steps__ctas { flex-direction: row; } }
  .eb-rules { border-radius: 1.5rem; border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.05); padding: 2rem; backdrop-filter: blur(8px); }
  .eb-rules li { font-size: .875rem; line-height: 1.5; color: rgba(211,188,168,.9); }
  .eb-rules li + li { margin-top: .75rem; }
  @media (min-width: 1024px) { .eb-rules-col { padding-top: 3.5rem; } }

  /* Prova */
  .eb-split { display: flex; flex-direction: column; align-items: flex-start; justify-content: space-between; gap: 1.5rem; }
  @media (min-width: 640px) { .eb-split { flex-direction: row; align-items: flex-end; } }
  .eb-rating { display: flex; align-items: center; gap: .75rem; border-radius: 999px; border: 1px solid rgba(77,64,58,.15); background: #fff; padding: .75rem 1.25rem; }
  .eb-stars { display: flex; gap: 2px; color: var(--eb-gold); }
  .eb-stars .eb-i { width: 1rem; height: 1rem; fill: var(--eb-gold); stroke: var(--eb-gold); }
  .eb-rating span:last-child { font-family: var(--eb-display); font-size: .875rem; font-weight: 800; }
  .eb-gallery { margin-top: 2.75rem; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  @media (min-width: 640px) { .eb-gallery { gap: 1.25rem; } }
  @media (min-width: 1024px) { .eb-gallery { grid-template-columns: repeat(3, 1fr); } }
  .eb-gallery figure { position: relative; height: 100%; overflow: hidden; border-radius: 1.5rem; background: var(--eb-linen); }
  .eb-gallery img { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; display: block; transition: transform .7s; }
  .eb-gallery figure:hover img { transform: scale(1.05); }
  .eb-gallery figcaption { position: absolute; bottom: .75rem; left: .75rem; border-radius: 999px; background: rgba(11,10,9,.75); padding: .375rem .875rem; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .18em; color: var(--eb-cream); backdrop-filter: blur(6px); }
  .eb-facts { margin-top: 3.5rem; display: grid; gap: 1.5rem; border-radius: 1.5rem; border: 1px solid rgba(77,64,58,.15); background: #fff; padding: 2rem; }
  @media (min-width: 640px) { .eb-facts { grid-template-columns: repeat(3, 1fr); } }
  .eb-facts strong { display: block; font-family: var(--eb-display); font-size: 1.875rem; font-weight: 900; }
  .eb-facts p { margin-top: .25rem; font-size: 13px; line-height: 1.625; color: rgba(77,64,58,.7); }

  /* Depoimentos */
  .eb-depo { background: var(--eb-linen); }
  .eb-depo__grid { margin-top: 2.75rem; display: grid; gap: 1rem; }
  @media (min-width: 640px) { .eb-depo__grid { gap: 1.25rem; } }
  @media (min-width: 768px) { .eb-depo__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .eb-depo__grid { grid-template-columns: repeat(3, 1fr); } }
  .eb-depo figure { display: flex; height: 100%; flex-direction: column; border-radius: 1.5rem; border: 1px solid rgba(77,64,58,.15); background: #fff; padding: 1.5rem; }
  .eb-depo .eb-quote { width: 1.75rem; height: 1.75rem; color: var(--eb-amber); stroke-width: 1.5; }
  .eb-depo blockquote { margin-top: 1rem; flex: 1; font-size: 15px; line-height: 1.625; color: rgba(46,37,33,.85); }
  .eb-depo .eb-stars { margin-top: 1.25rem; }
  .eb-depo .eb-stars .eb-i { width: .875rem; height: .875rem; }
  .eb-depo figcaption { margin-top: 1rem; display: flex; align-items: center; gap: .75rem; border-top: 1px solid rgba(77,64,58,.1); padding-top: 1rem; }
  .eb-avatar { display: flex; width: 2.5rem; height: 2.5rem; flex: none; align-items: center; justify-content: center; border-radius: 50%; background: var(--eb-onyx); font-family: var(--eb-display); font-size: 12px; font-weight: 900; letter-spacing: .04em; color: var(--eb-amber); }
  .eb-depo figcaption strong { display: block; font-family: var(--eb-display); font-size: .875rem; font-weight: 800; }
  .eb-depo figcaption small { display: block; font-size: 12px; line-height: 1.35; color: rgba(77,64,58,.7); }
  .eb-depo__nota { margin-top: 2rem; text-align: center; font-size: 13px; line-height: 1.625; color: rgba(77,64,58,.7); }

  /* FAQ */
  .eb-faq { background: #fff; }
  .eb-faq__wrap { max-width: 56rem; margin: 0 auto; padding: 0 1rem; }
  @media (min-width: 640px) { .eb-faq__wrap { padding: 0 1.5rem; } }
  .eb-faq__list { margin-top: 2.75rem; border-top: 1px solid rgba(77,64,58,.1); border-bottom: 1px solid rgba(77,64,58,.1); }
  .eb-faq__item + .eb-faq__item { border-top: 1px solid rgba(77,64,58,.1); }
  .eb-faq__q { display: flex; width: 100%; align-items: center; justify-content: space-between; gap: 1.5rem; padding: 1.25rem 0; border: 0; background: none; text-align: left; font-family: var(--eb-display); font-size: 1rem; font-weight: 800; color: var(--eb-cocoa); }
  @media (min-width: 640px) { .eb-faq__q { font-size: 1.125rem; } }
  .eb-faq__plus { display: flex; width: 2rem; height: 2rem; flex: none; align-items: center; justify-content: center; border-radius: 50%; border: 1px solid rgba(77,64,58,.25); color: rgba(77,64,58,.6); transition: transform .2s, border-color .2s, color .2s; }
  .eb-faq__q[aria-expanded="true"] .eb-faq__plus { transform: rotate(45deg); border-color: var(--eb-gold); color: var(--eb-gold); }
  .eb-faq__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows .28s ease-in-out; }
  .eb-faq__q[aria-expanded="true"] + .eb-faq__a { grid-template-rows: 1fr; }
  .eb-faq__a > div { overflow: hidden; }
  .eb-faq__a p { padding: 0 3rem 1.5rem 0; font-size: .875rem; line-height: 1.625; color: rgba(77,64,58,.8); }
  .eb-faq__foot { margin-top: 2.5rem; text-align: center; font-size: .875rem; color: rgba(77,64,58,.7); }
  .eb-faq__foot a { font-weight: 600; color: var(--eb-cocoa); text-decoration: underline; text-decoration-color: var(--eb-gold); text-decoration-thickness: 2px; text-underline-offset: 4px; }

  /* CTA final */
  .eb-final { position: relative; overflow: hidden; background: var(--eb-cocoa); color: var(--eb-cream); padding: 5rem 0; text-align: center; }
  @media (min-width: 1024px) { .eb-final { padding: 7rem 0; } }
  .eb-final__mark { display: none; position: absolute; left: -2.5rem; top: 50%; transform: translateY(-50%); font-family: var(--eb-display); font-size: 16rem; font-weight: 900; line-height: 1; color: transparent; -webkit-text-stroke: 1.5px rgba(211,188,168,.25); user-select: none; pointer-events: none; }
  @media (min-width: 1024px) { .eb-final__mark { display: block; } }
  .eb-final__inner { position: relative; max-width: 48rem; margin: 0 auto; padding: 0 1rem; }
  .eb-final .eb-eyebrow { color: var(--eb-amber); }
  .eb-final h2 { margin-top: 1.25rem; font-family: var(--eb-display); font-size: 2.25rem; font-weight: 900; text-transform: uppercase; line-height: .95; letter-spacing: -.02em; }
  @media (min-width: 640px) { .eb-final h2 { font-size: 3rem; } }
  @media (min-width: 1024px) { .eb-final h2 { font-size: 3.75rem; } }
  .eb-final p.eb-final__text { margin: 1.25rem auto 0; max-width: 36rem; font-size: 1rem; line-height: 1.625; color: rgba(211,188,168,.9); }
  .eb-final__ctas { margin-top: 2.5rem; display: flex; flex-direction: column; justify-content: center; gap: .75rem; }
  @media (min-width: 640px) { .eb-final__ctas { flex-direction: row; } }

  /* Barra fixa — fica ABAIXO do carrinho do tema (199/200) */
  .eb-sticky { position: fixed; inset: auto 0 0 0; z-index: 150; border-top: 1px solid rgba(255,255,255,.1); background: rgba(11,10,9,.9); backdrop-filter: blur(8px); transform: translateY(100%); opacity: 0; transition: transform .35s cubic-bezier(.22,1,.36,1), opacity .35s; }
  .eb-sticky.is-on { transform: none; opacity: 1; }
  .eb-sticky__in { display: flex; max-width: 80rem; margin: 0 auto; align-items: center; justify-content: space-between; gap: 1rem; padding: .75rem 1rem; }
  @media (min-width: 640px) { .eb-sticky__in { padding: .75rem 1.5rem; } }
  .eb-sticky__txt { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--eb-display); font-size: .875rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: var(--eb-cream); }
  .eb-sticky .eb-btn { flex: none; padding: .75rem 1.25rem; font-size: 12px; letter-spacing: .14em; }

  @media (prefers-reduced-motion: reduce) {
    .eb-js .eb-reveal { opacity: 1; transform: none; transition: none; }
    .eb-hero__anim, .eb-hero__outline { animation: none; }
    .eb-kit, .eb-kit__img img, .eb-gallery img, .eb-faq__a { transition: none; }
    .eb-kit:hover { transform: none; }
  }
</style>

