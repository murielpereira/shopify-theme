                <blockquote>{{ dp[3] }}</blockquote>
                <div class="eb-stars">{% for i in (1..5) %}<svg class="eb-i"><use href="#eb-star"/></svg>{% endfor %}</div>
                <figcaption>
                  <span class="eb-avatar">{{ dp[1] }}</span>
                  <span><strong>{{ dp[0] }}</strong><small>{{ dp[2] }}</small></span>
                </figcaption>
              </figure>
