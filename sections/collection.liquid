{% comment %} Âme — Coleção: banner + header editorial + sidebar + grid {% endcomment %}

{%- assign banner_video = collection.metafields.custom.banner_video.value -%}
{%- assign banner_img = collection.featured_image -%}
{%- comment -%}
  Banner mobile (opcional) — metafield custom.banner_image_mobile da coleção.
  Quando preenchido, é usado em viewports <768px no lugar do featured_image
  (que costuma ser horizontal e fica feio cortado no mobile). Cadastre o
  metafield em: Configurações Shopify → Metafields → Coleções → Adicionar
  definição: namespace "custom", chave "banner_image_mobile", tipo "Imagem".
{%- endcomment -%}
{%- assign banner_img_mobile = collection.metafields.custom.banner_image_mobile.value -%}
{%- assign has_banner = false -%}
{%- if section.settings.show_banner -%}
  {%- if banner_video != blank or banner_img != blank -%}
    {%- assign has_banner = true -%}
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Quando o banner está visível E tem o título por cima, esconde o título do
  header editorial abaixo pra evitar duplicação. Eyebrow ("Coleções"),
  descrição e tabs continuam.
{%- endcomment -%}
{%- assign hide_editorial_title = false -%}
{%- if has_banner and section.settings.banner_show_title -%}
  {%- assign hide_editorial_title = true -%}
{%- endif -%}

{%- if has_banner -%}
  <div
    class="ame-col-banner full-width"
    style="--banner-height: {{ section.settings.banner_height }}vh; --banner-overlay: {{ section.settings.banner_overlay | divided_by: 100.0 }};"
  >
    {%- if banner_video != blank -%}
      <video class="ame-col-banner__media" autoplay muted loop playsinline>
        {%- for source in banner_video.sources -%}
          <source src="{{ source.url }}" type="{{ source.mime_type }}">
        {%- endfor -%}
      </video>
    {%- elsif banner_img_mobile != blank -%}
      {%- comment -%}
        <picture> com source mobile dedicado. O browser baixa APENAS o que
        for usado (não os dois) — diferente do que acontece com display:none.
      {%- endcomment -%}
      <picture>
        <source
          media="(max-width: 767px)"
          srcset="{{ banner_img_mobile | image_url: width: 900 }} 900w, {{ banner_img_mobile | image_url: width: 600 }} 600w"
        >
        {{
          banner_img
          | image_url: width: 1800
          | image_tag:
            widths: '600, 1200, 1800',
            class: 'ame-col-banner__media',
            alt: collection.title,
            loading: 'eager',
            fetchpriority: 'high'
        }}
      </picture>
    {%- else -%}
      {{
        banner_img
        | image_url: width: 1800
        | image_tag:
          widths: '600, 1200, 1800',
          class: 'ame-col-banner__media',
          alt: collection.title,
          loading: 'eager',
          fetchpriority: 'high'
      }}
    {%- endif -%}

    <div class="ame-col-banner__overlay"></div>

    {%- if section.settings.banner_show_title -%}
      <div class="ame-col-banner__content">
        <p class="ame-col-banner__eyebrow">Coleção</p>
        <h2 class="ame-col-banner__title">{{ collection.title }}</h2>
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

<header class="ame-col-header full-width">
  <div class="ame-col-header__inner">
    {%- unless hide_editorial_title -%}
      <div class="ame-fade-up ame-delay-1">
        <p class="ame-label-sm">Coleções</p>
        <h1 class="ame-col-header__title">
          {{ collection.title -}}
          <br>
          <em>Curado.</em>
        </h1>
      </div>
    {%- endunless -%}
    {%- if collection.description != blank -%}
      <p class="ame-col-header__desc ame-fade-up ame-delay-2">{{ collection.description }}</p>
    {%- endif -%}
  </div>

  <div class="ame-col-header__tabs ame-fade-up ame-delay-3">
    <a href="{{ collection.url }}" class="ame-col-tab{% unless current_tags %} ame-col-tab--active{% endunless %}"
      >Tudo</a
    >
    {%- for tag in collection.all_tags -%}
      <a
        href="{{ collection.url }}/{{ tag | handle }}"
        class="ame-col-tab{% if current_tags contains tag %} ame-col-tab--active{% endif %}"
      >
        {{- tag -}}
      </a>
    {%- endfor -%}
  </div>

  <div class="ame-col-header__divider"></div>
</header>

<div class="ame-col-layout full-width">
  <aside class="ame-col-sidebar">
    <div class="ame-col-filter-group">
      <p class="ame-col-filter-title">Ordenar</p>
      <div class="ame-col-select-wrap">
        <select class="ame-col-select" onchange="window.location.href=this.value" aria-label="Ordenar por">
          <option
            value="{{ collection.url }}?sort_by=manual"
            {% if collection.sort_by == 'manual' %}
              selected
            {% endif %}
          >
            Em Destaque
          </option>
          <option
            value="{{ collection.url }}?sort_by=created-descending"
            {% if collection.sort_by == 'created-descending' %}
              selected
            {% endif %}
          >
            Mais Recentes
          </option>
          <option
            value="{{ collection.url }}?sort_by=price-ascending"
            {% if collection.sort_by == 'price-ascending' %}
              selected
            {% endif %}
          >
            Preço ↑
          </option>
          <option
            value="{{ collection.url }}?sort_by=price-descending"
            {% if collection.sort_by == 'price-descending' %}
              selected
            {% endif %}
          >
            Preço ↓
          </option>
          <option
            value="{{ collection.url }}?sort_by=best-selling"
            {% if collection.sort_by == 'best-selling' %}
              selected
            {% endif %}
          >
            Mais Vendidos
          </option>
        </select>
        <span class="material-symbols-outlined ame-col-select-icon" aria-hidden="true">expand_more</span>
      </div>
    </div>

    {%- comment -%}
      Filtro de Categoria (tags) removido conforme decisão de UI — as tags do
      catálogo são internas (ex: customizacao_*) e não fazem sentido pro cliente.
      Se um dia precisarmos reativar, é só restaurar o bloco {% if collection.all_tags.size > 0 %}.
    {%- endcomment -%}
  </aside>

  <div class="ame-col-main">
    <div class="ame-col-bar">
      <p class="ame-col-count">
        {{ collection.products_count }}
        {% if collection.products_count == 1 %}peça{% else %}peças{% endif %}
      </p>
    </div>

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if collection.products.size == 0 -%}
        <p class="ame-col-empty">Nenhum produto encontrado nesta coleção.</p>
      {%- else -%}
        <div class="ame-col-grid" style="--grid-cols: {{ section.settings.cols_desktop }};">
          {% comment %}
            ⚡ Bolt: Replace snippet render inside for-loop with `render ... for` syntax.
            💡 What: Uses the `render 'product-card' for array` tag instead of manually looping.
            🎯 Why: Liquid processes a `for` loop with a `render` inside by parsing and scoping the snippet per iteration (N+1 overhead).
            📊 Impact: Eliminates N+1 rendering overhead, dramatically reducing template compilation time for large collections.
            🔬 Measurement: Profile the Server Response time on large collection pages.
          {% endcomment %}
          {%- render 'product-card'
            for collection.products as card_product,
            card_btn_label: section.settings.card_btn_label
          -%}
        </div>

        {%- if paginate.pages > 1 -%}
          {%- comment -%}
            Paginação customizada (não usa default_pagination) pra dar o layout:
            [Anterior fixo] [scroll horizontal de páginas] [Avançar fixo].
            paginate.parts traz cada elemento (número, "..." gap, link ativo)
            com .title, .url e .is_link — usamos pra montar a lista do meio.
          {%- endcomment -%}
          <nav class="ame-col-pagination" aria-label="Paginação">
            {%- if paginate.previous -%}
              <a
                class="ame-col-pagination__nav ame-col-pagination__nav--prev"
                href="{{ paginate.previous.url }}"
                aria-label="Página anterior"
                rel="prev"
              >« Anterior</a>
            {%- else -%}
              <span class="ame-col-pagination__nav ame-col-pagination__nav--prev is-disabled" aria-disabled="true">« Anterior</span>
            {%- endif -%}

            <div class="ame-col-pagination__pages" data-pagination-pages>
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="ame-col-pagination__page" href="{{ part.url }}" aria-label="Página {{ part.title }}">{{ part.title }}</a>
                {%- else -%}
                  {%- if part.title == paginate.current_page -%}
                    <span class="ame-col-pagination__page is-current" aria-current="page">{{ part.title }}</span>
                  {%- else -%}
                    <span class="ame-col-pagination__page is-gap" aria-hidden="true">{{ part.title }}</span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
            </div>

            {%- if paginate.next -%}
              <a
                class="ame-col-pagination__nav ame-col-pagination__nav--next"
                href="{{ paginate.next.url }}"
                aria-label="Próxima página"
                rel="next"
              >Avançar »</a>
            {%- else -%}
              <span class="ame-col-pagination__nav ame-col-pagination__nav--next is-disabled" aria-disabled="true">Avançar »</span>
            {%- endif -%}
          </nav>

          <script>
            /* Centraliza a página atual no scroll horizontal do meio — sem isso,
               quando o cliente está na página 8 de 10, o scroll começa na 1 e
               ele teria que rolar pra ver onde está. */
            (() => {
              const wrap = document.querySelector('[data-pagination-pages]');
              if (!wrap) return;
              const current = wrap.querySelector('.is-current');
              if (!current) return;
              const wrapRect = wrap.getBoundingClientRect();
              const curRect = current.getBoundingClientRect();
              const offset = curRect.left - wrapRect.left - (wrapRect.width / 2) + (curRect.width / 2);
              wrap.scrollLeft = offset;
            })();
          </script>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  /* ── Banner ── */
  .ame-col-banner {
    position: relative;
    height: var(--banner-height, 55vh);
    overflow: hidden;
    background: var(--color-surface-container-highest, #ece1d5);
  }
  .ame-col-banner__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .ame-col-banner__overlay {
    position: absolute;
    inset: 0;
    background: rgba(32, 27, 20, var(--banner-overlay, 0.25));
  }
  .ame-col-banner__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem var(--page-margin, 2rem);
    max-width: calc(var(--page-width, 120rem) + var(--page-margin, 2rem) * 2);
    box-sizing: border-box;
  }
  .ame-col-banner__eyebrow {
    font-size: 0.625rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.65);
    display: block;
    margin-bottom: 0.5rem;
  }
  .ame-col-banner__title {
    font-size: clamp(2rem, 5vw, 4.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 0.95;
    color: #ffffff;
  }

  /* ── Header ── */
  .ame-col-header {
    padding: 2rem var(--page-margin, 2rem) 0;
  }
  .ame-col-header__inner {
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-bottom: 3.5rem;
  }
  @media (min-width: 768px) {
    .ame-col-header__inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
  }
  .ame-col-header__title {
    font-size: clamp(2.5rem, 5vw, 5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 0.92;
    color: var(--color-on-background, #201b14);
  }
  .ame-col-header__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-primary, #5a4742);
  }
  .ame-col-header__desc {
    font-size: 0.875rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant, #4f4442);
    max-width: 22rem;
    align-self: flex-end;
  }

  .ame-col-header__tabs {
    max-width: var(--page-width, 120rem);
    margin: 0 auto;
    /*display: flex; gap: 0.5rem; overflow-x: auto; padding-bottom: 0.5rem;*/
    display: none;
    scrollbar-width: none;
  }
  .ame-col-header__tabs::-webkit-scrollbar {
    display: none;
  }
  .ame-col-tab {
    flex-shrink: 0;
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius-full, 0.75rem);
    background: var(--color-surface-container, #f8ece0);
    color: var(--color-on-surface-variant, #4f4442);
    text-decoration: none;
    transition: background 0.25s ease, color 0.25s ease;
  }
  .ame-col-tab:hover {
    background: var(--color-surface-container-high, #f2e6da);
  }
  .ame-col-tab--active {
    background: var(--color-primary, #5a4742);
    color: #ffffff;
  }

  .ame-col-header__divider {
    max-width: var(--page-width, 120rem);
    margin: 1.5rem auto 0;
    height: 1px;
    background: rgba(210, 195, 192, 0.2);
  }

  /* ── Layout ── */
  .ame-col-layout {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding: 3rem var(--page-margin, 2rem) var(--section-gap, 7.5rem);
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 1024px) {
    .ame-col-layout {
      flex-direction: row;
    }
  }

  /* ── Sidebar ── */
  .ame-col-sidebar {
    flex-shrink: 0;
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
  }
  @media (min-width: 1024px) {
    .ame-col-sidebar {
      width: 15rem;
      flex-direction: column;
      flex-wrap: nowrap;
      position: sticky;
      top: 6.5rem;
      align-self: flex-start;
    }
  }
  .ame-col-filter-title {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(90, 71, 66, 0.5);
    margin-bottom: 0.875rem;
  }
  .ame-col-select-wrap {
    position: relative;
  }
  .ame-col-select {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(210, 195, 192, 0.3);
    border-radius: 0;
    font-size: 0.875rem;
    color: var(--color-on-background, #201b14);
    padding: 0.5rem 1.5rem 0.5rem 0;
    cursor: pointer;
    appearance: none;
    outline: none;
    transition: border-color 0.25s ease;
  }
  .ame-col-select:focus {
    border-bottom-color: var(--color-primary, #5a4742);
  }
  .ame-col-select-icon {
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-on-surface-variant, #4f4442);
    pointer-events: none;
    font-size: 1.125rem;
  }
  .ame-col-filter-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .ame-col-filter-check {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant, #4f4442);
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .ame-col-filter-check:hover {
    color: var(--color-on-background, #201b14);
  }
  .ame-col-filter-box {
    width: 1rem;
    height: 1rem;
    border-radius: var(--radius-sm, 0.125rem);
    border: 1px solid rgba(210, 195, 192, 0.4);
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .ame-col-filter-check--active .ame-col-filter-box {
    background: var(--color-primary, #5a4742);
    border-color: var(--color-primary, #5a4742);
  }
  .ame-col-filter-check--active .ame-col-filter-box::after {
    content: '';
    width: 6px;
    height: 6px;
    background: #fff;
    border-radius: 1px;
    clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  }

  /* ── Grid ── */
  .ame-col-main {
    flex: 1;
    min-width: 0;
  }
  .ame-col-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }
  .ame-col-count {
    font-size: 0.6875rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-on-surface-variant, #4f4442);
  }
  /* Grid responsivo idêntico ao da home (consistência visual):
     - mobile: 2 colunas, gap apertado
     - tablet (≥768): 2 colunas, gap maior
     - desktop (≥1024): 3 colunas (já considerando sidebar à esquerda)
     - desktop wide (≥1280): segue --grid-cols configurado no painel (padrão 3) */
  .ame-col-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 0.75rem;
  }
  @media (min-width: 768px) {
    .ame-col-grid {
      gap: 2rem 1.5rem;
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1280px) {
    .ame-col-grid {
      grid-template-columns: repeat(var(--grid-cols, 3), 1fr);
    }
  }
  .ame-col-empty {
    font-size: 1rem;
    color: var(--color-on-surface-variant, #4f4442);
    padding: 4rem 0;
    text-align: center;
  }
  /* Paginação: [Anterior fixo] [scroll horizontal de páginas] [Avançar fixo].
     Anterior/Avançar não encolhem — o meio é flex:1 com overflow-x:auto,
     então só ele scrolla quando há muitas páginas. */
  .ame-col-pagination {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 4rem;
    font-size: 0.875rem;
  }
  .ame-col-pagination__nav {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-md, 0.25rem);
    color: var(--color-on-surface-variant, #4f4442);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .ame-col-pagination__nav:hover {
    background: var(--color-surface-container, #f8ece0);
  }
  .ame-col-pagination__nav.is-disabled {
    opacity: 0.35;
    cursor: not-allowed;
    pointer-events: none;
  }
  .ame-col-pagination__pages {
    flex: 1 1 0;
    min-width: 0;              /* impede o flex item de crescer pra além do pai */
    display: flex;
    gap: 0.375rem;
    overflow-x: auto;
    padding: 0.25rem 0.5rem;   /* respiro vertical pro :hover não cortar */
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
  }
  .ame-col-pagination__pages::-webkit-scrollbar {
    display: none;
  }
  .ame-col-pagination__page {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-md, 0.25rem);
    color: var(--color-on-surface-variant, #4f4442);
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s ease;
  }
  .ame-col-pagination__page:hover {
    background: var(--color-surface-container, #f8ece0);
  }
  .ame-col-pagination__page.is-current {
    background: var(--color-primary, #5a4742);
    color: #ffffff;
  }
  .ame-col-pagination__page.is-gap {
    cursor: default;
    color: rgba(90, 71, 66, 0.5);
  }
  @media (max-width: 599px) {
    .ame-col-pagination {
      gap: 0.25rem;
      font-size: 0.8125rem;
    }
    .ame-col-pagination__nav {
      padding: 0.4rem 0.625rem;
      min-height: 2.25rem;
    }
    .ame-col-pagination__page {
      min-width: 2.25rem;
      min-height: 2.25rem;
      padding: 0.4rem 0.625rem;
    }
  }

  /* .ame-label-sm vive global no critical.css */
{% endstylesheet %}

{% schema %}
{
  "name": "Coleção",
  "settings": [
    {
      "type": "header",
      "content": "Banner da coleção"
    },
    {
      "type": "paragraph",
      "content": "A imagem de fundo vem do campo 'Imagem da coleção', configurado individualmente no Shopify Admin > Catálogo > Coleções. Para usar vídeo, crie o metafield 'custom.banner_video' (tipo: Arquivo de vídeo) em Configurações > Dados personalizados > Coleções."
    },
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "Exibir banner",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "banner_show_title",
      "label": "Mostrar nome da coleção no banner",
      "default": true
    },
    {
      "type": "range",
      "id": "banner_height",
      "min": 30,
      "max": 80,
      "step": 5,
      "unit": "vh",
      "label": "Altura do banner",
      "default": 55
    },
    {
      "type": "range",
      "id": "banner_overlay",
      "min": 0,
      "max": 70,
      "step": 5,
      "unit": "%",
      "label": "Escurecimento do overlay",
      "default": 25
    },
    {
      "type": "header",
      "content": "Grade de produtos"
    },
    {
      "type": "range",
      "id": "cols_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Produtos por linha (desktop)",
      "default": 3
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 48,
      "step": 4,
      "label": "Produtos por página",
      "default": 12
    },
    {
      "type": "text",
      "id": "card_btn_label",
      "label": "Texto do botão do card",
      "default": "Comprar"
    }
  ]
