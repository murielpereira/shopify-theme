{% comment %} Âme — Página de Favoritos (renderizada client-side via localStorage) {% endcomment %}

<section class="ame-favoritos">
  <header class="ame-favoritos__header">
    <h1 class="ame-favoritos__title">{{ section.settings.title | default: 'Seus Favoritos' }}</h1>
    {%- if section.settings.subtitle != blank -%}
      <p class="ame-favoritos__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}
  </header>

  <div
    id="ame-favoritos-grid"
    class="ame-col-grid"
    style="--grid-cols: {{ section.settings.cols_desktop | default: 4 }};"
    data-favoritos-grid
    hidden
  ></div>

  <div id="ame-favoritos-empty" class="ame-favoritos__empty" data-favoritos-empty>
    <span class="material-symbols-outlined ame-favoritos__empty-icon" aria-hidden="true">favorite</span>
    <p>{{ section.settings.empty_message | default: 'Você ainda não tem produtos favoritos.' }}</p>
    {%- if section.settings.empty_cta_url != blank and section.settings.empty_cta_label != blank -%}
      <a href="{{ section.settings.empty_cta_url }}" class="ame-favoritos__empty-cta">
        {{ section.settings.empty_cta_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="ame-favoritos__loading" data-favoritos-loading hidden>
    <span class="ame-favoritos__spinner" aria-hidden="true"></span>
  </div>
</section>

<script>
  (() => {
    const STORAGE_KEY = 'ame:wishlist';
    const grid = document.querySelector('[data-favoritos-grid]');
    const empty = document.querySelector('[data-favoritos-empty]');
    const loading = document.querySelector('[data-favoritos-loading]');
    if (!grid || !empty) return;

    function readList() {
      try { return JSON.parse(localStorage.getItem(STORAGE_KEY)) || []; }
      catch { return []; }
    }

    // Cache em memória dos cards já buscados — evita refetch quando o usuário
    // remove um item e o render() roda de novo. Key = handle.
    const cardCache = new Map();

    async function fetchCard(handle) {
      if (cardCache.has(handle)) return cardCache.get(handle);
      try {
        const res = await fetch(`/products/${encodeURIComponent(handle)}?view=card`, {
          headers: { Accept: 'text/html' },
        });
        if (!res.ok) return null;
        const html = (await res.text()).trim();
        cardCache.set(handle, html);
        return html;
      } catch {
        return null;
      }
    }

    let currentRender = 0;
    async function render() {
      const runId = ++currentRender;
      const list = readList();

      if (list.length === 0) {
        grid.hidden = true;
        empty.hidden = false;
        grid.innerHTML = '';
        return;
      }

      empty.hidden = true;
      // Loading só na primeira vez (grid vazio); em remoções subsequentes
      // o grid já tem conteúdo cacheado, melhor não piscar.
      if (!grid.innerHTML) {
        grid.hidden = true;
        if (loading) loading.hidden = false;
      }

      // Ordem: mais recente primeiro
      const sorted = [...list].sort((a, b) => (b.addedAt || 0) - (a.addedAt || 0));
      const htmls = await Promise.all(sorted.map(item => fetchCard(item.handle)));

      // Outra chamada começou enquanto fazíamos fetch — descarta esta.
      if (runId !== currentRender) return;

      const valid = htmls.filter(Boolean);
      if (valid.length === 0) {
        grid.hidden = true;
        empty.hidden = false;
        grid.innerHTML = '';
        if (loading) loading.hidden = true;
        return;
      }

      // Usar Range.createContextualFragment pra executar o <script> embutido
      // no product-card (innerHTML não executa scripts). O script tem guard
      // `if (window.AmeWishlistCardBound) return;` então é seguro rodar várias
      // vezes — só a primeira efetivamente registra o listener delegation.
      grid.innerHTML = '';
      const range = document.createRange();
      range.selectNodeContents(grid);
      const fragment = range.createContextualFragment(valid.join(''));
      grid.appendChild(fragment);
      grid.hidden = false;
      if (loading) loading.hidden = true;

      // O <script> do product-card faz delegação no document e roda
      // hydrateVisualState() ao receber o evento, pintando o coração como
      // "ativo" (FILL 1) nos botões recém-inseridos. Como esse listener
      // testa pelo handle no localStorage, é seguro disparar aqui.
      // Para evitar loop com o re-render abaixo, marcamos uma flag.
      window.__amefavRehydrating = true;
      document.dispatchEvent(new CustomEvent('ame:wishlist-changed', { detail: { list: readList(), source: 'favoritos-render' } }));
      window.__amefavRehydrating = false;
    }

    render();
    document.addEventListener('ame:wishlist-changed', (e) => {
      // Ignora o evento que nós mesmos disparamos pra re-hidratar visual.
      if (window.__amefavRehydrating) return;
      if (e?.detail?.source === 'favoritos-render') return;
      render();
    });
  })();
</script>

<style>
  .ame-favoritos {
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .ame-favoritos__header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .ame-favoritos__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.1;
    color: var(--color-on-background, #201b14);
    margin: 0;
  }
  .ame-favoritos__subtitle {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant, #4f4442);
    line-height: 1.6;
    max-width: 36rem;
    margin: 1rem auto 0;
  }

  /* Grid reusa as mesmas regras de .ame-col-grid do catálogo
     (definidas em sections/collection.liquid) — aqui só garantimos o fallback
     caso essa página seja servida sem o CSS do collection. */
  .ame-col-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 0.75rem;
  }
  @media (min-width: 768px) {
    .ame-col-grid {
      gap: 2rem 1.5rem;
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 1280px) {
    .ame-col-grid {
      grid-template-columns: repeat(var(--grid-cols, 4), 1fr);
    }
  }

  .ame-favoritos__empty {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-favoritos__empty-icon {
    font-size: 4rem !important;
    color: rgba(90, 71, 66, 0.2);
    margin-bottom: 1rem;
    display: inline-block;
  }
  .ame-favoritos__empty p {
    font-size: 1rem;
    margin: 0;
  }
  .ame-favoritos__empty-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary, #5a4742);
    color: var(--color-on-primary, #fff);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* :not([hidden]) é necessário porque uma regra de classe com display:flex
     vence o [hidden]{display:none} da UA stylesheet — sem isso o spinner
     nunca desaparecia mesmo com loading.hidden = true no JS. */
  .ame-favoritos__loading:not([hidden]) {
    display: flex;
    justify-content: center;
    padding: 3rem 0;
  }
  /* Spinner CSS-only (sem depender do Material Symbols subset). Um anel com
     a parte de cima transparente girando — efeito clássico de loader. */
  .ame-favoritos__spinner {
    width: 2rem;
    height: 2rem;
    border: 3px solid rgba(90, 71, 66, 0.18);
    border-top-color: var(--color-primary, #5a4742);
    border-radius: 50%;
    animation: ame-fav-spin 0.9s linear infinite;
  }
  @keyframes ame-fav-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
</style>

{% schema %}
{
  "name": "Favoritos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Seus Favoritos" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo" },
    {
      "type": "range",
      "id": "cols_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Colunas (desktop wide ≥ 1280px)",
      "default": 4
    },
    { "type": "text", "id": "empty_message", "label": "Mensagem quando vazio", "default": "Você ainda não tem produtos favoritos." },
    { "type": "text", "id": "empty_cta_label", "label": "Texto do botão (vazio)", "default": "Explorar produtos" },
    { "type": "url", "id": "empty_cta_url", "label": "Link do botão (vazio)" }
  ],
  "presets": [
    { "name": "Favoritos" }
  ],
  "enabled_on": { "templates": ["page"] }
}
{% endschema %}
