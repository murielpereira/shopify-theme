{% comment %} Âme — Acordeões de detalhes do produto (extraído de product.liquid) {% endcomment %}

<div class="pdp-accordions full-width" data-pdp-accordions>
  {%- if section.settings.show_description and product.description != blank -%}
    <div class="ame-accordion">
      <button
        class="ame-accordion__btn"
        type="button"
        aria-expanded="true"
        aria-controls="pdp-acc-{{ section.id }}-desc"
      >
        <span>{{ section.settings.description_title | default: 'Descrição' }}</span>
        <span
          class="material-symbols-outlined ame-accordion__icon"
          style="font-variation-settings:'wght' 300;"
          aria-hidden="true"
          >add</span
        >
      </button>
      <div
        id="pdp-acc-{{ section.id }}-desc"
        class="ame-accordion__content"
        style="max-height: none;"
      >
        <div class="ame-accordion__body">{{ product.description }}</div>
      </div>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'accordion' -%}
      {%- liquid
        # Quando o accordion automático de Descrição está ligado, pula blocks que
        # claramente duplicam essa função (mesmo título ou contendo "descri"/"detalhes")
        # — evita o problema de aparecer "DESCRIÇÃO" + "DETALHES DO PRODUTO" iguais.
        assign block_title_dc = block.settings.title | downcase | strip
        assign desc_title_dc = section.settings.description_title | default: 'Descrição' | downcase | strip
        assign skip_block = false
        if section.settings.show_description and product.description != blank
          if block_title_dc == desc_title_dc
            assign skip_block = true
          elsif block_title_dc contains 'descri'
            assign skip_block = true
          elsif block_title_dc contains 'detalhes do produto'
            assign skip_block = true
          endif
        endif
      -%}
      {%- unless skip_block -%}
        <div class="ame-accordion" {{ block.shopify_attributes }}>
          <button
            class="ame-accordion__btn"
            type="button"
            aria-expanded="false"
            aria-controls="pdp-acc-{{ section.id }}-{{ forloop.index }}"
          >
            <span>{{ block.settings.title }}</span>
            <span
              class="material-symbols-outlined ame-accordion__icon"
              style="font-variation-settings:'wght' 300;"
              aria-hidden="true"
              >add</span
            >
          </button>
          <div id="pdp-acc-{{ section.id }}-{{ forloop.index }}" class="ame-accordion__content" hidden>
            <div class="ame-accordion__body">{{ block.settings.body }}</div>
          </div>
        </div>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if section.blocks.size == 0 and product.description != blank -%}
    <div class="ame-accordion">
      <button
        class="ame-accordion__btn"
        type="button"
        aria-expanded="true"
        aria-controls="pdp-acc-{{ section.id }}-default"
      >
        <span>Detalhes do Produto</span>
        <span
          class="material-symbols-outlined ame-accordion__icon"
          style="font-variation-settings:'wght' 300;"
          aria-hidden="true"
          >add</span
        >
      </button>
      <div
        id="pdp-acc-{{ section.id }}-default"
        class="ame-accordion__content"
        style="max-height: none;"
      >
        <div class="ame-accordion__body">{{ product.description }}</div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (() => {
    /* Toggle dos acordeões — limitado a esta section pra não conflitar com outras */
    const root = document.querySelector('[data-pdp-accordions]');
    if (!root) return;
    root.querySelectorAll('.ame-accordion__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        root.querySelectorAll('.ame-accordion__btn').forEach((b) => {
          b.setAttribute('aria-expanded', 'false');
          b.nextElementSibling.setAttribute('hidden', '');
          b.nextElementSibling.style.maxHeight = '0';
        });
        if (!open) {
          btn.setAttribute('aria-expanded', 'true');
          btn.nextElementSibling.removeAttribute('hidden');
          btn.nextElementSibling.style.maxHeight = 'none';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Detalhes do Produto",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Acordeões exibidos na página do produto, abaixo da imagem e do botão Adicionar ao Carrinho. Adicione blocos abaixo. Se não houver blocos cadastrados, o tema exibe automaticamente um acordeão único com a descrição do produto."
    },
    {
      "type": "header",
      "content": "Descrição do produto"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Incluir um acordeão com a descrição completa do produto",
      "info": "Renderiza o campo Descrição cadastrado em Produtos → [produto].",
      "default": true
    },
    {
      "type": "text",
      "id": "description_title",
      "label": "Título do acordeão de descrição",
      "default": "Descrição"
    }
  ],
  "blocks": [
    {
      "type": "accordion",
      "name": "Acordeão",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Materiais & Craft" },
        { "type": "richtext", "id": "body", "label": "Conteúdo", "default": "<p>Descreva os materiais, tamanhos ou instruções de cuidado.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Detalhes do Produto",
      "blocks": [
        { "type": "accordion", "settings": { "title": "Materiais & Craft" } },
        { "type": "accordion", "settings": { "title": "Guia de Tamanhos" } },
        { "type": "accordion", "settings": { "title": "Cuidados & Manutenção" } },
        { "type": "accordion", "settings": { "title": "Envio & Embalagem" } }
      ]
    }
  ],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
