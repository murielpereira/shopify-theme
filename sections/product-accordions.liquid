{% comment %} Âme — Acordeões de detalhes do produto + Depois da compra + FAQ {% endcomment %}

{%- liquid
  # String pesquisável de tags do produto, em lowercase, com pipes como
  # sentinelas em volta de cada tag — formato '|tag1|tag2|tag3|'. Usada por:
  #   - Filtro de tags do bloco "Depois da compra" (etapas condicionais)
  #   - Filtro de tags dos blocks FAQ (whitelist por pergunta)
  # Pipes evitam que 'couro' case com 'couro_legitimo' (match exato, não substring).
  assign product_tags_search = product.tags | join: '|' | downcase | prepend: '|' | append: '|'
-%}

{%- comment -%}
  ⚡ Bolt: Optimize conditional rendering loops
  💡 What: Removed duplicate iteration for steps and FAQs by using `{% capture %}` to build the HTML in one pass.
  🎯 Why: Looping twice (once to detect visibility, once to render) doubles the Liquid processing overhead.
  📊 Impact: Reduces template evaluation time and improves backend TTFB.
{%- endcomment -%}

{%- capture after_purchase_steps_html -%}
  {%- if section.settings.show_after_purchase -%}
    {%- for i in (1..8) -%}
      {%- liquid
        assign emoji_key = 'step_' | append: i | append: '_emoji'
        assign title_key = 'step_' | append: i | append: '_title'
        assign tags_key = 'step_' | append: i | append: '_tags_filter'
        assign step_emoji = section.settings[emoji_key]
        assign step_title = section.settings[title_key]

        if step_title == blank
          continue
        endif

        assign step_visible = true
        if section.settings[tags_key] != blank
          assign step_visible = false
          assign step_filter_tags = section.settings[tags_key] | downcase | split: ','
          for sft in step_filter_tags
            assign sft_clean = sft | strip
            if sft_clean == blank
              continue
            endif
            assign sft_needle = sft_clean | prepend: '|' | append: '|'
            if product_tags_search contains sft_needle
              assign step_visible = true
              break
            endif
          endfor
        endif
      -%}
      {%- if step_visible -%}
        <li class="pdp__after-purchase__step">
          {%- if step_emoji != blank -%}
            <span class="pdp__after-purchase__emoji" aria-hidden="true">{{ step_emoji }}</span>
          {%- endif -%}
          <span class="pdp__after-purchase__step-title">{{ step_title }}</span>
        </li>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign after_purchase_steps_html = after_purchase_steps_html | strip -%}

{%- capture global_faqs_html -%}
  {%- if section.settings.show_faq -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'faq' and block.settings.question != blank -%}
        {%- liquid
          assign faq_visible = true
          if block.settings.tags_filter != blank
            assign faq_visible = false
            assign filter_tags = block.settings.tags_filter | downcase | split: ','
            for ft in filter_tags
              assign ft_clean = ft | strip
              if ft_clean == blank
                continue
              endif
              assign ft_needle = ft_clean | prepend: '|' | append: '|'
              if product_tags_search contains ft_needle
                assign faq_visible = true
                break
              endif
            endfor
          endif
        -%}
        {%- if faq_visible -%}
          <details class="pdp__faq__item" {{ block.shopify_attributes }}>
            <summary class="pdp__faq__question">
              <span>{{ block.settings.question }}</span>
              <span class="pdp__faq__toggle" aria-hidden="true">+</span>
            </summary>
            <div class="pdp__faq__answer">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- assign global_faqs_html = global_faqs_html | strip -%}

{%- liquid
  assign has_steps = false
  if after_purchase_steps_html != blank
    assign has_steps = true
  endif

  assign has_global_faq = false
  if global_faqs_html != blank
    assign has_global_faq = true
  endif

  # Detector FAQ por produto (metafield rich text custom.faq).
  assign product_faq = product.metafields.custom.faq
  assign has_product_faq = false
  if section.settings.show_faq and product_faq != blank
    assign has_product_faq = true
  endif

  # O accordion de Descrição abre se HOUVER qualquer conteúdo: descrição
  # textual, etapas do Depois da compra ou FAQ. Sem isso, produtos sem
  # descrição perdiam tudo (Depois da compra + FAQ eram filhos do accordion).
  assign show_desc_accordion = false
  if section.settings.show_description
    if product.description != blank or has_steps or has_global_faq or has_product_faq
      assign show_desc_accordion = true
    endif
  endif
-%}

<div class="pdp-accordions full-width" data-pdp-accordions>
  {%- if show_desc_accordion -%}
    <div class="ame-accordion">
      <button
        class="ame-accordion__btn"
        type="button"
        aria-expanded="true"
        aria-controls="pdp-acc-{{ section.id }}-desc"
      >
        <span>{{ section.settings.description_title | default: 'Descrição' }}</span>
        <span
          class="material-symbols-outlined ame-accordion__icon"
          style="font-variation-settings:'wght' 300;"
          aria-hidden="true"
          >add</span
        >
      </button>
      <div
        id="pdp-acc-{{ section.id }}-desc"
        class="ame-accordion__content"
        style="max-height: none;"
      >
        <div class="ame-accordion__body">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- endif -%}

          {%- comment -%}
            Bloco "Depois da compra" — 8 etapas configuráveis na section.
            has_steps já foi calculado no topo do template (junto com filtros
            de tag por etapa). Aparece embutido no acordeão de Descrição.
          {%- endcomment -%}
          {%- if has_steps -%}
            <div class="pdp__after-purchase">
              <h2 class="pdp__after-purchase__title">
                {{ section.settings.after_purchase_title | default: 'O que acontece depois da compra' }}
              </h2>
              <ol class="pdp__after-purchase__steps">
                {{ after_purchase_steps_html }}
              </ol>
            </div>
          {%- endif -%}

          {%- comment -%}
            FAQ — globais (definidas na section) + específicas do produto
            (metafield product.metafields.custom.faq, rich text com cada
            pergunta como <h3> ou <h4> seguida pelo conteúdo da resposta).
          {%- endcomment -%}
          {%- comment -%}
            has_global_faq / has_product_faq foram calculados no topo do template.
          {%- endcomment -%}
          {%- if has_global_faq or has_product_faq -%}
            <div class="pdp__faq">
              <h2 class="pdp__faq__title">
                {{ section.settings.faq_title | default: 'Perguntas Frequentes' }}
              </h2>
              <div class="pdp__faq__list" data-pdp-faq>
                {{ global_faqs_html }}

                {%- if has_product_faq -%}
                  {%- comment -%}
                    O metafield é rich text. Cada pergunta deve ser um Título
                    (H1..H6 no editor), seguido pelo conteúdo da resposta até
                    o próximo Título. O filtro `metafield_tag` converte o
                    rich text (que internamente é JSON) em HTML — sem ele,
                    o {{ product_faq }} renderiza o JSON cru como texto.
                    Renderizamos o HTML como bloco extra abaixo das FAQ
                    globais — o JS abaixo converte em <details> reais.
                  {%- endcomment -%}
                  <div class="pdp__faq__product-source" data-pdp-faq-source hidden>
                    {{ product.metafields.custom.faq | metafield_tag }}
                  </div>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- for block in section.blocks -%}
    {%- if block.type == 'accordion' -%}
      {%- liquid
        assign block_title_dc = block.settings.title | downcase | strip
        assign desc_title_dc = section.settings.description_title | default: 'Descrição' | downcase | strip
        assign skip_block = false
        if section.settings.show_description and product.description != blank
          if block_title_dc == desc_title_dc
            assign skip_block = true
          elsif block_title_dc contains 'descri'
            assign skip_block = true
          elsif block_title_dc contains 'detalhes do produto'
            assign skip_block = true
          endif
        endif
      -%}
      {%- unless skip_block -%}
        <div class="ame-accordion" {{ block.shopify_attributes }}>
          <button
            class="ame-accordion__btn"
            type="button"
            aria-expanded="false"
            aria-controls="pdp-acc-{{ section.id }}-{{ forloop.index }}"
          >
            <span>{{ block.settings.title }}</span>
            <span
              class="material-symbols-outlined ame-accordion__icon"
              style="font-variation-settings:'wght' 300;"
              aria-hidden="true"
              >add</span
            >
          </button>
          <div id="pdp-acc-{{ section.id }}-{{ forloop.index }}" class="ame-accordion__content" hidden>
            <div class="ame-accordion__body">{{ block.settings.body }}</div>
          </div>
        </div>
      {%- endunless -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if section.blocks.size == 0 and product.description != blank -%}
    <div class="ame-accordion">
      <button
        class="ame-accordion__btn"
        type="button"
        aria-expanded="true"
        aria-controls="pdp-acc-{{ section.id }}-default"
      >
        <span>Detalhes do Produto</span>
        <span
          class="material-symbols-outlined ame-accordion__icon"
          style="font-variation-settings:'wght' 300;"
          aria-hidden="true"
          >add</span
        >
      </button>
      <div
        id="pdp-acc-{{ section.id }}-default"
        class="ame-accordion__content"
        style="max-height: none;"
      >
        <div class="ame-accordion__body">{{ product.description }}</div>
      </div>
    </div>
  {%- endif -%}
</div>

<script>
  (() => {
    /* Toggle dos acordeões — limitado a esta section pra não conflitar com outras */
    const root = document.querySelector('[data-pdp-accordions]');
    if (!root) return;
    root.querySelectorAll('.ame-accordion__btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const open = btn.getAttribute('aria-expanded') === 'true';
        root.querySelectorAll('.ame-accordion__btn').forEach((b) => {
          b.setAttribute('aria-expanded', 'false');
          b.nextElementSibling.setAttribute('hidden', '');
          b.nextElementSibling.style.maxHeight = '0';
        });
        if (!open) {
          btn.setAttribute('aria-expanded', 'true');
          btn.nextElementSibling.removeAttribute('hidden');
          btn.nextElementSibling.style.maxHeight = 'none';
        }
      });
    });

    /* FAQ por produto — converte o rich text do metafield em <details> reais.
       O lojista escreve no admin do Shopify usando o editor visual: cada
       pergunta vira um heading (Título 1..6 no editor visual = h1..h6 no
       HTML), e o conteúdo abaixo até o próximo heading vira a resposta. */
    const faqSource = root.querySelector('[data-pdp-faq-source]');
    const faqList = root.querySelector('[data-pdp-faq]');
    if (faqSource && faqList) {
      const HEADING_RE = /^H[1-6]$/;
      const headings = faqSource.querySelectorAll('h1, h2, h3, h4, h5, h6');
      headings.forEach((heading) => {
        const question = heading.textContent.trim();
        if (!question) return;

        /* Coleta tudo entre este heading e o próximo (ou fim do source). */
        const answerNodes = [];
        let next = heading.nextElementSibling;
        while (next && !HEADING_RE.test(next.tagName)) {
          answerNodes.push(next);
          next = next.nextElementSibling;
        }

        const details = document.createElement('details');
        details.className = 'pdp__faq__item pdp__faq__item--product';
        details.innerHTML =
          '<summary class="pdp__faq__question">' +
          '<span></span>' +
          '<span class="pdp__faq__toggle" aria-hidden="true">+</span>' +
          '</summary>' +
          '<div class="pdp__faq__answer"></div>';
        details.querySelector('summary span').textContent = question;
        const answerEl = details.querySelector('.pdp__faq__answer');
        answerNodes.forEach((n) => answerEl.appendChild(n.cloneNode(true)));

        faqList.appendChild(details);
      });
      faqSource.remove();
    }
  })();
</script>

{% stylesheet %}
  /* ── Depois da compra ── */
  .pdp__after-purchase {
    margin-top: 2rem;
    padding: 1.5rem;
    background: var(--color-surface-light);
    border-radius: var(--radius-lg, 12px);
  }
  .pdp__after-purchase__title {
    text-align: center;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-on-background, #3d2d1c);
    margin: 0 0 1.5rem;
  }
  .pdp__after-purchase__steps {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 600px) {
    .pdp__after-purchase__steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .pdp__after-purchase__step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
  }
  .pdp__after-purchase__emoji {
    font-size: 1.875rem;
    line-height: 1;
  }
  .pdp__after-purchase__step-title {
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--color-on-surface-variant, #5a4b46);
  }

  /* ── FAQ ── */
  .pdp__faq {
    margin-top: 2rem;
  }
  .pdp__faq__title {
    text-align: center;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-on-background, #3d2d1c);
    margin: 0 0 1.5rem;
  }
  .pdp__faq__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pdp__faq__item {
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-outline-variant, #e0d5c7);
    border-radius: var(--radius-lg, 12px);
    overflow: hidden;
  }
  .pdp__faq__question {
    list-style: none;
    padding: 1rem 1.25rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-on-background, #3d2d1c);
    transition: background 0.2s ease;
  }
  .pdp__faq__question::-webkit-details-marker {
    display: none;
  }
  .pdp__faq__question:hover {
    background: var(--color-surface-light);
  }
  .pdp__faq__toggle {
    flex-shrink: 0;
    font-size: 1.25rem;
    font-weight: 400;
    color: var(--color-primary, #5a4742);
    transition: transform 0.25s ease;
  }
  .pdp__faq__item[open] .pdp__faq__toggle {
    transform: rotate(45deg);
  }
  .pdp__faq__answer {
    padding: 0 1.25rem 1.25rem;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-on-surface-variant, #5a4b46);
  }
  .pdp__faq__answer p:first-child {
    margin-top: 0;
  }
  .pdp__faq__answer p:last-child {
    margin-bottom: 0;
  }
  .pdp__faq__answer a {
    color: var(--color-primary, #5a4742);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
{% endstylesheet %}

{% schema %}
