{% comment %} Home — Brand Story {% endcomment %}

<section class="ame-story" data-story>
  <div class="ame-story__inner">
    <!-- Text column -->
    <div class="ame-story__text ame-reveal">
      {%- if section.settings.eyebrow != blank -%}
        <p class="ame-label-sm">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="ame-story__title">{{ section.settings.title }}</h2>

      {%- comment -%}
        No mobile essa seção fica muito longa e empurra o resto da home pra baixo.
        Colapsa body + stats num wrapper; o botão "Ler mais" abaixo alterna via JS.
        No desktop (>=768px) o wrapper fica sempre visível e o botão hidden.
      {%- endcomment -%}
      {%- comment -%}
        Body fica FORA do collapse — no mobile fechado ele aparece como teaser
        com `-webkit-line-clamp: 3`, e ao expandir libera todas as linhas +
        stats + imagem. Assim o cliente lê algumas linhas antes de decidir
        clicar em "Ler mais".
      {%- endcomment -%}
      {%- if section.settings.body != blank -%}
        <div class="ame-story__body">{{ section.settings.body }}</div>
      {%- endif -%}

      <div class="ame-story__collapse" data-story-collapse id="ame-story-collapse-{{ section.id }}">
        <!-- Stats grid -->
        {%- if section.blocks.size > 0 -%}
          <div class="ame-story__stats">
            {%- for block in section.blocks -%}
              {%- if block.type == 'stat' -%}
                <div class="ame-story__stat" {{ block.shopify_attributes }}>
                  <p class="ame-story__stat-value">{{ block.settings.value }}</p>
                  <p class="ame-story__stat-label">{{ block.settings.label }}</p>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <!-- Image column — vive dentro do collapse pra que no mobile ela
             seja parte do conteúdo colapsado. No desktop, o CSS usa
             `display: contents` no text+collapse pra promover a imagem
             de volta pra col 2 do grid principal. -->
        <div class="ame-story__image-col ame-reveal">
          <div class="ame-story__image-wrap">
            {%- if section.settings.image != blank -%}
              {% comment %}
                ⚡ Bolt: Eager load the LCP image in Brand Story section
                💡 What: Apply `loading: 'eager'` and `fetchpriority: 'high'` to the image.
                🎯 Why: Hardcoding `loading: 'lazy'` for this LCP candidate image delays rendering and perceived load time.
                📊 Impact: Improves LCP Web Vital metric significantly.
                🔬 Measurement: Profile the LCP metric on pages containing this section.
              {% endcomment %}
              {{
                section.settings.image
                | image_url: width: 900
                | image_tag:
                  widths: '300, 600, 900',
                  loading: 'eager',
                  fetchpriority: 'high',
                  class: 'ame-story__image',
                  alt: section.settings.image.alt
                | escape
              }}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'ame-story__image ame-story__image--placeholder' }}
            {%- endif -%}
          </div>

          <!-- Floating satisfaction chip -->
          {%- if section.settings.floating_label != blank -%}
            <div class="ame-story__float-chip">
              <p class="ame-story__float-label">{{ section.settings.floating_eyebrow }}</p>
              <p class="ame-story__float-value">{{ section.settings.floating_label }}</p>
              {%- if section.settings.floating_sublabel != blank -%}
                <p class="ame-story__float-sub">{{ section.settings.floating_sublabel }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>

      <button
        type="button"
        class="ame-story__toggle"
        data-story-toggle
        aria-expanded="false"
        aria-controls="ame-story-collapse-{{ section.id }}"
      >
        <span data-story-toggle-label>Ler mais</span>
        <span class="material-symbols-outlined ame-story__toggle-icon" aria-hidden="true">expand_more</span>
      </button>
    </div>
  </div>
</section>

{% stylesheet %}
  /* Lateral vem do grid da .shopify-section. */
  .ame-story {
    padding-block: var(--section-gap, 7.5rem);
  }

  .ame-story__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .ame-story__inner {
      grid-template-columns: 1fr 1fr;
      gap: 5rem;
    }
  }

  .ame-story__title {
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-on-surface-variant);
    margin-bottom: 2rem;
  }
  .ame-story__title em {
    font-style: italic;
    font-weight: 300;
    color: var(--color-primary, #5a4742);
  }

  .ame-story__body {
    font-size: 1rem;
    line-height: 1.9;
    color: var(--color-on-surface-variant, #4f4442);
    margin-bottom: 3rem;
  }
  .ame-story__body p + p {
    margin-top: 1rem;
  }

  .ame-story__stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(210, 195, 192, 0.2);
  }
  @media (min-width: 600px) {
    .ame-story__stats {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .ame-story__stat-value {
    font-size: 1.875rem;
    font-weight: 700;
    color: var(--color-on-surface-variant);
  }
  .ame-story__stat-label {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(90, 71, 66, 0.5);
    margin-top: 0.25rem;
  }

  /* Image */
  .ame-story__image-col {
    position: relative;
  }

  .ame-story__image-wrap {
    border-radius: var(--radius-lg, 0.5rem);
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--color-surface-container-highest, #ece1d5);
    box-shadow: var(--shadow-float, 0 32px 64px rgba(32, 27, 20, 0.06));
  }

  .ame-story__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    mix-blend-mode: multiply;
    opacity: 0.9;
  }
  .ame-story__image--placeholder {
    opacity: 0.3;
  }

  /* Floating chip */
  .ame-story__float-chip {
    position: absolute;
    bottom: -1.5rem;
    left: -1.5rem;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: var(--radius-lg, 0.5rem);
    padding: 1.5rem;
    box-shadow: var(--shadow-ambient, 0 16px 32px rgba(32, 27, 20, 0.06));
  }

  .ame-story__float-label {
    font-size: 0.625rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(90, 71, 66, 0.5);
    margin-bottom: 0.25rem;
  }
  .ame-story__float-value {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-on-background, #201b14);
  }
  .ame-story__float-sub {
    font-size: 0.625rem;
    color: rgba(90, 71, 66, 0.5);
    margin-top: 0.25rem;
  }

  /* ── Collapse mobile ──
     No mobile a section fica muito longa e empurra o resto da home; escondemos
     stats + imagem e mostramos um teaser do body + botão "Ler mais". No
     desktop (>=768px) o comportamento default é sempre expandido — o botão
     fica hidden e o body volta ao normal. */
  .ame-story__collapse {
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.35s ease;
  }
  .ame-story[data-story-open='true'] .ame-story__collapse {
    /* Valor alto pra caber o conteúdo real. Como o transition é em max-height,
       o efeito visual segue proporcional à altura real do conteúdo. */
    max-height: 2000px;
  }

  /* Teaser do body — no mobile fechado, corta em 3 linhas e mostra reticências.
     Ao abrir (data-story-open="true"), libera as linhas. */
  @media (max-width: 767px) {
    .ame-story:not([data-story-open='true']) .ame-story__body {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 0;
    }
  }
  .ame-story__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.125rem;
    margin-top: 1.5rem;
    background: transparent;
    border: 1px solid var(--color-primary, #5a4742);
    color: var(--color-primary, #5a4742);
    border-radius: 999px;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease;
  }
  .ame-story__toggle:hover {
    background: var(--color-primary, #5a4742);
    color: #fff;
  }
  .ame-story__toggle-icon {
    font-size: 1.125rem;
    transition: transform 0.25s ease;
  }
  .ame-story[data-story-open='true'] .ame-story__toggle-icon {
    transform: rotate(180deg);
  }

  @media (min-width: 768px) {
    /* Desktop: sem colapso. Wrapper sempre visível, botão sumido.
       display:contents no text+collapse "achata" a árvore — os filhos
       (eyebrow/title/body/stats/image-col/etc) passam a ser células
       diretas do grid `.ame-story__inner` (2-col), permitindo mandar
       a image-col pra col 2 mesmo estando aninhada no markup. */
    .ame-story__collapse {
      max-height: none;
      overflow: visible;
      display: contents;
    }
    .ame-story__text {
      display: contents;
    }
    .ame-story__toggle {
      display: none;
    }
    /* Tudo do texto vai pra col 1 do grid pai */
    .ame-story__inner > .ame-story__text > .ame-label-sm,
    .ame-story__inner > .ame-story__text > .ame-story__title,
    .ame-story__inner > .ame-story__text > .ame-story__body,
    .ame-story__inner .ame-story__collapse > .ame-story__stats {
      grid-column: 1;
    }
    /* Imagem vai pra col 2 e ocupa a altura toda (span de todas as rows) */
    .ame-story__inner .ame-story__collapse > .ame-story__image-col {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: center;
    }
  }
{% endstylesheet %}

<script>
  (() => {
    document.querySelectorAll('[data-story]').forEach((section) => {
      const btn = section.querySelector('[data-story-toggle]');
      const label = section.querySelector('[data-story-toggle-label]');
      if (!btn) return;
      btn.addEventListener('click', () => {
        const open = section.dataset.storyOpen === 'true';
        section.dataset.storyOpen = open ? 'false' : 'true';
        btn.setAttribute('aria-expanded', open ? 'false' : 'true');
        if (label) label.textContent = open ? 'Ler mais' : 'Ler menos';
      });
    });
  })();
</script>

{% schema %}
{
  "name": "História da Marca",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Texto acima do título",
      "default": "Nossa Filosofia"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Título",
      "default": "<p>Elegância<br><em>Aerodinámica.</em></p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto",
      "default": "<p>Cada peça Âme nasce do encontro entre a precisão da engenharia de alta performance e o artesanato minucioso dos grandes ateliês italianos.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagem"
    },
    {
      "type": "header",
      "content": "Chip flutuante"
    },
    {
      "type": "text",
      "id": "floating_eyebrow",
      "label": "Rótulo",
      "default": "Satisfação"
    },
    {
      "type": "text",
      "id": "floating_label",
      "label": "Valor",
      "default": "98.7%"
    },
    {
      "type": "text",
      "id": "floating_sublabel",
      "label": "Sublabel",
      "default": "de clientes satisfeitos"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Estatística",
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "7+" },
        { "type": "text", "id": "label", "label": "Rótulo", "default": "Anos de Craft" }
      ]
    }
  ],
  "presets": [
    {
      "name": "História da Marca",
      "blocks": [
        { "type": "stat", "settings": { "value": "7+", "label": "Anos de Craft" } },
        { "type": "stat", "settings": { "value": "3", "label": "Curtumes" } },
        { "type": "stat", "settings": { "value": "∞", "label": "Durabilidade" } }
      ]
    }
  ],
  "disabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
