{% comment %}
  Dashboard da conta — paleta Âme aplicada sobre o customer object nativo.
  Mostra: saudação + lista de pedidos + atalho pra endereços + logout.
{% endcomment %}

<section class="ame-account">
  <header class="ame-account__hero">
    <h1 class="ame-account__title">Olá, {{ customer.first_name | default: customer.name }}</h1>
    <p class="ame-account__sub">Bem-vindo de volta à sua conta Âme.</p>
    <a href="{{ routes.account_logout_url }}" class="ame-account__logout">
      <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      Sair
    </a>
  </header>

  <div class="ame-account__grid">
    <!-- Coluna principal: pedidos -->
    <div class="ame-account__main">
      <h2 class="ame-account__section-title">Meus pedidos</h2>

      {%- if customer.orders.size > 0 -%}
        <ul class="ame-account__orders" aria-label="Pedidos">
          {%- for order in customer.orders -%}
            <li class="ame-account__order">
              <div class="ame-account__order-head">
                <a href="{{ order.customer_url }}" class="ame-account__order-name">
                  {{ order.name }}
                </a>
                <span class="ame-account__order-status ame-account__order-status--{{ order.financial_status | default: 'pending' | handle }}">
                  {{ order.financial_status_label }}
                </span>
              </div>
              <dl class="ame-account__order-meta">
                <div>
                  <dt>Data</dt>
                  <dd>{{ order.created_at | date: '%d/%m/%Y' }}</dd>
                </div>
                <div>
                  <dt>Total</dt>
                  <dd>{{ order.total_price | money }}</dd>
                </div>
                <div>
                  <dt>Itens</dt>
                  <dd>{{ order.item_count }}</dd>
                </div>
                <div>
                  <dt>Envio</dt>
                  <dd>{{ order.fulfillment_status_label | default: 'Aguardando' }}</dd>
                </div>
              </dl>
              <a href="{{ order.customer_url }}" class="ame-account__order-link">
                Ver detalhes
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        {{ paginate | default_pagination }}
      {%- else -%}
        <div class="ame-account__empty">
          <span class="material-symbols-outlined ame-account__empty-icon" aria-hidden="true">shopping_bag</span>
          <p>Você ainda não fez nenhum pedido.</p>
          <a href="{{ routes.all_products_collection_url }}" class="ame-cta">
            Explorar produtos
            <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Coluna lateral: dados + atalhos -->
    <aside class="ame-account__side">
      <div class="ame-account__card">
        <h3 class="ame-account__card-title">Dados pessoais</h3>
        <p class="ame-account__card-value">{{ customer.name }}</p>
        <p class="ame-account__card-sub">{{ customer.email }}</p>
      </div>

      <div class="ame-account__card">
        <h3 class="ame-account__card-title">Endereços</h3>
        {%- if customer.default_address -%}
          <p class="ame-account__card-value">{{ customer.default_address.street }}</p>
          <p class="ame-account__card-sub">
            {{ customer.default_address.city }} — {{ customer.default_address.province_code }}
            <br>
            CEP {{ customer.default_address.zip }}
          </p>
        {%- else -%}
          <p class="ame-account__card-sub">Nenhum endereço cadastrado.</p>
        {%- endif -%}
        <a href="{{ routes.account_addresses_url }}" class="ame-account__card-link">
          Gerenciar endereços
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </a>
      </div>

      <a href="/pages/rastreamento" class="ame-account__card ame-account__card--cta">
        <span class="material-symbols-outlined" aria-hidden="true">local_shipping</span>
        <div>
          <h3 class="ame-account__card-title">Rastrear pedido</h3>
          <p class="ame-account__card-sub">Acompanhe a entrega em tempo real</p>
        </div>
        <span class="material-symbols-outlined ame-account__card-chevron" aria-hidden="true">arrow_forward</span>
      </a>
    </aside>
  </div>
</section>

<style>
  .ame-account {
    padding: clamp(2rem, 5vw, 4rem) var(--page-margin, 16px);
    color: var(--color-on-background, #201b14);
    max-width: 72rem;
    margin: 0 auto;
  }
  .ame-account__hero {
    position: relative;
    margin-bottom: 2.5rem;
  }
  .ame-account__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.375rem;
    color: var(--color-on-background, #201b14);
  }
  .ame-account__sub {
    color: var(--color-on-surface-variant, #4f4442);
    font-size: 0.9375rem;
    margin: 0;
  }
  .ame-account__logout {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-on-surface-variant, #4f4442);
    text-decoration: none;
    padding: 0.5rem 0.875rem;
    border-radius: 999px;
    border: 1px solid rgba(210, 195, 192, 0.5);
    transition: background 0.15s ease;
  }
  .ame-account__logout:hover {
    background: rgba(248, 236, 224, 0.5);
  }
  .ame-account__logout .material-symbols-outlined {
    font-size: 1rem;
  }

  .ame-account__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .ame-account__grid {
      grid-template-columns: 2fr 1fr;
      gap: 3rem;
    }
  }

  .ame-account__section-title {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0 0 1rem;
  }

  /* Pedidos */
  .ame-account__orders {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ame-account__order {
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1rem;
    padding: 1.25rem;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .ame-account__order:hover {
    border-color: rgba(90, 71, 66, 0.25);
    box-shadow: 0 4px 14px rgba(32, 27, 20, 0.06);
  }
  .ame-account__order-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.875rem;
    flex-wrap: wrap;
  }
  .ame-account__order-name {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-on-background, #201b14);
    text-decoration: none;
  }
  .ame-account__order-status {
    display: inline-flex;
    padding: 0.25rem 0.625rem;
    background: rgba(248, 236, 224, 0.7);
    color: var(--color-on-background, #201b14);
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .ame-account__order-status--paid {
    background: rgba(120, 169, 122, 0.18);
    color: #2f5f33;
  }
  .ame-account__order-status--refunded,
  .ame-account__order-status--voided {
    background: rgba(201, 123, 106, 0.15);
    color: #8a4032;
  }
  .ame-account__order-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.875rem 1.5rem;
    margin: 0 0 1rem;
  }
  .ame-account__order-meta dt {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
    margin-bottom: 0.125rem;
  }
  .ame-account__order-meta dd {
    margin: 0;
    font-weight: 500;
    color: var(--color-on-background, #201b14);
  }
  .ame-account__order-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary, #5a4742);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
  }
  .ame-account__order-link .material-symbols-outlined {
    font-size: 1rem;
    transition: transform 0.15s ease;
  }
  .ame-account__order-link:hover .material-symbols-outlined {
    transform: translateX(2px);
  }

  /* Estado vazio */
  .ame-account__empty {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px dashed rgba(210, 195, 192, 0.6);
    border-radius: 1rem;
  }
  .ame-account__empty-icon {
    font-size: 3.5rem;
    color: rgba(210, 195, 192, 0.8);
    margin-bottom: 0.75rem;
  }
  .ame-account__empty p {
    margin: 0 0 1.5rem;
    color: var(--color-on-surface-variant, #4f4442);
  }

  /* Side cards */
  .ame-account__side {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ame-account__card {
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1rem;
    padding: 1.25rem;
    text-decoration: none;
    color: var(--color-on-background, #201b14);
  }
  .ame-account__card-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0 0 0.5rem;
  }
  .ame-account__card-value {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }
  .ame-account__card-sub {
    font-size: 0.875rem;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0;
    line-height: 1.5;
  }
  .ame-account__card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 0.75rem;
    color: var(--color-primary, #5a4742);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ame-account__card-link .material-symbols-outlined {
    font-size: 1rem;
  }

  /* Card CTA (Rastrear) */
  .ame-account__card--cta {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    background: rgba(248, 236, 224, 0.5);
    border-color: rgba(210, 195, 192, 0.6);
    cursor: pointer;
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .ame-account__card--cta:hover {
    background: rgba(248, 236, 224, 0.85);
    transform: translateY(-1px);
  }
  .ame-account__card--cta > .material-symbols-outlined:first-child {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary, #5a4742);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    flex-shrink: 0;
  }
  .ame-account__card--cta > div {
    flex: 1;
    min-width: 0;
  }
  .ame-account__card-chevron {
    color: var(--color-primary, #5a4742);
    font-size: 1.25rem;
  }
</style>
