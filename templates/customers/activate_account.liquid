{% comment %}
  Ativação de conta — cliente clica no link do email de boas-vindas e
  define a senha aqui (primeira senha após ativação).
{% endcomment %}

<section class="ame-auth">
  <div class="ame-auth__inner">
    <header class="ame-auth__header">
      <h1 class="ame-auth__title">Ativar sua conta</h1>
      <p class="ame-auth__sub">Crie uma senha para começar a usar sua conta Âme.</p>
    </header>

    {% form 'activate_customer_password', class: 'ame-auth__form' %}
      {%- if form.errors -%}
        <div class="ame-auth__alert ame-auth__alert--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <label class="ame-auth__field">
        <span class="ame-auth__label">Senha</span>
        <input type="password" name="customer[password]" autocomplete="new-password" minlength="5" required>
      </label>

      <label class="ame-auth__field">
        <span class="ame-auth__label">Confirmar senha</span>
        <input type="password" name="customer[password_confirmation]" autocomplete="new-password" minlength="5" required>
      </label>

      <button type="submit" class="ame-cta ame-auth__submit">
        Ativar conta
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </button>

      <button type="submit" name="decline" value="decline" class="ame-auth__decline">
        Recusar convite
      </button>
    {% endform %}
  </div>
</section>

{% stylesheet %}
  .ame-auth {
    padding: clamp(2rem, 5vw, 4rem) var(--page-margin, 16px);
    color: var(--color-on-background, #201b14);
  }
  .ame-auth__inner {
    max-width: 28rem;
    margin: 0 auto;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 2px 12px rgba(32, 27, 20, 0.04);
  }
  .ame-auth__header { text-align: center; margin-bottom: 2rem; }
  .ame-auth__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0 0 0.5rem;
  }
  .ame-auth__sub {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0;
  }
  .ame-auth__form { display: flex; flex-direction: column; gap: 1rem; }
  .ame-auth__field { display: flex; flex-direction: column; gap: 0.375rem; }
  .ame-auth__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-auth__field input {
    border: 1px solid rgba(210, 195, 192, 0.5);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
    font-family: inherit;
    font-size: 16px;
    background: var(--color-surface-container-lowest, #fff);
  }
  .ame-auth__field input:focus {
    outline: none;
    border-color: var(--color-primary, #5a4742);
    box-shadow: 0 0 0 3px rgba(90, 71, 66, 0.12);
  }
  .ame-auth__submit { margin-top: 0.5rem; justify-content: center; }
  .ame-auth__decline {
    background: transparent;
    border: 0;
    color: var(--color-on-surface-variant, #8a7d7b);
    font-size: 0.8125rem;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
    padding: 0.5rem;
    margin-top: 0.25rem;
  }
  .ame-auth__alert {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    background: rgba(201, 123, 106, 0.12);
    color: #8a4032;
    border: 1px solid rgba(201, 123, 106, 0.3);
  }
  .ame-auth__alert ul { margin: 0; padding-left: 1.25rem; }
{% endstylesheet %}
