{% comment %}
  Endereços do cliente — listar/adicionar/editar/deletar.
  Usa os forms nativos `customer_address` do Shopify.
{% endcomment %}

<section class="ame-addresses">
  <header class="ame-addresses__hero">
    <a href="{{ routes.account_url }}" class="ame-addresses__back">
      <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
      Voltar à conta
    </a>
    <h1 class="ame-addresses__title">Meus endereços</h1>
  </header>

  <!-- Formulário pra novo endereço (toggle) -->
  <details class="ame-addresses__new">
    <summary class="ame-cta ame-addresses__new-toggle">
      <span class="material-symbols-outlined" aria-hidden="true">add</span>
      Adicionar novo endereço
    </summary>
    <div class="ame-addresses__form-wrap">
      {% form 'customer_address', customer.new_address, class: 'ame-addresses__form' %}
        {%- if form.errors -%}
          <div class="ame-addresses__alert" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        {%- render 'address-form-fields', form: form, address: customer.new_address -%}
        <div class="ame-addresses__form-actions">
          <button type="submit" class="ame-cta">Salvar endereço</button>
        </div>
      {% endform %}
    </div>
  </details>

  <!-- Lista de endereços existentes -->
  {%- if customer.addresses.size > 0 -%}
    <ul class="ame-addresses__list">
      {%- for address in customer.addresses -%}
        <li class="ame-addresses__card">
          <div class="ame-addresses__card-head">
            <strong>{{ address.first_name | escape }} {{ address.last_name | escape }}</strong>
            {%- if address == customer.default_address -%}
              <span class="ame-addresses__badge">Principal</span>
            {%- endif -%}
          </div>
          <address>
            {{ address.address1 | escape }}{% if address.address2 != blank %}, {{ address.address2 | escape }}{% endif %}<br>
            {{ address.city | escape }} — {{ address.province_code | escape }}<br>
            CEP {{ address.zip | escape }}<br>
            {{ address.country | escape }}
            {%- if address.phone != blank %}<br>Tel: {{ address.phone | escape }}{% endif -%}
          </address>
          <div class="ame-addresses__card-actions">
            <details class="ame-addresses__edit">
              <summary class="ame-addresses__card-btn">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
                Editar
              </summary>
              <div class="ame-addresses__form-wrap">
                {% form 'customer_address', address, class: 'ame-addresses__form' %}
                  {%- render 'address-form-fields', form: form, address: address -%}
                  <div class="ame-addresses__form-actions">
                    <button type="submit" class="ame-cta">Atualizar</button>
                    {%- unless address == customer.default_address -%}
                      <button type="submit" name="address[default]" value="1" class="ame-cta ame-cta--ghost">Tornar principal</button>
                    {%- endunless -%}
                    <a href="{{ address.url }}" data-target="{{ address.url }}" data-confirm-message="Excluir este endereço?" class="ame-addresses__delete">Excluir</a>
                  </div>
                {% endform %}
              </div>
            </details>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <div class="ame-addresses__empty">
      <span class="material-symbols-outlined ame-addresses__empty-icon" aria-hidden="true">person</span>
      <p>Você ainda não cadastrou nenhum endereço.</p>
    </div>
  {%- endif -%}
</section>

<script>
  // Confirmação de exclusão (snippet Shopify padrão)
  Shopify.CustomerAddress = Shopify.CustomerAddress || {};
  document.querySelectorAll('[data-confirm-message]').forEach(function(link){
    link.addEventListener('click', function(e){
      e.preventDefault();
      if (confirm(link.dataset.confirmMessage)) {
        Shopify.postLink(link.dataset.target, { parameters: { _method: 'delete' } });
      }
    });
  });
</script>

<style>
  .ame-addresses {
    padding: clamp(2rem, 5vw, 4rem) var(--page-margin, 16px);
    max-width: 56rem;
    margin: 0 auto;
    color: var(--color-on-background, #201b14);
  }
  .ame-addresses__hero { margin-bottom: 2rem; }
  .ame-addresses__back {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-on-surface-variant, #4f4442);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 1rem;
  }
  .ame-addresses__back .material-symbols-outlined { font-size: 1rem; }
  .ame-addresses__title {
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .ame-addresses__new { margin-bottom: 2rem; }
  .ame-addresses__new-toggle {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .ame-addresses__new-toggle::-webkit-details-marker { display: none; }
  .ame-addresses__form-wrap {
    margin-top: 1rem;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1rem;
    padding: 1.5rem;
  }
  .ame-addresses__form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  @media (max-width: 599px) {
    .ame-addresses__form { grid-template-columns: 1fr; }
  }
  .ame-addresses__form label {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-addresses__form input,
  .ame-addresses__form select {
    border: 1px solid rgba(210, 195, 192, 0.5);
    border-radius: 0.75rem;
    padding: 0.75rem 1rem;
    font-family: inherit;
    font-size: 16px;
    color: var(--color-on-background, #201b14);
    background: var(--color-surface-container-lowest, #fff);
    text-transform: none;
    letter-spacing: normal;
    font-weight: normal;
  }
  .ame-addresses__form-actions {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: center;
  }
  .ame-addresses__delete {
    color: #8a4032;
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 0.875rem;
    margin-left: auto;
    cursor: pointer;
  }
  .ame-addresses__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }
  @media (min-width: 700px) {
    .ame-addresses__list { grid-template-columns: 1fr 1fr; }
  }
  .ame-addresses__card {
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1rem;
    padding: 1.25rem;
  }
  .ame-addresses__card-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .ame-addresses__badge {
    background: rgba(248, 236, 224, 0.7);
    color: var(--color-on-background, #201b14);
    padding: 0.25rem 0.625rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .ame-addresses__card address {
    font-style: normal;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-on-surface-variant, #4f4442);
    margin: 0 0 1rem;
  }
  .ame-addresses__card-btn {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-primary, #5a4742);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .ame-addresses__card-btn::-webkit-details-marker { display: none; }
  .ame-addresses__card-btn .material-symbols-outlined { font-size: 1rem; }
  .ame-addresses__alert {
    background: rgba(201, 123, 106, 0.12);
    color: #8a4032;
    border: 1px solid rgba(201, 123, 106, 0.3);
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    grid-column: 1 / -1;
    margin-bottom: 1rem;
  }
  .ame-addresses__alert ul { margin: 0; padding-left: 1.25rem; }
  .ame-addresses__empty {
    text-align: center;
    padding: 3rem 1.5rem;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px dashed rgba(210, 195, 192, 0.6);
    border-radius: 1rem;
  }
  .ame-addresses__empty-icon {
    font-size: 3.5rem;
    color: rgba(210, 195, 192, 0.8);
    margin-bottom: 0.75rem;
  }
</style>
