{% comment %}
  Login do cliente — paleta Âme aplicada sobre o flow nativo do Shopify.
  Sem campos extras — segue 100% o customer_login_form do Shopify.
{% endcomment %}

<section class="ame-auth">
  <div class="ame-auth__inner">
    <header class="ame-auth__header">
      <h1 class="ame-auth__title">Entrar</h1>
      <p class="ame-auth__sub">Acesse sua conta para acompanhar seus pedidos.</p>
    </header>

    {% form 'customer_login', class: 'ame-auth__form' %}
      {%- if form.errors -%}
        <div class="ame-auth__alert ame-auth__alert--error" role="alert">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <label class="ame-auth__field">
        <span class="ame-auth__label">E-mail</span>
        <input
          type="email"
          name="customer[email]"
          id="customer_email"
          autocomplete="email"
          autocapitalize="off"
          autocorrect="off"
          required
        >
      </label>

      <label class="ame-auth__field">
        <span class="ame-auth__label">Senha</span>
        <input
          type="password"
          name="customer[password]"
          id="customer_password"
          autocomplete="current-password"
          required
        >
      </label>

      <button type="submit" class="ame-cta ame-auth__submit">
        Entrar
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </button>

      <p class="ame-auth__alt">
        <a href="#recover" class="ame-auth__link" onclick="document.getElementById('ame-recover').classList.add('is-open'); return false;">
          Esqueci minha senha
        </a>
      </p>
    {% endform %}

    <hr class="ame-auth__divider">

    <div class="ame-auth__cta-create">
      <p>Ainda não tem conta?</p>
      <a href="{{ routes.account_register_url }}" class="ame-cta ame-cta--ghost ame-auth__create-btn">
        Criar minha conta
        <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
      </a>
    </div>
  </div>

  <!-- Recuperação de senha — toggle inline pra não sair da página -->
  <div class="ame-auth-recover" id="ame-recover" aria-hidden="true">
    <div class="ame-auth-recover__panel">
      <button
        type="button"
        class="ame-auth-recover__close"
        aria-label="Fechar"
        onclick="document.getElementById('ame-recover').classList.remove('is-open')"
      >
        <span class="material-symbols-outlined" aria-hidden="true">close</span>
      </button>
      <h2 class="ame-auth__title">Recuperar senha</h2>
      <p class="ame-auth__sub">Informe seu e-mail e enviaremos um link para redefinir sua senha.</p>

      {% form 'recover_customer_password', class: 'ame-auth__form' %}
        {%- if form.posted_successfully? -%}
          <div class="ame-auth__alert ame-auth__alert--success" role="status">
            Pronto! Enviamos um link de recuperação para seu e-mail.
          </div>
        {%- endif -%}
        {%- if form.errors -%}
          <div class="ame-auth__alert ame-auth__alert--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <label class="ame-auth__field">
          <span class="ame-auth__label">E-mail</span>
          <input
            type="email"
            name="email"
            id="recover_email"
            autocomplete="email"
            required
          >
        </label>

        <button type="submit" class="ame-cta ame-auth__submit">
          Enviar link
          <span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
        </button>
      {% endform %}
    </div>
  </div>
</section>

<style>
  .ame-auth {
    padding: clamp(2rem, 5vw, 4rem) var(--page-margin, 16px);
    color: var(--color-on-background, #201b14);
  }
  .ame-auth__inner {
    max-width: 28rem;
    margin: 0 auto;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid rgba(210, 195, 192, 0.4);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    box-shadow: 0 2px 12px rgba(32, 27, 20, 0.04);
  }
  .ame-auth__header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .ame-auth__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 0.5rem;
    color: var(--color-on-background, #201b14);
  }
  .ame-auth__sub {
    font-size: 0.9375rem;
    color: var(--color-on-surface-variant, #4f4442);
    line-height: 1.6;
    margin: 0;
  }
  .ame-auth__form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .ame-auth__field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }
  .ame-auth__label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-auth__field input {
    border: 1px solid rgba(210, 195, 192, 0.5);
    border-radius: 0.75rem;
    padding: 0.875rem 1rem;
    font-family: inherit;
    font-size: 16px; /* sem zoom iOS */
    color: var(--color-on-background, #201b14);
    background: var(--color-surface-container-lowest, #fff);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .ame-auth__field input:focus {
    outline: none;
    border-color: var(--color-primary, #5a4742);
    box-shadow: 0 0 0 3px rgba(90, 71, 66, 0.12);
  }
  .ame-auth__submit {
    margin-top: 0.5rem;
    justify-content: center;
  }
  .ame-auth__alt {
    text-align: center;
    margin: 0.25rem 0 0;
    font-size: 0.875rem;
  }
  .ame-auth__link {
    color: var(--color-primary, #5a4742);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ame-auth__divider {
    border: 0;
    border-top: 1px solid rgba(210, 195, 192, 0.4);
    margin: 2rem 0;
  }
  .ame-auth__cta-create {
    text-align: center;
  }
  .ame-auth__cta-create p {
    margin: 0 0 0.75rem;
    color: var(--color-on-surface-variant, #4f4442);
    font-size: 0.9375rem;
  }
  .ame-auth__create-btn {
    width: 100%;
    justify-content: center;
  }
  .ame-auth__alert {
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .ame-auth__alert--error {
    background: rgba(201, 123, 106, 0.12);
    color: #8a4032;
    border: 1px solid rgba(201, 123, 106, 0.3);
  }
  .ame-auth__alert--success {
    background: rgba(120, 169, 122, 0.15);
    color: #2f5f33;
    border: 1px solid rgba(120, 169, 122, 0.35);
  }
  .ame-auth__alert ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  /* Painel de recuperação — modal inline */
  .ame-auth-recover {
    position: fixed;
    inset: 0;
    background: rgba(32, 27, 20, 0.45);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    z-index: 9000;
  }
  .ame-auth-recover.is-open {
    display: flex;
  }
  .ame-auth-recover__panel {
    position: relative;
    background: var(--color-surface-container-lowest, #fff);
    border-radius: 1.25rem;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    max-width: 26rem;
    width: 100%;
    box-shadow: 0 12px 40px rgba(32, 27, 20, 0.25);
  }
  .ame-auth-recover__close {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--color-on-surface-variant, #4f4442);
    padding: 0.375rem;
    border-radius: 50%;
    transition: background 0.15s ease;
  }
  .ame-auth-recover__close:hover {
    background: rgba(210, 195, 192, 0.25);
  }
</style>
