<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- render 'css-variables' -%}

    {%- comment -%}
      Preload da fonte do admin (settings.type_primary_font) removido:
      a fonte primária agora é Lexend self-hosted (preload já em
      css-variables.liquid). A fonte do admin nunca era renderizada porque
      Lexend vinha primeiro no font-family — o preload aqui só desperdiçava
      banda baixando um asset que o browser nunca aplicava.
    {%- endcomment -%}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {%- render 'meta-tags' -%}

    {{ content_for_header }}
  </head>

  <!-- Waltz -->
  {% if product %}
    <script>
      window.WaltzShopify = {
        productId: {{ product.id | json }},
        {%- comment -%}
          ⚡ Bolt: Optimize comma-separated string generation
          💡 What: Replaced manual `{% for %}` loop inside array definition with Liquid native `map` and `join` filters.
          🎯 Why: Native filters execute at the C/Rust level, avoiding Liquid loop parsing and scoping overhead.
          📊 Impact: Reduces template compilation overhead and improves rendering time for product pages, especially when a product belongs to many collections.
        {%- endcomment -%}
        collectionIds: [{{ product.collections | map: 'id' | join: ',' }}]
      };
    </script>
  {% endif %}

  <script src="https://waltz.up.railway.app/waltz-core.js" defer></script>

  <body>
    <a href="#main-content" class="ame-skip-to-content">Pular para o conteúdo principal</a>

    {%- sections 'header-group' -%}

    {%- render 'cart-drawer' -%}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    <script>
      /* ── Scroll reveal ── */
      document.addEventListener('DOMContentLoaded', () => {
        const reveals = document.querySelectorAll('.ame-reveal');
        if (!reveals.length) return;

        /* ⚡ Bolt: Unobserve elements after scroll reveal animation triggers */
        /* 💡 What: Calling io.unobserve(e.target) once the element intersects. */
        /* 🎯 Why: Keeping IntersectionObserver active on elements that have already animated causes unnecessary main-thread evaluation on every scroll event. */
        /* 📊 Impact: Reduces main-thread overhead during scrolling, preventing scroll jank on pages with many reveal elements. */
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        reveals.forEach((el) => io.observe(el));
      });

      /* ── Cart Drawer ── */
      (() => {
        'use strict';
        const drawer = () => document.getElementById('cart-drawer');
        const backdrop = () => document.getElementById('cart-backdrop');

        function openCart() {
          const d = drawer(),
            b = backdrop();
          if (!d) return;
          d.classList.add('is-open');
          d.setAttribute('aria-hidden', 'false');
          d.removeAttribute('inert');
          b?.classList.add('is-open');
          document.body.style.overflow = 'hidden';
          setTimeout(() => d.querySelector('[data-cart-close]')?.focus(), 50);
          const toggleBtn = document.querySelector('[data-cart-open]');
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
        }

        function closeCart() {
          const d = drawer(),
            b = backdrop();
          if (!d) return;
          d.classList.remove('is-open');
          d.setAttribute('aria-hidden', 'true');
          // inert bloqueia foco dentro do drawer fechado (PSI aria-hidden-focus).
          d.setAttribute('inert', '');
          b?.classList.remove('is-open');
          document.body.style.overflow = '';
          const toggleBtn = document.querySelector('[data-cart-open]');
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        }

        document.addEventListener('click', (e) => {
          if (e.target.closest('[data-cart-open]')) {
            e.preventDefault();
            openCart();
          }
          if (e.target.closest('[data-cart-close]')) closeCart();
          if (e.target.id === 'cart-backdrop') closeCart();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeCart();
        });

        /* ── Arrastar pra baixo pra fechar (mobile) ──
           Anexamos os listeners no próprio drawer (não no document) — assim o
           navegador não marca o scroll do site inteiro como bloqueado. */
        (() => {
          const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
          let startY = 0;
          let startT = 0;
          let dragging = false;
          let dragHeight = 0;
          let bound = false;

          function bindDrawerDrag() {
            const d = drawer();
            if (!d || bound) return;
            bound = true;

            d.addEventListener(
              'touchstart',
              (e) => {
                if (!isMobile()) return;
                if (!d.classList.contains('is-open')) return;
                if (!e.target.closest('.ame-cart-drawer__header, .ame-cart-drawer__handle')) return;
                if (e.target.closest('[data-cart-close]')) return;
                startY = e.touches[0].clientY;
                startT = Date.now();
                dragHeight = d.getBoundingClientRect().height;
                dragging = true;
                d.style.transition = 'none';
                d.style.touchAction = 'none';
              },
              { passive: true }
            );

            d.addEventListener(
              'touchmove',
              (e) => {
                if (!dragging) return;
                const dy = e.touches[0].clientY - startY;
                if (dy <= 0) {
                  d.style.transform = '';
                  return;
                }
                d.style.transform = `translateY(${dy}px)`;
              },
              { passive: true }
            );

            d.addEventListener(
              'touchend',
              (e) => {
                if (!dragging) return;
                dragging = false;
                d.style.touchAction = '';
                const dy = e.changedTouches[0].clientY - startY;
                const elapsed = Date.now() - startT;
                const velocity = dy / Math.max(1, elapsed);
                d.style.transition = '';
                d.style.transform = '';
                if (dy > dragHeight * 0.3 || velocity > 0.5) closeCart();
              },
              { passive: true }
            );

            d.addEventListener(
              'touchcancel',
              () => {
                if (!dragging) return;
                dragging = false;
                d.style.transition = '';
                d.style.transform = '';
              },
              { passive: true }
            );
          }

          // Tenta bindar agora; se o drawer ainda não está no DOM, espera DOMContentLoaded.
          if (drawer()) bindDrawerDrag();
          else document.addEventListener('DOMContentLoaded', bindDrawerDrag, { once: true });
        })();

        let _cartUpdating = false;
        let _discountCode = '';

        /* ── Desconto ── */
        function applyDiscount() {
          const d = drawer();
          const input = d?.querySelector('[data-cart-discount-input]');
          const feedback = d?.querySelector('[data-cart-discount-feedback]');
          const applyBtn = d?.querySelector('[data-cart-discount-apply]');
          const code = input?.value.trim().toUpperCase();
          if (!code) {
            input?.classList.add('is-error');
            setTimeout(() => input?.classList.remove('is-error'), 1200);
            return;
          }
          _discountCode = code;
          if (feedback) {
            feedback.textContent = `Cupom "${_discountCode}" será aplicado no checkout`;
            feedback.classList.add('is-applied');
          }
          if (applyBtn) {
            applyBtn.textContent = '✓ Aplicado';
            applyBtn.disabled = true;
          }
        }

        async function updateItem(key, quantity, triggerBtn) {
          if (_cartUpdating) return;
          _cartUpdating = true;

          const item = drawer()?.querySelector(`[data-item-key="${key}"]`);
          const btns = item?.querySelectorAll('.ame-cart-item__qty-btn');
          if (btns)
            btns.forEach((b) => {
              b.disabled = true;
              b.style.opacity = '0.4';
            });

          // Sincroniza itens pareados (coleira ↔ pingente brinde):
          // - Remoção (quantity=0): zera todos da mesma _coleira_key
          // - Mudança de quantidade: aplica a mesma quantidade nos pareados
          const coleiraKey = item?.dataset.coleiraKey;
          const pairedKeys = coleiraKey
            ? Array.from(drawer().querySelectorAll(`[data-coleira-key="${coleiraKey}"]`))
                .map((el) => el.dataset.itemKey)
                .filter((k) => k && k !== key)
            : [];

          try {
            let cartData;
            if (pairedKeys.length) {
              const updates = { [key]: quantity };
              pairedKeys.forEach((k) => {
                updates[k] = quantity;
              });
              const res = await fetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ updates }),
              });
              if (!res.ok) throw new Error('cart/update failed');
              cartData = await res.json();
            } else {
              const res = await fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ id: key, quantity }),
              });
              if (!res.ok) throw new Error('cart/change failed');
              cartData = await res.json();
            }
            refreshDrawer(cartData);
          } catch (err) {
            console.error('[Cart]', err);
            if (btns)
              btns.forEach((b) => {
                b.disabled = false;
                b.style.opacity = '';
              });
          } finally {
            _cartUpdating = false;
          }
        }

        function refreshDrawer(cart) {
          /* Header badge */
          document.querySelectorAll('.ame-header__cart-count').forEach((el) => {
            el.textContent = cart.item_count;
            el.style.display = cart.item_count > 0 ? '' : 'none';
          });
          /* Count label (drawer apenas; o badge do header já foi atualizado acima com só o número) */
          document.querySelectorAll('[data-cart-count]:not(.ame-header__cart-count)').forEach((el) => {
            el.textContent =
              cart.item_count > 0 ? `${cart.item_count} ${cart.item_count === 1 ? 'item' : 'itens'}` : '';
          });
          /* Subtotal */
          document.querySelectorAll('[data-cart-subtotal]').forEach((el) => {
            el.textContent = fmt(cart.total_price);
          });

          const d = drawer();
          const list = d?.querySelector('[data-cart-items]');
          const footer = d?.querySelector('[data-cart-footer]');
          const body = d?.querySelector('[data-cart-body]');

          if (cart.item_count === 0) {
            list?.remove();
            if (footer) footer.style.display = 'none';
            if (body && !body.querySelector('[data-cart-empty]')) body.innerHTML = emptyHTML();
            return;
          }

          body?.querySelector('[data-cart-empty]')?.remove();
          if (footer) footer.style.display = '';

          if (list) {
            list.innerHTML = cart.items.map(itemHTML).join('');
          } else if (body) {
            const ul = Object.assign(document.createElement('ul'), { className: 'ame-cart-items' });
            ul.setAttribute('data-cart-items', '');
            ul.innerHTML = cart.items.map(itemHTML).join('');
            body.prepend(ul);
          }

          const pct = Math.min((cart.total_price / 100 / 300) * 100, 100);
          const fill = d?.querySelector('.ame-cart-shipping-bar__fill');
          if (fill) fill.style.width = pct + '%';
        }

        function emptyHTML() {
          return `<div class="ame-cart-empty" data-cart-empty>
            <span class="material-symbols-outlined ame-cart-empty__icon" aria-hidden="true">shopping_bag</span>
            <p class="ame-cart-empty__title">Seu carrinho está vazio</p>
            <p class="ame-cart-empty__sub">Adicione produtos para começar</p>
            <a href="/collections/all" class="ame-cta ame-cart-empty__cta" data-cart-close>
              Explorar produtos<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a></div>`;
        }

        function itemHTML(item) {
          const img = item.featured_image?.url
            ? item.featured_image.url.replace(/(\.[^.?]+)(\?.*)?$/, '_200x200$1$2')
            : '';
          const v = item.variant_title && item.variant_title !== 'Default Title';
          const disc =
            item.original_line_price !== item.final_line_price
              ? `<span class="ame-cart-item__price-original">${fmt(item.original_line_price)}</span>`
              : '';
          const props = item.properties || {};
          const coleiraKey = props._coleira_key || '';
          const isBrinde = !!props.Brinde;
          const propEntries = Object.entries(props).filter(([k, val]) => k && val && !k.startsWith('_'));
          const propsHTML = propEntries.length
            ? `<ul class="ame-cart-item__props">${propEntries
                .map(([k, val]) => `<li><span class="ame-cart-item__prop-key">${esc(k)}:</span> ${esc(val)}</li>`)
                .join('')}</ul>`
            : '';
          const brindeChip = isBrinde
            ? `<span class="ame-cart-item__brinde-chip"><span class="material-symbols-outlined" aria-hidden="true">card_giftcard</span>Brinde</span>`
            : '';
          return `<li class="ame-cart-item${isBrinde ? ' ame-cart-item--brinde' : ''}" data-item-key="${esc(
            item.key
          )}"${coleiraKey ? ` data-coleira-key="${esc(coleiraKey)}"` : ''}>
            <a href="${esc(item.url)}" class="ame-cart-item__img-link">
              <div class="ame-cart-item__img-wrap">${
                img
                  ? `<img src="${esc(img)}" alt="${esc(item.product_title)}" class="ame-cart-item__img" loading="lazy">`
                  : ''
              }</div>
            </a>
            <div class="ame-cart-item__info">
              <a href="${esc(item.url)}" class="ame-cart-item__name">${esc(item.product_title)}</a>
              ${brindeChip}
              ${v ? `<p class="ame-cart-item__variant">${esc(item.variant_title)}</p>` : ''}
              ${propsHTML}
              <div class="ame-cart-item__bottom">
                <div class="ame-cart-item__qty">
                  <button type="button" class="ame-cart-item__qty-btn" aria-label="${
                    item.quantity <= 1 ? 'Remover item' : 'Diminuir quantidade'
                  }" title="${item.quantity <= 1 ? 'Remover item' : 'Diminuir quantidade'}" ${
            item.quantity <= 1 ? `data-remove="${esc(item.key)}"` : `data-qty-minus="${esc(item.key)}"`
          }>
                    <span class="material-symbols-outlined" aria-hidden="true">${
                      item.quantity <= 1 ? 'delete' : 'remove'
                    }</span>
                  </button>
                  <span class="ame-cart-item__qty-val" data-qty-val="${esc(item.key)}">${item.quantity}</span>
                  <button type="button" class="ame-cart-item__qty-btn" aria-label="Aumentar quantidade" title="Aumentar quantidade" data-qty-plus="${esc(
                    item.key
                  )}">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                  </button>
                </div>
                <div class="ame-cart-item__prices">${disc}<span class="ame-cart-item__price" data-line-price="${esc(
            item.key
          )}">${fmt(item.final_line_price)}</span></div>
              </div>
            </div></li>`;
        }

        function fmt(c) {
          const n = parseInt(c, 10);
          if (isNaN(n)) return '—';
          return 'R$ ' + (n / 100).toFixed(2).replace('.', ',');
        }
        function esc(s) {
          return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        document.addEventListener('click', (e) => {
          const plus = e.target.closest('[data-qty-plus]');
          const minus = e.target.closest('[data-qty-minus]');
          const remove = e.target.closest('[data-remove]');
          if (!plus && !minus && !remove) return;
          e.preventDefault();
          if (plus) {
            const cur = parseInt(
              drawer()?.querySelector(`[data-qty-val="${plus.dataset.qtyPlus}"]`)?.textContent || '1',
              10
            );
            updateItem(plus.dataset.qtyPlus, cur + 1, plus);
          }
          if (minus) {
            const cur = parseInt(
              drawer()?.querySelector(`[data-qty-val="${minus.dataset.qtyMinus}"]`)?.textContent || '1',
              10
            );
            if (cur > 1) updateItem(minus.dataset.qtyMinus, cur - 1, minus);
          }
          if (remove) updateItem(remove.dataset.remove, 0, remove);
        });

        /* ── Checkout & desconto ── */
        document.addEventListener('click', (e) => {
          if (e.target.closest('[data-cart-discount-apply]')) {
            e.preventDefault();
            applyDiscount();
            return;
          }
          const checkout = e.target.closest('[data-cart-checkout]');
          if (checkout) {
            e.preventDefault();
            const url = _discountCode ? `/checkout?discount=${encodeURIComponent(_discountCode)}` : '/checkout';
            window.location.href = url;
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && e.target.matches('[data-cart-discount-input]')) {
            e.preventDefault();
            applyDiscount();
          }
        });

        document.addEventListener('input', (e) => {
          if (!e.target.matches('[data-cart-discount-input]')) return;
          const d = drawer();
          const feedback = d?.querySelector('[data-cart-discount-feedback]');
          const applyBtn = d?.querySelector('[data-cart-discount-apply]');
          if (_discountCode && e.target.value.trim().toUpperCase() !== _discountCode) {
            _discountCode = '';
            if (feedback) {
              feedback.textContent = '';
              feedback.classList.remove('is-applied');
            }
            if (applyBtn) {
              applyBtn.textContent = 'Aplicar';
              applyBtn.disabled = false;
            }
          }
        });

        /* ─────────────────────────────────────────────────────────────
           Cross-sell — sugere guia quando há coleira/peitoral no carrinho
           ─────────────────────────────────────────────────────────────
           Convenção de handle:
             coleira-de-couro-pandora → guia-de-couro-pandora
             peitoral-de-couro-amelia → guia-de-couro-amelia
           A guia tem opções Cor/Tamanho/Cor do Metal IDÊNTICAS ao produto
           principal, mais um campo extra: Comprimento (120cm / 150cm) —
           obrigatório, cliente escolhe no card antes de adicionar.
        */
        const CROSSSELL_PREFIXES = ['coleira-', 'peitoral-'];
        const CROSSSELL_LENGTH_OPTION_NAMES = ['comprimento', 'tamanho da guia']; // tolerante a variações
        const productCache = new Map(); // handle → product JSON (evita refetch)

        function getCrossSellHandle(handle) {
          if (!handle) return null;
          for (const prefix of CROSSSELL_PREFIXES) {
            if (handle.startsWith(prefix)) {
              return 'guia-' + handle.slice(prefix.length);
            }
          }
          return null;
        }

        async function fetchProduct(handle) {
          if (productCache.has(handle)) return productCache.get(handle);
          try {
            const res = await fetch(`/products/${encodeURIComponent(handle)}.js`);
            if (!res.ok) {
              productCache.set(handle, null);
              return null;
            }
            const product = await res.json();
            productCache.set(handle, product);
            return product;
          } catch {
            productCache.set(handle, null);
            return null;
          }
        }

        /* Acha o índice da opção "comprimento" no produto guia. */
        function getLengthOptionIndex(product) {
          if (!product?.options) return -1;
          return product.options.findIndex(opt => {
            const lower = String(opt).toLowerCase().trim();
            return CROSSSELL_LENGTH_OPTION_NAMES.some(n => lower.includes(n));
          });
        }

        /* Tenta achar variante da guia que combina com Cor/Tamanho/Metal do
           item original + comprimento escolhido pelo cliente. */
        function findMatchingVariant(guia, cartItem, lengthValue) {
          if (!guia?.variants?.length) return null;
          const lengthIdx = getLengthOptionIndex(guia);
          const cartOptions = cartItem.options_with_values || [];

          // Match estrito: todas as opções não-comprimento batem + comprimento = lengthValue
          const candidates = guia.variants.filter(v => {
            // Comprimento bate
            if (lengthIdx >= 0 && lengthValue) {
              if (v[`option${lengthIdx + 1}`] !== lengthValue) return false;
            }
            // Demais opções batem com o item original
            for (let i = 0; i < guia.options.length; i++) {
              if (i === lengthIdx) continue;
              const optName = String(guia.options[i]).toLowerCase().trim();
              const cartOpt = cartOptions.find(o => String(o.name).toLowerCase().trim() === optName);
              if (!cartOpt) continue; // se item original não tem essa opção, ignora
              if (v[`option${i + 1}`] !== cartOpt.value) return false;
            }
            return true;
          });
          // Prioriza disponível
          return candidates.find(v => v.available) || candidates[0] || null;
        }

        /* Pega os valores possíveis pro Comprimento (geralmente 120cm/150cm). */
        function getLengthValues(guia) {
          const idx = getLengthOptionIndex(guia);
          if (idx < 0) return [];
          // products.json devolve options_with_values com valores em cada item
          if (guia.options_with_values && guia.options_with_values[idx]) {
            return guia.options_with_values[idx].values || [];
          }
          // Fallback: extrai valores únicos das variants
          const set = new Set();
          guia.variants.forEach(v => set.add(v[`option${idx + 1}`]));
          return Array.from(set);
        }

        function fmtMoney(cents) {
          return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',');
        }

        async function renderCrossSell(cart) {
          const wrap = document.querySelector('[data-cart-crosssell]');
          if (!wrap) return;

          if (!cart?.items?.length) {
            wrap.style.display = 'none';
            wrap.innerHTML = '';
            return;
          }

          // Lista de handles já no carrinho (pra não sugerir produto já adicionado)
          const cartHandles = new Set(cart.items.map(i => i.handle));

          // Pra cada item elegível, descobre a guia. Dedup pelo handle da guia.
          const suggestions = [];
          const seen = new Set();
          for (const item of cart.items) {
            const guiaHandle = getCrossSellHandle(item.handle);
            if (!guiaHandle || seen.has(guiaHandle) || cartHandles.has(guiaHandle)) continue;
            const guia = await fetchProduct(guiaHandle);
            if (!guia || !guia.available) continue;
            seen.add(guiaHandle);
            suggestions.push({ guia, sourceItem: item });
          }

          if (!suggestions.length) {
            wrap.style.display = 'none';
            wrap.innerHTML = '';
            return;
          }

          wrap.style.display = '';
          wrap.innerHTML = suggestions.map(({ guia, sourceItem }) => {
            const img = guia.featured_image
              ? guia.featured_image.replace(/(\.[a-z]+)(\?|$)/i, '_200x$1$2')
              : '';
            const price = (guia.price_min ?? guia.price) || 0;
            const lengths = getLengthValues(guia);
            const hasLengthOption = lengths.length > 0;
            const lengthBtns = hasLengthOption
              ? lengths.map(v => `<button type="button" class="ame-cart-crosssell__len-btn" data-cs-length="${escapeHTML(v)}">${escapeHTML(v)}</button>`).join('')
              : '';
            return `
              <div class="ame-cart-crosssell__card" data-cs-card data-cs-guia="${escapeHTML(guia.handle)}" data-cs-source="${escapeHTML(sourceItem.key)}">
                ${img ? `<img src="${escapeHTML(img)}" alt="" class="ame-cart-crosssell__img" loading="lazy">` : ''}
                <div class="ame-cart-crosssell__info">
                  <p class="ame-cart-crosssell__eyebrow">Complete o look</p>
                  <p class="ame-cart-crosssell__title">${escapeHTML(guia.title)}</p>
                  <p class="ame-cart-crosssell__price">${fmtMoney(price)}</p>
                  ${hasLengthOption ? `
                    <div class="ame-cart-crosssell__lengths" role="radiogroup" aria-label="Comprimento da guia">
                      ${lengthBtns}
                    </div>
                  ` : ''}
                  <button
                    type="button"
                    class="ame-cart-crosssell__add"
                    data-cs-add
                    ${hasLengthOption ? 'disabled' : ''}
                  >${hasLengthOption ? 'Escolha o comprimento' : 'Adicionar ao carrinho'}</button>
                </div>
              </div>
            `;
          }).join('');
        }

        /* Escape HTML pra evitar XSS dos dados do produto. */
        function escapeHTML(str) {
          return String(str ?? '').replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
          })[c]);
        }

        /* Click delegation: seleciona comprimento + adiciona */
        document.addEventListener('click', async (e) => {
          // Selecionar comprimento
          const lenBtn = e.target.closest('[data-cs-length]');
          if (lenBtn) {
            const card = lenBtn.closest('[data-cs-card]');
            card.querySelectorAll('[data-cs-length]').forEach(b => b.classList.remove('is-active'));
            lenBtn.classList.add('is-active');
            card.dataset.csSelectedLength = lenBtn.dataset.csLength;
            const addBtn = card.querySelector('[data-cs-add]');
            if (addBtn) {
              addBtn.disabled = false;
              addBtn.textContent = 'Adicionar ao carrinho';
            }
            return;
          }

          // Adicionar guia
          const addBtn = e.target.closest('[data-cs-add]');
          if (!addBtn || addBtn.disabled) return;
          const card = addBtn.closest('[data-cs-card]');
          const guiaHandle = card.dataset.csGuia;
          const sourceKey = card.dataset.csSource;
          const selectedLength = card.dataset.csSelectedLength || '';

          const guia = await fetchProduct(guiaHandle);
          if (!guia) return;

          // Encontra o item-fonte no cart atual pra pegar Cor/Tamanho/Metal
          const cartData = await (await fetch('/cart.js')).json();
          const sourceItem = cartData.items.find(i => i.key === sourceKey);
          if (!sourceItem) return;

          const variant = findMatchingVariant(guia, sourceItem, selectedLength);
          if (!variant) {
            (window.AmePdpToast || alert)('Não encontramos a guia com essa combinação.');
            return;
          }

          addBtn.disabled = true;
          addBtn.textContent = 'Adicionando...';
          try {
            await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [{ id: variant.id, quantity: 1 }] })
            });
            const refreshed = await (await fetch('/cart.js')).json();
            window.AmeCart?.refresh(refreshed);
          } catch {
            addBtn.disabled = false;
            addBtn.textContent = 'Tente novamente';
          }
        });

        /* Hook na refresh do drawer pra recalcular sugestões */
        const _origRefresh = refreshDrawer;
        refreshDrawer = function (cart) {
          _origRefresh(cart);
          renderCrossSell(cart);
        };

        /* Render inicial (no load) — busca cart atual */
        if (document.querySelector('[data-cart-crosssell]')) {
          fetch('/cart.js').then(r => r.json()).then(renderCrossSell).catch(() => {});
        }

        window.AmeCart = { open: openCart, close: closeCart, refresh: refreshDrawer };
      })();
    </script>
  </body>
</html>
