<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {%- render 'css-variables' -%}

    {%- comment -%}
      Preload da fonte do admin (settings.type_primary_font) removido:
      a fonte primária agora é Lexend self-hosted (preload já em
      css-variables.liquid). A fonte do admin nunca era renderizada porque
      Lexend vinha primeiro no font-family — o preload aqui só desperdiçava
      banda baixando um asset que o browser nunca aplicava.
    {%- endcomment -%}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {%- render 'meta-tags' -%}

    {{ content_for_header }}
  </head>

  <!-- Waltz -->
  {% if product %}
    <script>
      window.WaltzShopify = {
        productId: {{ product.id | json }},
        {%- comment -%}
          ⚡ Bolt: Optimize comma-separated string generation
          💡 What: Replaced manual `{% for %}` loop inside array definition with Liquid native `map` and `join` filters.
          🎯 Why: Native filters execute at the C/Rust level, avoiding Liquid loop parsing and scoping overhead.
          📊 Impact: Reduces template compilation overhead and improves rendering time for product pages, especially when a product belongs to many collections.
        {%- endcomment -%}
        collectionIds: [{{ product.collections | map: 'id' | join: ',' }}]
      };
    </script>
  {% endif %}

  <script src="https://waltz.up.railway.app/waltz-core.js" defer></script>

  <body>
    <a href="#main-content" class="ame-skip-to-content">Pular para o conteúdo principal</a>

    {%- sections 'header-group' -%}

    {%- render 'cart-drawer' -%}

    <main id="main-content" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- sections 'footer-group' -%}

    <script>
      /* ── Scroll reveal ── */
      document.addEventListener('DOMContentLoaded', () => {
        const reveals = document.querySelectorAll('.ame-reveal');
        if (!reveals.length) return;

        /* ⚡ Bolt: Unobserve elements after scroll reveal animation triggers */
        /* 💡 What: Calling io.unobserve(e.target) once the element intersects. */
        /* 🎯 Why: Keeping IntersectionObserver active on elements that have already animated causes unnecessary main-thread evaluation on every scroll event. */
        /* 📊 Impact: Reduces main-thread overhead during scrolling, preventing scroll jank on pages with many reveal elements. */
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.1 }
        );
        reveals.forEach((el) => io.observe(el));
      });

      /* ── Cart Drawer ── */
      (() => {
        'use strict';
        const drawer = () => document.getElementById('cart-drawer');
        const backdrop = () => document.getElementById('cart-backdrop');

        function openCart() {
          const d = drawer(),
            b = backdrop();
          if (!d) return;
          d.classList.add('is-open');
          d.setAttribute('aria-hidden', 'false');
          d.removeAttribute('inert');
          b?.classList.add('is-open');
          document.body.style.overflow = 'hidden';
          setTimeout(() => d.querySelector('[data-cart-close]')?.focus(), 50);
          const toggleBtn = document.querySelector('[data-cart-open]');
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
        }

        function closeCart() {
          const d = drawer(),
            b = backdrop();
          if (!d) return;
          d.classList.remove('is-open');
          d.setAttribute('aria-hidden', 'true');
          // inert bloqueia foco dentro do drawer fechado (PSI aria-hidden-focus).
          d.setAttribute('inert', '');
          b?.classList.remove('is-open');
          document.body.style.overflow = '';
          const toggleBtn = document.querySelector('[data-cart-open]');
          if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
        }

        document.addEventListener('click', (e) => {
          if (e.target.closest('[data-cart-open]')) {
            e.preventDefault();
            openCart();
          }
          if (e.target.closest('[data-cart-close]')) closeCart();
          if (e.target.id === 'cart-backdrop') closeCart();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') closeCart();
        });

        /* ── Arrastar pra baixo pra fechar (mobile) ──
           Anexamos os listeners no próprio drawer (não no document) — assim o
           navegador não marca o scroll do site inteiro como bloqueado. */
        (() => {
          const isMobile = () => window.matchMedia('(max-width: 767px)').matches;
          let startY = 0;
          let startT = 0;
          let dragging = false;
          let dragHeight = 0;
          let bound = false;

          function bindDrawerDrag() {
            const d = drawer();
            if (!d || bound) return;
            bound = true;

            d.addEventListener(
              'touchstart',
              (e) => {
                if (!isMobile()) return;
                if (!d.classList.contains('is-open')) return;
                if (!e.target.closest('.ame-cart-drawer__header, .ame-cart-drawer__handle')) return;
                if (e.target.closest('[data-cart-close]')) return;
                startY = e.touches[0].clientY;
                startT = Date.now();
                dragHeight = d.getBoundingClientRect().height;
                dragging = true;
                d.style.transition = 'none';
                d.style.touchAction = 'none';
              },
              { passive: true }
            );

            d.addEventListener(
              'touchmove',
              (e) => {
                if (!dragging) return;
                const dy = e.touches[0].clientY - startY;
                if (dy <= 0) {
                  d.style.transform = '';
                  return;
                }
                d.style.transform = `translateY(${dy}px)`;
              },
              { passive: true }
            );

            d.addEventListener(
              'touchend',
              (e) => {
                if (!dragging) return;
                dragging = false;
                d.style.touchAction = '';
                const dy = e.changedTouches[0].clientY - startY;
                const elapsed = Date.now() - startT;
                const velocity = dy / Math.max(1, elapsed);
                d.style.transition = '';
                d.style.transform = '';
                if (dy > dragHeight * 0.3 || velocity > 0.5) closeCart();
              },
              { passive: true }
            );

            d.addEventListener(
              'touchcancel',
              () => {
                if (!dragging) return;
                dragging = false;
                d.style.transition = '';
                d.style.transform = '';
              },
              { passive: true }
            );
          }

          // Tenta bindar agora; se o drawer ainda não está no DOM, espera DOMContentLoaded.
          if (drawer()) bindDrawerDrag();
          else document.addEventListener('DOMContentLoaded', bindDrawerDrag, { once: true });
        })();

        let _cartUpdating = false;
        let _discountCode = '';

        /* ── Desconto ── */
        function applyDiscount() {
          const d = drawer();
          const input = d?.querySelector('[data-cart-discount-input]');
          const feedback = d?.querySelector('[data-cart-discount-feedback]');
          const applyBtn = d?.querySelector('[data-cart-discount-apply]');
          const code = input?.value.trim().toUpperCase();
          if (!code) {
            input?.classList.add('is-error');
            setTimeout(() => input?.classList.remove('is-error'), 1200);
            return;
          }
          _discountCode = code;
          if (feedback) {
            feedback.textContent = `Cupom "${_discountCode}" será aplicado no checkout`;
            feedback.classList.add('is-applied');
          }
          if (applyBtn) {
            applyBtn.textContent = '✓ Aplicado';
            applyBtn.disabled = true;
          }
        }

        async function updateItem(key, quantity, triggerBtn) {
          if (_cartUpdating) return;
          _cartUpdating = true;

          const item = drawer()?.querySelector(`[data-item-key="${key}"]`);
          const btns = item?.querySelectorAll('.ame-cart-item__qty-btn');
          if (btns)
            btns.forEach((b) => {
              b.disabled = true;
              b.style.opacity = '0.4';
            });

          // Sincroniza itens pareados (coleira ↔ pingente brinde):
          // - Remoção (quantity=0): zera todos da mesma _coleira_key
          // - Mudança de quantidade: aplica a mesma quantidade nos pareados
          const coleiraKey = item?.dataset.coleiraKey;
          const pairedKeys = coleiraKey
            ? Array.from(drawer().querySelectorAll(`[data-coleira-key="${coleiraKey}"]`))
                .map((el) => el.dataset.itemKey)
                .filter((k) => k && k !== key)
            : [];

          try {
            let cartData;
            if (pairedKeys.length) {
              const updates = { [key]: quantity };
              pairedKeys.forEach((k) => {
                updates[k] = quantity;
              });
              const res = await fetch('/cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ updates }),
              });
              if (!res.ok) throw new Error('cart/update failed');
              cartData = await res.json();
            } else {
              const res = await fetch('/cart/change.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify({ id: key, quantity }),
              });
              if (!res.ok) throw new Error('cart/change failed');
              cartData = await res.json();
            }
            refreshDrawer(cartData);
          } catch (err) {
            console.error('[Cart]', err);
            if (btns)
              btns.forEach((b) => {
                b.disabled = false;
                b.style.opacity = '';
              });
          } finally {
            _cartUpdating = false;
          }
        }

        function refreshDrawer(cart) {
          /* Header badge */
          document.querySelectorAll('.ame-header__cart-count').forEach((el) => {
            el.textContent = cart.item_count;
            el.style.display = cart.item_count > 0 ? '' : 'none';
          });
          /* Count label (drawer apenas; o badge do header já foi atualizado acima com só o número) */
          document.querySelectorAll('[data-cart-count]:not(.ame-header__cart-count)').forEach((el) => {
            el.textContent =
              cart.item_count > 0 ? `${cart.item_count} ${cart.item_count === 1 ? 'item' : 'itens'}` : '';
          });
          /* Subtotal */
          document.querySelectorAll('[data-cart-subtotal]').forEach((el) => {
            el.textContent = fmt(cart.total_price);
          });

          const d = drawer();
          const list = d?.querySelector('[data-cart-items]');
          const footer = d?.querySelector('[data-cart-footer]');
          const body = d?.querySelector('[data-cart-body]');

          if (cart.item_count === 0) {
            list?.remove();
            if (footer) footer.style.display = 'none';
            if (body && !body.querySelector('[data-cart-empty]')) body.innerHTML = emptyHTML();
            return;
          }

          body?.querySelector('[data-cart-empty]')?.remove();
          if (footer) footer.style.display = '';

          if (list) {
            list.innerHTML = cart.items.map(itemHTML).join('');
          } else if (body) {
            const ul = Object.assign(document.createElement('ul'), { className: 'ame-cart-items' });
            ul.setAttribute('data-cart-items', '');
            ul.innerHTML = cart.items.map(itemHTML).join('');
            body.prepend(ul);
          }

          const pct = Math.min((cart.total_price / 100 / 300) * 100, 100);
          const fill = d?.querySelector('.ame-cart-shipping-bar__fill');
          if (fill) fill.style.width = pct + '%';
        }

        function emptyHTML() {
          return `<div class="ame-cart-empty" data-cart-empty>
            <span class="material-symbols-outlined ame-cart-empty__icon" aria-hidden="true">shopping_bag</span>
            <p class="ame-cart-empty__title">Seu carrinho está vazio</p>
            <p class="ame-cart-empty__sub">Adicione produtos para começar</p>
            <a href="/collections/all" class="ame-cta ame-cart-empty__cta" data-cart-close>
              Explorar produtos<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
            </a></div>`;
        }

        function itemHTML(item) {
          const img = item.featured_image?.url
            ? item.featured_image.url.replace(/(\.[^.?]+)(\?.*)?$/, '_200x200$1$2')
            : '';
          const v = item.variant_title && item.variant_title !== 'Default Title';
          const disc =
            item.original_line_price !== item.final_line_price
              ? `<span class="ame-cart-item__price-original">${fmt(item.original_line_price)}</span>`
              : '';
          const props = item.properties || {};
          const coleiraKey = props._coleira_key || '';
          const isBrinde = !!props.Brinde;
          const propEntries = Object.entries(props).filter(([k, val]) => k && val && !k.startsWith('_'));
          const propsHTML = propEntries.length
            ? `<ul class="ame-cart-item__props">${propEntries
                .map(([k, val]) => `<li><span class="ame-cart-item__prop-key">${esc(k)}:</span> ${esc(val)}</li>`)
                .join('')}</ul>`
            : '';
          const brindeChip = isBrinde
            ? `<span class="ame-cart-item__brinde-chip"><span class="material-symbols-outlined" aria-hidden="true">card_giftcard</span>Brinde</span>`
            : '';
          return `<li class="ame-cart-item${isBrinde ? ' ame-cart-item--brinde' : ''}" data-item-key="${esc(
            item.key
          )}"${coleiraKey ? ` data-coleira-key="${esc(coleiraKey)}"` : ''}>
            <a href="${esc(item.url)}" class="ame-cart-item__img-link">
              <div class="ame-cart-item__img-wrap">${
                img
                  ? `<img src="${esc(img)}" alt="${esc(item.product_title)}" class="ame-cart-item__img" loading="lazy">`
                  : ''
              }</div>
            </a>
            <div class="ame-cart-item__info">
              <a href="${esc(item.url)}" class="ame-cart-item__name">${esc(item.product_title)}</a>
              ${brindeChip}
              ${v ? `<p class="ame-cart-item__variant">${esc(item.variant_title)}</p>` : ''}
              ${propsHTML}
              <div class="ame-cart-item__bottom">
                <div class="ame-cart-item__qty">
                  <button type="button" class="ame-cart-item__qty-btn" aria-label="${
                    item.quantity <= 1 ? 'Remover item' : 'Diminuir quantidade'
                  }" title="${item.quantity <= 1 ? 'Remover item' : 'Diminuir quantidade'}" ${
            item.quantity <= 1 ? `data-remove="${esc(item.key)}"` : `data-qty-minus="${esc(item.key)}"`
          }>
                    <span class="material-symbols-outlined" aria-hidden="true">${
                      item.quantity <= 1 ? 'delete' : 'remove'
                    }</span>
                  </button>
                  <span class="ame-cart-item__qty-val" data-qty-val="${esc(item.key)}">${item.quantity}</span>
                  <button type="button" class="ame-cart-item__qty-btn" aria-label="Aumentar quantidade" title="Aumentar quantidade" data-qty-plus="${esc(
                    item.key
                  )}">
                    <span class="material-symbols-outlined" aria-hidden="true">add</span>
                  </button>
                </div>
                <div class="ame-cart-item__prices">${disc}<span class="ame-cart-item__price" data-line-price="${esc(
            item.key
          )}">${fmt(item.final_line_price)}</span></div>
              </div>
            </div>
            <div class="ame-cart-crosssell" data-cs-slot data-cs-source-key="${esc(item.key)}"></div></li>`;
        }

        function fmt(c) {
          const n = parseInt(c, 10);
          if (isNaN(n)) return '—';
          return 'R$ ' + (n / 100).toFixed(2).replace('.', ',');
        }
        function esc(s) {
          return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        document.addEventListener('click', (e) => {
          const plus = e.target.closest('[data-qty-plus]');
          const minus = e.target.closest('[data-qty-minus]');
          const remove = e.target.closest('[data-remove]');
          if (!plus && !minus && !remove) return;
          e.preventDefault();
          if (plus) {
            const cur = parseInt(
              drawer()?.querySelector(`[data-qty-val="${plus.dataset.qtyPlus}"]`)?.textContent || '1',
              10
            );
            updateItem(plus.dataset.qtyPlus, cur + 1, plus);
          }
          if (minus) {
            const cur = parseInt(
              drawer()?.querySelector(`[data-qty-val="${minus.dataset.qtyMinus}"]`)?.textContent || '1',
              10
            );
            if (cur > 1) updateItem(minus.dataset.qtyMinus, cur - 1, minus);
          }
          if (remove) updateItem(remove.dataset.remove, 0, remove);
        });

        /* ── Checkout & desconto ── */
        document.addEventListener('click', (e) => {
          if (e.target.closest('[data-cart-discount-apply]')) {
            e.preventDefault();
            applyDiscount();
            return;
          }
          const checkout = e.target.closest('[data-cart-checkout]');
          if (checkout) {
            e.preventDefault();
            const url = _discountCode ? `/checkout?discount=${encodeURIComponent(_discountCode)}` : '/checkout';
            window.location.href = url;
          }
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && e.target.matches('[data-cart-discount-input]')) {
            e.preventDefault();
            applyDiscount();
          }
        });

        document.addEventListener('input', (e) => {
          if (!e.target.matches('[data-cart-discount-input]')) return;
          const d = drawer();
          const feedback = d?.querySelector('[data-cart-discount-feedback]');
          const applyBtn = d?.querySelector('[data-cart-discount-apply]');
          if (_discountCode && e.target.value.trim().toUpperCase() !== _discountCode) {
            _discountCode = '';
            if (feedback) {
              feedback.textContent = '';
              feedback.classList.remove('is-applied');
            }
            if (applyBtn) {
              applyBtn.textContent = 'Aplicar';
              applyBtn.disabled = false;
            }
          }
        });

        /* ─────────────────────────────────────────────────────────────
           Cross-sell — sugere guia quando há coleira/peitoral no carrinho
           ─────────────────────────────────────────────────────────────
           Convenção de handle:
             coleira-de-couro-pandora → guia-de-couro-pandora
             peitoral-de-couro-amelia → guia-de-couro-amelia

           Auto-match de variante:
           Pra cada opção da guia, tenta achar valor que case com o item
           original. Match em ordem:
             1. Mesma opção (por nome) E mesmo valor exato
             2. Mesma opção E o valor da coleira aparece como token no
                valor da guia (split por '/'). Ex: opção "Comprimento" da
                guia tem valores "PP / P / 15mm" → match se a coleira tem
                Tamanho "P".
             3. Qualquer opção da coleira cujo valor exato apareça nos
                valores da guia.

           Se TODAS as opções da guia conseguem match automático → adiciona
           direto, sem seletor. Se ALGUMA não casa → mostra botões pra essa
           opção (ex: Comprimento 120cm/150cm em guias longas).
        */
        const CROSSSELL_PREFIXES = ['coleira-', 'peitoral-'];
        // Guia padrão usada como fallback quando a coleira/peitoral não tem
        // uma guia com o mesmo nome (ex: peitoral-de-couro-X sem guia-de-couro-X).
        const CROSSSELL_FALLBACK_HANDLE = 'guia-de-couro-atena';
        const productCache = new Map(); // handle → product JSON (evita refetch)

        function getCrossSellHandle(handle) {
          if (!handle) return null;
          for (const prefix of CROSSSELL_PREFIXES) {
            if (handle.startsWith(prefix)) {
              return 'guia-' + handle.slice(prefix.length);
            }
          }
          return null;
        }

        async function fetchProduct(handle) {
          if (productCache.has(handle)) return productCache.get(handle);
          try {
            const res = await fetch(`/products/${encodeURIComponent(handle)}.js`);
            if (!res.ok) {
              productCache.set(handle, null);
              return null;
            }
            const product = await res.json();
            productCache.set(handle, product);
            return product;
          } catch {
            productCache.set(handle, null);
            return null;
          }
        }

        /* Resolve a guia pra um item do carrinho:
           1. Tenta guia com mesmo nome (convenção: coleira-X → guia-X)
           2. Se não existir / indisponível, cai pro fallback Atena */
        async function resolveCrossSellProduct(item) {
          if (!item?.handle) return null;
          const ownGuiaHandle = getCrossSellHandle(item.handle);
          if (ownGuiaHandle) {
            const own = await fetchProduct(ownGuiaHandle);
            if (own && own.available) return own;
          }
          // Fallback — só faz sentido se o item original é coleira/peitoral
          if (ownGuiaHandle) {
            const fallback = await fetchProduct(CROSSSELL_FALLBACK_HANDLE);
            if (fallback && fallback.available) return fallback;
          }
          return null;
        }

        /* Extrai array uniforme {name, values[]} das opções do produto.
           O endpoint .js pode retornar options como array de strings OU
           array de objetos — esta função normaliza pra objeto. */
        function getProductOptions(product) {
          if (!product?.options) return [];
          return product.options.map((opt, i) => {
            if (typeof opt === 'string') {
              // Array de strings: pega valores únicos das variants
              const set = new Set();
              product.variants.forEach(v => {
                const val = v[`option${i + 1}`];
                if (val) set.add(val);
              });
              return { name: opt, values: Array.from(set) };
            }
            return { name: opt.name, values: opt.values || [] };
          });
        }

        /* Tenta achar o valor da `guiaOption` que combine com alguma opção
           do `cartItem`. Retorna o valor da guia (string) ou null. */
        function matchOptionValue(cartItem, guiaOption) {
          const cartOptions = cartItem.options_with_values || [];
          const guiaName = String(guiaOption.name).toLowerCase().trim();
          const guiaValues = guiaOption.values || [];

          // 1. Tenta match pelo NOME da opção
          const sameName = cartOptions.find(o =>
            String(o.name).toLowerCase().trim() === guiaName
          );
          if (sameName) {
            const cartVal = String(sameName.value).trim();
            // 1a. Valor exato
            const exact = guiaValues.find(v => String(v).trim() === cartVal);
            if (exact) return exact;
            // 1b. Token match (split por '/')
            const tokenMatch = guiaValues.find(v =>
              String(v).split('/').some(tok => tok.trim().toLowerCase() === cartVal.toLowerCase())
            );
            if (tokenMatch) return tokenMatch;
          }

          // 2. Fallback: tenta match pelo VALOR em qualquer opção do cart
          for (const cartOpt of cartOptions) {
            const cartVal = String(cartOpt.value).trim();
            // 2a. Valor exato
            const exact = guiaValues.find(v => String(v).trim() === cartVal);
            if (exact) return exact;
            // 2b. Token match
            const tokenMatch = guiaValues.find(v =>
              String(v).split('/').some(tok => tok.trim().toLowerCase() === cartVal.toLowerCase())
            );
            if (tokenMatch) return tokenMatch;
          }

          return null; // não conseguiu match — cliente precisa escolher
        }

        /* Resolve TODAS as opções da guia contra o cartItem.
           Retorna array { matched, value, option } pra cada opção da guia. */
        function resolveOptions(guia, cartItem) {
          const opts = getProductOptions(guia);
          return opts.map(opt => {
            const value = matchOptionValue(cartItem, opt);
            return {
              option: opt,
              value,
              matched: value !== null,
            };
          });
        }

        /* Acha variant da guia com os valores resolvidos.
           `selections` é um array paralelo a `guia.options` com o valor
           selecionado pra cada opção (auto-match OU clique do cliente). */
        function findVariant(guia, selections) {
          if (!guia?.variants?.length) return null;
          const candidates = guia.variants.filter(v =>
            selections.every((sel, i) => v[`option${i + 1}`] === sel)
          );
          return candidates.find(v => v.available) || candidates[0] || null;
        }

        function fmtMoney(cents) {
          return 'R$ ' + (cents / 100).toFixed(2).replace('.', ',');
        }

        /* Dismiss state — quais cards o cliente já fechou nessa sessão.
           Chave: `${sourceKey}::${guiaHandle}`. Volta ao reabrir o navegador. */
        function getDismissed() {
          try {
            return new Set(JSON.parse(sessionStorage.getItem('ame:cs-dismiss') || '[]'));
          } catch {
            return new Set();
          }
        }
        function addDismissed(key) {
          const s = getDismissed();
          s.add(key);
          sessionStorage.setItem('ame:cs-dismiss', JSON.stringify(Array.from(s)));
        }

        /* Acha a imagem específica de uma variante. Tenta nesta ordem:
           variant.featured_image.src → product.images[image_id] → product.featured_image */
        function getVariantImage(guia, variant) {
          if (!variant) return guia.featured_image || '';
          if (variant.featured_image?.src) return variant.featured_image.src;
          if (variant.featured_image && typeof variant.featured_image === 'string') return variant.featured_image;
          return guia.featured_image || '';
        }

        /* Lê a config de comprimento_guia das settings do tema.
           Renderizado inline via Liquid no script atual. */
        const COMPRIMENTO_GUIA_CONFIG = {
          enabled: {{ settings.custom_field_13_enable | json }},
          tag: {{ settings.custom_field_13_tag | json }},
          name: {{ settings.custom_field_13_name | json }},
          options: {{ settings.custom_field_13_options | json }},
          required: {{ settings.custom_field_13_required | json }},
        };

        /* Renderiza o card de cross-sell num slot específico (dentro do <li>).
           Cada produto elegível do carrinho tem seu próprio slot e card,
           refletindo as opções/cor/foto da variante exata sugerida. */
        async function renderCrossSellForSlot(slot, cart, dismissed) {
          slot.innerHTML = '';
          const sourceKey = slot.dataset.csSourceKey;
          if (!sourceKey) return;
          const item = cart.items.find(i => i.key === sourceKey);
          if (!item) return;

          const guia = await resolveCrossSellProduct(item);
          if (!guia) return;

          // Já adicionou esta guia no carrinho? Não sugere de novo.
          if (cart.items.some(i => i.handle === guia.handle)) return;

          // Cliente fechou esta sugestão nesta sessão?
          const dismissKey = `${sourceKey}::${guia.handle}`;
          if (dismissed.has(dismissKey)) return;

          const resolutions = resolveOptions(guia, item);
          const unmatched = resolutions.filter(r => !r.matched);

          // Tenta achar variante já com auto-match (pra pegar foto/preço correto)
          let previewVariant = null;
          if (unmatched.length === 0) {
            const selections = resolutions.map(r => r.value);
            previewVariant = findVariant(guia, selections);
          } else {
            // Pega 1ª variant que combina com as opções auto-matched (ignora unmatched)
            previewVariant = guia.variants.find(v => {
              return resolutions.every((r, i) => !r.matched || v[`option${i + 1}`] === r.value);
            }) || guia.variants[0];
          }

          const img = getVariantImage(guia, previewVariant);
          const imgSmall = img ? img.replace(/(\.[a-z]+)(\?|$)/i, '_240x$1$2') : '';
          const price = previewVariant?.price ?? guia.price ?? guia.price_min ?? 0;

          // Cor da variante preview (pra mostrar no card como confirmação visual)
          const variantColor = previewVariant
            ? (resolutions[1]?.value || previewVariant.option2 || '')
            : '';

          // Comprimento via custom field (tag comprimento_guia)
          const hasComprimentoTag = COMPRIMENTO_GUIA_CONFIG.enabled
            && COMPRIMENTO_GUIA_CONFIG.tag
            && Array.isArray(guia.tags)
            && guia.tags.includes(COMPRIMENTO_GUIA_CONFIG.tag);
          const comprimentoValues = hasComprimentoTag && COMPRIMENTO_GUIA_CONFIG.options
            ? String(COMPRIMENTO_GUIA_CONFIG.options).split(',').map(s => s.trim()).filter(Boolean)
            : [];

          // Pra cada opção não-resolvida (variant), gera seletor.
          // Sem template literals (uso concat de strings) pra não confundir o
          // parser do theme-check, que esbarra em backticks aninhados.
          const selectorsHtml = unmatched.map(function (r) {
            const optIdx = resolutions.indexOf(r);
            const btns = r.option.values.map(function (v) {
              return '<button type="button" class="ame-cart-crosssell__len-btn" data-cs-opt-idx="' +
                optIdx + '" data-cs-opt-val="' + escapeHTML(v) + '">' + escapeHTML(v) + '</button>';
            }).join('');
            return '<div class="ame-cart-crosssell__lengths" role="radiogroup" aria-label="' +
              escapeHTML(r.option.name) + '">' +
              '<span class="ame-cart-crosssell__lengths-label">' + escapeHTML(r.option.name) + ':</span>' +
              btns +
              '</div>';
          }).join('');

          // Seletor de comprimento_guia (via property, não variante).
          let comprimentoHtml = '';
          if (comprimentoValues.length) {
            const compName = escapeHTML(COMPRIMENTO_GUIA_CONFIG.name || 'Comprimento');
            const compBtns = comprimentoValues.map(function (v) {
              return '<button type="button" class="ame-cart-crosssell__len-btn" data-cs-prop-val="' +
                escapeHTML(v) + '">' + escapeHTML(v) + '</button>';
            }).join('');
            comprimentoHtml = '<div class="ame-cart-crosssell__lengths" role="radiogroup" aria-label="' +
              compName + '">' +
              '<span class="ame-cart-crosssell__lengths-label">' + compName + ':</span>' +
              compBtns +
              '</div>';
          }

          const selDataAttrs = resolutions
            .map((r, i) => r.matched ? `data-cs-sel${i}="${escapeHTML(r.value)}"` : '')
            .filter(Boolean)
            .join(' ');

          const needsVariantSelection = unmatched.length > 0;
          const needsComprimento = comprimentoValues.length > 0 && COMPRIMENTO_GUIA_CONFIG.required;
          const initiallyDisabled = needsVariantSelection || needsComprimento;
          const initialLabel = needsVariantSelection || needsComprimento
            ? 'Escolha as opções acima' : 'Adicionar ao carrinho';

          // Extraído em variáveis (sem template literals aninhados) pra
          // não confundir o parser HTML do theme-check.
          const imgHtml = imgSmall
            ? '<img src="' + escapeHTML(imgSmall) + '" alt="" class="ame-cart-crosssell__img" loading="lazy">'
            : '';
          const colorHtml = variantColor
            ? '<p class="ame-cart-crosssell__variant">' + escapeHTML(variantColor) + '</p>'
            : '';
          const disabledAttr = initiallyDisabled ? 'disabled' : '';
          const needsPropAttr = comprimentoValues.length > 0 ? '1' : '0';

          slot.innerHTML =
            '<div class="ame-cart-crosssell__card" data-cs-card' +
            ' data-cs-guia="' + escapeHTML(guia.handle) + '"' +
            ' data-cs-source="' + escapeHTML(sourceKey) + '"' +
            ' data-cs-total-opts="' + resolutions.length + '"' +
            ' data-cs-needs-prop="' + needsPropAttr + '"' +
            ' data-cs-prop-name="' + escapeHTML(COMPRIMENTO_GUIA_CONFIG.name || '') + '"' +
            ' ' + selDataAttrs + '>' +
            '<button type="button" class="ame-cart-crosssell__dismiss" data-cs-dismiss aria-label="Recusar sugestão" title="Recusar sugestão">&times;</button>' +
            imgHtml +
            '<div class="ame-cart-crosssell__info">' +
              '<p class="ame-cart-crosssell__eyebrow">Combine com este produto</p>' +
              '<p class="ame-cart-crosssell__title">' + escapeHTML(guia.title) + '</p>' +
              colorHtml +
              '<p class="ame-cart-crosssell__price">' + fmtMoney(price) + '</p>' +
              selectorsHtml +
              comprimentoHtml +
              '<button type="button" class="ame-cart-crosssell__add" data-cs-add ' + disabledAttr + '>' + initialLabel + '</button>' +
            '</div>' +
            '</div>';
        }

        async function renderCrossSell(cart) {
          const slots = document.querySelectorAll('[data-cs-slot]');
          if (!slots.length || !cart?.items?.length) return;
          const dismissed = getDismissed();
          // Processa em paralelo, mas cada slot é independente
          await Promise.all(Array.from(slots).map(slot => renderCrossSellForSlot(slot, cart, dismissed)));
        }

        /* Escape HTML pra evitar XSS dos dados do produto. */
        function escapeHTML(str) {
          return String(str ?? '').replace(/[&<>"']/g, c => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
          })[c]);
        }

        /* Click delegation: seleciona opção pendente, dismiss e adiciona */
        document.addEventListener('click', async (e) => {
          // Dismiss — fecha sugestão pra este par source+guia
          const dismissBtn = e.target.closest('[data-cs-dismiss]');
          if (dismissBtn) {
            const card = dismissBtn.closest('[data-cs-card]');
            const slot = card.closest('[data-cs-slot]');
            const key = card.dataset.csSource + '::' + card.dataset.csGuia;
            addDismissed(key);
            if (slot) slot.innerHTML = '';
            return;
          }

          // Selecionar valor pra uma opção de variante não auto-matched
          const optBtn = e.target.closest('[data-cs-opt-idx]');
          if (optBtn) {
            const card = optBtn.closest('[data-cs-card]');
            const idx = optBtn.dataset.csOptIdx;
            card.querySelectorAll('[data-cs-opt-idx="' + idx + '"]').forEach(b => b.classList.remove('is-active'));
            optBtn.classList.add('is-active');
            card.dataset['csSel' + idx] = optBtn.dataset.csOptVal;
            updateAddBtnState(card);
            return;
          }

          // Selecionar valor pra property (ex: Comprimento da Guia 120/150)
          const propBtn = e.target.closest('[data-cs-prop-val]');
          if (propBtn) {
            const card = propBtn.closest('[data-cs-card]');
            card.querySelectorAll('[data-cs-prop-val]').forEach(b => b.classList.remove('is-active'));
            propBtn.classList.add('is-active');
            card.dataset.csPropVal = propBtn.dataset.csPropVal;
            updateAddBtnState(card);
            return;
          }

          // Adicionar guia ao carrinho
          const addBtn = e.target.closest('[data-cs-add]');
          if (!addBtn) return;
          if (addBtn.disabled) {
            console.warn('[cross-sell] botão clicado mas está disabled');
            return;
          }
          const card = addBtn.closest('[data-cs-card]');
          if (!card) {
            console.warn('[cross-sell] card pai não encontrado');
            return;
          }
          const guiaHandle = card.dataset.csGuia;
          console.log('[cross-sell] add clicked. guia=', guiaHandle);

          const guia = await fetchProduct(guiaHandle);
          if (!guia) {
            console.warn('[cross-sell] guia não retornada do fetch:', guiaHandle);
            (window.AmePdpToast || alert)('Não foi possível encontrar a guia.');
            return;
          }

          const totalOpts = parseInt(card.dataset.csTotalOpts, 10) || 0;
          const selections = [];
          for (let i = 0; i < totalOpts; i++) {
            const v = card.dataset['csSel' + i];
            console.log('[cross-sell] sel ' + i + ' =', v);
            if (!v) {
              (window.AmePdpToast || alert)('Selecione todas as opções.');
              return;
            }
            selections.push(v);
          }

          const variant = findVariant(guia, selections);
          console.log('[cross-sell] selections:', selections, '→ variant:', variant);
          if (!variant) {
            (window.AmePdpToast || alert)('Não encontramos uma variante com essa combinação: ' + selections.join(' / '));
            return;
          }

          // Propriedades (ex: Comprimento da Guia) — só se a guia exigir
          const needsProp = card.dataset.csNeedsProp === '1';
          const propName = card.dataset.csPropName || '';
          const propVal = card.dataset.csPropVal || '';
          const propsPayload = {};
          if (needsProp && propName && propVal) {
            propsPayload[propName] = propVal;
          }

          addBtn.disabled = true;
          addBtn.textContent = 'Adicionando...';
          try {
            const itemPayload = { id: variant.id, quantity: 1 };
            if (Object.keys(propsPayload).length) itemPayload.properties = propsPayload;
            const res = await fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: [itemPayload] })
            });
            if (!res.ok) {
              const err = await res.json().catch(() => ({}));
              throw new Error(err.description || err.message || 'Erro ao adicionar');
            }
            const refreshed = await (await fetch('/cart.js')).json();
            window.AmeCart?.refresh(refreshed);
          } catch (err) {
            console.warn('[cross-sell] add failed:', err);
            addBtn.disabled = false;
            addBtn.textContent = 'Tente novamente';
            (window.AmePdpToast || alert)(err.message || 'Não foi possível adicionar.');
          }
        });

        /* Habilita botão Adicionar quando todas as opções + property
           obrigatória estão preenchidas. */
        function updateAddBtnState(card) {
          const totalOpts = parseInt(card.dataset.csTotalOpts, 10) || 0;
          let allOpts = true;
          for (let i = 0; i < totalOpts; i++) {
            if (!card.dataset['csSel' + i]) { allOpts = false; break; }
          }
          const needsProp = card.dataset.csNeedsProp === '1';
          const hasProp = !needsProp || !!card.dataset.csPropVal;
          const addBtn = card.querySelector('[data-cs-add]');
          if (!addBtn) return;
          if (allOpts && hasProp) {
            addBtn.disabled = false;
            addBtn.textContent = 'Adicionar ao carrinho';
          }
        }

        /* Limpar carrinho — exige 2 cliques (confirmação inline).
           Primeiro clique: muda label pra "Confirmar?" e adiciona is-confirming.
           Segundo clique (dentro de 5s): chama /cart/clear.js e atualiza drawer.
           Click fora ou timeout 5s: cancela. */
        let clearConfirmTimer = null;
        document.addEventListener('click', async (e) => {
          const clearBtn = e.target.closest('[data-cart-clear]');
          if (!clearBtn) {
            // Click fora do botão cancela o estado de confirmação
            document.querySelectorAll('[data-cart-clear].is-confirming').forEach(b => {
              b.classList.remove('is-confirming');
              b.textContent = b.dataset.labelOriginal || 'Esvaziar carrinho';
            });
            clearTimeout(clearConfirmTimer);
            return;
          }
          if (!clearBtn.classList.contains('is-confirming')) {
            // 1º clique: pede confirmação
            clearBtn.dataset.labelOriginal = clearBtn.textContent;
            clearBtn.classList.add('is-confirming');
            clearBtn.textContent = 'Toque novamente para confirmar';
            clearTimeout(clearConfirmTimer);
            clearConfirmTimer = setTimeout(() => {
              clearBtn.classList.remove('is-confirming');
              clearBtn.textContent = clearBtn.dataset.labelOriginal || 'Esvaziar carrinho';
            }, 5000);
            e.stopPropagation();
            return;
          }
          // 2º clique: limpa de fato
          clearTimeout(clearConfirmTimer);
          clearBtn.disabled = true;
          clearBtn.textContent = 'Esvaziando...';
          try {
            await fetch('/cart/clear.js', { method: 'POST' });
            const refreshed = await (await fetch('/cart.js')).json();
            window.AmeCart?.refresh(refreshed);
          } catch (err) {
            console.warn('[cart] clear failed:', err);
            (window.AmePdpToast || alert)('Não foi possível esvaziar o carrinho.');
          } finally {
            clearBtn.disabled = false;
            clearBtn.classList.remove('is-confirming');
            clearBtn.textContent = clearBtn.dataset.labelOriginal || 'Esvaziar carrinho';
          }
        });

        /* Hook na refresh do drawer pra recalcular sugestões */
        const _origRefresh = refreshDrawer;
        refreshDrawer = function (cart) {
          _origRefresh(cart);
          renderCrossSell(cart);
        };

        /* Render inicial (no load) — busca cart atual e popula os slots */
        if (document.querySelector('[data-cs-slot]')) {
          fetch('/cart.js').then(r => r.json()).then(renderCrossSell).catch(() => {});
        }

        window.AmeCart = { open: openCart, close: closeCart, refresh: refreshDrawer };
      })();
    </script>
  </body>
</html>
