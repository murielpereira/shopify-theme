{% doc %}
  @prompt
    Crie uma seção para um banner de video, que ocupe toda a largura da página e com um unico CTA, permitindo colocar um link. Permita escolher a posição e personalizar o cta via painel.  Serão videos diferente para mobile e desktop., Permita poder escolher videos locais, e use link de video como fallback.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-video-banner-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.min_height_desktop }}px;
    overflow: hidden;
    display: block;
  }

  .ai-video-banner__video-wrapper-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .ai-video-banner__video-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-video-banner__placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-video-banner__placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-video-banner__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    pointer-events: none;
  }

  .ai-video-banner__content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: {{ block.settings.content_alignment_horizontal }};
    justify-content: {{ block.settings.content_alignment_vertical }};
    min-height: {{ block.settings.min_height_desktop }}px;
    padding: 40px 20px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-video-banner__heading-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    margin: 0 0 16px;
    max-width: 800px;
  }

  .ai-video-banner__subheading-{{ ai_gen_id }} {
    color: {{ block.settings.subheading_color }};
    font-size: {{ block.settings.subheading_size }}px;
    margin: 0 0 24px;
    max-width: 600px;
  }

  .ai-video-banner__cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .ai-video-banner__cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .ai-video-banner-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
    }

    .ai-video-banner__content-{{ ai_gen_id }} {
      min-height: {{ block.settings.min_height_mobile }}px;
      padding: 30px 16px;
    }

    .ai-video-banner__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-video-banner__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-video-banner__cta-{{ ai_gen_id }} {
      font-size: {{ block.settings.cta_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<video-banner-{{ ai_gen_id }} class="ai-video-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-video-banner__video-wrapper-{{ ai_gen_id }}">
    {% liquid
      assign has_desktop_video = false
      assign has_mobile_video = false
      
      if block.settings.video_desktop_file != blank
        assign desktop_video_src = block.settings.video_desktop_file | file_url
        assign has_desktop_video = true
      elsif block.settings.video_desktop_url != blank
        assign desktop_video_src = block.settings.video_desktop_url
        assign has_desktop_video = true
      endif
      
      if block.settings.video_mobile_file != blank
        assign mobile_video_src = block.settings.video_mobile_file | file_url
        assign has_mobile_video = true
      elsif block.settings.video_mobile_url != blank
        assign mobile_video_src = block.settings.video_mobile_url
        assign has_mobile_video = true
      endif
    %}

    {% if has_desktop_video or has_mobile_video %}
      {% if has_desktop_video %}
        <video
          class="ai-video-banner__video-{{ ai_gen_id }} ai-video-banner__video-desktop-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
          src="{{ desktop_video_src }}"
          aria-label="Vídeo de fundo do banner"
        ></video>
      {% endif %}
      
      {% if has_mobile_video %}
        <video
          class="ai-video-banner__video-{{ ai_gen_id }} ai-video-banner__video-mobile-{{ ai_gen_id }}"
          autoplay
          muted
          loop
          playsinline
          src="{{ mobile_video_src }}"
          aria-label="Vídeo de fundo do banner (mobile)"
          style="display: none;"
        ></video>
      {% endif %}
    {% else %}
      <div class="ai-video-banner__placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-video-banner__overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-video-banner__content-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-video-banner__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-video-banner__subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
    {% endif %}

    {% if block.settings.cta_text != blank %}
      <a
        href="{{ block.settings.cta_link }}"
        class="ai-video-banner__cta-{{ ai_gen_id }}"
      >
        {{ block.settings.cta_text }}
      </a>
    {% endif %}
  </div>
</video-banner-{{ ai_gen_id }}>

<script>
  (function() {
    class VideoBanner{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.desktopVideo = this.querySelector('.ai-video-banner__video-desktop-{{ ai_gen_id }}');
        this.mobileVideo = this.querySelector('.ai-video-banner__video-mobile-{{ ai_gen_id }}');
      }

      connectedCallback() {
        if (this.mobileVideo && this.desktopVideo) {
          this.handleResponsiveVideo();
          window.addEventListener('resize', this.handleResponsiveVideo.bind(this));
        }
      }

      handleResponsiveVideo() {
        const isMobile = window.innerWidth < 750;
        
        if (this.desktopVideo && this.mobileVideo) {
          if (isMobile) {
            this.desktopVideo.style.display = 'none';
            this.mobileVideo.style.display = 'block';
            this.mobileVideo.play();
          } else {
            this.desktopVideo.style.display = 'block';
            this.mobileVideo.style.display = 'none';
            this.desktopVideo.play();
          }
        }
      }

      disconnectedCallback() {
        if (this.mobileVideo && this.desktopVideo) {
          window.removeEventListener('resize', this.handleResponsiveVideo.bind(this));
        }
      }
    }

    customElements.define('video-banner-{{ ai_gen_id }}', VideoBanner{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Banner de vídeo",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Vídeo desktop"
    },
    {
      "type": "paragraph",
      "content": "Escolha um vídeo local (recomendado) ou insira um link como alternativa."
    },
    {
      "type": "video",
      "id": "video_desktop_file",
      "label": "Vídeo local (desktop)"
    },
    {
      "type": "video_url",
      "id": "video_desktop_url",
      "label": "Link do vídeo (desktop)",
      "accept": ["youtube", "vimeo"],
      "info": "Usado apenas se nenhum vídeo local for selecionado"
    },
    {
      "type": "header",
      "content": "Vídeo mobile"
    },
    {
      "type": "paragraph",
      "content": "Escolha um vídeo local (recomendado) ou insira um link como alternativa."
    },
    {
      "type": "video",
      "id": "video_mobile_file",
      "label": "Vídeo local (mobile)"
    },
    {
      "type": "video_url",
      "id": "video_mobile_url",
      "label": "Link do vídeo (mobile)",
      "accept": ["youtube", "vimeo"],
      "info": "Usado apenas se nenhum vídeo local for selecionado"
    },
    {
      "type": "header",
      "content": "Dimensões"
    },
    {
      "type": "range",
      "id": "min_height_desktop",
      "label": "Altura mínima (desktop)",
      "min": 300,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "min_height_mobile",
      "label": "Altura mínima (mobile)",
