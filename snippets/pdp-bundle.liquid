{%- comment -%}
  Widget "Compre Junto" da PDP.

  Lê tags `crosssell:<handle>` do produto atual, busca cada produto via
  /products/<handle>.js (client-side), monta uma lista com checkboxes
  e auto-match de variante com a do produto atual.

  Diferente do bundle clássico: NÃO tem botão "Adicionar ao carrinho"
  próprio nem o produto atual na lista. O cliente clica o CTA normal
  do PDP e os cross-sells marcados vão junto no mesmo POST /cart/add.js
  (interceptado pelo submit handler em sections/product.liquid).

  Não renderiza se: produto tem `crosssell:none`/`no-crosssell`,
  nenhuma tag `crosssell:*` válida, ou nenhum cross-sell em estoque.

  Limite de 4 cross-sells.
{%- endcomment -%}

<div class="pdp-bundle" data-pdp-bundle hidden>
  <h2 class="pdp-bundle__title">Compre Junto</h2>
  <p class="pdp-bundle__subtitle">Adicione com 1 clique ao seu pedido</p>
  <ul class="pdp-bundle__list" data-pdp-bundle-list></ul>
</div>

{%- comment -%}
  Custom fields globais (settings 1..20) — gated por tag. Passamos a config
  inteira pro JS; ele decide quais aplicam a cada cross-sell comparando a
  tag de cada CF com as tags do produto sugerido (carregadas via /products/X.js).
{%- endcomment -%}
{%- capture cfs_json -%}
  [
    {%- assign first = true -%}
    {%- for cf_i in (1..20) -%}
      {%- assign en = 'custom_field_' | append: cf_i | append: '_enable' -%}
      {%- if settings[en] -%}
        {%- unless first -%},{%- endunless -%}
        {%- assign first = false -%}
        {%- assign tag_k = 'custom_field_' | append: cf_i | append: '_tag' -%}
        {%- assign nm_k  = 'custom_field_' | append: cf_i | append: '_name' -%}
        {%- assign tt_k  = 'custom_field_' | append: cf_i | append: '_title' -%}
        {%- assign ph_k  = 'custom_field_' | append: cf_i | append: '_placeholder' -%}
        {%- assign hl_k  = 'custom_field_' | append: cf_i | append: '_helper' -%}
        {%- assign lm_k  = 'custom_field_' | append: cf_i | append: '_limiter' -%}
        {%- assign tp_k  = 'custom_field_' | append: cf_i | append: '_type' -%}
        {%- assign op_k  = 'custom_field_' | append: cf_i | append: '_options' -%}
        {%- assign rq_k  = 'custom_field_' | append: cf_i | append: '_required' -%}
        {
          "tag": {{ settings[tag_k] | default: '' | json }},
          "name": {{ settings[nm_k] | default: '' | json }},
          "title": {{ settings[tt_k] | default: '' | json }},
          "placeholder": {{ settings[ph_k] | default: '' | json }},
          "helper": {{ settings[hl_k] | default: '' | json }},
          "limiter": {{ settings[lm_k] | default: 0 | json }},
          "type": {{ settings[tp_k] | default: 'text' | json }},
          "options": {{ settings[op_k] | default: '' | json }},
          "required": {{ settings[rq_k] | default: false | json }}
        }
      {%- endif -%}
    {%- endfor -%}
  ]
{%- endcapture -%}

<script type="application/json" data-pdp-bundle-config>
  {
    "currentHandle": {{ product.handle | json }},
    "tags": {{ product.tags | json }},
    "customFields": {{ cfs_json }}
  }
</script>

<style>
  .pdp-bundle {
    padding: 1rem 1.25rem;
    background: var(--color-surface, #fff);
    border: 1px solid var(--color-outline-variant, #e6dad1);
    border-radius: 12px;
    margin: 1rem 0;
  }
  .pdp-bundle[hidden] {
    display: none;
  }
  .pdp-bundle__title {
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.25rem;
    color: var(--color-on-background, #201b14);
  }
  .pdp-bundle__subtitle {
    font-size: 0.8125rem;
    color: var(--color-on-surface-muted, #6f645d);
    margin: 0 0 0.75rem;
  }
  .pdp-bundle__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .pdp-bundle__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 0.625rem;
    border: 1px solid var(--color-outline-variant, #e6dad1);
    border-radius: 10px;
    background: var(--color-surface, #fff);
  }
  /* Estado "não incluído": o dim fica só na miniatura, não no <li> inteiro.
     Todo cross-sell nasce desmarcado (checked: false em ame-pdp-bundle.js),
     então o antigo `opacity: .5` no item era o estado DEFAULT do bloco e
     derrubava o contraste de TODO o texto sobre #f7f5f2: nome 3,23:1, label
     de variante 2,07:1 e o "De:" riscado 1,43:1 (mínimo AA = 4,5:1). O
     checkbox vazio já comunica "não incluído" sem apagar nome e preço. */
  .pdp-bundle__item.is-unchecked .pdp-bundle__img {
    opacity: 0.55;
  }
  .pdp-bundle__check {
    width: 1.125rem;
    height: 1.125rem;
    flex-shrink: 0;
    cursor: pointer;
    accent-color: var(--color-primary, #5a4742);
  }
  .pdp-bundle__img {
    width: 3rem;
    height: 3rem;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
    background: var(--color-surface-container, #f8ece0);
    transition: opacity 0.15s;
  }
  .pdp-bundle__info {
    flex: 1;
    min-width: 0;
  }
  .pdp-bundle__name {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
    line-height: 1.3;
    color: var(--color-on-background, #201b14);
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  /* Os textos secundários deste bloco usavam var(--text-muted, #6b6259), mas
     --text-muted não existe em nenhum lugar do tema (sempre caía no fallback).
     Trocado pelo token real, que é themeável e vale 5,3:1 sobre #f7f5f2. */
  .pdp-bundle__variant-label {
    font-size: 0.6875rem;
    color: var(--color-on-surface-muted, #6f645d);
    margin: 0.125rem 0 0;
  }
  .pdp-bundle__row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    width: 100%;
  }
  /* Linha de preço: "De: R$ X" riscado + selo de % + preço final */
  .pdp-bundle__price-wrap {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
    align-self: flex-end;
  }
  /* rgba(90,71,66,.45) dava 2,10:1 sobre #f7f5f2 (1,43:1 com o dim antigo do
     item): o preço "De" ficava invisível. O token vale 5,3:1 e o line-through
     + o tamanho menor mantêm a distinção com o preço final, sem depender da
     cor. */
  .pdp-bundle__compare {
    font-size: 0.75rem;
    color: var(--color-on-surface-muted, #6f645d);
    text-decoration: line-through;
    white-space: nowrap;
  }
  .pdp-bundle__discount {
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    background: rgba(90, 71, 66, 0.09);
    color: var(--color-primary, #5a4742);
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    white-space: nowrap;
  }
  .pdp-bundle__price {
    font-size: 0.875rem;
    font-weight: 600;
    margin: 0;
    white-space: nowrap;
    color: var(--color-on-background, #201b14);
    text-align: right;
  }
  .pdp-bundle__variants {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.375rem;
  }
  .pdp-bundle__variant-btn {
    font-size: 0.6875rem;
    padding: 0.1875rem 0.5rem;
    border: 1px solid var(--color-outline-variant, #e6dad1);
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-on-background, #201b14);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .pdp-bundle__variant-btn:hover {
    background: var(--color-surface-container, #f8ece0);
  }
  .pdp-bundle__variant-btn[aria-pressed='true'] {
    background: var(--color-primary, #5a4742);
    color: #fff;
    border-color: var(--color-primary, #5a4742);
  }
  .pdp-bundle__variant-btn[disabled] {
    opacity: 0.4;
    cursor: not-allowed;
    text-decoration: line-through;
  }
  .pdp-bundle__cf {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-top: 0.5rem;
  }
  .pdp-bundle__cf-label {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--color-on-background, #201b14);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pdp-bundle__cf-label--required::after {
    content: ' *';
    color: #b3261e;
  }
  .pdp-bundle__cf-input,
  .pdp-bundle__cf-select {
    width: 100%;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--color-outline-variant, #e6dad1);
    border-radius: 8px;
    background: var(--color-surface, #fff);
    font-size: 0.8125rem;
    color: var(--color-on-background, #201b14);
    font-family: inherit;
  }
  .pdp-bundle__cf-input:focus,
  .pdp-bundle__cf-select:focus {
    outline: none;
    border-color: var(--color-primary, #5a4742);
  }
  .pdp-bundle__cf-input--invalid {
    border-color: #b3261e;
  }
  .pdp-bundle__cf-helper {
    font-size: 0.6875rem;
    color: var(--color-on-surface-muted, #6f645d);
    margin: 0;
  }
  .pdp-bundle__cf-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }
  .pdp-bundle__cf-pill {
    font-size: 0.75rem;
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--color-outline-variant, #e6dad1);
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    color: var(--color-on-background, #201b14);
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .pdp-bundle__cf-pill:hover {
    background: var(--color-surface-container, #f8ece0);
  }
  .pdp-bundle__cf-pill[aria-pressed='true'] {
    background: var(--color-primary, #5a4742);
    color: #fff;
    border-color: var(--color-primary, #5a4742);
  }
  .pdp-bundle__cf--invalid .pdp-bundle__cf-label {
    color: #b3261e;
  }
  .pdp-bundle__cf--invalid .pdp-bundle__cf-pill {
    border-color: #b3261e;
  }
</style>

<script src="{{ 'ame-pdp-bundle.js' | asset_url }}" defer></script>
