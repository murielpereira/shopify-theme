{% comment %}
  Calculadora de frete no carrinho — chama a Shopify Ajax API
  `/cart/shipping_rates.json` que delega pra TODAS as carrier services
  configuradas (SmartEnvios incluída). Mesmo cálculo que aparece no
  checkout — zero divergência.

  CEP fica salvo em localStorage entre sessões. Quando o cart muda
  (item adicionado/removido), o cliente clica "Recalcular" pra atualizar.

  Vide [snippets/cart-drawer.liquid] onde é renderizado.
{% endcomment %}

<div class="ame-cart-freight" data-cart-freight>
  <p class="ame-cart-freight__title">
    <span class="material-symbols-outlined" aria-hidden="true">local_shipping</span>
    Calcular frete
  </p>
  <form class="ame-cart-freight__form" data-cart-freight-form novalidate>
    <input
      type="text"
      id="ame-cart-freight-cep"
      name="cep"
      inputmode="numeric"
      autocomplete="postal-code"
      placeholder="00000-000"
      maxlength="9"
      aria-label="CEP de entrega"
      class="ame-cart-freight__input"
      data-cart-freight-input
    >
    <button type="submit" class="ame-cart-freight__btn" data-cart-freight-submit>
      <span data-cart-freight-btn-label>Calcular</span>
    </button>
  </form>
  <a href="https://buscacepinter.correios.com.br/app/endereco/index.php" target="_blank" rel="noopener" class="ame-cart-freight__cep-link">
    Não sei meu CEP
  </a>
  <ul class="ame-cart-freight__results" data-cart-freight-results hidden></ul>
  <p class="ame-cart-freight__error" data-cart-freight-error hidden></p>
  {%- render 'avisos-frete', onde: 'carrinho' -%}
</div>

<script defer src="{{ 'ame-cart-frete.js' | asset_url }}"></script>

<style>
  .ame-cart-freight {
    padding: 0.875rem 0 0.5rem;
    border-top: 1px solid rgba(210, 195, 192, 0.25);
    margin-top: 0.5rem;
  }

  .ame-cart-freight__title {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0 0 0.625rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-primary, #5a4742);
  }

  .ame-cart-freight__title .material-symbols-outlined {
    font-size: 0.95rem;
    font-variation-settings: 'wght' 300;
  }

  .ame-cart-freight__form {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .ame-cart-freight__input {
    flex: 1;
    border: 1px solid var(--color-outline-variant, #d2c3c0);
    border-radius: var(--radius-md, 0.25rem);
    padding: 0.5rem 0.625rem;
    font-size: 0.875rem;
    color: var(--color-on-background, #201b14);
    background: var(--color-surface, #fff);
    outline: none;
    transition: border-color 0.2s ease;
  }
  .ame-cart-freight__input::placeholder {
    color: rgba(90, 71, 66, 0.4);
  }
  .ame-cart-freight__input:focus {
    border-color: var(--color-primary, #5a4742);
  }

  .ame-cart-freight__btn {
    position: relative;
    flex-shrink: 0;
    background: var(--color-primary, #5a4742);
    color: var(--color-on-primary, #fff);
    border: none;
    cursor: pointer;
    border-radius: var(--radius-md, 0.25rem);
    padding: 0.5rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: opacity 0.15s ease;
  }
  .ame-cart-freight__btn:hover:not(:disabled) { opacity: 0.9; }
  .ame-cart-freight__btn:disabled { opacity: 0.6; cursor: default; }
  /* Estado loading: esconde o texto e mostra spinner rotativo por cima.
     Evita que "Calculando..." estoure a largura do botão em telas estreitas. */
  .ame-cart-freight__btn.is-loading > * { visibility: hidden; }
  .ame-cart-freight__btn.is-loading::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 1rem;
    height: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    border-radius: 50%;
    animation: ame-freight-spin 0.7s linear infinite;
  }
  @keyframes ame-freight-spin {
    to { transform: rotate(360deg); }
  }

  .ame-cart-freight__cep-link {
    display: inline-block;
    margin-top: 0.375rem;
    font-size: 0.6875rem;
    color: rgba(90, 71, 66, 0.55);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .ame-cart-freight__cep-link:hover { color: var(--color-primary, #5a4742); }

  .ame-cart-freight__error {
    margin: 0.625rem 0 0;
    padding: 0.5rem 0.75rem;
    background: rgba(192, 57, 43, 0.08);
    color: #a8392b;
    border-radius: var(--radius-md, 0.25rem);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .ame-cart-freight__results {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  /* Sem esta guarda o `hidden` do <ul> não vale nada: `[hidden]` só existe na
     folha do navegador e o `display:flex` acima a derruba. A lista fica vazia
     antes de calcular o frete, então o estrago é só o `margin-top` sobrando —
     mas é o mesmo defeito que fez os kits mostrarem "De: —" em 01/10/2026. */
  .ame-cart-freight__results[hidden] {
    display: none;
  }

  /* Card informativo — sem seleção. Cliente escolhe o frete no checkout,
     aqui apenas mostramos as cotações pra o cliente ter previsibilidade. */
  .ame-cart-freight__result {
    list-style: none;
    margin: 0;
    padding: 0.625rem 0.75rem;
    background: var(--color-surface-container-lowest, #fff);
    border: 1px solid var(--color-outline-variant, #d2c3c0);
    border-radius: var(--radius-md, 0.5rem);
  }

  /* Placeholder enquanto a cotação é refeita depois de mudar o carrinho. */
  .ame-cart-freight__result--loading {
    text-align: center;
    border-style: dashed;
    background: transparent;
    color: var(--color-on-surface-variant, #4f4442);
    font-size: 0.75rem;
  }

  .ame-cart-freight__result-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    font-size: 0.8125rem;
  }

  .ame-cart-freight__result-top {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }


  .ame-cart-freight__result-name {
    flex: 1;
    color: var(--color-on-background, #201b14);
    font-weight: 500;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ame-cart-freight__result-prazo {
    font-size: 0.6875rem;
    color: var(--color-on-surface-variant, #4f4442);
  }
  .ame-cart-freight__result-prazo strong {
    color: var(--color-on-background, #201b14);
    font-weight: 600;
  }

  /* Tags "Mais barato" / "Mais rápido" / "Melhor opção" */
  .ame-cart-freight__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }

  .ame-cart-freight__tag {
    display: inline-block;
    font-size: 0.5625rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
    line-height: 1.2;
  }

  .ame-cart-freight__tag--cheap {
    background: #d4f0db;
    color: #15803d;
  }
  .ame-cart-freight__tag--fast {
    background: #dbeafe;
    color: #1d4ed8;
  }
  .ame-cart-freight__tag--best {
    background: linear-gradient(135deg, #c89b5e 0%, #e9c89a 50%, #c89b5e 100%);
    color: #fff;
  }

  .ame-cart-freight__result-price {
    font-weight: 700;
    color: var(--color-on-background, #201b14);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
