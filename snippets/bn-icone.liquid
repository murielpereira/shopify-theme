{%- comment -%}
  Âme · ícone de linha (traço, 24x24) usado nos blocos de confiança da Home (bn-diferenciais) e da
  coleção Black November. Parâmetro: icone = garantia | couro | mao | frete | parcelas | cashback | presente.
  A cor e o tamanho vêm do CSS de quem usa (stroke: currentColor ou var).
{%- endcomment -%}
{%- case icone -%}
  {%- when 'garantia' -%}<svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.5-3 8.4-7 10-4-1.6-7-5.5-7-10V6l7-3z"/><path d="M9 12l2 2 4-4"/></svg>
  {%- when 'couro' -%}<svg viewBox="0 0 24 24"><path d="M12 3l1.8 4.7L18.5 9.5l-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/></svg>
  {%- when 'mao' -%}<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg>
  {%- when 'frete' -%}<svg viewBox="0 0 24 24"><path d="M3 6h11v10H3z"/><path d="M14 9h4l3 3v4h-7"/><circle cx="7" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/></svg>
  {%- when 'parcelas' -%}<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M7 15h4"/></svg>
  {%- when 'cashback' -%}<svg viewBox="0 0 24 24"><circle cx="9" cy="9" r="5"/><path d="M14.5 9.5A5 5 0 1 1 9.5 14.5"/><path d="M9 7v4"/></svg>
  {%- when 'presente' -%}<svg viewBox="0 0 24 24"><rect x="4" y="9" width="16" height="11" rx="1"/><path d="M3 9h18M12 9v11M12 9c-2-4-6-4-6-1.5S10 9 12 9zm0 0c2-4 6-4 6-1.5S14 9 12 9z"/></svg>
  {%- else -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/></svg>
{%- endcase -%}
