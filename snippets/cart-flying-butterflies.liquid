{% comment %}
  Âme — Borboletas voadoras pro carrinho
  Cria N borboletas saindo de um elemento de origem (CTA "Adicionar ao Carrinho")
  e voando até o ícone da sacola no header.

  API global:
    window.AmeButterflies.fly(originEl, { count, color, onArrive })

  Uso: chamar `window.AmeButterflies.fly(addBtn)` após sucesso do cart/add.
  Ativação típica: produtos com a tag `efeito_borboletas`.
{% endcomment %}

<style>
  /* Container fixed que cobre a tela; pointer-events: none pra não bloquear clicks */
  .ame-butterfly-swarm {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    overflow: visible;
  }

  /* Cada borboleta: posicionada via JS (left/top), animada via WAAPI */
  .ame-butterfly {
    position: absolute;
    width: 38px;
    height: 30px;
    transform: translate(-50%, -50%);
    will-change: transform, opacity;
  }

  /* Asas: usa o mesmo princípio do CSS original (radial gradient pra cada asa) */
  .ame-butterfly__wings {
    width: 100%;
    height: 100%;
    background:
      radial-gradient(closest-side at 50% 50%, var(--bf-color, #fff) 50%, rgba(255,255,255,0) 50%),
      radial-gradient(closest-side at 50% 50%, var(--bf-color, #fff) 50%, rgba(255,255,255,0) 50%);
    background-repeat: no-repeat;
    background-size: 90% 70%, 100% 70%;
    background-position: 20% -40%, 0 40%;
    filter: drop-shadow(0 3px 6px rgba(32, 27, 20, 0.35));
    animation: ame-butterfly-flap 180ms ease-in-out infinite alternate;
  }

  @keyframes ame-butterfly-flap {
    0%   { transform: scale(1, 1.2) rotate(35deg); }
    100% { transform: scale(0.7, -1) rotate(-35deg); }
  }

  /* Pulse do ícone do carrinho (.ame-cart-pulse) e seu @keyframes vivem no
     critical.css global — evita duplicação com cart-flying-butterflies-svg. */

  /* Respeita preferências de acessibilidade */
  @media (prefers-reduced-motion: reduce) {
    .ame-butterfly-swarm { display: none; }
  }
</style>

<script>
  (() => {
    if (window.AmeButterflies) return;

    const DEFAULT_COUNT = 8;
    const DEFAULT_DURATION = 1800;
    // Paleta combinando com a identidade Âme (cream/brown) + tons pastel
    const DEFAULT_PALETTE = [
      '#ffffff',  // branco
      '#fbcfe8',  // rosa claro
      '#f5d4a8',  // dourado claro
      '#d4b4e0',  // lilás
      '#a8d4c4',  // verde menta
      '#f0a8a8',  // coral
      '#735e59',  // marrom da marca
      '#dcc1ba',  // bege rosado
    ];

    function fly(originEl, opts) {
      if (!originEl) return Promise.resolve();
      const cartIcon = document.querySelector('[data-cart-open]');
      if (!cartIcon) return Promise.resolve();

      const count = (opts && opts.count) || DEFAULT_COUNT;
      const baseDuration = (opts && opts.duration) || DEFAULT_DURATION;
      const palette = (opts && opts.colors) || DEFAULT_PALETTE;
      const onArrive = opts && opts.onArrive;

      const origin = originEl.getBoundingClientRect();
      const target = cartIcon.getBoundingClientRect();
      const startX = origin.left + origin.width / 2;
      const startY = origin.top + origin.height / 2;
      const endX = target.left + target.width / 2;
      const endY = target.top + target.height / 2;
      const dx = endX - startX;
      const dy = endY - startY;

      const swarm = document.createElement('div');
      swarm.className = 'ame-butterfly-swarm';
      swarm.setAttribute('aria-hidden', 'true');
      document.body.appendChild(swarm);

      // Constrói cada borboleta e dispara a animação
      const animations = [];
      for (let i = 0; i < count; i++) {
        const b = document.createElement('div');
        b.className = 'ame-butterfly';
        // Cor aleatória da paleta — cada borboleta com tom diferente
        const color = palette[Math.floor(Math.random() * palette.length)];
        b.style.setProperty('--bf-color', color);
        b.style.left = startX + 'px';
        b.style.top = startY + 'px';
        b.innerHTML = '<div class="ame-butterfly__wings"></div>';
        swarm.appendChild(b);

        // Cada borboleta tem um desvio aleatório no meio do caminho (parábola)
        const wobble = (Math.random() - 0.5) * 120;
        const arcHeight = -Math.abs(dx) * 0.4 - 120;
        const startRot = (Math.random() - 0.5) * 40;
        const midRot = (Math.random() - 0.5) * 80;
        // Delay maior pra espalhar o enxame e dar tempo de ver cada borboleta
        const delay = i * 140;
        const duration = baseDuration + (Math.random() - 0.5) * 400;

        const anim = b.animate(
          [
            { transform: 'translate(-50%, -50%) rotate(' + startRot + 'deg) scale(1)', opacity: 1 },
            {
              transform:
                'translate(calc(' + dx * 0.5 + 'px - 50%), calc(' + arcHeight + 'px + ' + wobble + 'px - 50%)) rotate(' + midRot + 'deg) scale(1.1)',
              offset: 0.55,
              opacity: 1,
            },
            {
              transform: 'translate(calc(' + dx + 'px - 50%), calc(' + dy + 'px - 50%)) rotate(0deg) scale(0.25)',
              opacity: 0,
            },
          ],
          { duration: duration, delay: delay, easing: 'cubic-bezier(0.42, 0, 0.55, 1)', fill: 'forwards' }
        );
        animations.push(anim.finished.catch(() => {}));
      }

      // Mantém o swarm vivo até a última borboleta terminar; remove em background.
      Promise.all(animations).finally(() => swarm.remove());

      // Retorna uma promise que resolve quando a primeira borboleta chega (~ baseDuration).
      // Assim o drawer abre nesse momento e as borboletas restantes continuam voando
      // sem bloquear o cliente.
      return new Promise((resolve) => {
        setTimeout(() => {
          cartIcon.classList.add('ame-cart-pulse');
          setTimeout(() => cartIcon.classList.remove('ame-cart-pulse'), 600);
          if (onArrive) onArrive();
          resolve();
        }, baseDuration);
      });
    }

    window.AmeButterflies = { fly };
    console.info('[ame-butterflies] snippet carregado');
  })();
</script>
