{%- comment -%}
  Modal com a tabela completa de parcelas (1x..max_n).

  Cada linha mostra: nº de parcelas × valor da parcela = total. Marca quando
  é sem juros (sem aumento no total) vs com juros (taxa da tabela aplicada).
  Aberto pelo botão "Ver mais detalhes" no installments-info.liquid (data-
  installments-modal-open).

  Params:
    price_cents — int (preço em centavos)
{%- endcomment -%}
{%- liquid
  if settings.show_installments == false
    assign skip = true
  endif
-%}
{%- unless skip -%}
  {%- liquid
    assign price_int = price_cents | default: 0 | plus: 0
    assign max_n = settings.installments_max | default: 12
    assign no_int_max = settings.installments_no_interest | default: 6
    assign min_value_brl = settings.installment_min_value | default: 40
    assign min_value_cents = min_value_brl | times: 100

    if no_int_max > max_n
      assign no_int_max = max_n
    endif

    # Pix com desconto (pra exibir no topo do modal)
    assign pix_pct = settings.pix_discount | default: 5
    assign pix_disc_cents = price_int | times: pix_pct | divided_by: 100
    assign pix_price_cents = price_int | minus: pix_disc_cents
    assign show_pix = settings.show_pix

    # Parse da tabela de juros: "1:2.61, 2:3.81, ..." → array por índice de parcela
    # Liquid não suporta map<int,float>, então uso array onde inst_taxas[n-1] = taxa
    assign taxas_raw = settings.installments_interest_table | default: ''
  -%}

  <dialog class="ame-installments-modal" data-installments-modal aria-labelledby="ame-installments-modal-title">
    <div class="ame-installments-modal__inner">
      <header class="ame-installments-modal__header">
        <h2 id="ame-installments-modal-title" class="ame-installments-modal__title">Formas de pagamento</h2>
        <button type="button" class="ame-installments-modal__close" data-installments-modal-close aria-label="Fechar">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </header>

      {%- if show_pix != false and price_int > 0 -%}
        <div class="ame-installments-modal__pix" data-installments-modal-pix>
          <div class="ame-installments-modal__pix-label">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <polyline points="20 6 9 17 4 12"/>
            </svg>
            <span
              >No Pix com <strong>{{ pix_pct }}%</strong> de desconto</span
            >
          </div>
          <div class="ame-installments-modal__pix-value">
            <strong data-installments-modal-pix-value>{{ pix_price_cents | money }}</strong>
            <span data-installments-modal-pix-saved>Economize {{ pix_disc_cents | money }}</span>
          </div>
        </div>
      {%- endif -%}

      <table class="ame-installments-modal__table">
        <thead>
          <tr>
            <th>Parcelas</th>
            <th>Valor da parcela</th>
            <th>Total</th>
          </tr>
        </thead>
        <tbody>
          {%- liquid
            # ⚡ Bolt: Optimize installment table rendering
            # 💡 What: Prepare padded string for O(1) interest rate lookups inside the loop instead of O(N) array iteration.
            # 🎯 Why: Replaces a nested loop (O(N*M)) with native string manipulation and splitting, executing at the C/Rust level and significantly reducing Liquid processing overhead.
            # 📊 Impact: Improves backend response time (TTFB) when rendering the installments modal.
            assign padded_taxas = taxas_raw | replace: ',', ', ' | replace: '  ', ' ' | prepend: ' ' | append: ','
          -%}
          {%- for n in (1..max_n) -%}
            {%- liquid
              assign search_key = ' ' | append: n | append: ':'
              assign taxa_pct = 0
              if padded_taxas contains search_key
                assign taxa_part = padded_taxas | split: search_key | last
                assign taxa_pct = taxa_part | split: ',' | first | strip | times: 1.0
              endif

              # Se está no range sem juros, força taxa=0 (mesmo que tabela tenha valor pra n)
              if n <= no_int_max
                assign taxa_pct = 0
              endif

              # Calcula total e parcela com aritmética em centavos
              # taxa_pct é float tipo 7.96 — multiplico por 100 pra integer
              assign taxa_cent = taxa_pct | times: 100 | round
              assign total_cents = price_int | times: 10000 | plus: 0
              # total = price * (10000 + taxa_cent) / 10000
              assign mult = 10000 | plus: taxa_cent
              assign total_cents = price_int | times: mult | divided_by: 10000
              assign parc_cents = total_cents | divided_by: n
              assign viable = false
              if parc_cents >= min_value_cents
                assign viable = true
              endif
              if n == 1
                assign viable = true
              endif
            -%}
            {%- if viable -%}
              <tr class="ame-installments-modal__row{% if taxa_pct == 0 %} ame-installments-modal__row--no-interest{% endif %}">
                <td>
                  <strong>{{ n }}x</strong>
                  {%- if taxa_pct == 0 -%}
                    <span class="ame-installments-modal__tag ame-installments-modal__tag--no-interest">sem juros</span>
                  {%- else -%}
                    <span class="ame-installments-modal__tag">+{{ taxa_pct }}%</span>
                  {%- endif -%}
                </td>
                <td>{{ parc_cents | money }}</td>
                <td>{{ total_cents | money }}</td>
              </tr>
            {%- endif -%}
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </dialog>

  <script>
    (() => {
      // Singleton — o modal é re-renderizado a cada variante (Section Rendering
      // substitui #pdp-installments-modal-wrap), então NÃO cacheamos o dialog
      // no closure. Buscamos via querySelector na hora pra sempre pegar o
      // dialog ATIVO no DOM. Flag global evita re-bindar os listeners.
      if (window.__ameInstallmentsModalBound) return;
      window.__ameInstallmentsModalBound = true;

      function getDialog() {
        return document.querySelector('[data-installments-modal]');
      }
      function open() {
        const dialog = getDialog();
        if (!dialog) return;
        if (typeof dialog.showModal === 'function') dialog.showModal();
        else dialog.setAttribute('open', '');
      }
      function close() {
        const dialog = getDialog();
        if (!dialog) return;
        if (typeof dialog.close === 'function') dialog.close();
        else dialog.removeAttribute('open');
      }

      // Delegação no document — qualquer botão "Ver mais detalhes" abre o
      // modal ativo. Sobrevive ao Section Rendering swap.
      document.addEventListener('click', (e) => {
        if (e.target.closest('[data-installments-modal-open]')) {
          e.preventDefault();
          open();
          return;
        }
        if (e.target.closest('[data-installments-modal-close]')) {
          e.preventDefault();
          close();
          return;
        }
        // Click no backdrop (target é o próprio dialog, não o inner)
        const dialog = getDialog();
        if (dialog && e.target === dialog) close();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const dialog = getDialog();
        if (dialog && dialog.open) close();
      });
    })();
  </script>

  <style>
    .ame-installments-modal {
      border: none;
      border-radius: var(--radius-lg, 12px);
      padding: 0;
      max-width: 480px;
      width: calc(100% - 2rem);
      background: var(--color-surface, #fff);
      color: var(--color-on-background, #201b14);
      box-shadow: 0 24px 80px rgba(32, 27, 20, 0.25);
      /* Força centralização — algumas regras globais do tema (margin: 0
         no reset) sobrescrevem o `margin: auto` default do <dialog>, fazendo
         ele abrir no canto superior esquerdo. */
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      margin: 0;
      max-height: calc(100vh - 2rem);
      overflow-y: auto;
    }
    .ame-installments-modal::backdrop {
      background: rgba(20, 15, 12, 0.7);
      backdrop-filter: blur(4px);
    }
    .ame-installments-modal__inner {
      padding: 1.25rem 1.25rem 1rem;
    }
    .ame-installments-modal__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 0.875rem;
    }
    .ame-installments-modal__title {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-primary, #5a4742);
      margin: 0;
    }
    .ame-installments-modal__close {
      background: transparent;
      border: none;
      cursor: pointer;
      color: var(--color-on-surface-variant, #4f4442);
      width: 2rem;
      height: 2rem;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.15s ease;
    }
    .ame-installments-modal__close:hover,
    .ame-installments-modal__close:focus-visible {
      background: var(--color-surface-container, #f8ece0);
      outline: none;
    }
    .ame-installments-modal__table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.8125rem;
    }
    .ame-installments-modal__table th {
      text-align: left;
      font-weight: 600;
      font-size: 0.6875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-on-surface-variant, #4f4442);
      padding: 0.5rem 0.5rem 0.5rem 0;
      border-bottom: 1px solid var(--color-outline-variant, #d2c3c0);
    }
    .ame-installments-modal__table th:last-child,
    .ame-installments-modal__table td:last-child {
      text-align: right;
      padding-right: 0;
    }
    .ame-installments-modal__table td {
      padding: 0.5rem 0.5rem 0.5rem 0;
      border-bottom: 1px solid rgba(210, 195, 192, 0.4);
      vertical-align: baseline;
    }
    .ame-installments-modal__row--no-interest td {
      background: rgba(90, 71, 66, 0.02);
    }
    .ame-installments-modal__row strong {
      font-weight: 600;
      margin-right: 0.375rem;
    }
    .ame-installments-modal__tag {
      display: inline-block;
      font-size: 0.625rem;
      padding: 0.1rem 0.4rem;
      border-radius: 999px;
      background: var(--color-surface-container, #f8ece0);
      color: var(--color-on-surface-variant, #4f4442);
      letter-spacing: 0.02em;
    }
    .ame-installments-modal__tag--no-interest {
      background: rgba(90, 116, 97, 0.15);
      color: #5a7461;
      font-weight: 600;
    }
    /* Bloco Pix no topo do modal — destaca o valor com desconto */
    .ame-installments-modal__pix {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      padding: 0.75rem 0.875rem;
      margin-bottom: 0.875rem;
      background: rgba(90, 116, 97, 0.08);
      border: 1px solid rgba(90, 116, 97, 0.2);
      border-radius: var(--radius-md, 8px);
    }
    .ame-installments-modal__pix-label {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      font-size: 0.75rem;
      color: #5a7461;
      line-height: 1.3;
    }
    .ame-installments-modal__pix-label svg {
      flex-shrink: 0;
      color: #5a7461;
    }
    .ame-installments-modal__pix-label strong {
      font-weight: 700;
    }
    .ame-installments-modal__pix-value {
      /*display: flex;*/
      flex-direction: column;
      align-items: flex-end;
      gap: 0.1rem;
      text-align: right;
    }
    .ame-installments-modal__pix-value strong {
      font-size: 1rem;
      font-weight: 700;
      color: var(--color-on-background, #201b14);
      letter-spacing: -0.01em;
    }
    .ame-installments-modal__pix-value span {
      font-size: 0.625rem;
      color: var(--color-on-surface-variant, #4f4442);
      letter-spacing: 0.02em;
    }
  </style>
{%- endunless -%}
