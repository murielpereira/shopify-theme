<style>
  .ame-butterfly-svg-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .ame-butterfly-svg-swarm {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 9999;
    overflow: visible;
  }

  /* Cada borboleta: container 60×60 com perspectiva 3D pras asas */
  .ame-butterfly-svg {
    position: absolute;
    width: 60px;
    height: 60px;
    transform: translate(-50%, -50%);
    transform-style: preserve-3d;
    will-change: transform, opacity;
    /* color é herdado pelo fill="currentColor" do path principal */
    color: var(--bf-color, #5a4742);
    filter: drop-shadow(0 4px 8px rgba(32, 27, 20, 0.3));
  }

  .ame-butterfly-svg__fig {
    position: absolute;
    inset: 0;
    margin: 0;
    transform-style: preserve-3d;
    transform: rotate3d(1, 0.5, 0, 30deg);
  }

  .ame-butterfly-svg__wing {
    position: absolute;
    top: 0;
    width: 50%;
    height: 100%;
    transform-style: preserve-3d;
  }
  .ame-butterfly-svg__wing--left {
    left: 0;
    transform-origin: 100% 50%;
    animation: ame-bf-svg-left-flap 320ms ease-in-out infinite;
  }
  .ame-butterfly-svg__wing--right {
    left: 50%;
    transform-origin: 0 50%;
    animation: ame-bf-svg-right-flap 320ms ease-in-out infinite;
  }
  .ame-butterfly-svg__wing svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .ame-butterfly-svg__wing--right svg {
    transform: scaleX(-1);
  }

  /* Asas batem (rotação 3D em Y, de aberta até quase fechada) */
  @keyframes ame-bf-svg-left-flap {
    0%, 100% { transform: rotate3d(0, 1, 0, 55deg); }
    50%      { transform: rotate3d(0, 1, 0, -65deg); }
  }
  @keyframes ame-bf-svg-right-flap {
    0%, 100% { transform: rotate3d(0, 1, 0, -55deg); }
    50%      { transform: rotate3d(0, 1, 0, 65deg); }
  }

  /* Pulse no ícone do carrinho quando as borboletas chegam (reusa) */
  .ame-cart-pulse {
    animation: ame-cart-pulse 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @keyframes ame-cart-pulse {
    0%   { transform: scale(1); }
    40%  { transform: scale(1.35); }
    65%  { transform: scale(0.92); }
    100% { transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ame-butterfly-svg-swarm { display: none; }
    .ame-cart-pulse { animation: none; }
  }
</style>

<script>
  (() => {
    if (window.AmeButterfliesSvg) return;

    const DEFAULT_COUNT = 8;
    const DEFAULT_DURATION = 1800;
    const DEFAULT_PALETTE = [
      '#fbcfe8', // rosa claro
      '#f5d4a8', // dourado claro
      '#d4b4e0', // lilás
      '#a8d4c4', // verde menta
      '#f0a8a8', // coral
      '#735e59', // marrom da marca
      '#1cb1f2', // azul (original do SVG)
      '#ff9ec7', // pink vivo
      '#9b59b6', // roxo
    ];

    function fly(originEl, opts) {
      if (!originEl) return Promise.resolve();
      const cartIcon = document.querySelector('[data-cart-open]');
      if (!cartIcon) return Promise.resolve();

      const count = (opts && opts.count) || DEFAULT_COUNT;
      const baseDuration = (opts && opts.duration) || DEFAULT_DURATION;
      const palette = (opts && opts.colors) || DEFAULT_PALETTE;
      const onArrive = opts && opts.onArrive;

      const origin = originEl.getBoundingClientRect();
      const target = cartIcon.getBoundingClientRect();
      const startX = origin.left + origin.width / 2;
      const startY = origin.top + origin.height / 2;
      const endX = target.left + target.width / 2;
      const endY = target.top + target.height / 2;
      const dx = endX - startX;
      const dy = endY - startY;

      const swarm = document.createElement('div');
      swarm.className = 'ame-butterfly-svg-swarm';
      swarm.setAttribute('aria-hidden', 'true');
      document.body.appendChild(swarm);

      const wingSVG =
        '<svg viewBox="0 0 119.744 148.477"><use href="#ame-shape-moth"></use></svg>';

      const animations = [];
      for (let i = 0; i < count; i++) {
        const b = document.createElement('div');
        b.className = 'ame-butterfly-svg';
        b.style.setProperty('--bf-color', palette[Math.floor(Math.random() * palette.length)]);
        b.style.left = startX + 'px';
        b.style.top = startY + 'px';
        b.innerHTML =
          '<figure class="ame-butterfly-svg__fig">' +
          '<div class="ame-butterfly-svg__wing ame-butterfly-svg__wing--left">' + wingSVG + '</div>' +
          '<div class="ame-butterfly-svg__wing ame-butterfly-svg__wing--right">' + wingSVG + '</div>' +
          '</figure>';
        swarm.appendChild(b);

        const wobble = (Math.random() - 0.5) * 120;
        const arcHeight = -Math.abs(dx) * 0.4 - 120;
        const startRot = (Math.random() - 0.5) * 40;
        const midRot = (Math.random() - 0.5) * 80;
        const delay = i * 140;
        const duration = baseDuration + (Math.random() - 0.5) * 400;

        const anim = b.animate(
          [
            { transform: 'translate(-50%, -50%) rotate(' + startRot + 'deg) scale(1)', opacity: 1 },
            {
              transform:
                'translate(calc(' + dx * 0.5 + 'px - 50%), calc(' + arcHeight + 'px + ' + wobble + 'px - 50%)) rotate(' + midRot + 'deg) scale(1.1)',
              offset: 0.55,
              opacity: 1,
            },
            {
              transform: 'translate(calc(' + dx + 'px - 50%), calc(' + dy + 'px - 50%)) rotate(0deg) scale(0.25)',
              opacity: 0,
            },
          ],
          { duration: duration, delay: delay, easing: 'cubic-bezier(0.42, 0, 0.55, 1)', fill: 'forwards' }
        );
        animations.push(anim.finished.catch(() => {}));
      }

      Promise.all(animations).finally(() => swarm.remove());

      return new Promise((resolve) => {
        setTimeout(() => {
          cartIcon.classList.add('ame-cart-pulse');
          setTimeout(() => cartIcon.classList.remove('ame-cart-pulse'), 600);
          if (onArrive) onArrive();
          resolve();
        }, baseDuration);
      });
    }

    window.AmeButterfliesSvg = { fly };
    console.info('[ame-butterflies-svg] snippet carregado');
  })();
</script>
