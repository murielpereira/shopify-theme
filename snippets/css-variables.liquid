{% comment %} Âme — Design Tokens + Font preloads (self-hosted) {% endcomment %}

{%- comment -%}
  Fontes self-hosted (em /assets/) — antes vinham do Google Fonts.

  Motivos pra self-host:
  - Sem preconnect/handshake TLS pra fonts.googleapis.com + fonts.gstatic.com
    (eram 2 origens; PSI reclamava de render-blocking nas 2)
  - URL imune a mudanças do Google (woff2 do Google tem hash variável)
  - LGPD/privacidade: nenhum dado de visitante vai pro Google
  - CDN edge da Shopify (mais perto do BR que fonts.gstatic.com)

  Lexend: variable font (wght 200..900 num único arquivo por subset).
  Subsets: latin (a-z, ASCII) e latin-ext (acentos PT-BR + €, etc).
  Browser baixa automaticamente o latin-ext só quando encontra caractere
  fora do latin (via unicode-range).

  Material Symbols: subset com APENAS os ícones realmente usados.
  Variable font (wght 200..400, FILL 0..1) num único arquivo.

  IMPORTANTE: ao adicionar um novo ícone Material Symbols no .liquid/.js,
  é OBRIGATÓRIO regenerar o subset baixando o woff2 atualizado. Senão
  o ícone renderiza como TEXTO LITERAL (ex: "delete" em vez do lixinho).

  Como regenerar o subset (5 passos):
  1. Detectar todos os ícones em uso:
       grep -rohE "material-symbols-outlined[^>]*>[a-z_]+" \
         --include='*.liquid' --include='*.js' \
         snippets/ sections/ layout/ blocks/ assets/ \
       | sed -E 's/.*>([a-z_]+)/\1/' | sort -u | paste -sd,
  2. Cole a lista em &icon_names= na URL do Google Fonts:
       https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@200..400,0..1&icon_names=<lista>&display=block
  3. curl com User-Agent de browser desktop e pegue o url() do .woff2
  4. Baixe o .woff2 e salve em assets/material-symbols-subset.woff2
  5. Commit. O Shopify CDN edge-cacheia o asset por hash; vai propagar.
{%- endcomment -%}

<link rel="preload" href="{{ 'lexend-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'material-symbols-subset.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

{% style %}
  /* Lexend — variable font, subset latin (ASCII) */
  @font-face {
    font-family: 'Lexend';
    font-style: normal;
    font-weight: 200 900;
    font-display: swap;
    src: url('{{ 'lexend-latin.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  /* Lexend — subset latin-ext (acentos PT-BR estendidos) */
  @font-face {
    font-family: 'Lexend';
    font-style: normal;
    font-weight: 200 900;
    font-display: swap;
    src: url('{{ 'lexend-latin-ext.woff2' | asset_url }}') format('woff2');
    unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
  }

  /* Material Symbols Outlined — subset com 42 ícones em uso (inclui delete) */
  @font-face {
    font-family: 'Material Symbols Outlined';
    font-style: normal;
    font-weight: 200 400;
    font-display: block;
    src: url('{{ 'material-symbols-subset.woff2' | asset_url }}') format('woff2');
  }
  .material-symbols-outlined {
    font-family: 'Material Symbols Outlined';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
    -webkit-font-feature-settings: 'liga';
    -webkit-font-smoothing: antialiased;
  }

  {%- liquid
    # Valores de layout hardcoded — antes vinham do admin (aba Layout),
    # removidos pra evitar que mudanças acidentais quebrem o tema.
    # Para ajustar, edite os defaults aqui em [snippets/css-variables.liquid].
    assign r_base = 6
    assign r_sm   = r_base | divided_by: 2.0
    assign r_lg   = r_base | times: 2
    assign r_xl   = r_base | times: 4
    assign r_full = r_base | times: 6

    # Modo de cores (Configurações do tema → Modo de cores): Escuro usa os grupos
    # "Escuro · …"; Claro, os "Claro · …".
    assign escuro = false
    if settings.modo_cores == 'escuro'
      assign escuro = true
    endif
  -%}

  :root {
    /* ── Tipografia ── */
    /* Lexend self-hosted (acima). Fallbacks: system-ui no SO do usuário,
       sans-serif genérico em último caso. Antes interpolava
       settings.type_primary_font.family (Shopify) — removido com a
       transição pra self-host. */
    --font-primary--family: 'Lexend', system-ui, -apple-system, 'Segoe UI', sans-serif;

    /* ── Layout ──
       Mobile: 12px fixo (override no media query abaixo).
       Tablet+: clamp(2rem, 10vw, 160px) — cresce com a viewport até 160px.
       Atenção: o grid global da .shopify-section em [assets/critical.css]
       já reserva --page-margin em cada lado da viewport. Sections internas
       NÃO devem aplicar `padding: ... var(--page-margin)` — isso duplica
       a margem (foi a causa do layout quebrado depois do refactor anterior).
       Use apenas `padding-block` nas sections; o lateral vem do grid. */
    --page-width:   120rem;
    --page-margin:  clamp(2rem, 12vw, 240px); /* era clamp(2rem,10vw,160px) — max subido pra 240px senão 12vw fica capado em telas ≥1366px */
    --section-gap:  clamp(3rem, 6vw, 120px);

    /* ── Cor Principal ── */
    --color-primary:            {% if escuro %}{{ settings.escuro_color_primary }}{% else %}{{ settings.color_primary }}{% endif %};
    --color-primary-container:  {% if escuro %}{{ settings.escuro_color_primary_container }}{% else %}{{ settings.color_primary_container }}{% endif %};
    --color-on-primary:         {% if escuro %}{{ settings.escuro_color_on_primary }}{% else %}{{ settings.color_on_primary }}{% endif %};
    --color-primary-fixed:      #f9dcd6;
    --color-primary-fixed-dim:  #dcc1ba;


    /* ── Fundo e Superfícies ── */
    --color-background:                 {% if escuro %}{{ settings.escuro_color_background }}{% else %}{{ settings.color_background }}{% endif %};
    --color-surface:                    {% if escuro %}{{ settings.escuro_color_surface_lowest | default: '#1c1c1c' }}{% else %}{{ settings.color_background }}{% endif %};
    --color-surface-container-lowest:   {% if escuro %}{{ settings.escuro_color_surface_lowest | default: '#ffffff' }}{% else %}{{ settings.color_surface_lowest | default: '#ffffff' }}{% endif %};
    --color-surface-container-low:      {% if escuro %}{{ settings.escuro_color_surface_low | default: '#fef2e5' }}{% else %}{{ settings.color_surface_low | default: '#fef2e5' }}{% endif %};
    --color-surface-container:          {% if escuro %}{{ settings.escuro_color_surface_container }}{% else %}{{ settings.color_surface_container }}{% endif %};
    --color-surface-container-high:     {% if escuro %}{{ settings.escuro_color_surface_container_high }}{% else %}{{ settings.color_surface_container_high }}{% endif %};
    --color-surface-container-highest:  {% if escuro %}{{ settings.escuro_color_surface_highest | default: '#ece1d5' }}{% else %}{{ settings.color_surface_highest | default: '#ece1d5' }}{% endif %};
    /* derivados dos tokens configuráveis (valores de hoje: #ece1d5, #e3d8cc, #f8ece085) */
    --color-surface-variant:            var(--color-surface-container-highest);
    --color-surface-dim:                color-mix(in srgb, var(--color-surface-container-highest) 96%, #000);
    --color-surface-light:              color-mix(in srgb, var(--color-surface-container) 52%, transparent);
    --color-tertiary-fixed:             #e7e2de;

    /* ── Texto ── */
    --color-on-background:      {% if escuro %}{{ settings.escuro_color_on_background }}{% else %}{{ settings.color_on_background }}{% endif %};
    --color-on-surface:         {% if escuro %}{{ settings.escuro_color_on_background }}{% else %}{{ settings.color_on_background }}{% endif %};
    --color-on-surface-variant: {% if escuro %}{{ settings.escuro_color_on_surface_variant }}{% else %}{{ settings.color_on_surface_variant }}{% endif %};
    {%- comment -%}
      Terceiro nível de texto (abaixo de --color-on-surface-variant). Existe
      porque metade dos blocos de preço usava rgba(90,71,66, .45~.6) direto no
      CSS e reprovava contraste no PSI: "De R$", parcelamento, "a partir de" e
      labels de variante ficavam entre 1,43:1 e 2,91:1 — justamente a
      informação que decide a compra. #6f645d dá 5,1:1 sobre #f8f0e7 e 5,3:1
      sobre #f7f5f2 (mínimo AA = 4,5:1) e continua claramente secundário ao
      #201b14. Use este token em vez de rgba() com alpha baixo.
    {%- endcomment -%}
    --color-on-surface-muted:   {% if escuro %}{{ settings.escuro_color_on_surface_muted | default: '#6c6159' }}{% else %}{{ settings.color_on_surface_muted | default: '#6c6159' }}{% endif %};
    --color-outline:            {% if escuro %}{{ settings.escuro_color_outline | default: '#7a6f6b' }}{% else %}{{ settings.color_outline | default: '#7a6f6b' }}{% endif %};
    --color-outline-variant:    {% if escuro %}{{ settings.escuro_color_outline_variant }}{% else %}{{ settings.color_outline_variant }}{% endif %};

    /* ── Barra de anúncios ── */
    --color-announce-bg:   {% if escuro %}{{ settings.escuro_color_announce_bg }}{% else %}{{ settings.color_announce_bg }}{% endif %};
    --color-announce-text: {% if escuro %}{{ settings.escuro_color_announce_text }}{% else %}{{ settings.color_announce_text }}{% endif %};

    /* ── Cabeçalho e menu ──
       Ícones/links em branco nas configurações seguem a paleta (Cor Principal
       e Texto secundário). O fundo é só a cor-base: o CSS aplica a
       transparência com color-mix. */
    --color-header-bg:         {% if escuro %}{{ settings.escuro_color_header_bg | default: '#fff8f3' }}{% else %}{{ settings.color_header_bg | default: '#fff8f3' }}{% endif %};
    --color-header-icons:      {% if escuro %}{{ settings.escuro_color_header_icons | default: settings.escuro_color_primary }}{% else %}{{ settings.color_header_icons | default: settings.color_primary }}{% endif %};
    --color-header-link:       {% if escuro %}{{ settings.escuro_color_header_link | default: settings.escuro_color_on_surface_variant }}{% else %}{{ settings.color_header_link | default: settings.color_on_surface_variant }}{% endif %};
    --color-header-link-hover: {% if escuro %}{{ settings.escuro_color_header_link_hover | default: settings.escuro_color_primary }}{% else %}{{ settings.color_header_link_hover | default: settings.color_primary }}{% endif %};

    /* ── Rodapé ── em branco nas configurações = Cor Principal / Texto sobre ela */
    --color-footer-bg:   {% if escuro %}{{ settings.escuro_color_footer_bg | default: settings.escuro_color_primary }}{% else %}{{ settings.color_footer_bg | default: settings.color_primary }}{% endif %};
    --color-footer-text: {% if escuro %}{{ settings.escuro_color_footer_text | default: settings.escuro_color_on_primary }}{% else %}{{ settings.color_footer_text | default: settings.color_on_primary }}{% endif %};

    /* ── Carrinho (gaveta) ── */
    --color-cart-bg: {% if escuro %}{{ settings.escuro_color_cart_bg | default: '#ffffff' }}{% else %}{{ settings.color_cart_bg | default: '#ffffff' }}{% endif %};

    /* ── Mistura de imagem ──
       As fotos de fundo branco usam multiply para "derreter" no fundo claro. Num fundo
       escuro o multiply escurece a foto inteira, então no modo Escuro vira normal. */
    --blend-multiply: {% if escuro %}normal{% else %}multiply{% endif %};

    /* ── Sombras e escurecimentos ──
       Base das sombras de cartões/menus e do véu escuro sobre banners, vídeos e
       atrás da gaveta. Separada do Texto principal de propósito: num tema escuro
       o texto é claro, e sombra clara vira brilho. */
    --color-shade: {% if escuro %}{{ settings.escuro_color_shade | default: '#201b14' }}{% else %}{{ settings.color_shade | default: '#201b14' }}{% endif %};

    /* ── Selos, mensagens e avisos ──
       Cada um nasceu de uma cor escrita à mão em vários arquivos; os valores
       padrão são os que já estavam lá. */
    --color-on-accent:    {% if escuro %}{{ settings.escuro_color_on_accent | default: '#ffffff' }}{% else %}{{ settings.color_on_accent | default: '#ffffff' }}{% endif %};
    --color-on-gold:      {% if escuro %}{{ settings.escuro_color_on_gold | default: '#3a2a0c' }}{% else %}{{ settings.color_on_gold | default: '#3a2a0c' }}{% endif %};
    --color-accent-green: {% if escuro %}{{ settings.escuro_color_accent_green | default: '#5a7461' }}{% else %}{{ settings.color_accent_green | default: '#5a7461' }}{% endif %};
    --color-accent-blue:  {% if escuro %}{{ settings.escuro_color_accent_blue | default: '#5a6b74' }}{% else %}{{ settings.color_accent_blue | default: '#5a6b74' }}{% endif %};
    --color-gold:         {% if escuro %}{{ settings.escuro_color_gold | default: '#c89b5e' }}{% else %}{{ settings.color_gold | default: '#c89b5e' }}{% endif %};
    --color-gold-light:   {% if escuro %}{{ settings.escuro_color_gold_light | default: '#e9c89a' }}{% else %}{{ settings.color_gold_light | default: '#e9c89a' }}{% endif %};
    --color-star:         {{ settings.color_star | default: '#f5a623' }};
    --color-error:        {% if escuro %}{{ settings.escuro_color_error | default: '#c0392b' }}{% else %}{{ settings.color_error | default: '#c0392b' }}{% endif %};
    --color-success:      {% if escuro %}{{ settings.escuro_color_success | default: '#166534' }}{% else %}{{ settings.color_success | default: '#166534' }}{% endif %};
    --color-success-bg:   {% if escuro %}{{ settings.escuro_color_success_bg | default: '#d4f0db' }}{% else %}{{ settings.color_success_bg | default: '#d4f0db' }}{% endif %};
    --color-info:         {% if escuro %}{{ settings.escuro_color_info | default: '#1d4ed8' }}{% else %}{{ settings.color_info | default: '#1d4ed8' }}{% endif %};
    --color-info-bg:      {% if escuro %}{{ settings.escuro_color_info_bg | default: '#dbeafe' }}{% else %}{{ settings.color_info_bg | default: '#dbeafe' }}{% endif %};
    --color-notice:       {% if escuro %}{{ settings.escuro_color_notice | default: '#d4a76a' }}{% else %}{{ settings.color_notice | default: '#d4a76a' }}{% endif %};
    --color-notice-text:  {% if escuro %}{{ settings.escuro_color_notice_text | default: '#8a6630' }}{% else %}{{ settings.color_notice_text | default: '#8a6630' }}{% endif %};

    /* ── Botão primário ── */
    --color-btn-primary-bg:   {% if escuro %}{{ settings.escuro_color_btn_primary_bg }}{% else %}{{ settings.color_btn_primary_bg }}{% endif %};
    --color-btn-primary-text: {% if escuro %}{{ settings.escuro_color_btn_primary_text }}{% else %}{{ settings.color_btn_primary_text }}{% endif %};

    /* ── Border radius (gerados a partir de border_radius_base) ── */
    --radius-sm:   {{ r_sm }}px;
    --radius-md:   {{ r_base }}px;
    --radius-lg:   {{ r_lg }}px;
    --radius-xl:   {{ r_xl }}px;
    --radius-full: {{ r_full }}px;

    /* ── Sombras ── */
    --shadow-ambient: 0 16px 32px rgba(32,27,20,0.06);
    --shadow-float:   0 32px 64px rgba(32,27,20,0.08);

    /* ── Easing ── */
    --ease-luxury: cubic-bezier(0.22, 1, 0.36, 1);

     --neutral-0: #ffffff;
    --neutral-25: #fcfdff;
    --neutral-50: #f8fafc;
    --neutral-100: #f1f5f9;
    --neutral-150: #eaf0f7;
    --neutral-200: #e2e8f0;
    --neutral-300: #cbd5e1;
    --neutral-400: #94a3b8;
    --neutral-500: #64748b;
    --neutral-600: #475569;
    --neutral-700: #334155;
    --neutral-800: #1e293b;
    --neutral-900: #0f172a;
    --neutral-950: #020617;

    --success-50: #f0fdf4;
    --success-100: #dcfce7;
    --success-200: #bbf7d0;
    --success-400: #86efac;
    --success-500: #22c55e;
    --success-600: #16a34a;
    --success-700: #15803d;
    --warning-50: #fffbeb;
    --warning-100: #fef3c7;
    --warning-200: #fde68a;
    --warning-500: #f59e0b;
    --warning-600: #d97706;
    --danger-50: #fef2f2;
    --danger-100: #fee2e2;
    --danger-200: #fecaca;
    --danger-400: #f87171;
    --danger-500: #ef4444;
    --danger-600: #dc2626;
    --danger-700: #b91c1c;
    --info-50: #eff6ff;
    --info-100: #dbeafe;
    --info-200: #bfdbfe;
    --info-600: #2563eb;
    --teal-500: #06b6d4;
    --whatsapp-500: #25d366;

    {%- comment -%}
      Cor do botão CTA (comprar/adicionar ao carrinho). Global — usada tanto
      no card do produto (.ame-card__buy-btn) quanto no botão do PDP/kit
      (.ame-cta / .pdp__add-btn). Configurável em Configurações do Tema →
      Cores → "Botão de compra (CTA principal)".
    {%- endcomment -%}
    --pdp-btn-bg: {% if escuro %}{{ settings.escuro_pdp_btn_bg_color | default: '#5a4742' }}{% else %}{{ settings.pdp_btn_bg_color | default: '#5a4742' }}{% endif %};
    --pdp-btn-text: {% if escuro %}{{ settings.escuro_pdp_btn_fg_color | default: '#ffffff' }}{% else %}{{ settings.pdp_btn_fg_color | default: '#ffffff' }}{% endif %};
    --pdp-btn-fg: {% if escuro %}{{ settings.escuro_pdp_btn_fg_color | default: '#ffffff' }}{% else %}{{ settings.pdp_btn_fg_color | default: '#ffffff' }}{% endif %};
  }

  /* Mobile override: 12px de margem lateral é o suficiente. O clamp(2rem, 10vw, 160px)
     que vale do tablet pra cima é exagerado em telas <600px (gasta espaço útil pro
     conteúdo). */
  @media (max-width: 599px) {
    :root {
      --page-margin: 15px;
      /*--page-margin original -e 12px*/
    }
  }
  {%- if escuro -%}
    /* Controles nativos do navegador (lista aberta do <select>, campos, barras) seguem o
       tema escuro; sem isto a lista abre BRANCA com texto claro e as opções somem. */
    :root { color-scheme: dark; }

    /* Conteúdo escrito no admin (descrição de coleção etc.) traz <style> e cores inline
       fixas (fundo branco, texto marrom). No modo Escuro segue a paleta. */
    .ame-col-header__desc .ame-section { background: var(--color-surface-container) !important; }
    .ame-col-header__desc .ame-section p:not(.ame-label):not(.ame-h2) { color: var(--color-on-surface-variant) !important; }
    .ame-col-header__desc .ame-label { color: var(--color-on-surface-muted) !important; }
    .ame-col-header__desc .ame-h2 { color: var(--color-on-background) !important; }
    .ame-col-header__desc .ame-divider { background: var(--color-outline) !important; }

    /* Avaliações e perguntas da Konfidency: o app traz cores fixas (#3e3e3e, #666, fundos brancos e
       creme). No escuro, texto claro e fundos da paleta. Estrelas (svg) e o verde dos
       tópicos da IA ficam como estão. */
    :is(#konfidency-reviews-container, #konfidency-questions-container) *:not(svg):not(path):not(.konfidency__ai-summary--topic-text):not(.konfidency__ai-summary--topic-text *) { color: var(--color-on-surface-variant) !important; }
    :is(#konfidency-reviews-container, #konfidency-questions-container) h2,
    :is(#konfidency-reviews-container, #konfidency-questions-container) h3,
    :is(#konfidency-reviews-container, #konfidency-questions-container) .summary,
    :is(#konfidency-reviews-container, #konfidency-questions-container) .kfyDetails__review-count--total { color: var(--color-on-background) !important; }
    :is(#konfidency-reviews-container, #konfidency-questions-container) .konfidency__ai-summary,
    :is(#konfidency-reviews-container, #konfidency-questions-container) .review { background: var(--color-surface-container) !important; }
    :is(#konfidency-reviews-container, #konfidency-questions-container) button.fetch-review,
    :is(#konfidency-reviews-container, #konfidency-questions-container) button.send-question,
    :is(#konfidency-reviews-container, #konfidency-questions-container) button.fetch-questions {
      background: var(--color-surface-container-lowest) !important;
      color: var(--color-primary) !important;
      border-color: var(--color-outline-variant) !important;
    }

    /* Modal que abre ao clicar numa foto/avaliação: o app pinta o painel de BRANCO fixo, e a regra
       de cima deixava o texto claro por cima (ilegível). O painel vira escuro como o resto; a área
       da foto fica cinza-claro porque as fotos dos clientes têm fundo claro e as setas são pretas. */
    :is(#konfidency-reviews-container, #konfidency-questions-container) .konfidency__media-modal { background: var(--color-surface-container) !important; border: 1px solid var(--color-outline-variant); }
    :is(#konfidency-reviews-container, #konfidency-questions-container) .konfidency__media-modal--name,
    :is(#konfidency-reviews-container, #konfidency-questions-container) .konfidency__meddia-modal--text,
    :is(#konfidency-reviews-container, #konfidency-questions-container) .konfidency__media-modal--btn-close { color: var(--color-on-background) !important; }
    :is(#konfidency-reviews-container, #konfidency-questions-container) .konfidency__media-modal--btn-close { opacity: 1; }
  {%- endif -%}
{% endstyle %}
