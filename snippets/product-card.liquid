{% comment %}
  Reutilizável — card de produto
  Parâmetros:
    card_product    — objeto product (obrigatório)
    card_show_badge — boolean (opcional)
    card_btn_label  — string (opcional, default "Comprar")
{% endcomment %}

{%- liquid
  assign card_url = card_product.url
  assign card_title = card_product.title
  # Quando o produto é "principal" do agrupador de cores, oculta o sufixo " - <cor>" no nome.
  if card_product.tags contains 'produto_principal'
    assign card_title = card_title | split: ' - ' | first
  endif
  assign card_img = card_product.featured_image
  # Segunda imagem (hover desktop) — só renderiza se for diferente da primeira
  assign card_img_alt_src = blank
  if card_product.images.size > 1
    assign second = card_product.images[1]
    if second.id != card_img.id
      assign card_img_alt_src = second
    endif
  endif
  assign card_cta_label = card_btn_label | default: 'Comprar'

  # Kit de produtos: produto-pai sem variantes próprias (preço 0) — pra
  # listagens/busca mostrarem o preço real, soma o `price_min` de cada
  # componente referenciado no metafield `custom.kit_componentes`. Vide
  # [sections/product.liquid] e [snippets/kit-picker.liquid].
  assign card_kit_components = card_product.metafields.custom.kit_componentes.value
  assign card_is_kit = false
  if card_kit_components != blank and card_kit_components.size > 1
    assign card_is_kit = true
  endif

  assign card_has_discount = false
  assign card_discount_pct = 0
  assign card_compare = card_product.compare_at_price_max | default: 0
  if card_compare == 0
    assign card_cv = card_product.selected_or_first_available_variant
    assign card_compare = card_cv.compare_at_price | default: 0
  endif
  assign card_price = card_product.price_min | default: card_product.price
  if card_is_kit
    assign card_price = 0
    for comp in card_kit_components
      assign comp_price = comp.price_min | default: comp.price
      assign card_price = card_price | plus: comp_price
    endfor
  endif
  if card_compare > card_price
    assign card_has_discount = true
    assign card_discount_pct = card_compare | minus: card_price | times: 100 | divided_by: card_compare | round
  endif

  assign card_effective_price = card_price
  if card_has_discount == false and settings.auto_discount_enabled and settings.auto_discount_percent > 0
    assign card_has_discount = true
    assign card_discount_pct = settings.auto_discount_percent
    assign card_compare_price = card_price
    assign card_discount_cents = card_price | times: card_discount_pct | divided_by: 100
    assign card_effective_price = card_price | minus: card_discount_cents
  else
    assign card_compare_price = card_compare
  endif

  # Badge de status do produto. Prioridade: lancamento > heritage > novo > mais-vendido.
  # Lançamento ganha prioridade pra dar destaque aos produtos recém-saídos do forno;
  # ele também recebe a classe modificadora --lancamento pra cor de destaque.
  assign card_badge = ''
  assign card_badge_mod = ''
  if card_product.tags contains 'lancamento'
    assign card_badge = 'Lançamento'
    assign card_badge_mod = 'lancamento'
  elsif card_product.tags contains 'heritage'
    assign card_badge = 'Heritage'
  elsif card_product.tags contains 'novo'
    assign card_badge = 'Novo'
  elsif card_product.tags contains 'mais-vendido'
    assign card_badge = 'Mais Vendido'
  endif

  # Esgotado: card_product.available é false quando TODAS as variantes têm
  # inventory_quantity <= 0 e tracking habilitado. Cobre tanto produtos
  # simples quanto multi-variantes.
  assign card_is_sold_out = false
  unless card_product.available
    assign card_is_sold_out = true
  endunless

  # "Sob Medida" é informação técnica (afeta produção/prazo), não promoção —
  # por isso aparece JUNTO com lancamento/heritage/etc na mesma pilha,
  # independente do card_badge principal.
  assign card_is_sob_medida = false
  if card_product.tags contains 'customizacao_sobmedida'
    assign card_is_sob_medida = true
  endif

  # Rating do badge sobre a imagem é populado em runtime pela API REST do
  # Konfidency (ame-konfidency-card-rating.js carregado em theme.liquid).
  # O metafield `reviews.rating.value` ficou como fallback caso o JS falhe
  # — quando estiver presente, exibimos imediatamente sem esperar o XHR.
  assign card_rating = card_product.metafields.reviews.rating.value

  assign pix_pct = settings.pix_discount | default: 5
  assign pix_cents = card_effective_price | times: pix_pct | divided_by: 100
  assign pix_cents = card_effective_price | minus: pix_cents
  assign inst_count = settings.installments_count | default: 3
  assign inst_value = card_effective_price | divided_by: inst_count
-%}

<div class="ame-card{% if card_is_sold_out %} ame-card--sold-out{% endif %}" data-product-card>
  <div class="ame-card__image-wrap">
    <a href="{{ card_url }}" class="ame-card__link" tabindex="-1" aria-hidden="true"></a>
    {%- if card_img != blank -%}
      {%- assign card_img_alt = card_img.alt | default: card_title | escape -%}
      {%- liquid
        assign img_loading = 'lazy'
        assign img_fetchpriority = 'auto'

        # ⚡ Bolt: Eager load the LCP image in product grids
        # 💡 What: Conditionally apply `loading: 'eager'` and `fetchpriority: 'high'` to the first product card image.
        # 🎯 Why: Hardcoding `loading: 'lazy'` for all product cards delays the LCP when the first card is above the fold.
        # 📊 Impact: Improves LCP Web Vital metric for collection, search, and recommendation pages.
        if forloop.first or eager_load_image
          assign img_loading = 'eager'
          assign img_fetchpriority = 'high'
        endif
      -%}
      {{
        card_img
        | image_url: width: 600
        | image_tag:
          loading: img_loading,
          fetchpriority: img_fetchpriority,
          widths: '200, 400, 600',
          class: 'ame-card__img ame-card__img--primary',
          alt: card_img_alt
      }}
      {%- if card_img_alt_src != blank -%}
        {{
          card_img_alt_src
          | image_url: width: 600
          | image_tag:
            loading: 'lazy',
            widths: '200, 400, 600',
            class: 'ame-card__img ame-card__img--secondary',
            alt: ''
        }}
      {%- endif -%}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'ame-card__img ame-card__img--placeholder' }}
    {%- endif -%}

    <!-- Pilha de badges no top-left: Esgotado/Desconto + Lançamento/Heritage/Novo + Sob Medida.
         Esgotado tem prioridade sobre desconto (se não dá pra comprar, o % não importa).
         "Sob Medida" é informação técnica, aparece junto com qualquer outro badge. -->
    {%- if card_is_sold_out or card_has_discount or card_badge != '' or card_is_sob_medida -%}
      <div class="ame-card__badges">
        {%- if card_is_sold_out -%}
          <span class="ame-card__badge-pill ame-card__badge-pill--sold-out" aria-label="Produto esgotado">Esgotado</span>
        {%- elsif card_has_discount -%}
          <span class="ame-card__badge-pill ame-card__badge-pill--discount" aria-label="{{ card_discount_pct }}% de desconto">{{ card_discount_pct }}% OFF</span>
        {%- endif -%}
        {%- if card_badge != '' -%}
          <span class="ame-card__badge-pill ame-card__badge-pill--{{ card_badge_mod | default: 'status' }}">{{ card_badge }}</span>
        {%- endif -%}
        {%- if card_is_sob_medida -%}
          <span class="ame-card__badge-pill ame-card__badge-pill--sob-medida" aria-label="Produto feito sob medida">Sob Medida</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      Avaliação top-right. Renderiza imediatamente se houver metafield
      reviews.rating.value (fallback estático). Caso contrário, fica `hidden`
      até o ame-konfidency-card-rating.js popular via REST API do Konfidency
      em batch (1 request por página, cobre todos os IDs visíveis).
    {%- endcomment -%}
    <span
      class="ame-card__rating-badge"
      data-konfidency-rating="{%- render 'konfidency-id', product: card_product, mode: 'all' -%}"
      aria-label="Avaliação"
      {% if card_rating == blank %}hidden{% endif %}
    >
      <span class="material-symbols-outlined ame-card__rating-star" aria-hidden="true">star</span>
      <span data-konfidency-rating-value>{{ card_rating }}</span>
    </span>

    <!-- Favorito bottom-right (sobre a imagem, acima do link clicável) -->
    <button
      class="ame-wishlist ame-card__wishlist"
      aria-label="Adicionar aos favoritos"
      title="Adicionar aos favoritos"
      data-wishlist-btn="{{ card_product.id }}"
      data-wishlist-handle="{{ card_product.handle }}"
      data-wishlist-title="{{ card_title | escape }}"
      type="button"
      aria-pressed="false"
    >
      <span
        class="material-symbols-outlined"
        style="font-size:1.125rem; font-variation-settings:'FILL' 0;"
        aria-hidden="true"
        >favorite</span
      >
    </button>
  </div>

  <div class="ame-card__info">
    <!--
      {%- if card_product.metafields.custom.collection_name != blank -%}
        <p class="ame-card__collection">{{ card_product.metafields.custom.collection_name }}</p>
      {%- elsif card_product.collections.first != blank -%}
        <p class="ame-card__collection">{{ card_product.collections.first.title }}</p>
      {%- endif -%}
    -->

    <h3 class="ame-card__title">
      <a href="{{ card_url }}">{{ card_title }}</a>
    </h3>

    <!-- Bloco de preços -->
    <div class="ame-card__prices">
      {%- if card_has_discount -%}
        <p class="ame-card__price-de">
          De: <s>{{ card_compare_price | money }}</s>
        </p>
      {%- endif -%}

      <p class="ame-card__price-main">
        <span class="ame-card__price-label">a partir de</span>
        <strong class="ame-card__price-value">{{ card_effective_price | money }}</strong>
      </p>

      {%- if settings.show_installments != false and inst_count > 1 -%}
        <p class="ame-card__installments">ou {{ inst_count }}x de {{ inst_value | money }}</p>
      {%- endif -%}

      {%- if settings.show_pix != false -%}
        <p class="ame-card__pix">{{ pix_cents | money }} com Pix</p>
      {%- endif -%}
    </div>

    {%- if settings.cashback_enabled -%}
      {%- liquid
        assign cb_pct = settings.cashback_percent | default: 8
        assign cb_min = settings.cashback_min_value | default: 10
        assign cb_color = settings.cashback_color | default: '#5a4742'
        assign cb_mode = 'card'

        # Cálculo em centavos (inteiro) pra usar money_without_currency e ter 2 casas
        assign cb_value_cents = card_effective_price | default: 0
        assign cb_value_centavos = cb_value_cents | times: cb_pct | divided_by: 100
        assign cb_value_reais = cb_value_centavos | divided_by: 100.0
        assign cb_show_value = false
        if cb_value_reais >= cb_min
          assign cb_show_value = true
        endif
      -%}

      <div
        class="ame-cashback{% if cb_mode == 'card' %} ame-cashback--card{% endif %}"
        data-cashback
        data-pct="{{ cb_pct }}"
        data-min="{{ cb_min }}"
        style="--cashback-color: {{ cb_color }};"
      >
        <svg
          class="ame-cashback__icon"
          viewBox="0 0 74 68"
          fill="none"
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
        >
          <path d="M73.5001 34C73.5001 52.5 58.5001 67.5 40.0001 67.5C21.5001 67.5 6.5001 52.5 6.5001 34C6.5001 33.7 6.60009 33.4 6.70009 33.2L3.40009 36.5C3.10009 36.8 2.60009 37 2.20009 37C1.80009 37 1.3001 36.8 1.0001 36.5C0.300098 35.8 0.300098 34.7 1.0001 34.1L7.1001 28C7.3001 27.8 7.50009 27.7 7.70009 27.6C8.20009 27.4 8.8001 27.4 9.3001 27.8C9.4001 27.9 9.5001 27.9 9.6001 28L15.7001 34.1C16.4001 34.8 16.4001 35.9 15.7001 36.5C15.4001 36.8 14.9001 37 14.5001 37C14.1001 37 13.6001 36.8 13.3001 36.5L10.0001 33.2C10.1001 33.4 10.2001 33.7 10.2001 34C10.2001 50.6 23.7001 64.1 40.3001 64.1C56.9001 64.1 70.4001 50.6 70.4001 34C70.4001 17.4 56.9001 3.89999 40.3001 3.89999C32.1001 3.89999 24.5001 7.1 18.8001 13C18.1001 13.7 17.0001 13.7 16.4001 13C15.7001 12.3 15.7001 11.2 16.4001 10.6C22.8001 4.10001 31.3001 0.5 40.4001 0.5C58.5001 0.5 73.5001 15.5 73.5001 34ZM40.0001 15.9C39.1001 15.9 38.3001 16.7 38.3001 17.6V21.2H37.5001C33.5001 21.2 30.3001 24.4 30.3001 28.4C30.3001 32.4 33.5001 35.6 37.5001 35.6H42.5001C44.6001 35.6 46.3001 37.3 46.3001 39.4C46.3001 41.5 44.6001 43.2 42.5001 43.2H42.4001H42.3001H33.4001C32.5001 43.2 31.7001 44 31.7001 44.9C31.7001 45.8 32.5001 46.6 33.4001 46.6H38.2001V50.2C38.2001 51.1 39.0001 51.9 39.9001 51.9C40.8001 51.9 41.6001 51.1 41.6001 50.2V46.6H42.2001H42.3001H42.4001C46.4001 46.6 49.6001 43.4 49.6001 39.4C49.6001 35.4 46.4001 32.2 42.4001 32.2H37.4001C35.3001 32.2 33.6001 30.5 33.6001 28.4C33.6001 26.3 35.3001 24.6 37.4001 24.6H46.3001C47.2001 24.6 48.0001 23.8 48.0001 22.9C48.0001 22 47.2001 21.2 46.3001 21.2H41.7001V17.6C41.8001 16.7 41.0001 15.9 40.0001 15.9Z" fill="currentColor"/>
        </svg>
        <p class="ame-cashback__text">
          Ganhe
          {%- if cb_show_value -%}
            <strong class="ame-cashback__cifra">R$</strong>
            <strong class="ame-cashback__value" data-cashback-value>
              {{- cb_value_centavos | money_without_currency -}}
            </strong>
          {%- else -%}
            <strong class="ame-cashback__value" data-cashback-value>{{ cb_pct | round }}%</strong>
          {%- endif -%}
          de cashback.
        </p>
      </div>
    {%- endif -%}

    {%- if card_is_sold_out -%}
      <a href="{{ card_url }}" class="ame-card__buy-btn ame-card__buy-btn--sold-out" aria-label="Produto esgotado: {{ card_title }}">
        Esgotado
      </a>
    {%- else -%}
      <a href="{{ card_url }}" class="ame-card__buy-btn" aria-label="{{ card_cta_label }}: {{ card_title }}">
        {{ card_cta_label }}
      </a>
    {%- endif -%}
  </div>
</div>

<script>
  (() => {
    if (window.AmeWishlistCardBound) return;
    window.AmeWishlistCardBound = true;

    const STORAGE_KEY = 'ame:wishlist';

    function readList() {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
      } catch {
        return [];
      }
    }
    function writeList(list) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
      document.dispatchEvent(new CustomEvent('ame:wishlist-changed', { detail: { list } }));
    }
    function isInList(list, handle) {
      return list.some((p) => p.handle === handle);
    }

    function syncButton(btn, isActive) {
      btn.classList.toggle('is-active', isActive);
      btn.setAttribute('aria-pressed', isActive);
      btn.setAttribute('aria-label', isActive ? 'Remover dos favoritos' : 'Adicionar aos favoritos');
      btn.setAttribute('title', isActive ? 'Remover dos favoritos' : 'Adicionar aos favoritos');
      const icon = btn.querySelector('.material-symbols-outlined');
      if (icon) icon.style.fontVariationSettings = isActive ? "'FILL' 1" : "'FILL' 0";
    }

    /* Hidrata visualmente os botões existentes (sem bind individual — delegation faz isso) */
    function hydrateVisualState() {
      const list = readList();
      document.querySelectorAll('[data-wishlist-btn]').forEach((btn) => {
        syncButton(btn, isInList(list, btn.dataset.wishlistHandle));
      });
    }

    /* Event delegation: um único listener no document cuida de todos os botões,
       inclusive os adicionados dinamicamente depois (search predictivo, paginação ajax).
       Sem MutationObserver pesado. */
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-wishlist-btn]');
      if (!btn) return;
      e.preventDefault();
      e.stopPropagation();
      const handle = btn.dataset.wishlistHandle;
      const current = readList();
      const exists = isInList(current, handle);
      const next = exists
        ? current.filter((p) => p.handle !== handle)
        : [...current, { id: btn.dataset.wishlistBtn, handle, title: btn.dataset.wishlistTitle, addedAt: Date.now() }];
      writeList(next);
    });

    hydrateVisualState();
    document.addEventListener('ame:wishlist-changed', hydrateVisualState);
    /* Re-hidrata só quando algum input/output relevante mudar (paginação ajax dispara isso) */
    window.addEventListener('pageshow', hydrateVisualState);
  })();
</script>
